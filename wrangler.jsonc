// Moon — web estática en Cloudflare Workers
// ============================================================
// El frontend compilado (frontend/dist) se sirve desde la red de
// Cloudflare. El API sigue viviendo en su propio servicio: cuando la
// web corre aquí, VITE_API_URL apunta a él.
{
  "name": "moon",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./frontend/dist",
    "not_found_handling": "single-page-application"
  },
  // Declarado a propósito: sin esta línea wrangler avisa de que activa
  // workers.dev «por defecto», y fue justo esa ruta la que dejó la web en
  // blanco (moon.alexsndersoto04.workers.dev sin contenido servido).
  // Dejándolo explícito, ningún despliegue futuro la vuelve a apagar.
  "workers_dev": true
}

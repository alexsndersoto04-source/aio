#!/bin/bash
# Generar un secreto JWT seguro para Nexo
# Ejecutar: titan run scripts/generate_secret.titan

fn main() {
    let secret = std::random::bytes(64)
    let encoded = std::encoding::base64_encode(secret)
    print("JWT_SECRET=" + encoded)
    print("")
    print("Agrega esta línea a /etc/systemd/system/nexo.service:")
    print("Environment=NEXO_JWT_SECRET=" + encoded)
}

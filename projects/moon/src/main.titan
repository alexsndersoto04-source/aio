fn main_router() -> int {
    let r = std::router::new()
    std::router::insert(r, "/api/health", "health")
    std::router::insert(r, "/api/metrics", "metrics")
    // Cuenta y seguridad
    std::router::insert(r, "/api/auth/register", "auth_register")
    std::router::insert(r, "/api/auth/login", "auth_login")
    std::router::insert(r, "/api/auth/logout", "auth_logout")
    std::router::insert(r, "/api/auth/refresh", "auth_refresh")
    std::router::insert(r, "/api/auth/me", "auth_me")
    std::router::insert(r, "/api/auth/update", "auth_update_me")
    std::router::insert(r, "/api/auth/privacy", "auth_privacy")
    std::router::insert(r, "/api/auth/change-password", "auth_change_password")
    std::router::insert(r, "/api/auth/recovery/request", "auth_recovery_request")
    std::router::insert(r, "/api/auth/recovery/verify", "auth_recovery_verify")
    std::router::insert(r, "/api/auth/2fa/verify", "auth_2fa_verify")
    std::router::insert(r, "/api/auth/2fa/enable", "auth_2fa_enable")
    std::router::insert(r, "/api/auth/2fa/confirm", "auth_2fa_confirm")
    std::router::insert(r, "/api/auth/2fa/disable", "auth_2fa_disable")
    std::router::insert(r, "/api/auth/sessions", "auth_sessions")
    std::router::insert(r, pat_sessions_id(), "auth_revoke_session")
    std::router::insert(r, "/api/auth/sessions-all", "auth_revoke_all")
    std::router::insert(r, "/api/auth/account", "auth_delete")
    std::router::insert(r, "/api/auth/export", "auth_export")
    // Perfiles y grafo
    std::router::insert(r, pat_users_id(), "users_profile")
    std::router::insert(r, pat_users_id_posts(), "users_posts")
    std::router::insert(r, pat_users_id_followers(), "users_followers")
    std::router::insert(r, pat_users_id_following(), "users_following")
    std::router::insert(r, pat_users_id_liked(), "users_liked")
    std::router::insert(r, "/api/me/saved", "users_saved")
    std::router::insert(r, "/api/search", "search")
    std::router::insert(r, pat_users_id_follow(), "users_follow")
    std::router::insert(r, pat_users_id_block(), "users_block")
    std::router::insert(r, "/api/users/suggestions", "users_suggestions")
    // Contenido
    std::router::insert(r, "/api/posts", "posts_create")
    std::router::insert(r, pat_posts_id(), "posts_get")
    std::router::insert(r, pat_posts_id_like(), "posts_like")
    std::router::insert(r, pat_posts_id_save(), "posts_save")
    std::router::insert(r, pat_posts_id_comments(), "posts_comments")
    std::router::insert(r, pat_comments_id(), "comments_delete")
    std::router::insert(r, "/api/hashtags", "hashtags_trending")
    std::router::insert(r, pat_hashtag(), "hashtag_page")
    // Explorar
    std::router::insert(r, "/api/feed", "feed")
    std::router::insert(r, "/api/feed/trending", "trending")
    std::router::insert(r, "/api/feed/for-you", "for_you")
    std::router::insert(r, "/api/feed/latest", "latest")
    // Mensajería
    std::router::insert(r, "/api/messages/conversations", "messages_conversations")
    std::router::insert(r, pat_conversations_id(), "messages_thread")
    std::router::insert(r, pat_conversations_id_messages(), "messages_send")
    std::router::insert(r, pat_conversations_id_read(), "messages_read")
    std::router::insert(r, pat_messages_id(), "messages_delete")
    std::router::insert(r, pat_messages_id_react(), "messages_react")
    // Notificaciones
    std::router::insert(r, "/api/notifications", "notifications")
    std::router::insert(r, pat_notifications_id_read(), "notifications_read")
    std::router::insert(r, "/api/notifications/read-all", "notifications_read_all")
    std::router::insert(r, "/api/notifications/prefs", "notifications_prefs")
    // Reportes
    std::router::insert(r, "/api/reports", "report_create")
    std::router::insert(r, pat_reports_id(), "report_status")
    // Admin
    std::router::insert(r, "/api/admin/dashboard", "admin_dashboard")
    std::router::insert(r, "/api/admin/users", "admin_users")
    std::router::insert(r, pat_admin_users_id_suspend(), "admin_suspend")
    std::router::insert(r, pat_admin_users_id_activate(), "admin_activate")
    std::router::insert(r, pat_admin_users_id_verify(), "admin_verify")
    std::router::insert(r, "/api/admin/reports", "admin_reports")
    std::router::insert(r, pat_admin_reports_id_resolve(), "admin_resolve_report")
    std::router::insert(r, "/api/admin/export", "admin_backup")
    std::router::insert(r, "/api/admin/stats", "admin_stats")
    std::router::insert(r, "/api/admin/words", "admin_words")
    std::router::insert(r, "/api/admin/activity", "admin_activity")
    std::router::insert(r, pat_admin_words_id(), "admin_remove_word")
    // Media
    std::router::insert(r, "/api/upload", "upload")
    std::router::insert(r, pat_media(), "media")
    print("Rutas registradas: 68")
    r
}

// Lee el id del path param como int.
fn main_param_id(params: any, name: string) -> int {
    let raw = std::map::get(params, name)
    v_path_id(raw, -1)
}

fn main_dispatch(r: int, req: int, ctx: map) {
    let method = std::server::method(req)
    let path = std::server::path(req)

    // WebSocket de tiempo real
    if path == "/ws" {
        rt_handle_ws(req, ctx)
        return
    }

    if method == "OPTIONS" {
        r_preflight(req)
        return
    }

    let hit = std::router::at(r, path)
    if hit == nil {
        r_err(req, 404, "Not found")
        return
    }
    let tag = hit.pattern
    let params = hit.params

    // ---- Sistema ----
    if tag == "health" { if r_expect_method(req, "GET") { h_health(req, ctx) } return }
    if tag == "metrics" { if r_expect_method(req, "GET") { h_metrics(req, ctx) } return }

    // ---- Cuenta y seguridad ----
    if tag == "auth_register" { if r_expect_method(req, "POST") { h_auth_register(req, ctx) } return }
    if tag == "auth_login" { if r_expect_method(req, "POST") { h_auth_login(req, ctx) } return }
    if tag == "auth_logout" { if r_expect_method(req, "POST") { h_auth_logout(req, ctx) } return }
    if tag == "auth_refresh" { if r_expect_method(req, "POST") { h_auth_refresh(req, ctx) } return }
    if tag == "auth_me" { if r_expect_method(req, "GET") { h_auth_me(req, ctx) } return }
    if tag == "auth_update_me" { if r_expect_method(req, "PATCH") { h_auth_update_me(req, ctx) } return }
    if tag == "auth_privacy" { if r_expect_method(req, "PATCH") { h_auth_set_privacy(req, ctx) } return }
    if tag == "auth_change_password" { if r_expect_method(req, "POST") { h_auth_change_password(req, ctx) } return }
    if tag == "auth_recovery_request" { if r_expect_method(req, "POST") { h_auth_recovery_request(req, ctx) } return }
    if tag == "auth_recovery_verify" { if r_expect_method(req, "POST") { h_auth_recovery_verify(req, ctx) } return }
    if tag == "auth_2fa_verify" { if r_expect_method(req, "POST") { h_auth_2fa_verify(req, ctx) } return }
    if tag == "auth_2fa_enable" { if r_expect_method(req, "POST") { h_auth_2fa_enable(req, ctx) } return }
    if tag == "auth_2fa_confirm" { if r_expect_method(req, "POST") { h_auth_2fa_confirm_enable(req, ctx) } return }
    if tag == "auth_2fa_disable" { if r_expect_method(req, "POST") { h_auth_2fa_disable(req, ctx) } return }
    if tag == "auth_sessions" { if r_expect_method(req, "GET") { h_auth_sessions(req, ctx) } return }
    if tag == "auth_revoke_session" {
        if r_expect_method(req, "DELETE") {
            let sid = main_param_id(params, "id")
            if sid > 0 { h_auth_revoke_session(req, ctx, sid) }
        }
        return
    }
    if tag == "auth_revoke_all" { if r_expect_method(req, "POST") { h_auth_revoke_all(req, ctx) } return }
    if tag == "auth_delete" { if r_expect_method(req, "DELETE") { h_auth_delete_account(req, ctx) } return }
    if tag == "auth_export" { if r_expect_method(req, "GET") { h_auth_export(req, ctx) } return }

    // ---- Perfiles y grafo ----
    if tag == "users_profile" {
        if r_expect_method(req, "GET") {
            let tid = main_param_id(params, "id")
            if tid > 0 { h_users_profile(req, ctx, tid) }
        }
        return
    }
    if tag == "users_posts" {
        if r_expect_method(req, "GET") {
            let tid = main_param_id(params, "id")
            if tid > 0 { h_users_posts(req, ctx, tid) }
        }
        return
    }
    if tag == "users_followers" {
        if r_expect_method(req, "GET") {
            let tid = main_param_id(params, "id")
            if tid > 0 { h_users_followers(req, ctx, tid) }
        }
        return
    }
    if tag == "users_following" {
        if r_expect_method(req, "GET") {
            let tid = main_param_id(params, "id")
            if tid > 0 { h_users_following(req, ctx, tid) }
        }
        return
    }
    if tag == "users_liked" {
        if r_expect_method(req, "GET") {
            let tid = main_param_id(params, "id")
            if tid > 0 { h_users_liked(req, ctx, tid) }
        }
        return
    }
    if tag == "users_saved" { if r_expect_method(req, "GET") { h_users_saved(req, ctx) } return }
    if tag == "search" { if r_expect_method(req, "GET") { h_users_search(req, ctx) } return }
    if tag == "users_follow" {
        if method == "POST" {
            let tid = main_param_id(params, "id")
            if tid > 0 { h_users_follow(req, ctx, tid) }
        } else if method == "DELETE" {
            let tid = main_param_id(params, "id")
            if tid > 0 { h_users_unfollow(req, ctx, tid) }
        } else {
            r_err(req, 405, "Método no permitido")
        }
        return
    }
    if tag == "users_block" {
        if method == "POST" {
            let tid = main_param_id(params, "id")
            if tid > 0 { h_users_block(req, ctx, tid) }
        } else if method == "DELETE" {
            let tid = main_param_id(params, "id")
            if tid > 0 { h_users_unblock(req, ctx, tid) }
        } else {
            r_err(req, 405, "Método no permitido")
        }
        return
    }
    if tag == "users_suggestions" { if r_expect_method(req, "GET") { h_users_suggestions(req, ctx) } return }

    // ---- Contenido ----
    if tag == "posts_create" { if r_expect_method(req, "POST") { h_posts_create(req, ctx) } return }
    if tag == "posts_get" {
        if r_expect_method(req, "GET") {
            let pid = main_param_id(params, "id")
            if pid > 0 { h_posts_get(req, ctx, pid) }
        } else if method == "PATCH" {
            let pid = main_param_id(params, "id")
            if pid > 0 { h_posts_edit(req, ctx, pid) }
        } else if method == "DELETE" {
            let pid = main_param_id(params, "id")
            if pid > 0 { h_posts_delete(req, ctx, pid) }
        } else {
            r_err(req, 405, "Método no permitido")
        }
        return
    }
    if tag == "posts_like" {
        if method == "POST" {
            let pid = main_param_id(params, "id")
            if pid > 0 { h_posts_like(req, ctx, pid) }
        } else if method == "DELETE" {
            let pid = main_param_id(params, "id")
            if pid > 0 { h_posts_unlike(req, ctx, pid) }
        } else {
            r_err(req, 405, "Método no permitido")
        }
        return
    }
    if tag == "posts_save" {
        if r_expect_method(req, "POST") {
            let pid = main_param_id(params, "id")
            if pid > 0 { h_posts_save(req, ctx, pid) }
        }
        return
    }
    if tag == "posts_comments" {
        if method == "GET" {
            let pid = main_param_id(params, "id")
            if pid > 0 { h_posts_comments(req, ctx, pid) }
        } else if method == "POST" {
            let pid = main_param_id(params, "id")
            if pid > 0 { h_posts_comment(req, ctx, pid, 0) }
        } else {
            r_err(req, 405, "Método no permitido")
        }
        return
    }
    if tag == "comments_delete" {
        if r_expect_method(req, "DELETE") {
            let cid = main_param_id(params, "id")
            if cid > 0 { h_posts_delete_comment(req, ctx, cid) }
        }
        return
    }
    if tag == "hashtags_trending" { if r_expect_method(req, "GET") { h_trending_hashtags(req, ctx) } return }
    if tag == "hashtag_page" {
        if r_expect_method(req, "GET") {
            let tag_name = std::map::get(params, "tag")
            if tag_name != nil { h_hashtag_page(req, ctx, tag_name) }
        }
        return
    }

    // ---- Explorar ----
    if tag == "feed" { if r_expect_method(req, "GET") { h_feed(req, ctx) } return }
    if tag == "trending" { if r_expect_method(req, "GET") { h_trending(req, ctx) } return }
    if tag == "for_you" { if r_expect_method(req, "GET") { h_for_you(req, ctx) } return }
    if tag == "latest" { if r_expect_method(req, "GET") { h_latest(req, ctx) } return }

    // ---- Mensajería ----
    if tag == "messages_conversations" {
        if method == "GET" { h_messages_conversations(req, ctx) }
        else if method == "POST" { h_messages_start(req, ctx) }
        else { r_err(req, 405, "Método no permitido") }
        return
    }
    if tag == "messages_thread" {
        if r_expect_method(req, "GET") {
            let cid = main_param_id(params, "id")
            if cid > 0 { h_messages_thread(req, ctx, cid) }
        }
        return
    }
    if tag == "messages_send" {
        if r_expect_method(req, "POST") {
            let cid = main_param_id(params, "id")
            if cid > 0 { h_messages_send(req, ctx, cid) }
        }
        return
    }
    if tag == "messages_read" {
        if r_expect_method(req, "POST") {
            let cid = main_param_id(params, "id")
            if cid > 0 { h_messages_mark_read(req, ctx, cid) }
        }
        return
    }
    if tag == "messages_delete" {
        if r_expect_method(req, "DELETE") {
            let mid = main_param_id(params, "id")
            if mid > 0 { h_messages_delete(req, ctx, mid) }
        }
        return
    }
    if tag == "messages_react" {
        if r_expect_method(req, "POST") {
            let mid = main_param_id(params, "id")
            if mid > 0 { h_messages_react(req, ctx, mid) }
        }
        return
    }

    // ---- Notificaciones ----
    if tag == "notifications" { if r_expect_method(req, "GET") { h_notifications_list(req, ctx) } return }
    if tag == "notifications_read" {
        if r_expect_method(req, "POST") {
            let nid = main_param_id(params, "id")
            if nid > 0 { h_notifications_read(req, ctx, nid) }
        }
        return
    }
    if tag == "notifications_read_all" { if r_expect_method(req, "POST") { h_notifications_read_all(req, ctx) } return }
    if tag == "notifications_prefs" {
        if method == "GET" { h_notifications_prefs(req, ctx) }
        else if method == "PATCH" { h_notifications_prefs_update(req, ctx) }
        else { r_err(req, 405, "Método no permitido") }
        return
    }

    // ---- Reportes ----
    if tag == "report_create" { if r_expect_method(req, "POST") { h_report_create(req, ctx) } return }
    if tag == "report_status" {
        if r_expect_method(req, "GET") {
            let rid = main_param_id(params, "id")
            if rid > 0 { h_report_status(req, ctx, rid) }
        }
        return
    }

    // ---- Admin ----
    if tag == "admin_dashboard" { if r_expect_method(req, "GET") { h_admin_dashboard(req, ctx) } return }
    if tag == "admin_users" { if r_expect_method(req, "GET") { h_admin_list_users(req, ctx) } return }
    if tag == "admin_suspend" {
        if r_expect_method(req, "POST") {
            let tid = main_param_id(params, "id")
            if tid > 0 { h_admin_suspend(req, ctx, tid) }
        }
        return
    }
    if tag == "admin_activate" {
        if r_expect_method(req, "POST") {
            let tid = main_param_id(params, "id")
            if tid > 0 { h_admin_activate(req, ctx, tid) }
        }
        return
    }
    if tag == "admin_verify" {
        if r_expect_method(req, "POST") {
            let tid = main_param_id(params, "id")
            if tid > 0 { h_admin_verify(req, ctx, tid) }
        }
        return
    }
    if tag == "admin_reports" { if r_expect_method(req, "GET") { h_admin_list_reports(req, ctx) } return }
    if tag == "admin_resolve_report" {
        if r_expect_method(req, "POST") {
            let rid = main_param_id(params, "id")
            if rid > 0 { h_admin_resolve_report(req, ctx, rid) }
        }
        return
    }
    if tag == "admin_backup" { if r_expect_method(req, "GET") { h_admin_backup(req, ctx) } return }
    if tag == "admin_stats" { if r_expect_method(req, "GET") { h_admin_stats(req, ctx) } return }
    if tag == "admin_words" {
        if method == "GET" { h_admin_blocked_words(req, ctx) }
        else if method == "POST" { h_admin_add_word(req, ctx) }
        else { r_err(req, 405, "Método no permitido") }
        return
    }
    if tag == "admin_remove_word" {
        if r_expect_method(req, "DELETE") {
            let wid = main_param_id(params, "id")
            if wid > 0 { h_admin_remove_word(req, ctx, wid) }
        }
        return
    }
    if tag == "admin_activity" { if r_expect_method(req, "GET") { h_admin_activity(req, ctx) } return }

    // ---- Media ----
    if tag == "upload" { if r_expect_method(req, "POST") { h_media_upload(req, ctx) } return }
    if tag == "media" {
        if r_expect_method(req, "GET") {
            let name = std::map::get(params, "name")
            if name != nil { h_media_serve(req, ctx, name) }
        }
        return
    }

    r_err(req, 404, "Ruta no encontrada")
}

// Acepta y despacha UNA conexión dentro de su propia tarea; al terminar
// se libera el slot del control de backpressure.
fn main_accept_once(s: int, control: ServerControl, r: int, ctx: map, req: int) {
    let acquired = std::try::catch(|| std::server::try_acquire(control))
    let allowed = match acquired {
        Result::Ok(ok) => ok,
        Result::Err(_) => false,
    }
    if allowed {
        // 1 tarea por conexión: concurrencia real (SPEC §1)
        spawn || {
            main_handle_connection(r, req, ctx, control)
        }
    } else {
        let body = std::encoding::utf8_encode("{\"error\":\"Servidor ocupado\"}")
        let _ = std::try::catch(|| std::server::respond_full(req, 503, "application/json; charset=utf-8", r_headers(), body))
    }
}

// Una conexión completa se atiende en su propia tarea; al terminar se
// libera el slot del control de backpressure.
fn main_handle_connection(r: int, req: int, ctx: map, control: ServerControl) {
    let attempt = std::try::catch(|| main_dispatch(r, req, ctx))
    match attempt {
        Result::Err(msg) => {
            let _ = std::try::catch(|| r_err(req, 500, "Error interno del servidor"))
            print("ERROR manejando request: " + msg)
        },
        Result::Ok(_) => {}
    }
    let _ = std::try::catch(|| std::server::release(control))
}

fn main() {
    print("===========================================")
    print("  Moon — Red Social Profesional")
    print("  Backend Titan + PostgreSQL + WebSocket")
    print("===========================================")

    // Configuración (falla duro si faltan secretos)
    cfg_jwt_secret()
    let url = cfg_database_url()
    let _ = url

    // Base de datos con migraciones
    let pool = db_init()
    db_ensure_dirs()

    // Hub de tiempo real
    let hub = rt_start()

    // Contexto compartido
    let mut ctx = std::map::new()
    ctx = std::map::insert(ctx, "pool", pool)
    ctx = std::map::insert(ctx, "hub", hub)

    // Router
    let r = main_router()

    // Servidor
    let port = cfg_port()
    let bind = "0.0.0.0:" + port
    let s = std::server::start(bind)
    let addr = std::server::local_addr(s)
    print("Moon escuchando en http://" + addr)
    print("CORS origen: " + cfg_cors_origin())

    // Backpressure real: máximo de conexiones concurrentes
    let control = std::server::control(CFG_MAX_CONNECTIONS)

    loop {
        let attempt = std::try::catch(|| std::server::accept(s, 30000))
        match attempt {
            Result::Err(_) => {
                // Conexiones incompletas (health checks/scanners): ignorar
            },
            Result::Ok(req) => {
                if req >= 0 {
                    let iter = std::try::catch(|| main_accept_once(s, control, r, ctx, req))
                    match iter {
                        Result::Ok(_) => {},
                        Result::Err(msg) => {
                            print("error en bucle de aceptación: " + msg)
                        }
                    }
                }
            }
        }
    }

    std::server::stop(s)
    std::router::drop(r)
    std::postgres::pool_close(pool)
    print("Moon detenido.")
}

// Moon - Red Social Backend v1.0
// Reglas aplicadas:
// - let mut para toda variable reasignada
// - Tipos de retorno correctos (map, no int)
// - No comparar Bool con Nil
// - Verificar != nil antes de indexar resultados de query

const HOST: string = "0.0.0.0"
const PORT: int = 3000
const JWT_EXPIRES: int = 86400
const MAX_POSTS_PER_HOUR: int = 30
const APP_NAME: string = "Moon"

// ---- RESPONSES ----
fn respond_ok(req, json_string: string) {
    std::server::respond_json(req, 200, json_string)
}
fn respond_created(req, json_string: string) {
    std::server::respond_json(req, 201, json_string)
}
fn respond_err(req, status: int, message: string) {
    let body = "{\"error\":\"" + message + "\"}"
    std::server::respond_json(req, status, body)
}

// ---- AUTH ----
fn get_secret() -> string {
    let val = std::env::get("JWT_SECRET")
    if val == "" { return "moon-default-secret-change-in-production" }
    val
}

fn authenticate(req) -> int {
    let auth_header = std::server::header(req, "Authorization")
    if auth_header == nil { return -1 }
    let words = std::text::words(auth_header)
    if std::collections::length(words) != 2 { return -1 }
    if words[0] != "Bearer" { return -1 }
    let token = words[1]
    let secret_bytes = std::encoding::utf8_encode(get_secret())
    let claims = std::jwt::verify_hs256(token, secret_bytes, "", "")
    if claims == nil { return -1 }
    let uid = claims.user_id
    uid
}

fn require_auth(req) -> int {
    let uid = authenticate(req)
    if uid < 0 {
        respond_err(req, 401, "No autorizado")
        return -1
    }
    uid
}

// ---- TOKEN ----
fn make_token(user_id, username: string) -> string {
    let secret_bytes = std::encoding::utf8_encode(get_secret())
    let now = std::datetime::now()
    let exp = std::datetime::add_seconds(now, JWT_EXPIRES)
    let mut claims = std::map::new()
    claims = std::map::insert(claims, "user_id", user_id)
    claims = std::map::insert(claims, "username", username)
    claims = std::map::insert(claims, "iat", now)
    claims = std::map::insert(claims, "exp", exp)
    std::jwt::sign_hs256(claims, secret_bytes)
}

// ---- NOTIFICATION ----
fn notify(conn, uid, ntype: string, from_uid) {
    let p1 = [uid, ntype, from_uid, 0, 0]
    std::sqlite::execute(conn, "INSERT INTO notifications (user_id, type, from_user_id) VALUES (?, ?, ?)", p1)
}

// ---- DB INIT ----
fn init_db() {
    print("Iniciando SQLite...")
    let pool = std::sqlite::pool("moon.db", 5)
    print("SQLite pool creado.")

    let conn_opt = std::sqlite::acquire(pool, 2000)
    match conn_opt {
        Option::Some(conn) => {
            std::sqlite::execute(conn, "CREATE TABLE IF NOT EXISTS users (id INTEGER PRIMARY KEY AUTOINCREMENT, username TEXT UNIQUE NOT NULL, email TEXT UNIQUE NOT NULL, password_hash TEXT NOT NULL, display_name TEXT DEFAULT '', bio TEXT DEFAULT '', avatar_url TEXT DEFAULT '', followers_count INTEGER DEFAULT 0, following_count INTEGER DEFAULT 0, posts_count INTEGER DEFAULT 0, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, last_login_at DATETIME)", [])
            std::sqlite::execute(conn, "CREATE TABLE IF NOT EXISTS posts (id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER NOT NULL, content TEXT NOT NULL, likes_count INTEGER DEFAULT 0, comments_count INTEGER DEFAULT 0, created_at DATETIME DEFAULT CURRENT_TIMESTAMP)", [])
            std::sqlite::execute(conn, "CREATE TABLE IF NOT EXISTS follows (follower_id INTEGER NOT NULL, following_id INTEGER NOT NULL, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, PRIMARY KEY (follower_id, following_id))", [])
            std::sqlite::execute(conn, "CREATE TABLE IF NOT EXISTS likes (user_id INTEGER NOT NULL, post_id INTEGER NOT NULL, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, PRIMARY KEY (user_id, post_id))", [])
            std::sqlite::execute(conn, "CREATE TABLE IF NOT EXISTS comments (id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER NOT NULL, post_id INTEGER NOT NULL, content TEXT NOT NULL, created_at DATETIME DEFAULT CURRENT_TIMESTAMP)", [])
            std::sqlite::execute(conn, "CREATE TABLE IF NOT EXISTS direct_messages (id INTEGER PRIMARY KEY AUTOINCREMENT, sender_id INTEGER NOT NULL, receiver_id INTEGER NOT NULL, content TEXT NOT NULL, is_read INTEGER DEFAULT 0, created_at DATETIME DEFAULT CURRENT_TIMESTAMP)", [])
            std::sqlite::execute(conn, "CREATE TABLE IF NOT EXISTS notifications (id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER NOT NULL, type TEXT NOT NULL, from_user_id INTEGER, is_read INTEGER DEFAULT 0, created_at DATETIME DEFAULT CURRENT_TIMESTAMP)", [])
            std::sqlite::close(conn)
            print("Tablas creadas.")
        },
        Option::None => {
            print("ERROR: No se pudo conectar a SQLite")
        }
    }
    pool
}

// ============================================================
// HANDLERS
// ============================================================

fn handle_health(req) {
    let mut resp = std::map::new()
    resp = std::map::insert(resp, "status", "ok")
    resp = std::map::insert(resp, "app", APP_NAME)
    respond_ok(req, std::json::stringify(resp))
}

fn handle_register(r, req, pool) {
    let conn_opt = std::sqlite::acquire(pool, 2000)
    match conn_opt {
        Option::Some(conn) => {
            let body_text = std::server::body_text(req)
            let body = std::json::parse(body_text)
            let username = body.username
            let email = body.email
            let password = body.password

            if std::collections::length(username) < 3 {
                respond_err(req, 400, "Username muy corto")
                std::sqlite::close(conn)
                return
            }
            if std::collections::length(password) < 8 {
                respond_err(req, 400, "Password muy corto")
                std::sqlite::close(conn)
                return
            }

            let p1 = [username]
            let existing = std::sqlite::query(conn, "SELECT id FROM users WHERE username = ?", p1)
            if existing != nil {
                if std::collections::length(existing) > 0 {
                    respond_err(req, 409, "Username en uso")
                    std::sqlite::close(conn)
                    return
                }
            }

            let p2 = [email]
            let existing2 = std::sqlite::query(conn, "SELECT id FROM users WHERE email = ?", p2)
            if existing2 != nil {
                if std::collections::length(existing2) > 0 {
                    respond_err(req, 409, "Email en uso")
                    std::sqlite::close(conn)
                    return
                }
            }

            let pw_hash = std::password::hash_argon2(password)
            let p3 = [username, email, pw_hash, username]
            std::sqlite::execute(conn, "INSERT INTO users (username, email, password_hash, display_name) VALUES (?, ?, ?, ?)", p3)

            let p4 = [username]
            let nu = std::sqlite::query(conn, "SELECT id, username, email, display_name FROM users WHERE username = ?", p4)
            if nu == nil {
                respond_err(req, 500, "Error")
                std::sqlite::close(conn)
                return
            }
            let user = nu[0]
            let token = make_token(user.id, username)

            let mut resp = std::map::new()
            resp = std::map::insert(resp, "token", token)
            resp = std::map::insert(resp, "user", user)
            respond_created(req, std::json::stringify(resp))
            std::sqlite::close(conn)
        },
        Option::None => { respond_err(req, 500, "DB error") }
    }
}

fn handle_login(r, req, pool) {
    let conn_opt = std::sqlite::acquire(pool, 2000)
    match conn_opt {
        Option::Some(conn) => {
            let body_text = std::server::body_text(req)
            let body = std::json::parse(body_text)
            let username = body.username
            let password = body.password

            if username == "" {
                respond_err(req, 400, "Username requerido")
                std::sqlite::close(conn)
                return
            }
            if password == "" {
                respond_err(req, 400, "Password requerido")
                std::sqlite::close(conn)
                return
            }

            let p1 = [username, username]
            let users = std::sqlite::query(conn, "SELECT id, username, email, password_hash, display_name, bio, avatar_url FROM users WHERE username = ? OR email = ?", p1)

            if users == nil {
                respond_err(req, 401, "Credenciales invalidas")
                std::sqlite::close(conn)
                return
            }
            if std::collections::length(users) == 0 {
                respond_err(req, 401, "Credenciales invalidas")
                std::sqlite::close(conn)
                return
            }

            let user = users[0]
            let valid = std::password::verify_argon2(user.password_hash, password)
            if valid != true {
                respond_err(req, 401, "Credenciales invalidas")
                std::sqlite::close(conn)
                return
            }

            let uid = user.id
            let p2 = [uid]
            std::sqlite::execute(conn, "UPDATE users SET last_login_at = CURRENT_TIMESTAMP WHERE id = ?", p2)

            let token = make_token(user.id, user.username)

            let mut su = std::map::new()
            su = std::map::insert(su, "id", user.id)
            su = std::map::insert(su, "username", user.username)
            su = std::map::insert(su, "email", user.email)
            su = std::map::insert(su, "display_name", user.display_name)
            su = std::map::insert(su, "bio", user.bio)
            su = std::map::insert(su, "avatar_url", user.avatar_url)

            let mut resp = std::map::new()
            resp = std::map::insert(resp, "token", token)
            resp = std::map::insert(resp, "user", su)
            respond_ok(req, std::json::stringify(resp))
            std::sqlite::close(conn)
        },
        Option::None => { respond_err(req, 500, "DB error") }
    }
}

fn handle_me(r, req, pool) {
    let uid = require_auth(req)
    if uid < 0 { return }
    let conn_opt = std::sqlite::acquire(pool, 2000)
    match conn_opt {
        Option::Some(conn) => {
            let p1 = [uid]
            let users = std::sqlite::query(conn, "SELECT id, username, email, display_name, bio, avatar_url, followers_count, following_count, posts_count, created_at FROM users WHERE id = ?", p1)
            if users == nil {
                respond_err(req, 404, "No encontrado")
                std::sqlite::close(conn)
                return
            }
            if std::collections::length(users) == 0 {
                respond_err(req, 404, "No encontrado")
                std::sqlite::close(conn)
                return
            }
            respond_ok(req, std::json::stringify(users[0]))
            std::sqlite::close(conn)
        },
        Option::None => { respond_err(req, 500, "DB error") }
    }
}

fn handle_get_profile(r, req, pool) {
    let uid = require_auth(req)
    if uid < 0 { return }
    let path = std::server::path(req)
    let hit = std::router::at(r, path)
    let target_id = hit.params.id
    let conn_opt = std::sqlite::acquire(pool, 2000)
    match conn_opt {
        Option::Some(conn) => {
            let p1 = [target_id]
            let users = std::sqlite::query(conn, "SELECT id, username, display_name, bio, avatar_url, followers_count, following_count, posts_count FROM users WHERE id = ?", p1)
            if users == nil {
                respond_err(req, 404, "No encontrado")
                std::sqlite::close(conn)
                return
            }
            if std::collections::length(users) == 0 {
                respond_err(req, 404, "No encontrado")
                std::sqlite::close(conn)
                return
            }
            let profile = users[0]

            let p2 = [uid, target_id]
            let follows = std::sqlite::query(conn, "SELECT 1 FROM follows WHERE follower_id = ? AND following_id = ?", p2)
            let mut is_following = false
            if follows != nil {
                if std::collections::length(follows) > 0 {
                    is_following = true
                }
            }

            let mut resp = std::map::new()
            resp = std::map::insert(resp, "user", profile)
            resp = std::map::insert(resp, "is_following", is_following)
            respond_ok(req, std::json::stringify(resp))
            std::sqlite::close(conn)
        },
        Option::None => { respond_err(req, 500, "DB error") }
    }
}

fn handle_follow(r, req, pool) {
    let uid = require_auth(req)
    if uid < 0 { return }
    let path = std::server::path(req)
    let hit = std::router::at(r, path)
    let target_id = hit.params.user_id

    if uid == target_id {
        respond_err(req, 400, "No puedes seguirte a ti mismo")
        return
    }

    let conn_opt = std::sqlite::acquire(pool, 2000)
    match conn_opt {
        Option::Some(conn) => {
            let p1 = [target_id]
            let t = std::sqlite::query(conn, "SELECT id FROM users WHERE id = ?", p1)
            if t == nil {
                respond_err(req, 404, "No encontrado")
                std::sqlite::close(conn)
                return
            }
            if std::collections::length(t) == 0 {
                respond_err(req, 404, "No encontrado")
                std::sqlite::close(conn)
                return
            }

            let p2 = [uid, target_id]
            let already = std::sqlite::query(conn, "SELECT 1 FROM follows WHERE follower_id = ? AND following_id = ?", p2)
            if already != nil {
                if std::collections::length(already) > 0 {
                    respond_err(req, 409, "Ya sigues a este usuario")
                    std::sqlite::close(conn)
                    return
                }
            }

            let p3 = [uid, target_id]
            std::sqlite::execute(conn, "INSERT INTO follows (follower_id, following_id) VALUES (?, ?)", p3)
            let p4 = [uid]
            std::sqlite::execute(conn, "UPDATE users SET following_count = following_count + 1 WHERE id = ?", p4)
            let p5 = [target_id]
            std::sqlite::execute(conn, "UPDATE users SET followers_count = followers_count + 1 WHERE id = ?", p5)
            notify(conn, target_id, "follow", uid)

            let mut resp = std::map::new()
            resp = std::map::insert(resp, "message", "Ahora sigues a este usuario")
            respond_ok(req, std::json::stringify(resp))
            std::sqlite::close(conn)
        },
        Option::None => { respond_err(req, 500, "DB error") }
    }
}

fn handle_unfollow(r, req, pool) {
    let uid = require_auth(req)
    if uid < 0 { return }
    let path = std::server::path(req)
    let hit = std::router::at(r, path)
    let target_id = hit.params.user_id
    let conn_opt = std::sqlite::acquire(pool, 2000)
    match conn_opt {
        Option::Some(conn) => {
            let p1 = [uid, target_id]
            std::sqlite::execute(conn, "DELETE FROM follows WHERE follower_id = ? AND following_id = ?", p1)
            let p2 = [uid]
            std::sqlite::execute(conn, "UPDATE users SET following_count = following_count - 1 WHERE id = ?", p2)
            let p3 = [target_id]
            std::sqlite::execute(conn, "UPDATE users SET followers_count = followers_count - 1 WHERE id = ?", p3)
            let mut resp = std::map::new()
            resp = std::map::insert(resp, "message", "Dejaste de seguir")
            respond_ok(req, std::json::stringify(resp))
            std::sqlite::close(conn)
        },
        Option::None => { respond_err(req, 500, "DB error") }
    }
}

fn handle_create_post(r, req, pool) {
    let uid = require_auth(req)
    if uid < 0 { return }
    let conn_opt = std::sqlite::acquire(pool, 2000)
    match conn_opt {
        Option::Some(conn) => {
            let body_text = std::server::body_text(req)
            let body = std::json::parse(body_text)
            let content = body.content
            if content == "" {
                respond_err(req, 400, "Contenido vacio")
                std::sqlite::close(conn)
                return
            }
            let p1 = [uid, content]
            std::sqlite::execute(conn, "INSERT INTO posts (user_id, content) VALUES (?, ?)", p1)
            let p2 = [uid]
            let np = std::sqlite::query(conn, "SELECT p.id, p.content, p.likes_count, p.comments_count, p.created_at, u.username, u.display_name, u.avatar_url FROM posts p JOIN users u ON p.user_id = u.id WHERE p.user_id = ? ORDER BY p.created_at DESC LIMIT 1", p2)
            if np == nil {
                respond_err(req, 500, "Error")
                std::sqlite::close(conn)
                return
            }
            let post = np[0]
            let p3 = [uid]
            std::sqlite::execute(conn, "UPDATE users SET posts_count = posts_count + 1 WHERE id = ?", p3)
            respond_created(req, std::json::stringify(post))
            std::sqlite::close(conn)
        },
        Option::None => { respond_err(req, 500, "DB error") }
    }
}

fn handle_get_post(r, req, pool) {
    let uid = require_auth(req)
    if uid < 0 { return }
    let path = std::server::path(req)
    let hit = std::router::at(r, path)
    let post_id = hit.params.id
    let conn_opt = std::sqlite::acquire(pool, 2000)
    match conn_opt {
        Option::Some(conn) => {
            let p1 = [post_id]
            let posts = std::sqlite::query(conn, "SELECT p.id, p.content, p.likes_count, p.comments_count, p.created_at, u.username, u.display_name, u.avatar_url FROM posts p JOIN users u ON p.user_id = u.id WHERE p.id = ?", p1)
            if posts == nil {
                respond_err(req, 404, "No encontrado")
                std::sqlite::close(conn)
                return
            }
            if std::collections::length(posts) == 0 {
                respond_err(req, 404, "No encontrado")
                std::sqlite::close(conn)
                return
            }
            let post = posts[0]
            let p2 = [uid, post_id]
            let likes = std::sqlite::query(conn, "SELECT 1 FROM likes WHERE user_id = ? AND post_id = ?", p2)
            let mut is_liked = false
            if likes != nil {
                if std::collections::length(likes) > 0 {
                    is_liked = true
                }
            }
            let mut resp = std::map::new()
            resp = std::map::insert(resp, "post", post)
            resp = std::map::insert(resp, "is_liked", is_liked)
            respond_ok(req, std::json::stringify(resp))
            std::sqlite::close(conn)
        },
        Option::None => { respond_err(req, 500, "DB error") }
    }
}

fn handle_like(r, req, pool) {
    let uid = require_auth(req)
    if uid < 0 { return }
    let path = std::server::path(req)
    let hit = std::router::at(r, path)
    let post_id = hit.params.id
    let conn_opt = std::sqlite::acquire(pool, 2000)
    match conn_opt {
        Option::Some(conn) => {
            let p1 = [post_id]
            let pc = std::sqlite::query(conn, "SELECT user_id FROM posts WHERE id = ?", p1)
            if pc == nil {
                respond_err(req, 404, "No encontrado")
                std::sqlite::close(conn)
                return
            }
            if std::collections::length(pc) == 0 {
                respond_err(req, 404, "No encontrado")
                std::sqlite::close(conn)
                return
            }
            let owner = pc[0].user_id
            let p2 = [uid, post_id]
            let existing = std::sqlite::query(conn, "SELECT 1 FROM likes WHERE user_id = ? AND post_id = ?", p2)
            if existing != nil {
                if std::collections::length(existing) > 0 {
                    respond_err(req, 409, "Ya diste like")
                    std::sqlite::close(conn)
                    return
                }
            }
            let p3 = [uid, post_id]
            std::sqlite::execute(conn, "INSERT INTO likes (user_id, post_id) VALUES (?, ?)", p3)
            let p4 = [post_id]
            std::sqlite::execute(conn, "UPDATE posts SET likes_count = likes_count + 1 WHERE id = ?", p4)
            if owner != uid {
                notify(conn, owner, "like", uid)
            }
            let mut resp = std::map::new()
            resp = std::map::insert(resp, "message", "Like agregado")
            respond_ok(req, std::json::stringify(resp))
            std::sqlite::close(conn)
        },
        Option::None => { respond_err(req, 500, "DB error") }
    }
}

fn handle_unlike(r, req, pool) {
    let uid = require_auth(req)
    if uid < 0 { return }
    let path = std::server::path(req)
    let hit = std::router::at(r, path)
    let post_id = hit.params.id
    let conn_opt = std::sqlite::acquire(pool, 2000)
    match conn_opt {
        Option::Some(conn) => {
            let p1 = [uid, post_id]
            std::sqlite::execute(conn, "DELETE FROM likes WHERE user_id = ? AND post_id = ?", p1)
            let p2 = [post_id]
            std::sqlite::execute(conn, "UPDATE posts SET likes_count = likes_count - 1 WHERE id = ?", p2)
            let mut resp = std::map::new()
            resp = std::map::insert(resp, "message", "Like removido")
            respond_ok(req, std::json::stringify(resp))
            std::sqlite::close(conn)
        },
        Option::None => { respond_err(req, 500, "DB error") }
    }
}

fn handle_get_comments(r, req, pool) {
    let uid = require_auth(req)
    if uid < 0 { return }
    let path = std::server::path(req)
    let hit = std::router::at(r, path)
    let post_id = hit.params.id
    let conn_opt = std::sqlite::acquire(pool, 2000)
    match conn_opt {
        Option::Some(conn) => {
            let p1 = [post_id]
            let comments = std::sqlite::query(conn, "SELECT c.id, c.content, c.created_at, u.username, u.display_name, u.avatar_url FROM comments c JOIN users u ON c.user_id = u.id WHERE c.post_id = ? ORDER BY c.created_at ASC LIMIT 50", p1)
            if comments == nil {
                respond_ok(req, "[]")
            } else {
                respond_ok(req, std::json::stringify(comments))
            }
            std::sqlite::close(conn)

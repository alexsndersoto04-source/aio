fn handle_add_comment(r, req, pool) {
    let user_id = require_auth(req)
    if user_id < 0 { return }
    let path = std::server::path(req)
    let hit = std::router::at(r, path)
    let post_id = hit.params.id
    let conn_opt = std::sqlite::acquire(pool, 2000)
    match conn_opt {
        Option::Some(conn) => {
            let body_text = std::server::body_text(req)
            let body = std::json::parse(body_text)
            let content = body.content
            if content == "" {
                respond_json_error(req, 400, "Comentario vacio")
                std::sqlite::close(conn)
                return
            }
            let p1 = [user_id, post_id, content]
            std::sqlite::execute(conn, "INSERT INTO comments (user_id, post_id, content) VALUES (?, ?, ?)", p1)
            let p2 = [post_id]
            std::sqlite::execute(conn, "UPDATE posts SET comments_count = comments_count + 1 WHERE id = ?", p2)
            let p3 = [post_id]
            let pc = std::sqlite::query(conn, "SELECT user_id FROM posts WHERE id = ?", p3)
            if std::collections::length(pc) > 0 {
                let owner = pc[0].user_id
                if owner != user_id {
                    create_notification(conn, owner, "comment", user_id, post_id, 0)
                }
            }
            let resp = std::map::new()
            let resp = std::map::insert(resp, "message", "Comentario agregado")
            respond_json_created(req, std::json::stringify(resp))
            std::sqlite::close(conn)
        },
        Option::None => { respond_json_error(req, 500, "DB error") }
    }
}

fn handle_feed(r, req, pool) {
    let user_id = require_auth(req)
    if user_id < 0 { return }
    let conn_opt = std::sqlite::acquire(pool, 2000)
    match conn_opt {
        Option::Some(conn) => {
            let p1 = [user_id, user_id]
            let posts = std::sqlite::query(conn, "SELECT p.id, p.content, p.likes_count, p.comments_count, p.created_at, u.username, u.display_name, u.avatar_url FROM posts p JOIN users u ON p.user_id = u.id WHERE p.user_id IN (SELECT following_id FROM follows WHERE follower_id = ?) OR p.user_id = ? ORDER BY p.created_at DESC LIMIT 20", p1)
            respond_json_ok(req, std::json::stringify(posts))
            std::sqlite::close(conn)
        },
        Option::None => { respond_json_error(req, 500, "DB error") }
    }
}

fn handle_trending(r, req, pool) {
    let user_id = require_auth(req)
    if user_id < 0 { return }
    let conn_opt = std::sqlite::acquire(pool, 2000)
    match conn_opt {
        Option::Some(conn) => {
            let posts = std::sqlite::query(conn, "SELECT p.id, p.content, p.likes_count, p.comments_count, p.created_at, u.username, u.display_name FROM posts p JOIN users u ON p.user_id = u.id ORDER BY (p.likes_count + p.comments_count * 2) DESC LIMIT 20")
            respond_json_ok(req, std::json::stringify(posts))
            std::sqlite::close(conn)
        },
        Option::None => { respond_json_error(req, 500, "DB error") }
    }
}

fn handle_user_posts(r, req, pool) {
    let user_id = require_auth(req)
    if user_id < 0 { return }
    let path = std::server::path(req)
    let hit = std::router::at(r, path)
    let target_id = hit.params.id
    let conn_opt = std::sqlite::acquire(pool, 2000)
    match conn_opt {
        Option::Some(conn) => {
            let p1 = [target_id]
            let posts = std::sqlite::query(conn, "SELECT p.id, p.content, p.likes_count, p.comments_count, p.created_at, u.username, u.display_name FROM posts p JOIN users u ON p.user_id = u.id WHERE p.user_id = ? ORDER BY p.created_at DESC LIMIT 20", p1)
            respond_json_ok(req, std::json::stringify(posts))
            std::sqlite::close(conn)
        },
        Option::None => { respond_json_error(req, 500, "DB error") }
    }
}

fn handle_notifications(r, req, pool) {
    let user_id = require_auth(req)
    if user_id < 0 { return }
    let conn_opt = std::sqlite::acquire(pool, 2000)
    match conn_opt {
        Option::Some(conn) => {
            let p1 = [user_id]
            let notifs = std::sqlite::query(conn, "SELECT n.id, n.type, n.is_read, n.created_at, fu.username as from_username FROM notifications n LEFT JOIN users fu ON n.from_user_id = fu.id WHERE n.user_id = ? ORDER BY n.created_at DESC LIMIT 30", p1)
            respond_json_ok(req, std::json::stringify(notifs))
            std::sqlite::close(conn)
        },
        Option::None => { respond_json_error(req, 500, "DB error") }
    }
}

fn handle_conversations(r, req, pool) {
    let user_id = require_auth(req)
    if user_id < 0 { return }
    let conn_opt = std::sqlite::acquire(pool, 2000)
    match conn_opt {
        Option::Some(conn) => {
            let p1 = [user_id, user_id, user_id]
            let convs = std::sqlite::query(conn, "SELECT DISTINCT partner_id, username, last_message, last_created_at FROM (SELECT CASE WHEN dm.sender_id = ? THEN dm.receiver_id ELSE dm.sender_id END as partner_id, dm.content as last_message, dm.created_at as last_created_at FROM direct_messages dm WHERE dm.sender_id = ? OR dm.receiver_id = ? ORDER BY dm.created_at DESC) as recent JOIN users u ON partner_id = u.id ORDER BY last_created_at DESC LIMIT 50", p1)
            respond_json_ok(req, std::json::stringify(convs))
            std::sqlite::close(conn)
        },
        Option::None => { respond_json_error(req, 500, "DB error") }
    }
}

fn handle_send_message(r, req, pool) {
    let user_id = require_auth(req)
    if user_id < 0 { return }
    let body_text = std::server::body_text(req)
    let body = std::json::parse(body_text)
    let receiver_id = body.receiver_id
    let content = body.content
    if content == "" {
        respond_json_error(req, 400, "Mensaje vacio")
        return
    }
    let conn_opt = std::sqlite::acquire(pool, 2000)
    match conn_opt {
        Option::Some(conn) => {
            let p1 = [user_id, receiver_id, content]
            std::sqlite::execute(conn, "INSERT INTO direct_messages (sender_id, receiver_id, content) VALUES (?, ?, ?)", p1)
            create_notification(conn, receiver_id, "message", user_id, 0, 0)
            let resp = std::map::new()
            let resp = std::map::insert(resp, "message", "Mensaje enviado")
            respond_json_created(req, std::json::stringify(resp))
            std::sqlite::close(conn)
        },
        Option::None => { respond_json_error(req, 500, "DB error") }
    }
}

// ---- MAIN ----
fn main() {
    print("=================================")
    print("  Moon - Red Social Backend")
    print("  v1.0.0 (SQLite)")
    print("=================================")

    let pool = init_db()

    print("Conectando a Redis...")
    let r_url = std::env::get("REDIS_URL")
    if r_url == "" { r_url = "redis://localhost:6379" }
    let redis = std::redis::connect(r_url)
    std::redis::ping(redis)
    print("Redis conectado.")

    let r = std::router::new()
    std::router::insert(r, "/api/health", "health")
    std::router::insert(r, "/api/auth/register", "register")
    std::router::insert(r, "/api/auth/login", "login")
    std::router::insert(r, "/api/auth/me", "me")
    std::router::insert(r, "/api/users/:id", "profile")
    std::router::insert(r, "/api/follow/:user_id", "follow")
    std::router::insert(r, "/api/unfollow/:user_id", "unfollow")
    std::router::insert(r, "/api/posts", "create_post")
    std::router::insert(r, "/api/posts/:id", "get_post")
    std::router::insert(r, "/api/posts/:id/like", "like")
    std::router::insert(r, "/api/posts/:id/unlike", "unlike")
    std::router::insert(r, "/api/posts/:id/comments", "get_comments")
    std::router::insert(r, "/api/posts/:id/comment", "add_comment")
    std::router::insert(r, "/api/feed", "feed")
    std::router::insert(r, "/api/feed/trending", "trending")
    std::router::insert(r, "/api/users/:id/posts", "user_posts")
    std::router::insert(r, "/api/notifications", "notifications")
    std::router::insert(r, "/api/messages/conversations", "conversations")
    std::router::insert(r, "/api/messages/send", "send_message")
    print("Router configurado.")

    let bind_addr = HOST + ":" + PORT
    let s = std::server::start(bind_addr)
    let addr = std::server::local_addr(s)
    print("Moon corriendo en: http://" + addr)

    loop {
        let req = std::server::accept(s, 60000)
        if req < 0 {
        } else {
            let path = std::server::path(req)
            let hit = std::router::at(r, path)
            if hit == nil {
                respond_json_error(req, 404, "Not found")
            } else {
                let tag = hit.pattern
                if tag == "health" { handle_health(req) }
                if tag == "register" { handle_register(r, req, pool, redis) }
                if tag == "login" { handle_login(r, req, pool, redis) }
                if tag == "me" { handle_me(r, req, pool) }
                if tag == "profile" { handle_get_profile(r, req, pool) }
                if tag == "follow" { handle_follow(r, req, pool) }
                if tag == "unfollow" { handle_unfollow(r, req, pool) }
                if tag == "create_post" { handle_create_post(r, req, pool, redis) }
                if tag == "get_post" { handle_get_post(r, req, pool) }
                if tag == "like" { handle_like(r, req, pool) }
                if tag == "unlike" { handle_unlike(r, req, pool) }
                if tag == "get_comments" { handle_get_comments(r, req, pool) }
                if tag == "add_comment" { handle_add_comment(r, req, pool) }
                if tag == "feed" { handle_feed(r, req, pool) }
                if tag == "trending" { handle_trending(r, req, pool) }
                if tag == "user_posts" { handle_user_posts(r, req, pool) }
                if tag == "notifications" { handle_notifications(r, req, pool) }
                if tag == "conversations" { handle_conversations(r, req, pool) }
                if tag == "send_message" { handle_send_message(r, req, pool) }
            }
        }
    }

    std::server::stop(s)
    std::router::drop(r)
    std::redis::close(redis)
    std::sqlite::pool_close(pool)
    print("Moon detenido.")
}

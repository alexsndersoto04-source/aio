// ============================================================
// Moon — Red Social Backend
// Basado estrictamente en ejemplos que funcionan:
//   enterprise_pool.titan (SQLite pool pattern)
//   webserver.titan (router pattern)
//   security.titan (JWT + password)
// ============================================================

const HOST: string = "0.0.0.0"
const PORT: int = 3000
const JWT_EXPIRES: int = 86400
const MAX_POSTS_PER_HOUR: int = 30
const MAX_MESSAGE_LENGTH: int = 2000
const MAX_POST_LENGTH: int = 5000
const APP_NAME: string = "Moon"

// ---- Helpers de respuesta ----
fn respond_json_ok(req, json_string: string) {
    std::server::respond(req, 200, json_string)
}
fn respond_json_created(req, json_string: string) {
    std::server::respond(req, 201, json_string)
}
fn respond_json_error(req, status: int, message: string) {
    let body = "{\"error\":\"" + message + "\"}"
    std::server::respond(req, status, body)
}

// ---- Config ----
fn jwt_secret_val() -> string {
    let val = std::env::get("JWT_SECRET")
    if val == "" { return "moon-default-secret-change-in-production" }
    val
}

// ---- Auth ----
fn authenticate(req) -> int {
    let auth_header = std::server::header(req, "Authorization")
    if auth_header == "" { return -1 }
    let words = std::text::words(auth_header)
    if std::collections::length(words) != 2 { return -1 }
    if words[0] != "Bearer" { return -1 }
    let token = words[1]
    let secret = std::encoding::utf8_encode(jwt_secret_val())
    let claims = std::jwt::verify_hs256(token, secret, "", "")
    if claims == nil { return -1 }
    let uid = claims.user_id
    uid
}

fn require_auth(req) -> int {
    let uid = authenticate(req)
    if uid < 0 {
        respond_json_error(req, 401, "No autorizado")
        return -1
    }
    uid
}

// ---- Rate limit ----
fn rate_limit_check(redis, key: string, max_req: int, window: int) -> bool {
    let cur = std::redis::get(redis, key)
    if cur == nil {
        std::redis::set_ex(redis, key, "1", window)
        return true
    }
    let count_str = std::encoding::utf8_decode(cur)
    let count = 0
    match std::text::parse_int(count_str) {
        Option::Some(n) => count = n,
        Option::None => count = 0,
    }
    if count >= max_req { return false }
    std::redis::incr(redis, key)
    true
}

// ---- Token generation ----
fn generate_token(user_id, username: string) -> string {
    let secret = std::encoding::utf8_encode(jwt_secret_val())
    let ahora = std::datetime::now()
    let expira = std::datetime::add_seconds(ahora, JWT_EXPIRES)
    let claims = std::map::new()
    let claims = std::map::insert(claims, "user_id", user_id)
    let claims = std::map::insert(claims, "username", username)
    let claims = std::map::insert(claims, "iat", ahora)
    let claims = std::map::insert(claims, "exp", expira)
    std::jwt::sign_hs256(claims, secret)
}

// ---- Notification helper ----
fn create_notification(conn, user_id, ntype: string, from_uid, post_id, comment_id) {
    let p1 = [user_id, ntype, from_uid, post_id, comment_id]
    std::sqlite::execute(conn, "INSERT INTO notifications (user_id, type, from_user_id, post_id, comment_id) VALUES (?, ?, ?, ?, ?)", p1)
}

// ---- DB Init ----
fn init_db() {
    print("Iniciando SQLite...")
    let path = "moon.db"
    let pool = std::sqlite::pool(path, 5)
    print("SQLite pool creado en: " + path)

    let conn_opt = std::sqlite::acquire(pool, 2000)
    match conn_opt {
        Option::Some(conn) => {
            print("Conexión adquirida, creando tablas...")
            std::sqlite::execute(conn, "CREATE TABLE IF NOT EXISTS users (id INTEGER PRIMARY KEY AUTOINCREMENT, username TEXT UNIQUE NOT NULL, email TEXT UNIQUE NOT NULL, password_hash TEXT NOT NULL, display_name TEXT, bio TEXT DEFAULT '', avatar_url TEXT DEFAULT '', banner_url TEXT DEFAULT '', is_verified INTEGER DEFAULT 0, is_private INTEGER DEFAULT 0, followers_count INTEGER DEFAULT 0, following_count INTEGER DEFAULT 0, posts_count INTEGER DEFAULT 0, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP, last_login_at DATETIME)", [])
            std::sqlite::execute(conn, "CREATE TABLE IF NOT EXISTS posts (id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE, content TEXT NOT NULL, media_urls TEXT DEFAULT '[]', media_types TEXT DEFAULT '[]', likes_count INTEGER DEFAULT 0, comments_count INTEGER DEFAULT 0, reposts_count INTEGER DEFAULT 0, is_reply INTEGER DEFAULT 0, reply_to_id INTEGER REFERENCES posts(id) ON DELETE CASCADE, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP)", [])
            std::sqlite::execute(conn, "CREATE TABLE IF NOT EXISTS follows (follower_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE, following_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, PRIMARY KEY (follower_id, following_id))", [])
            std::sqlite::execute(conn, "CREATE TABLE IF NOT EXISTS likes (user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE, post_id INTEGER NOT NULL REFERENCES posts(id) ON DELETE CASCADE, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, PRIMARY KEY (user_id, post_id))", [])
            std::sqlite::execute(conn, "CREATE TABLE IF NOT EXISTS comments (id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE, post_id INTEGER NOT NULL REFERENCES posts(id) ON DELETE CASCADE, parent_id INTEGER REFERENCES comments(id) ON DELETE CASCADE, content TEXT NOT NULL, likes_count INTEGER DEFAULT 0, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP)", [])
            std::sqlite::execute(conn, "CREATE TABLE IF NOT EXISTS direct_messages (id INTEGER PRIMARY KEY AUTOINCREMENT, sender_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE, receiver_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE, content TEXT NOT NULL, is_read INTEGER DEFAULT 0, created_at DATETIME DEFAULT CURRENT_TIMESTAMP)", [])
            std::sqlite::execute(conn, "CREATE TABLE IF NOT EXISTS notifications (id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE, type TEXT NOT NULL, from_user_id INTEGER REFERENCES users(id) ON DELETE CASCADE, post_id INTEGER REFERENCES posts(id) ON DELETE CASCADE, comment_id INTEGER REFERENCES comments(id) ON DELETE CASCADE, is_read INTEGER DEFAULT 0, created_at DATETIME DEFAULT CURRENT_TIMESTAMP)", [])
            std::sqlite::execute(conn, "CREATE INDEX IF NOT EXISTS idx_posts_uid ON posts(user_id)", [])
            std::sqlite::execute(conn, "CREATE INDEX IF NOT EXISTS idx_follows_f ON follows(follower_id)", [])
            std::sqlite::execute(conn, "CREATE INDEX IF NOT EXISTS idx_likes_p ON likes(post_id)", [])
            std::sqlite::execute(conn, "CREATE INDEX IF NOT EXISTS idx_notif_u ON notifications(user_id)", [])
            std::sqlite::close(conn)
            print("Tablas creadas correctamente.")
        },
        Option::None => {
            print("ERROR: No se pudo adquirir conexión SQLite")
        }
    }
    pool
}

// ---- HANDLERS ----
// Cada handler recibe (r, req, pool, redis) o la combinación que necesite.
// El router handle 'r' se usa para std::router::at(r, path).

fn handle_health(req) {
    let resp = std::map::new()
    let resp = std::map::insert(resp, "status", "ok")
    let resp = std::map::insert(resp, "app", APP_NAME)
    respond_json_ok(req, std::json::stringify(resp))
}

fn handle_register(r, req, pool, redis) {
    let conn_opt = std::sqlite::acquire(pool, 2000)
    match conn_opt {
        Option::Some(conn) => {
            let body_text = std::server::body_text(req)
            let body = std::json::parse(body_text)
            let username = body.username
            let email = body.email
            let password = body.password

            if std::collections::length(username) < 3 {
                respond_json_error(req, 400, "Username muy corto")
                std::sqlite::close(conn)
                return
            }
            if std::collections::length(password) < 8 {
                respond_json_error(req, 400, "Password muy corto")
                std::sqlite::close(conn)
                return
            }

            let p1 = [username]
            let existing = std::sqlite::query(conn, "SELECT id FROM users WHERE username = ?", p1)
            if std::collections::length(existing) > 0 {
                respond_json_error(req, 409, "Username en uso")
                std::sqlite::close(conn)
                return
            }

            let p2 = [email]
            let existing2 = std::sqlite::query(conn, "SELECT id FROM users WHERE email = ?", p2)
            if std::collections::length(existing2) > 0 {
                respond_json_error(req, 409, "Email en uso")
                std::sqlite::close(conn)
                return
            }

            let pw_hash = std::password::hash_argon2(password)
            let p3 = [username, email, pw_hash, username]
            std::sqlite::execute(conn, "INSERT INTO users (username, email, password_hash, display_name) VALUES (?, ?, ?, ?)", p3)

            let p4 = [username]
            let nu = std::sqlite::query(conn, "SELECT id, username, email, display_name FROM users WHERE username = ?", p4)
            let user = nu[0]
            let token = generate_token(user.id, username)
            let sk = "session:" + user.id
            std::redis::set_ex(redis, sk, token, JWT_EXPIRES)

            let resp = std::map::new()
            let resp = std::map::insert(resp, "token", token)
            let resp = std::map::insert(resp, "user", user)
            respond_json_created(req, std::json::stringify(resp))
            std::sqlite::close(conn)
        },
        Option::None => { respond_json_error(req, 500, "DB error") }
    }
}

fn handle_login(r, req, pool, redis) {
    let conn_opt = std::sqlite::acquire(pool, 2000)
    match conn_opt {
        Option::Some(conn) => {
            let body_text = std::server::body_text(req)
            let body = std::json::parse(body_text)
            let username = body.username
            let password = body.password

            if username == "" {
                respond_json_error(req, 400, "Username requerido")
                std::sqlite::close(conn)
                return
            }
            if password == "" {
                respond_json_error(req, 400, "Password requerido")
                std::sqlite::close(conn)
                return
            }

            let p1 = [username, username]
            let users = std::sqlite::query(conn, "SELECT id, username, email, password_hash, display_name, bio, avatar_url FROM users WHERE username = ? OR email = ?", p1)

            if std::collections::length(users) == 0 {
                respond_json_error(req, 401, "Credenciales invalidas")
                std::sqlite::close(conn)
                return
            }

            let user = users[0]
            let valid = std::password::verify_argon2(user.password_hash, password)
            if valid == false {
                respond_json_error(req, 401, "Credenciales invalidas")
                std::sqlite::close(conn)
                return
            }

            let uid = user.id
            let p2 = [uid]
            std::sqlite::execute(conn, "UPDATE users SET last_login_at = CURRENT_TIMESTAMP WHERE id = ?", p2)

            let token = generate_token(user.id, user.username)
            let sk = "session:" + user.id
            std::redis::set_ex(redis, sk, token, JWT_EXPIRES)

            let su = std::map::new()
            let su = std::map::insert(su, "id", user.id)
            let su = std::map::insert(su, "username", user.username)
            let su = std::map::insert(su, "email", user.email)
            let su = std::map::insert(su, "display_name", user.display_name)
            let su = std::map::insert(su, "bio", user.bio)
            let su = std::map::insert(su, "avatar_url", user.avatar_url)

            let resp = std::map::new()
            let resp = std::map::insert(resp, "token", token)
            let resp = std::map::insert(resp, "user", su)
            respond_json_ok(req, std::json::stringify(resp))
            std::sqlite::close(conn)
        },
        Option::None => { respond_json_error(req, 500, "DB error") }
    }
}

fn handle_me(r, req, pool) {
    let user_id = require_auth(req)
    if user_id < 0 { return }
    let conn_opt = std::sqlite::acquire(pool, 2000)
    match conn_opt {
        Option::Some(conn) => {
            let p1 = [user_id]
            let users = std::sqlite::query(conn, "SELECT id, username, email, display_name, bio, avatar_url, banner_url, is_verified, is_private, followers_count, following_count, posts_count, created_at FROM users WHERE id = ?", p1)
            if std::collections::length(users) == 0 {
                respond_json_error(req, 404, "Usuario no encontrado")
                std::sqlite::close(conn)
                return
            }
            respond_json_ok(req, std::json::stringify(users[0]))
            std::sqlite::close(conn)
        },
        Option::None => { respond_json_error(req, 500, "DB error") }
    }
}

fn handle_get_profile(r, req, pool) {
    let user_id = require_auth(req)
    if user_id < 0 { return }
    let path = std::server::path(req)
    let hit = std::router::at(r, path)
    let target_id = hit.params.id
    let conn_opt = std::sqlite::acquire(pool, 2000)
    match conn_opt {
        Option::Some(conn) => {
            let p1 = [target_id]
            let users = std::sqlite::query(conn, "SELECT id, username, display_name, bio, avatar_url, is_verified, followers_count, following_count, posts_count FROM users WHERE id = ?", p1)
            if std::collections::length(users) == 0 {
                respond_json_error(req, 404, "Usuario no encontrado")
                std::sqlite::close(conn)
                return
            }
            let profile = users[0]
            let p2 = [user_id, target_id]
            let follows = std::sqlite::query(conn, "SELECT 1 FROM follows WHERE follower_id = ? AND following_id = ?", p2)
            let is_following = std::collections::length(follows) > 0
            let resp = std::map::new()
            let resp = std::map::insert(resp, "user", profile)
            let resp = std::map::insert(resp, "is_following", is_following)
            respond_json_ok(req, std::json::stringify(resp))
            std::sqlite::close(conn)
        },
        Option::None => { respond_json_error(req, 500, "DB error") }
    }
}

fn handle_follow(r, req, pool) {
    let user_id = require_auth(req)
    if user_id < 0 { return }
    let path = std::server::path(req)
    let hit = std::router::at(r, path)
    let target_id = hit.params.user_id

    if user_id == target_id {
        respond_json_error(req, 400, "No puedes seguirte a ti mismo")
        return
    }

    let conn_opt = std::sqlite::acquire(pool, 2000)
    match conn_opt {
        Option::Some(conn) => {
            let p1 = [target_id]
            let t = std::sqlite::query(conn, "SELECT id FROM users WHERE id = ?", p1)
            if std::collections::length(t) == 0 {
                respond_json_error(req, 404, "Usuario no encontrado")
                std::sqlite::close(conn)
                return
            }
            let p2 = [user_id, target_id]
            let already = std::sqlite::query(conn, "SELECT 1 FROM follows WHERE follower_id = ? AND following_id = ?", p2)
            if std::collections::length(already) > 0 {
                respond_json_error(req, 409, "Ya sigues a este usuario")
                std::sqlite::close(conn)
                return
            }
            let p3 = [user_id, target_id]
            std::sqlite::execute(conn, "INSERT INTO follows (follower_id, following_id) VALUES (?, ?)", p3)
            let p4 = [user_id]
            std::sqlite::execute(conn, "UPDATE users SET following_count = following_count + 1 WHERE id = ?", p4)
            let p5 = [target_id]
            std::sqlite::execute(conn, "UPDATE users SET followers_count = followers_count + 1 WHERE id = ?", p5)
            create_notification(conn, target_id, "follow", user_id, 0, 0)
            let resp = std::map::new()
            let resp = std::map::insert(resp, "message", "Ahora sigues a este usuario")
            respond_json_ok(req, std::json::stringify(resp))
            std::sqlite::close(conn)
        },
        Option::None => { respond_json_error(req, 500, "DB error") }
    }
}

fn handle_unfollow(r, req, pool) {
    let user_id = require_auth(req)
    if user_id < 0 { return }
    let path = std::server::path(req)
    let hit = std::router::at(r, path)
    let target_id = hit.params.user_id
    let conn_opt = std::sqlite::acquire(pool, 2000)
    match conn_opt {
        Option::Some(conn) => {
            let p1 = [user_id, target_id]
            std::sqlite::execute(conn, "DELETE FROM follows WHERE follower_id = ? AND following_id = ?", p1)
            let p2 = [user_id]
            std::sqlite::execute(conn, "UPDATE users SET following_count = following_count - 1 WHERE id = ?", p2)
            let p3 = [target_id]
            std::sqlite::execute(conn, "UPDATE users SET followers_count = followers_count - 1 WHERE id = ?", p3)
            let resp = std::map::new()
            let resp = std::map::insert(resp, "message", "Dejaste de seguir")
            respond_json_ok(req, std::json::stringify(resp))
            std::sqlite::close(conn)
        },
        Option::None => { respond_json_error(req, 500, "DB error") }
    }
}

fn handle_create_post(r, req, pool, redis) {
    let user_id = require_auth(req)
    if user_id < 0 { return }
    let rk = "post:" + user_id
    let ok = rate_limit_check(redis, rk, MAX_POSTS_PER_HOUR, 3600)
    if ok == false {
        respond_json_error(req, 429, "Limite de posts por hora")
        return
    }
    let conn_opt = std::sqlite::acquire(pool, 2000)
    match conn_opt {
        Option::Some(conn) => {
            let body_text = std::server::body_text(req)
            let body = std::json::parse(body_text)
            let content = body.content
            if content == "" {
                respond_json_error(req, 400, "Contenido vacio")
                std::sqlite::close(conn)
                return
            }
            let p1 = [user_id, content]
            std::sqlite::execute(conn, "INSERT INTO posts (user_id, content) VALUES (?, ?)", p1)
            let p2 = [user_id]
            let np = std::sqlite::query(conn, "SELECT p.id, p.content, p.likes_count, p.comments_count, p.created_at, u.username, u.display_name, u.avatar_url FROM posts p JOIN users u ON p.user_id = u.id WHERE p.user_id = ? ORDER BY p.created_at DESC LIMIT 1", p2)
            let post = np[0]
            let p3 = [user_id]
            std::sqlite::execute(conn, "UPDATE users SET posts_count = posts_count + 1 WHERE id = ?", p3)
            respond_json_created(req, std::json::stringify(post))
            std::sqlite::close(conn)
        },
        Option::None => { respond_json_error(req, 500, "DB error") }
    }
}

fn handle_get_post(r, req, pool) {
    let user_id = require_auth(req)
    if user_id < 0 { return }
    let path = std::server::path(req)
    let hit = std::router::at(r, path)
    let post_id = hit.params.id
    let conn_opt = std::sqlite::acquire(pool, 2000)
    match conn_opt {
        Option::Some(conn) => {
            let p1 = [post_id]
            let posts = std::sqlite::query(conn, "SELECT p.id, p.content, p.likes_count, p.comments_count, p.created_at, u.username, u.display_name, u.avatar_url FROM posts p JOIN users u ON p.user_id = u.id WHERE p.id = ?", p1)
            if std::collections::length(posts) == 0 {
                respond_json_error(req, 404, "Post no encontrado")
                std::sqlite::close(conn)
                return
            }
            let post = posts[0]
            let p2 = [user_id, post_id]
            let likes = std::sqlite::query(conn, "SELECT 1 FROM likes WHERE user_id = ? AND post_id = ?", p2)
            let is_liked = std::collections::length(likes) > 0
            let resp = std::map::new()
            let resp = std::map::insert(resp, "post", post)
            let resp = std::map::insert(resp, "is_liked", is_liked)
            respond_json_ok(req, std::json::stringify(resp))
            std::sqlite::close(conn)
        },
        Option::None => { respond_json_error(req, 500, "DB error") }
    }
}

fn handle_like(r, req, pool) {
    let user_id = require_auth(req)
    if user_id < 0 { return }
    let path = std::server::path(req)
    let hit = std::router::at(r, path)
    let post_id = hit.params.id
    let conn_opt = std::sqlite::acquire(pool, 2000)
    match conn_opt {
        Option::Some(conn) => {
            let p1 = [post_id]
            let pc = std::sqlite::query(conn, "SELECT user_id FROM posts WHERE id = ?", p1)
            if std::collections::length(pc) == 0 {
                respond_json_error(req, 404, "Post no encontrado")
                std::sqlite::close(conn)
                return
            }
            let owner = pc[0].user_id
            let p2 = [user_id, post_id]
            let existing = std::sqlite::query(conn, "SELECT 1 FROM likes WHERE user_id = ? AND post_id = ?", p2)
            if std::collections::length(existing) > 0 {
                respond_json_error(req, 409, "Ya diste like")
                std::sqlite::close(conn)
                return
            }
            let p3 = [user_id, post_id]
            std::sqlite::execute(conn, "INSERT INTO likes (user_id, post_id) VALUES (?, ?)", p3)
            let p4 = [post_id]
            std::sqlite::execute(conn, "UPDATE posts SET likes_count = likes_count + 1 WHERE id = ?", p4)
            if owner != user_id {
                create_notification(conn, owner, "like", user_id, post_id, 0)
            }
            let resp = std::map::new()
            let resp = std::map::insert(resp, "message", "Like agregado")
            respond_json_ok(req, std::json::stringify(resp))
            std::sqlite::close(conn)
        },
        Option::None => { respond_json_error(req, 500, "DB error") }
    }
}

fn handle_unlike(r, req, pool) {
    let user_id = require_auth(req)
    if user_id < 0 { return }
    let path = std::server::path(req)
    let hit = std::router::at(r, path)
    let post_id = hit.params.id
    let conn_opt = std::sqlite::acquire(pool, 2000)
    match conn_opt {
        Option::Some(conn) => {
            let p1 = [user_id, post_id]
            std::sqlite::execute(conn, "DELETE FROM likes WHERE user_id = ? AND post_id = ?", p1)
            let p2 = [post_id]
            std::sqlite::execute(conn, "UPDATE posts SET likes_count = likes_count - 1 WHERE id = ?", p2)
            let resp = std::map::new()
            let resp = std::map::insert(resp, "message", "Like removido")
            respond_json_ok(req, std::json::stringify(resp))
            std::sqlite::close(conn)
        },
        Option::None => { respond_json_error(req, 500, "DB error") }
    }
}


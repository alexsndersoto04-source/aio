// Moon — Handlers de perfil y grafo social (h_users.titan)
// ============================================================
// user_profile · user_posts · user_liked · user_saved ·
// user_followers · user_following · search · follow · unfollow ·
// block · unblock · suggested_users (SPEC §3)

fn hu_get_target(req: int, conn: Postgres, target_id: int) -> any {
    let user = q_user_public_by_id(conn, target_id)
    if user == nil {
        r_err(req, 404, "Usuario no encontrado")
        return nil
    }
    user
}

fn h_users_profile(req: int, ctx: map, target_id: int) {
    let pool = std::map::get(ctx, "pool")
    let claims = a_require(req)
    if claims == nil { return }
    let viewer = a_uid(claims)
    let conn = db_acquire(pool)
    if conn == nil { r_err(req, 503, "Base de datos no disponible"); return }
    let target = hu_get_target(req, conn, target_id)
    if target == nil {
        let _c = std::postgres::close(conn)
        return
    }
    let out = q_user_profile_map(conn, viewer, target)
    let _c = std::postgres::close(conn)
    r_ok(req, out)
}

fn h_users_posts(req: int, ctx: map, target_id: int) {
    let pool = std::map::get(ctx, "pool")
    let claims = a_require(req)
    if claims == nil { return }
    let viewer = a_uid(claims)
    let pag = qs_page(req)
    let page = pag[0]
    let limit = pag[1]
    let conn = db_acquire(pool)
    if conn == nil { r_err(req, 503, "Base de datos no disponible"); return }
    let target = hu_get_target(req, conn, target_id)
    if target == nil {
        let _c = std::postgres::close(conn)
        return
    }
    let is_private = std::map::get(target, "is_private")
    if !q_can_view_author_posts(conn, viewer, target_id, is_private) {
        let _c = std::postgres::close(conn)
        r_err_code(req, 403, "private_account", "Esta cuenta es privada")
        return
    }
    let rows = q_posts_visible(conn, viewer, target_id, page, limit)
    let total = q_count_posts_visible(conn, viewer, target_id)
    let out = q_decorate_batch(conn, rows, viewer)
    let _c = std::postgres::close(conn)
    r_ok_list(req, out, total, page, limit)
}

fn h_users_followers(req: int, ctx: map, target_id: int) {
    let pool = std::map::get(ctx, "pool")
    let claims = a_require(req)
    if claims == nil { return }
    let viewer = a_uid(claims)
    let pag = qs_page(req)
    let page = pag[0]
    let limit = pag[1]
    let offset = (page - 1) * limit
    let conn = db_acquire(pool)
    if conn == nil { r_err(req, 503, "Base de datos no disponible"); return }
    let target = hu_get_target(req, conn, target_id)
    if target == nil {
        let _c = std::postgres::close(conn)
        return
    }
    let rows = db_rows(conn, "SELECT u.id, u.username, u.display_name, u.avatar_url, u.is_verified, u.followers_count FROM follows f JOIN users u ON u.id = f.follower_id WHERE f.following_id = ? AND u.status = 'active' AND NOT EXISTS (SELECT 1 FROM blocks b WHERE (b.blocker_id = ? AND b.blocked_id = u.id) OR (b.blocker_id = u.id AND b.blocked_id = ?)) ORDER BY f.created_at DESC LIMIT ? OFFSET ?", [target_id, viewer, viewer, limit, offset])
    let total = db_count(conn, "SELECT COUNT(*) AS count FROM follows f JOIN users u ON u.id = f.follower_id WHERE f.following_id = ? AND u.status = 'active'", [target_id])
    if rows == nil {
        let _c = std::postgres::close(conn)
        r_ok_list(req, [], total, page, limit)
        return
    }
    let _c = std::postgres::close(conn)
    r_ok_list(req, rows, total, page, limit)
}


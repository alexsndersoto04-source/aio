// std::async — utilidades de tiempo, retry y timeout para operaciones
// de red, IO y otras tareas que pueden fallar transitoriamente.
//
// Este archivo es la PRIMERA parte de la stdlib de Titan escrita EN
// Titan. Se importa con:
//
//     import std::async
//
// El compilador busca `stdlib/async.titan` en el directorio de
// instalacion de zett y lo carga automaticamente (Fase 31).
//
// Funciones expuestas (todas en el namespace plano — se llaman
// directo por su nombre, sin prefijo):
//
//   delay(ms)                       — dormir n milisegundos
//   measure(fn)                     — (resultado, ms_transcurridos)
//   retry(fn, veces, delay_ms)      — reintenta hasta N veces
//   retry_backoff(fn, veces, base)  — reintenta con backoff exponencial
//   timeout(fn, max_ms)             — corre con limite de tiempo
//
// Como todas las funciones aceptan closures, se combinan naturalmente
// con std::try::catch (Fase 18) para manejar errores tipados.

// Dormir n milisegundos. Alias claro sobre std::time::sleep_ms.
fn delay(ms: int) {
    std::time::sleep_ms(ms)
}

// Corre una fn y retorna (resultado, ms_transcurridos).
// Util para benchmarking rapido.
fn measure(work: fn() -> any) -> any {
    let start = std::time::unix_millis()
    let resultado = work()
    let fin = std::time::unix_millis()
    return (resultado, fin - start)
}

// Reintenta `work` hasta `veces` veces. Entre intento e intento
// espera `delay_ms` (constante). Retorna el primer Ok o el ultimo
// error. Requiere que `work` retorne Result::Ok/Err.
//
// Ejemplo:
//     let r = retry(|| fetch_api(url), 3, 500)
fn retry(work: fn() -> any, veces: int, delay_ms: int) -> Result {
    let mut intentos = 0
    let mut ultimo = std::try::catch(work)
    while intentos < veces {
        match ultimo {
            Result::Ok(_) => return ultimo,
            Result::Err(_) => {
                intentos = intentos + 1
                if intentos >= veces { return ultimo }
                std::time::sleep_ms(delay_ms)
                ultimo = std::try::catch(work)
            }
        }
    }
    return ultimo
}

// Igual que retry pero con backoff exponencial: espera base_ms,
// luego base_ms*2, luego base_ms*4, etc. Muy usado para reintentar
// APIs con rate limiting.
//
// Ejemplo:
//     let r = retry_backoff(|| fetch_api(url), 5, 100)
//     (esperas: 100ms, 200ms, 400ms, 800ms entre intentos)
fn retry_backoff(work: fn() -> any, veces: int, base_ms: int) -> Result {
    let mut intentos = 0
    let mut espera = base_ms
    let mut ultimo = std::try::catch(work)
    while intentos < veces {
        match ultimo {
            Result::Ok(_) => return ultimo,
            Result::Err(_) => {
                intentos = intentos + 1
                if intentos >= veces { return ultimo }
                std::time::sleep_ms(espera)
                espera = espera * 2
                ultimo = std::try::catch(work)
            }
        }
    }
    return ultimo
}

// Corre `work` con un limite de tiempo aproximado.
//
// NOTA: Titan no tiene forma segura de "interrumpir" una fn ya
// corriendo (requeriria signal handling desde el runtime). Lo que
// hacemos es MEDIR cuanto tardo y si excedio el limite, devolver
// Result::Err — pero la funcion habra corrido igual. Util para
// LOGGING de operaciones lentas, no para "matar" tareas.
//
// Para timeouts REALES (aborta la task) usar `spawn` + `join_timeout`
// que ya existen en el runtime.
fn timeout(work: fn() -> any, max_ms: int) -> Result {
    let start = std::time::unix_millis()
    let intento = std::try::catch(work)
    let dur = std::time::unix_millis() - start
    if dur > max_ms {
        return Result::Err("timeout: tardo " + dur + "ms, limite " + max_ms + "ms")
    }
    return intento
}

{
  "name": "Moon — red social",
  "short_name": "Moon",
  "description": "Moon: publicaciones, fotos, historias, grupos y mensajes en vivo. Una red social real.",
  "lang": "es",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#0a0a17",
  "theme_color": "#0a0a17",
  "categories": ["social", "communication"],
  "icons": [
    { "src": "/iconos/icono-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/iconos/icono-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/iconos/icono-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Mensajes", "url": "/#/messages", "icons": [{ "src": "/iconos/icono-192.png", "sizes": "192x192" }] },
    { "name": "Publicar", "url": "/#/feed", "icons": [{ "src": "/iconos/icono-192.png", "sizes": "192x192" }] },
    { "name": "Mi perfil", "url": "/#/profile", "icons": [{ "src": "/iconos/icono-192.png", "sizes": "192x192" }] }
  ]
}

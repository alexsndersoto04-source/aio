fn on_click() {
    let event_name = std::web::event_type();
    std::web::set_text("#status", "Evento click ejecutado por TITAN 🚀");
    std::web::set_attribute("#status", "data-last-event", event_name);
    std::web::add_class("#status", "clicked");
    println(event_name);
    0
}

fn on_input() {
    let value = std::web::event_value();
    std::web::set_text("#status", value);
    println(value);
    0
}

fn on_socket_open() {
    let socket = std::web::ws_id();
    std::web::ws_send(socket, "Hola desde TITAN WebAssembly 🚀");
    std::web::set_text("#socket-state", "WebSocket conectado; mensaje enviado");
    0
}

fn on_socket_message() {
    let message = std::web::ws_message();
    std::web::set_text("#socket-state", message);
    println(message);
    0
}

fn on_socket_error() {
    let error = std::web::ws_error();
    std::web::set_text("#socket-state", error);
    println(error);
    0
}

fn on_socket_close() {
    let reason = std::web::ws_close_reason();
    std::web::set_text("#socket-state", "WebSocket cerrado");
    println(reason);
    0
}

fn connect_socket() {
    let url = std::web::event_value();
    std::web::set_text("#socket-state", "Conectando WebSocket…");
    std::web::ws_connect(url, "[]", 65536, "on_socket_open", "on_socket_message", "on_socket_error", "on_socket_close");
    0
}

fn on_fetch() {
    if std::web::fetch_ok() {
        let body = std::web::fetch_body();
        let headers = std::web::fetch_headers();
        std::web::set_text("#response", body);
        println(headers);
        println(body);
    } else {
        let error = std::web::fetch_error();
        std::web::set_text("#response", error);
        println(error);
    }
    0
}

fn draw_webgl_scene() {
    let vertex = "#version 300 es\nin vec2 a_position;\nuniform float u_offset;\nvoid main() { gl_Position = vec4(a_position.x + u_offset, a_position.y, 0.0, 1.0); }";
    let fragment = "#version 300 es\nprecision highp float;\nout vec4 color;\nvoid main() { color = vec4(0.15, 0.75, 0.95, 1.0); }";
    let scene = std::web::webgl_create("#gl-scene", vertex, fragment, "[-0.65,-0.65,0.65,-0.65,0.0,0.7]", "[0,1,2]");
    std::web::webgl_uniform_f32(scene, "u_offset", 20, 100);
    std::web::webgl_draw(scene, "[0.02,0.04,0.09,1.0]");
    0
}

fn draw_scene() {
    std::web::canvas_resize("#scene", 640, 240);
    std::web::canvas_clear("#scene", "#0f172a");
    std::web::canvas_fill_rect("#scene", 32, 42, 150, 100, "#0ea5e9");
    std::web::canvas_stroke_rect("#scene", 28, 38, 158, 108, "#f8fafc", 3);
    std::web::canvas_line("#scene", 215, 142, 590, 42, "#a78bfa", 5);
    std::web::canvas_text("#scene", "TITAN + Canvas 2D 🚀", 215, 110, "#f8fafc", "26px sans-serif");
    0
}

fn animate_scene() {
    let time = std::web::frame_time_ms();
    let x = (time / 8) % 430;
    std::web::canvas_clear("#scene", "#0f172a");
    std::web::canvas_fill_rect("#scene", x + 24, 48, 150, 92, "#0ea5e9");
    std::web::canvas_stroke_rect("#scene", x + 20, 44, 158, 100, "#f8fafc", 3);
    std::web::canvas_line("#scene", 20, 190, 620, 190, "#a78bfa", 4);
    std::web::canvas_text("#scene", "requestAnimationFrame + TITAN 🚀", 150, 220, "#f8fafc", "22px sans-serif");
    0
}

fn main() {
    std::web::set_title("TITAN WebAssembly");
    draw_scene();
    if std::web::webgl_supported("#gl-scene") {
        draw_webgl_scene();
    } else {
        std::web::set_text("#webgl-status", "WebGL2 no está disponible en este navegador");
    }
    std::web::animation_start("animate_scene");
    std::web::set_text("#status", "TITAN controla este DOM desde WebAssembly 🚀");
    std::web::set_attribute("#status", "data-runtime", "titan-wasm");
    std::web::add_class("#status", "ready");
    std::web::listen("#action", "click", "on_click");
    std::web::listen("#message", "input", "on_input");
    std::web::listen("#socket-url", "change", "connect_socket");
    std::web::request("GET", "./data.json", "{\"Accept\":\"application/json\"}", "", 65536, 5000, "on_fetch");

    if std::web::query_exists("#status") {
        println("DOM actualizado y eventos registrados correctamente");
    } else {
        println("No se encontró #status");
    }

    0
}

// Demo Fase 11: servidor web real (tiny_http + matchit).
// Ejecutar en Termux con:
//     zett run examples/webserver.titan
//
// Bindea 127.0.0.1:8080 y sirve varias rutas con path-params estilo axum.
// Desde OTRA sesion de Termux (Sesiones -> Nueva) probalo con:
//
//   curl http://127.0.0.1:8080/
//   curl http://127.0.0.1:8080/hello/juan
//   curl http://127.0.0.1:8080/api/users/42
//   curl -X POST -d "hola" http://127.0.0.1:8080/echo
//   curl http://127.0.0.1:8080/files/a/b/c.txt
//
// Procesa hasta 20 requests y se cierra solo.

fn handle(r: int, req: int) {
    let met  = std::server::method(req)
    let ruta = std::server::path(req)
    print("---- request: {met} {ruta}")

    let hit = std::router::at(r, ruta)
    if hit == nil {
        std::server::respond(req, 404, "Not Found")
        print("respondido 404")
    } else {
        let tag    = hit.pattern
        let params = hit.params

        if tag == "home" {
            let html = "<h1>Titan Web Server</h1><p>Fase 11 corriendo.</p>"
            std::server::respond_html(req, 200, html)
        }
        if tag == "hello" {
            let nombre = params.name
            let msg = "hola {nombre} desde Titan!"
            std::server::respond(req, 200, msg)
        }
        if tag == "get_user" {
            let id = params.id
            let usuario = std::map::new()
            let usuario = std::map::insert(usuario, "id",   id)
            let nombre_usr = "usuario-{id}"
            let usuario = std::map::insert(usuario, "name", nombre_usr)
            let usuario = std::map::insert(usuario, "lang", "titan")
            let json = std::json::stringify(usuario)
            std::server::respond_json(req, 200, json)
        }
        if tag == "echo" {
            let body = std::server::body_text(req)
            std::server::respond(req, 200, body)
        }
        if tag == "files" {
            let rest = params.rest
            let msg = "pediste el archivo: {rest}"
            std::server::respond(req, 200, msg)
        }
        print("respondido {tag}")
    }
}

fn main() {
    // ---- 1) Router (matchit, el mismo que usa axum por dentro) ----
    let r = std::router::new()
    std::router::insert(r, "/",               "home")
    std::router::insert(r, "/hello/{name}",   "hello")
    std::router::insert(r, "/api/users/{id}", "get_user")
    std::router::insert(r, "/echo",           "echo")
    std::router::insert(r, "/files/{*rest}",  "files")

    // ---- 2) Arrancar el servidor ----
    let s = std::server::start("127.0.0.1:8080")
    let addr = std::server::local_addr(s)
    print("---- Servidor Titan escuchando en: {addr}")
    print("Prueba desde otra sesion de Termux:")
    print("  curl http://127.0.0.1:8080/")
    print("  curl http://127.0.0.1:8080/hello/juan")
    print("  curl http://127.0.0.1:8080/api/users/42")
    print("  curl -X POST -d 'hola' http://127.0.0.1:8080/echo")
    print("  curl http://127.0.0.1:8080/files/a/b/c.txt")
    print("---- Aceptando hasta 20 requests (60s timeout c/u) ----")

    // ---- 3) Loop de aceptacion ----
    for i in 0..20 {
        let req = std::server::accept(s, 60000)
        if req < 0 {
            print("timeout, saliendo")
        } else {
            handle(r, req)
            // Terminar el else con un print (Nil) para que el
            // typechecker vea el mismo tipo en ambas ramas del if
            // (handle() por si sola devuelve Unit).
            print("---")
        }
    }

    // ---- 4) Cerrar todo ----
    std::server::stop(s)
    std::router::drop(r)
    print("---- Servidor detenido. Listo ----")
}

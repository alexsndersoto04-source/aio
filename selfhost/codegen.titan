// ============================================================================
// Generador de bytecode de Titan escrito en Titan (self-hosting, fase 4a).
//
// Traducción fiel de crates/titan_codegen/src/lib.rs (AstCompiler): recibe el
// AST de selfhost/parser.titan (ya validado por selfhost/typechecker.titan) y
// produce el mismo módulo de bytecode que el generador de Rust: mismas
// instrucciones, mismos índices de locales y de cadenas, mismas ubicaciones de
// depuración y los mismos mensajes de error. Verificación diferencial:
// `cg_dump_module` produce el mismo texto que `titan bytecode <archivo>`.
//
// Representación:
//   - Op: una instrucción. `k` es el nombre de la variante de Rust; los demás
//     campos se usan según la variante (ver cg_op_text).
//   - G: estado del generador (el `AstCompiler` de Rust). Se pasa y se
//     devuelve; los errores viajan como Result::Err(mensaje).
//   - Los tipos de parámetros (`BytecodeType`) se guardan ya como texto
//     `Debug` de Rust, que es lo único que se hace con ellos.
// Todas las funciones llevan el prefijo `cg_` porque `import` junta todos los
// nombres en un único espacio (y este archivo convive con el typechecker).
// ============================================================================

import typechecker
import codegen_tables

struct Op {
    k: string,
    n: int,
    m: int,
    s: string,
    s2: string,
    flag: bool,
    list: array,
}

struct Meta {
    name: string,
    file: any,
    arity: int,
    params: array,
    ret: any,
    captures: int,
}

struct Func {
    name: string,
    file: any,
    arity: int,
    params: array,
    ret: any,
    captures: int,
    locals: int,
    max_stack: int,
    code: array,
    locs: array,
}

struct Loop {
    breaks: array,
    continues: array,
    target: int,
}

struct G {
    funcs: array,
    strings: map,
    table: array,
    fids: map,
    variants: map,
    consts: map,
    cexp: array,
    locals: array,
    muts: array,
    next: int,
    loops: array,
    loc: any,
    code: array,
    locs: array,
    meta: Meta,
    dedicated: map,
    natives: map,
    structs: map,
    enums: map,
    methods: map,
    entry: int,
}

fn gs_funcs(s: G, v) -> G {
    G { funcs: v, strings: s.strings, table: s.table, fids: s.fids, variants: s.variants, consts: s.consts, cexp: s.cexp, locals: s.locals, muts: s.muts, next: s.next, loops: s.loops, loc: s.loc, code: s.code, locs: s.locs, meta: s.meta, dedicated: s.dedicated, natives: s.natives, structs: s.structs, enums: s.enums, methods: s.methods, entry: s.entry }
}

fn gs_strings(s: G, v) -> G {
    G { funcs: s.funcs, strings: v, table: s.table, fids: s.fids, variants: s.variants, consts: s.consts, cexp: s.cexp, locals: s.locals, muts: s.muts, next: s.next, loops: s.loops, loc: s.loc, code: s.code, locs: s.locs, meta: s.meta, dedicated: s.dedicated, natives: s.natives, structs: s.structs, enums: s.enums, methods: s.methods, entry: s.entry }
}

fn gs_table(s: G, v) -> G {

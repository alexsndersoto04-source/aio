    G { funcs: s.funcs, strings: s.strings, table: s.table, fids: s.fids, variants: s.variants, consts: s.consts, cexp: s.cexp, locals: s.locals, muts: s.muts, next: v, loops: s.loops, loc: s.loc, code: s.code, locs: s.locs, meta: s.meta, dedicated: s.dedicated, natives: s.natives, structs: s.structs, enums: s.enums, methods: s.methods, entry: s.entry }

// Flujo del motor sin hardware: validaciones, cola y reproducción hacia un archivo
// (TITAN_AUDIO_SINK=file:<ruta>). Sin esa variable `engine_play` falla con NoDevice.
fn show(label: string, r: any) {
    println(label + " => " + std::json::stringify(r))
}

fn main() {
    let dir = "/home/user/aio/selfhost/tests/audio/fixtures/"
    show("status idle", std::try::catch(|| { std::audio::engine_status() }))
    show("state", std::audio::engine_state())
    show("position", std::try::catch(|| { std::audio::engine_position() }))
    show("device", std::audio::engine_device())
    show("volume 101", std::try::catch(|| { std::audio::engine_set_volume(101) }))
    show("volume 55", std::try::catch(|| { std::audio::engine_set_volume(55) }))
    show("crossfade 13", std::try::catch(|| { std::audio::engine_set_crossfade(13.0) }))
    show("crossfade 0.5", std::try::catch(|| { std::audio::engine_set_crossfade(0.5) }))
    show("eq 13", std::try::catch(|| { std::audio::engine_set_eq(0, 13, 0) }))
    show("eq ok", std::try::catch(|| { std::audio::engine_set_eq(3, -2, 5) }))
    show("gapless", std::try::catch(|| { std::audio::engine_set_gapless(false) }))
    show("queue_add missing", std::try::catch(|| { std::audio::engine_queue_add("/nope.wav") }))
    show("queue_add", std::try::catch(|| { std::audio::engine_queue_add(dir + "pcm16_stereo.wav") }))
    show("queue_list", std::audio::engine_queue_list())
    show("stop idle", std::try::catch(|| { std::audio::engine_stop() }))
    show("pause idle", std::try::catch(|| { std::audio::engine_pause() }))
    show("seek idle", std::try::catch(|| { std::audio::engine_seek(1.0) }))
    show("seek neg", std::try::catch(|| { std::audio::engine_seek(-1.0) }))
    show("next idle", std::try::catch(|| { std::audio::engine_next() }))
    show("prev idle", std::try::catch(|| { std::audio::engine_prev() }))
    show("current idle", std::try::catch(|| { std::audio::engine_current() }))
    show("play missing", std::try::catch(|| { std::audio::engine_play("/nope.wav") }))
    show("play bad", std::try::catch(|| { std::audio::engine_play(dir + "nope.mp3") }))
    show("status", std::try::catch(|| { std::audio::engine_status() }))
    show("play", std::try::catch(|| { std::audio::engine_play(dir + "q_mid.ogg") }))
    show("queue after play", std::audio::engine_queue_list())
    show("device after", std::audio::engine_device())
    show("state playing", std::audio::engine_state())
    std::time::sleep_ms(300)
    show("current", std::try::catch(|| { std::audio::engine_current() }))
    show("pause", std::try::catch(|| { std::audio::engine_pause() }))
    show("state paused", std::audio::engine_state())
    show("resume", std::try::catch(|| { std::audio::engine_resume() }))
    show("seek far", std::try::catch(|| { std::audio::engine_seek(500.0) }))
    show("seek", std::try::catch(|| { std::audio::engine_seek(0.5) }))
    std::time::sleep_ms(300)
    show("levels len", len(std::audio::engine_levels()))
    show("queue_add2", std::try::catch(|| { std::audio::engine_queue_add(dir + "pcm16_mono.wav") }))
    show("next", std::try::catch(|| { std::audio::engine_next() }))
    std::time::sleep_ms(300)
    show("prev", std::try::catch(|| { std::audio::engine_prev() }))
    std::time::sleep_ms(300)
    show("status playing", std::try::catch(|| { std::audio::engine_status() }))
    show("stop", std::try::catch(|| { std::audio::engine_stop() }))
    show("state end", std::audio::engine_state())
}

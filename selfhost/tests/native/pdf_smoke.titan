fn find_sequence(bytes: array, needle: array) -> int {
    if len(needle) == 0 { return 0 }
    if len(needle) > len(bytes) { return -1 }
    let mut start = 0
    while start + len(needle) <= len(bytes) {
        let mut matched = true
        let mut i = 0
        while i < len(needle) {
            if bytes[start + i] != needle[i] {
                matched = false
                break
            }
            i += 1
        }
        if matched { return start }
        start += 1
    }
    -1
}

fn pdf_whitespace(byte: int) -> bool {
    byte == 0 || byte == 9 || byte == 10 || byte == 12 || byte == 13 || byte == 32
}

fn has_pdf_name_value(bytes: array, name: array, value: array) -> bool {
    let mut search = 0
    while search < len(bytes) {
        let tail = std::array::slice(bytes, search, len(bytes))
        let relative = find_sequence(tail, name)
        if relative < 0 { return false }
        let marker = search + relative
        let mut position = marker + len(name)
        while position < len(bytes) && pdf_whitespace(bytes[position]) {
            position += 1
        }
        if position + len(value) <= len(bytes) {
            let mut matched = true
            let mut i = 0
            while i < len(value) {
                if bytes[position + i] != value[i] { matched = false }
                i += 1
            }
            if matched { return true }
        }
        search = marker + len(name)
    }
    false
}

fn pdf_count(bytes: array) -> int {
    let marker = find_sequence(bytes, [47, 67, 111, 117, 110, 116])
    if marker < 0 { return -1 }
    let mut position = marker + 6
    while position < len(bytes) && pdf_whitespace(bytes[position]) {
        position += 1
    }
    let mut count = 0
    let mut digits = 0
    while position < len(bytes) && bytes[position] >= 48 && bytes[position] <= 57 {
        count = count * 10 + bytes[position] - 48
        digits += 1
        position += 1
    }
    if digits == 0 { return -1 }
    count
}

fn has_valid_xref(data: any) -> bool {
    let bytes = std::bytes::to_array(data)
    if len(bytes) < 8 || bytes[0] != 37 || bytes[1] != 80 || bytes[2] != 68 || bytes[3] != 70 || bytes[4] != 45 { return false }
    if !has_pdf_name_value(bytes, [47, 84, 121, 112, 101], [47, 80, 97, 103, 101, 115]) || pdf_count(bytes) != 2 { return false }
    let marker = find_sequence(bytes, [115, 116, 97, 114, 116, 120, 114, 101, 102])
    let eof = find_sequence(bytes, [37, 37, 69, 79, 70])
    if marker < 0 || eof <= marker { return false }
    let mut position = marker + 9
    // PDF whitespace includes NUL, TAB, LF, FF, CR, and SPACE.
    while position < len(bytes) && pdf_whitespace(bytes[position]) {
        position += 1
    }
    let mut offset = 0
    let mut digits = 0
    while position < len(bytes) && bytes[position] >= 48 && bytes[position] <= 57 {
        if offset > 100000000 { return false }
        offset = 10 * offset + bytes[position] - 48
        digits += 1
        position += 1
    }
    if digits == 0 || offset < 0 || offset >= marker || offset + 4 > len(bytes) { return false }
    // PDF 1.4 writers use an xref table; newer writers may point startxref
    // at an indirect xref-stream object. Both page-tree count and API count are checked.
    let classic_table = bytes[offset] == 120 && bytes[offset + 1] == 114 && bytes[offset + 2] == 101 && bytes[offset + 3] == 102
    if classic_table { return true }
    let xref_stream = std::array::slice(bytes, offset, len(bytes))
    let type_marker = find_sequence(xref_stream, [47, 84, 121, 112, 101])
    if type_marker < 0 { return false }
    let mut type_value = type_marker + 5
    while type_value < len(xref_stream) && pdf_whitespace(xref_stream[type_value]) {
        type_value += 1
    }
    if type_value + 5 > len(xref_stream) { return false }
    xref_stream[type_value] == 47 && xref_stream[type_value + 1] == 88 && xref_stream[type_value + 2] == 82 && xref_stream[type_value + 3] == 101 && xref_stream[type_value + 4] == 102
}

fn closed_handle_is_rejected(handle: int) -> bool {
    match std::try::catch(|| std::pdf::page_count(handle)) {
        Result::Ok(_) => false,
        Result::Err(_) => true,
    }
}

fn main() {
    let path = "selfhost/native/pdf-smoke.pdf"
    let document = std::pdf::new("Titan PDF", 210.0, 297.0)
    std::pdf::set_color(document, 0, 0, 0.2, 0.6, 0.8)
    std::pdf::add_text(document, 0, 0, "Hola desde Titan", 18.0, 20.0, 270.0)
    std::pdf::add_line(document, 0, 0, 20.0, 260.0, 190.0, 260.0, 0.5)
    std::pdf::add_rect(document, 0, 0, 20.0, 200.0, 50.0, 30.0)
    let second_page = std::pdf::add_page(document, 210.0, 297.0, "Detalles")
    std::testing::assert(second_page == 1, "PDF devuelve el índice de página basado en cero")
    std::pdf::add_text(document, second_page, 0, "Página dos", 14.0, 20.0, 270.0)
    std::testing::assert(std::pdf::page_count(document) == 2, "PDF conserva ambas páginas")
    std::pdf::save(document, path)
    let bytes = std::fs::read_bytes(path)
    std::testing::assert(has_valid_xref(bytes), "PDF tiene cabecera, árbol de páginas, xref real y EOF")
    println("PDF multipágina válido")
    std::pdf::close(document)
    std::testing::assert(closed_handle_is_rejected(document), "PDF operations reject a closed handle")
    std::pdf::close(document)
    std::fs::remove_file(path)
}

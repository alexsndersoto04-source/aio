// std::term: todo lo que se puede comprobar sin terminal (secuencias de
// escape exactas). Las teclas, el modo crudo y el tamaño en una terminal de
// verdad se prueban con selfhost/native/term/verificar.sh.
fn main() {
    std::term::print_colored("Red", "hola")
    print("|")
    std::term::print_colored("PURPLE", "p")
    std::term::print_colored("darkGray", "d")
    std::term::print_colored("grey", "g")
    std::term::print_colored("default", "r")
    std::term::print_styled("rgb:1,+2,255", "#0A0b0C", "x\ny")
    print("|")
    std::term::print_styled("black", "white", "bw")
    std::term::print_colored("#+f+f+f", "p")
    std::term::print_colored("rgb:007,0,00255", "c")
    std::term::print_attr("INVERT", "z")
    std::term::print_attr("bold", "b")
    std::term::print_attr("Under", "u")
    std::term::print_attr("hidden", "h")
    std::term::print_attr("reset", "0")
    std::term::print_attr("dim", "")
    std::term::print_attr("italic", "i")
    std::term::clear_screen()
    std::term::clear_line()
    std::term::move_to(65535, 65535)
    std::term::move_to(0, 7)
    std::term::move_to(12, 0)
    std::term::hide_cursor()
    std::term::show_cursor()
    std::term::enter_alt_screen()
    std::term::leave_alt_screen()
    std::term::flush()
    std::term::disable_raw()
    print("")
    print("fin")
}

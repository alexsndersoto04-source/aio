// Resolución de nombres (getaddrinfo) en bind y connect.
fn texto(b: bytes) -> string {
    std::encoding::utf8_decode(b)
}

fn main() {
    let l = std::net::tcp_listen("127.0.0.1:0")
    let addr = std::net::tcp_local_addr(l)
    let puerto = std::text::substring(addr, 10, len(addr))
    let t = spawn || {
        let c = std::net::tcp_connect("localhost:" + puerto)
        std::net::tcp_write(c, "por nombre")
        std::net::tcp_close(c)
        1
    }
    let (s, peer) = std::net::tcp_accept(l)
    print(texto(std::net::tcp_read(s, 100)))
    print(join(t))
    print(std::try::catch(|| std::net::tcp_connect("no-existe.invalid:80")))
    print(std::try::catch(|| std::net::tcp_listen("nombre con nul\0:80")))
    // Un puerto en la dirección de bind con nombre local.
    let l2 = std::net::tcp_listen("localhost:0")
    print(l2)
}

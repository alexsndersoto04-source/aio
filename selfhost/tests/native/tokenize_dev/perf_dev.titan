fn rep(s: string, n: int) -> string {
    std::collections::join(std::array::filled(n, s), "")
}

fn bench(name: string) {
    let src = std::fs::read_text("/tmp/tkcfg/" + name + ".json")
    let h = std::tokenize::from_json(src)
    let base = "The quick brown fox, jumps over the lazy dog! Héllo wörld 123. "
    let text = std::text::substring(rep(base, 1100), 0, 60000)
    let t0 = std::time::unix_millis()
    let e = std::tokenize::encode(h, text, true)
    let t1 = std::time::unix_millis()
    let n = len(e["ids"])
    let d1 = t1 - t0
    print(name + " encode60k " + "{d1}" + "ms tokens " + "{n}")
    let chunk = std::text::substring(text, 0, 3500)
    let b = std::tokenize::encode_batch(h, std::array::filled(64, chunk), true)
    let t2 = std::time::unix_millis()
    let ids = std::array::slice(e["ids"], 0, 10000)
    let d = std::tokenize::decode(h, ids, true)
    let t3 = std::time::unix_millis()
    let d2 = t2 - t1
    let d3 = t3 - t2
    print(name + " batch64x3.5k " + "{d2}" + "ms decode10k " + "{d3}" + "ms")
    std::tokenize::close(h)
}

fn main() {
    bench("bert_uncased")
    bench("gpt2")
    bench("unigram_basic")
    bench("llama_like")
    bench("roberta")
}

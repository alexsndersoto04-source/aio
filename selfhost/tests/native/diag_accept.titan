// Diagnostic: isolate native accept bug
fn main() {
    println("1: creating socket...")
    let fd = std::raw::syscall(41, 2, 1, 0, 0, 0, 0)
    println("  socket fd=")
    println("  " + rt_int_to_str(fd))
    if fd < 0 {
        println("FAIL: socket")
        return
    }
    
    // bind
    println("2: binding to 0.0.0.0:19999...")
    let sa = rt_alloc_zero(16)
    std::raw::store8(sa + 0, 2)
    std::raw::store8(sa + 1, 0)
    // port 19999 = 0x4E1F
    std::raw::store8(sa + 2, 78)
    std::raw::store8(sa + 3, 31)
    std::raw::store8(sa + 4, 0)
    std::raw::store8(sa + 5, 0)
    std::raw::store8(sa + 6, 0)
    std::raw::store8(sa + 7, 0)
    let br = std::raw::syscall(49, fd, sa, 16, 0, 0, 0)
    println("  bind result=")
    println("  " + rt_int_to_str(br))
    if br < 0 {
        println("FAIL: bind")
        std::raw::syscall(3, fd, 0, 0, 0, 0, 0)
        return
    }
    
    // listen
    println("3: listening...")
    let lr = std::raw::syscall(50, fd, 1, 0, 0, 0, 0)
    println("  listen result=")
    println("  " + rt_int_to_str(lr))
    if lr < 0 {
        println("FAIL: listen")
        std::raw::syscall(3, fd, 0, 0, 0, 0, 0)
        return
    }
    
    // set SO_RCVTIMEO = 2 seconds
    println("4: setting SO_RCVTIMEO...")
    let tv = rt_alloc_zero(16)
    std::raw::store(tv, 2)
    std::raw::store(tv + 8, 0)
    let sr = std::raw::syscall(54, fd, 1, 20, tv, 16, 0)
    println("  setsockopt result=")
    println("  " + rt_int_to_str(sr))

    // spawn curl in background
    println("5: spawning curl...")
    let client = std::process::spawn("sh -c 'sleep 1 && curl -s http://127.0.0.1:19999/test'")
    println("  curl spawned")
    
    // accept
    println("6: calling accept(43)...")
    let sa2 = rt_alloc_zero(128)
    let lp = rt_alloc_zero(8)
    std::raw::store(lp, 128)
    let r = std::raw::syscall(43, fd, sa2, lp, 0, 0, 0)
    println("  accept result=")
    println("  " + rt_int_to_str(r))
    
    if r < 0 {
        println("  trying accept4(288)...")
        r = std::raw::syscall(288, fd, sa2, lp, 0, 0, 0)
        println("  accept4 result=")
        println("  " + rt_int_to_str(r))
    }
    
    if r >= 0 {
        println("SUCCESS: got client fd")
        // send response
        let resp = "HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nOK"
        let buf = rt_alloc(resp.length())
        let mut i = 0
        while i < resp.length() {
            std::raw::store8(buf + i, std::raw::cast(resp[i]))
            i = i + 1
        }
        std::raw::syscall(1, r, buf, resp.length(), 0, 0, 0)
        std::raw::syscall(3, r, 0, 0, 0, 0, 0)
        rt_free_block(buf)
    } else {
        println("FAIL: accept returned negative")
    }
    
    // cleanup
    std::raw::syscall(3, fd, 0, 0, 0, 0, 0)
    rt_free_block(sa)
    rt_free_block(sa2)
    rt_free_block(lp)
    rt_free_block(tv)
    
    // wait for curl
    let cw = std::process::spawn_wait(client)
    let out = std::map::get(cw, "stdout")
    println("curl output:")
    println(out)
    println("DONE")
}
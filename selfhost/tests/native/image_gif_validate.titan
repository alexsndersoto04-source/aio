fn fingerprint(data: any) -> int {
    let bytes = std::bytes::to_array(data)
    let mut value = 0
    let mut i = 0
    while i < len(bytes) {
        value = (value * 131 + bytes[i]) & 2147483647
        i += 1
    }
    value
}

fn show_image(handle: int, label: string) {
    println(label)
    println(std::image::width(handle))
    println(std::image::height(handle))
    println(std::image::color_type(handle))
    println(fingerprint(std::image::encode(handle, "png")))
    println(fingerprint(std::image::encode(handle, "bmp")))
}

fn main() {
    let args = std::env::args()
    let base = args[len(args) - 1]
    let files = ["rgb.gif", "rgba.gif", "partial.gif", "high.gif", "high-alpha.gif", "save-rgb.gif"]
    let mut i = 0
    while i < len(files) {
        let path = base + "." + files[i]
        let image = std::image::load(path)
        show_image(image, files[i])
        std::image::close(image)
        i += 1
    }
}

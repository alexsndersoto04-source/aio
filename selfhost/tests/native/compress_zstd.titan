// GENERADO por native/compress/gen_zstd_test.py (no editar a mano).
// std::compress::zstd_decode con marcos hechos por la libzstd 1.5.7 real:
// válidos (varios marcos, saltables, checksum, RLE, raw, salida grande) y
// estropeados. Se imprime la salida (entera si es corta, si no longitud y
// CRC-32) o el mensaje de error, que tiene que ser el mismo que en la VM.

fn desc(b: bytes) -> string {
    let n = len(b)
    if n <= 40 {
        return std::encoding::hex_encode(b)
    }
    let c = std::checksum::crc32(b)
    "len={n} crc={c}"
}

fn main() {
    let casos = [
        "vacio",
        "",
        "marco de 0 bytes",
        "28b52ffd2000010000",
        "hola",
        "28b52ffd200a510000686f6c61206d756e646f",
        "texto 3000",
        "",
        "texto 3000 nivel 19 + checksum",
        "",
        "texto 20000 sin tamano (por bloques)",
        "",
        "repetido 300000 (salida > 8192)",
        "28b52ffda4e09304001c0100d8706174726f6e20726570657469646f20303132333435363738392001008bff7b3ec74c0000086f0100fcff3910024d000008610100dc131d0801e66db978",
        "repetido 300000 nivel 1 sin tamano",
        "28b52ffd00481c0100d8706174726f6e20726570657469646f20303132333435363738392001008bff7b3ec74c0000086f0100fcff3910024d000008610100dc131d0801",
        "bytes aleatorios (bloques raw)",
        "",
        "ceros (bloque RLE)",
        "28b52ffda0400d03005400001000000100fbff39c002036a0800",
        "dos marcos",
        "28b52ffd20084100007072696d65726f2028b52ffd2007390000736567756e646f",
        "saltable + marco + saltable",
        "",
        "solo saltable",
        "502a4d180700000031323334353637",
        "ventana 2^20 streaming",
        "",
        "checksum incorrecto",
        "",
        "truncado",
        "",
        "solo cabecera",
        "28b52ffd64b8",
        "magia mala",
        "",
        "basura final",
        "",
        "un byte",
        "28",
        "diccionario pedido",
        "",
        "ventana demasiado grande",
        "",
        "bit reservado",
        "",
        "corrupto 0",
        "",
        "corrupto 1",
        "",
        "corrupto 2",
        "",
        "corrupto 3",
        "",
        "corrupto 4",
        "",
        "corrupto 5",
        "",
        "corrupto 6",
        "",
        "corrupto 7",
        "",
        "corrupto 8",
        "",
        "corrupto 9",
        "",
        "corrupto 10",
        "",
        "corrupto 11",
        "",
    ]
    let mut i = 0
    while i < len(casos) {
        let nombre = casos[i]
        let datos = std::encoding::hex_decode(casos[i + 1])
        let r = std::try::catch(|| { std::compress::zstd_decode(datos) })
        let s = match r {
            Result::Ok(v) => "ok " + desc(v),
            Result::Err(e) => "error: " + e,
        }
        println("{nombre}: {s}")
        i += 2
    }
}

// Control de conexiones de un servidor: cupo, estadísticas, salud y apagado.
fn main() {
    let c = std::server::control(2)
    print(c)
    print(std::server::try_acquire(c))
    print(std::server::try_acquire(c))
    print(std::server::try_acquire(c))
    print(std::server::stats(c))
    print(std::server::health_response(c))
    print(std::server::release(c))
    print(std::server::release(c))
    print(std::server::release(c))
    print(std::server::try_acquire(c))
    print(std::server::stats(c))
    std::server::shutdown(c)
    print(std::server::try_acquire(c))
    print(std::server::stats(c))
    let h = std::server::health_response(c)
    print(h)
    print(std::map::get(h, "status"))
    let d = std::server::control(1)
    print(d)
    print(c == d)
    print(c == c)
    print(std::server::control(0))
}

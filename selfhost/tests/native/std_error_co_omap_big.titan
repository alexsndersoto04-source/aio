fn rep(n: int) -> string {
    let mut out = ""
    let mut piece = "a"
    let mut k = n
    while k > 0 {
        if k % 2 == 1 {
            out = out + piece
        }
        piece = piece + piece
        k = k / 2
    }
    out
}

fn main() {
    let m = std::collections::omap_new()
    std::collections::omap_insert(m, "k", rep(65534))
}

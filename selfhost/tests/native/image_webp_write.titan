fn main() {
    let args = std::env::args()
    let output_base = args[len(args) - 1]

    let rgb = std::image::load("selfhost/native/image/testdata/color-baseline.jpg")
    std::fs::write_bytes(output_base + ".rgb.webp", std::image::encode(rgb, "webp"))
    std::image::save(rgb, output_base + ".save-rgb.webp")
    std::image::close(rgb)

    let rgba = std::image::load("selfhost/native/image/testdata/rgb8-trns.png")
    std::fs::write_bytes(output_base + ".rgba.webp", std::image::encode(rgba, "WEBP"))
    std::image::close(rgba)

    let gray = std::image::load("selfhost/native/image/testdata/gray-baseline.jpg")
    std::fs::write_bytes(output_base + ".gray.webp", std::image::encode(gray, "webp"))
    std::image::close(gray)

    let rgba16 = std::image::load("selfhost/native/image/testdata/rgba16.png")
    std::fs::write_bytes(output_base + ".rgba16.webp", std::image::encode(rgba16, "webp"))
    std::image::close(rgba16)
    println("wrote VP8L RGB, RGBA, L8 and converted 16-bit images")
}

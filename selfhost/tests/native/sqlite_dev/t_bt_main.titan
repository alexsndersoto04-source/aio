fn rnd(s: int) -> int {
    (s * 1103515245 + 12345) % 2147483648
}

fn mk_text(rowid: int, l: int) -> string {
    let letters = ["a","b","c","d","e","f","g","h","i","j","k","l","m","n","o","p","q","r","s","t","u","v","w","x","y","z"]
    std::collections::join(std::array::filled(l, letters[rowid % 26]), "")
}

fn row_rec(rowid: int, l: int) -> array {
    sq_rec_enc([Sv::SInt(rowid * 3), Sv::SText(mk_text(rowid, l))])
}

fn len_for(r: int) -> int {
    let sizes = [0, 1, 5, 10, 20, 20, 30, 50, 100, 200, 500, 1000, 3000, 5000, 20000]
    sizes[(r / 7) % 15]
}

fn master_rec(name: string, root: int, sql: string) -> array {
    let ty = "table"
    sq_rec_enc([Sv::SText(ty), Sv::SText(name), Sv::SText(name), Sv::SInt(root), Sv::SText(sql)])
}

fn run(seed: int, nops: int, maxkey: int, path: string, small: bool, ins: int) -> int {
    let (p0, err) = sqp_open(sqio_mem())
    let mut p = sqp_begin(p0)
    let (p1, root) = sqt_new_root(p, 13)
    p = p1
    p = sqt_t_put(p, 1, 1, master_rec("t", root, "CREATE TABLE t(a,b)"))
    let mut model = std::map::new()
    let mut s = seed
    let mut i = 0
    while i < nops {
        s = rnd(s)
        let k = 1 + (s / 16) % maxkey
        s = rnd(s)
        let act = (s / 16) % 10
        let key = "{k}"
        if act < ins {
            s = rnd(s)
            let mut l = len_for(s / 16)
            if small {
                l = (s / 16) % 40
            }
            p = sqt_t_put(p, root, k, row_rec(k, l))
            model = std::map::insert(model, key, l)
        } else {
            p = sqt_t_del(p, root, k)
            model = std::map::insert(model, key, -1)
        }
        i += 1
    }
    // verificación
    let rows = sqt_t_scan(p, root)
    let mut bad = 0
    let mut cnt = 0
    let mut prev = 0
    for r in rows {
        if r[0] <= prev {
            bad += 1
        }
        prev = r[0]
        let l = std::map::get(model, "{prev}")
        if l == nil || l < 0 {
            bad += 1
        } else if r[1] != row_rec(prev, l) {
            bad += 1
        }
        cnt += 1
    }
    let mut expect = 0
    for k in std::map::keys(model) {
        if std::map::get(model, k) >= 0 {
            expect += 1
        }
    }
    if expect != cnt {
        bad += 1
    }
    let q = sqp_commit(p, 0)
    std::fs::write_bytes(path, q.io.img)
    print("run", seed, "rows", cnt, "bad", bad, "pages", q.npages)
    bad
}

fn main() {
    run(1, 300, 200, "/tmp/sq_t1.db", false, 7)
    run(2, 2000, 600, "/tmp/sq_t2.db", true, 7)
    run(3, 3000, 400, "/tmp/sq_t3.db", false, 7)
    run(4, 4000, 100000, "/tmp/sq_t4.db", true, 7)
    run(5, 6000, 300, "/tmp/sq_t5.db", true, 3)
    run(6, 3000, 300, "/tmp/sq_t6.db", false, 4)
}

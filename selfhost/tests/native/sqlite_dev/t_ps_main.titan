fn show(sql: string) {
    let (all, err) = ss_parse_all(sql)
    if err != "" {
        print("ERR", err)
        return
    }
    for a in all {
        let st = a[0]
        let k = st.k
        print("OK", k, len(all))
        if k == "createtable" {
            print(ss_master_text(sql, a[1], st.v.ntok, a[3], "TABLE"))
        }
    }
}

fn main() {
    show("CREATE TABLE IF NOT EXISTS users (id TEXT PRIMARY KEY, username TEXT UNIQUE NOT NULL, n INTEGER DEFAULT 5 CHECK (n > 0), FOREIGN KEY (id) REFERENCES x(y) ON DELETE CASCADE);")
    show("INSERT INTO t (a,b) VALUES (1,'x'),(2,'y') ON CONFLICT(a) DO UPDATE SET b = excluded.b RETURNING a")
    show("UPDATE t SET a = a + 1, b = 2 WHERE c = ?")
    show("DELETE FROM t WHERE a IN (SELECT x FROM u)")
    show("CREATE UNIQUE INDEX i ON t (a DESC, b COLLATE nocase) WHERE a > 0")
    show("CREATE TRIGGER tr AFTER INSERT ON t FOR EACH ROW WHEN new.a > 1 BEGIN INSERT INTO log(a) VALUES (new.a); UPDATE c SET n = n + 1; END")
    show("ALTER TABLE t ADD COLUMN z INTEGER DEFAULT 0; DROP TABLE IF EXISTS q; PRAGMA foreign_keys = ON; BEGIN IMMEDIATE; COMMIT")
    show("CREATE VIEW v AS SELECT 1")
    show("selec 1")
}

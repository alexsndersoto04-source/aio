fn hx(a: array) -> string {
    let mut s = ""
    for b in a {
        let h = std::encoding::hex_encode(std::bytes::from_array([b]))
        s = s + h
    }
    s
}

fn main() {
    let ints = [0, 1, 127, 128, 16383, 16384, 72057594037927935, 72057594037927936, 9223372036854775807, -1, -128, -129, -9223372036854775807]
    for i in ints {
        let e = sq_varint_enc(i)
        let (v, n) = sq_varint(e, 0)
        let ok = v == i && n == len(e)
        print("V", i, hx(e), ok)
    }
    let fs = ["1.5", "-2.25", "0.1", "3.141592653589793", "1e300", "-1e-300", "4.9e-324", "2.2250738585072014e-308", "1.7976931348623157e308", "123456789.123456789", "5e-324", "1e-310", "0.5", "2.0"]
    for s in fs {
        let f = match std::text::parse_float(s) {
            Option::Some(x) => x,
            _ => 0.0,
        }
        let e = sq_f2b(f)
        let g = sq_b2f(e, 0)
        print("F", s, hx(e), g == f)
    }
    let vals = [Sv::SInt(300), Sv::SNull, Sv::SText("héllo"), Sv::SReal(2.5), Sv::SBlob(std::bytes::from_array([1,2,3])), Sv::SInt(-70000), Sv::SInt(1), Sv::SInt(0), Sv::SInt(9223372036854775807), Sv::SInt(-9223372036854775807)]
    let r = sq_rec_enc(vals)
    print("R", hx(r))
    let d = sq_rec_dec(r, -1)
    print("D", d)
}

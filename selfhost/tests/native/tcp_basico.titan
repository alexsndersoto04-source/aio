// TCP por loopback: listener, accept, connect, read, write y close, con el
// cliente en una tarea.
fn texto(b: bytes) -> string {
    std::encoding::utf8_decode(b)
}

fn main() {
    let l = std::net::tcp_listen("127.0.0.1:0")
    print(l)
    let addr = std::net::tcp_local_addr(l)
    print(std::text::starts_with(addr, "127.0.0.1:"))
    let cliente = spawn || {
        let c = std::net::tcp_connect(addr)
        let n = std::net::tcp_write(c, "hola servidor")
        let r = std::net::tcp_read(c, 100)
        std::net::tcp_close(c)
        let par = [n, texto(r)]
        par
    }
    let (s, peer) = std::net::tcp_accept(l)
    print(std::text::starts_with(peer, "127.0.0.1:"))
    let pedido = std::net::tcp_read(s, 100)
    print(texto(pedido))
    print(std::net::tcp_write(s, std::encoding::utf8_encode("adios cliente")))
    print(join(cliente))
    // El cliente cerró: la lectura da 0 bytes (fin de conexión).
    let fin = std::net::tcp_read(s, 10)
    print(std::bytes::length(fin))
    print(std::net::tcp_close(s))
    print(std::net::tcp_close(s))
    print(std::net::tcp_close(l))
    print(std::net::tcp_close(l))
    // maximo 0 espera a que haya datos, pero no consume nada.
    let l2 = std::net::tcp_listen("127.0.0.1:0")
    print(l2)
    let a2 = std::net::tcp_local_addr(l2)
    let c2 = std::net::tcp_connect(a2)
    let (s2, p2) = std::net::tcp_accept(l2)
    std::net::tcp_write(s2, "datos")
    print(std::bytes::length(std::net::tcp_read(c2, 0)))
    print(texto(std::net::tcp_read(c2, 100)))
    print(c2 == c2)
    print(c2 == s2)
}

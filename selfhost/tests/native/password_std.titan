// std::password: vectores Argon2 generados con una implementación de referencia
// independiente en Python (RFC 9106, hashlib.blake2b), aceptados también por la VM.
fn main() {
    println(std::password::verify_argon2("$argon2i$v=16$m=100,t=1,p=3,keyid=RJTWSTydXDQ$HW0TLN7WI3su2R4/ch/LGQ$0xF1OPfS77zjoA", "~0"), std::password::verify_argon2("$argon2i$v=16$m=100,t=1,p=3,keyid=RJTWSTydXDQ$HW0TLN7WI3su2R4/ch/LGQ$0xF1OPfS77zjoA", "~0x"))
    println(std::password::verify_argon2("$argon2id$v=16$m=16,t=3,p=2,data=IR+e5JHFsQ$2qDu6LmZf1x8KZn9r+WTJTzWVK9N+tcUJ6Cus/7pIy+K$sORcLfxw6nIOMw", "X&"), std::password::verify_argon2("$argon2id$v=16$m=16,t=3,p=2,data=IR+e5JHFsQ$2qDu6LmZf1x8KZn9r+WTJTzWVK9N+tcUJ6Cus/7pIy+K$sORcLfxw6nIOMw", "X&x"))
    println(std::password::verify_argon2("$argon2id$v=16$m=33,t=2,p=3,data=H2EiauFTOA$jkbcjtS3wnZNKlpNdncG+F2GkAJK1r2jQBvpyMvMyTX2$MMTAsRWk/2RS2kaiJGro+ZZKQX55lBjxFUkUGv9aFdQ", "!@"), std::password::verify_argon2("$argon2id$v=16$m=33,t=2,p=3,data=H2EiauFTOA$jkbcjtS3wnZNKlpNdncG+F2GkAJK1r2jQBvpyMvMyTX2$MMTAsRWk/2RS2kaiJGro+ZZKQX55lBjxFUkUGv9aFdQ", "!@x"))
    println(std::password::verify_argon2("$argon2d$v=16$m=32,t=2,p=4$h/VSC2m5Sw2YLoW7VbZyqA$xBdTZoQGfhDYJmjH7UwepyQgDFctQKrgDHfwUuY0EQjyCe9WCBZm6TsJrFIWf4DGDXvOp5QOndGGSdDUIBZY", "bY&< *:;]11^[]]-Z 0"), std::password::verify_argon2("$argon2d$v=16$m=32,t=2,p=4$h/VSC2m5Sw2YLoW7VbZyqA$xBdTZoQGfhDYJmjH7UwepyQgDFctQKrgDHfwUuY0EQjyCe9WCBZm6TsJrFIWf4DGDXvOp5QOndGGSdDUIBZY", "bY&< *:;]11^[]]-Z 0x"))
    println(std::password::verify_argon2("$argon2id$v=19$m=100,t=1,p=2,data=APWwKz3GZvRb3qosyu3NK1FXQQ5N7krys09DCgc0R94$8YRjsOSyuilwNHTwZKxo9w$ZTxbEcTZmLDyLGGERR7ldw", ""), std::password::verify_argon2("$argon2id$v=19$m=100,t=1,p=2,data=APWwKz3GZvRb3qosyu3NK1FXQQ5N7krys09DCgc0R94$8YRjsOSyuilwNHTwZKxo9w$ZTxbEcTZmLDyLGGERR7ldw", "x"))
    println(std::password::verify_argon2("$argon2id$v=19$m=64,t=2,p=2,keyid=2yVs,data=RtU+yOKhJQ$Qk0J4V0CTFhI8j0fpvc2HX9hjRUy5w4g4qZmjef0foRn$9fslYOAEwQFZ9uBy2MOcXnAxXNElHi7ReJVtFDF3qSD5k08mebrFewthA4+PrJ+lL79iRDX3r6jYHA9JRAofJQ", "X:[|"), std::password::verify_argon2("$argon2id$v=19$m=64,t=2,p=2,keyid=2yVs,data=RtU+yOKhJQ$Qk0J4V0CTFhI8j0fpvc2HX9hjRUy5w4g4qZmjef0foRn$9fslYOAEwQFZ9uBy2MOcXnAxXNElHi7ReJVtFDF3qSD5k08mebrFewthA4+PrJ+lL79iRDX3r6jYHA9JRAofJQ", "X:[|x"))
    println(std::password::verify_argon2("$argon2d$v=16$m=19,t=2,p=2,data=TP2nLY4dXQ$U3JS3M6t12S2oy+7Ca3q4QnEqZcgOXU1K4eLFFyKQtiE$R4qIuIkQj5MfWG5SGEMExIKiUsZGqgLn0D+F34Qeylm7", "[(0="), std::password::verify_argon2("$argon2d$v=16$m=19,t=2,p=2,data=TP2nLY4dXQ$U3JS3M6t12S2oy+7Ca3q4QnEqZcgOXU1K4eLFFyKQtiE$R4qIuIkQj5MfWG5SGEMExIKiUsZGqgLn0D+F34Qeylm7", "[(0=x"))
    println(std::password::verify_argon2("$argon2id$v=16$m=16,t=3,p=2,data=CQ$QhZ6OFKGGVxnn5xplORbig$4LmpLXj8IpfxudpppARh2yQKfSqVV0Kxh+QRZaNGykc", "Y*1[a/>"), std::password::verify_argon2("$argon2id$v=16$m=16,t=3,p=2,data=CQ$QhZ6OFKGGVxnn5xplORbig$4LmpLXj8IpfxudpppARh2yQKfSqVV0Kxh+QRZaNGykc", "Y*1[a/>x"))
    println(std::password::verify_argon2("$argon2d$v=16$m=33,t=1,p=4,data=kHyWF+teUA$QgckgtxTHCs$ORBHn6EfWyUYNKHYkFK4IY0WbqRnGn4Zq2Ugoh13cno", "0?^~=_-&(/%9=:"), std::password::verify_argon2("$argon2d$v=16$m=33,t=1,p=4,data=kHyWF+teUA$QgckgtxTHCs$ORBHn6EfWyUYNKHYkFK4IY0WbqRnGn4Zq2Ugoh13cno", "0?^~=_-&(/%9=:x"))
    println(std::password::verify_argon2("$argon2d$v=19$m=8,t=2,p=1,data=Iy8h8oEmhw$FckLmZt3K0/Hpv1MkUoW20cIdSsPFUS4NcDnGQl9+ocB$21KTae2w47yJTMwWdSjn4Q", "Z]+_%)_aZ*Z "), std::password::verify_argon2("$argon2d$v=19$m=8,t=2,p=1,data=Iy8h8oEmhw$FckLmZt3K0/Hpv1MkUoW20cIdSsPFUS4NcDnGQl9+ocB$21KTae2w47yJTMwWdSjn4Q", "Z]+_%)_aZ*Z x"))
    println(std::password::verify_bcrypt("$2y$12$L6Bc/AlTQHyd9liGgGEZyOFLPHNgyxeEPfgYfBCVxJ7JIlwxyVU3u", "hunter2"))
    println(std::password::verify_bcrypt("$2b$04$.sj375e8Aogez.LaXMCRgO/uiCq0oci2.sCIRcnlxgiUlvQ3qC3aK", ""))
    println(std::password::verify_bcrypt("$2b$+4$.sj375e8Aogez.LaXMCRgO/uiCq0oci2.sCIRcnlxgiUlvQ3qC3aK", "a"))
    let largo = "0123456789012345678901234567890123456789012345678901234567890123456789012_resto"
    let b = std::password::hash_bcrypt(largo, 4)
    println(len(b), std::text::starts_with(b, "$2b$04$"))
    println(std::password::verify_bcrypt(b, largo), std::password::verify_bcrypt(b, "0123456789012345678901234567890123456789012345678901234567890123456789012_otro"), std::password::verify_bcrypt(b, "x"))
    let a = std::password::hash_argon2("ñandú café")
    println(len(a), std::text::starts_with(a, "$argon2id$v=19$m=19456,t=2,p=1$"))
    println(std::password::verify_argon2(a, "ñandú café"), std::password::verify_argon2(a, "ñandu café"))
    println(std::password::hash_argon2("x") != std::password::hash_argon2("x"))
    println(std::password::verify_argon2("$argon2id$m=7,t=1,p=1$c29tZXNhbHQ$wWKIMhR9lyDFvRz9YTZweHKfbftvj+qf+YFY4NeBbtA", "password"))
    println(std::password::verify_argon2("$foo$m=8,t=1,p=1$c29tZXNhbHQ$wWKIMhR9lyDFvRz9YTZweHKfbftvj+qf+YFY4NeBbtA", "password"))
}

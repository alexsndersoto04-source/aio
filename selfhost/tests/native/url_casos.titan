// GENERADO por native/url/gen_casos.py. Todas las funciones de std::url
// con muchas URL (WHATWG, nombres de dominio internacionales y errores).

fn show(r: Result) -> string {
    match r {
        Result::Ok(v) => "{v}",
        Result::Err(e) => "Err(" + e + ")",
    }
}

fn one(u: string) {
    let v = std::url::is_valid(u)
    let s = show(std::try::catch(|| { std::url::scheme(u) }))
    let h = show(std::try::catch(|| { std::url::host(u) }))
    let p = show(std::try::catch(|| { std::url::port(u) }))
    let pa = show(std::try::catch(|| { std::url::path(u) }))
    let q = show(std::try::catch(|| { std::url::query(u) }))
    let f = show(std::try::catch(|| { std::url::fragment(u) }))
    println("[" + u + "] valid={v}")
    println("  scheme=" + s + " host=" + h + " port=" + p)
    println("  path=" + pa + " query=" + q + " fragment=" + f)
}

fn une(b: string, r: string) {
    let j = show(std::try::catch(|| { std::url::join(b, r) }))
    println("join [" + b + "] [" + r + "] = " + j)
}

fn pq(q: string) {
    let m = std::url::parse_query(q)
    println("parse_query [" + q + "] = {m}")
}


// Empates exactos en el último dígito: serde_json y serde_yaml (zmij/ryu) eligen el
// dígito par; Display de Rust (que usa print) redondea hacia arriba.
fn main() {
    print(std::json::stringify([1936443305115367.75, 1936443305115367.25, 1936443305115368.25, 1936443305115368.75, 4503599627370497.5, 4503599627370498.5, 9007199254740993.0, 2251799813685248.25, 2251799813685249.75, 2251799813685250.25, 2251799813685251.75, 1328.99591064453125, 1329.00390625, 1.00000762939453125]))

fn peligro(n: int) -> int {
    10 / n
}
fn main() {
    let ok = peligro(2)
    let capturado = std::try::catch(|| {
        peligro(0)
    })
    print("ok={ok}")
    match capturado {
        Result::Ok(v) => { print("ok") },
        Result::Err(e) => { print("err {e}") },
    }
    peligro(0)
}

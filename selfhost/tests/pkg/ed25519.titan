// Ed25519 nativo: vector 1 de RFC 8032, ida y vuelta, manipulación y entradas inválidas.
fn hex(b: any) -> string { std::encoding::hex_encode(b) }

fn falla(r: any) -> bool {
    match r {
        Result::Err(_) => true,
        _ => false,
    }
}

fn main() {
    let seed = std::encoding::hex_decode("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60")
    let pk = std::crypto::ed25519_public_key(seed)
    std::testing::assert_eq(hex(pk), "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a", "clave pública RFC 8032")
    let empty = std::encoding::utf8_encode("")
    let sig = std::crypto::ed25519_sign(seed, empty)
    std::testing::assert_eq(hex(sig), "e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b", "firma RFC 8032")
    std::testing::assert(std::crypto::ed25519_verify(pk, empty, sig), "verifica la firma RFC")
    std::testing::assert(!std::crypto::ed25519_verify(pk, std::encoding::utf8_encode("x"), sig), "mensaje distinto")
    let msg = std::encoding::utf8_encode("paquete titan 1.0.0")
    let s2 = std::crypto::ed25519_sign(seed, msg)
    std::testing::assert(std::crypto::ed25519_verify(pk, msg, s2), "ida y vuelta")
    std::testing::assert_eq(hex(std::crypto::ed25519_sign(seed, msg)), hex(s2), "determinista")
    let mut i = 0
    while i < 64 {
        let t = std::bytes::to_array(s2)
        let cambiado = std::array::set(t, i, (t[i] + 1) % 256)
        std::testing::assert(!std::crypto::ed25519_verify(pk, msg, std::bytes::from_array(cambiado)), "firma alterada")
        i += 7
    }
    std::testing::assert(!std::crypto::ed25519_verify(std::crypto::ed25519_public_key(std::crypto::generate_key_32()), msg, s2), "otra clave")
    std::testing::assert(falla(std::try::catch(|| { std::crypto::ed25519_public_key(std::encoding::hex_decode("00")) })), "semilla corta")
    std::testing::assert(falla(std::try::catch(|| { std::crypto::ed25519_verify(pk, msg, std::encoding::hex_decode("00")) })), "firma corta")
    print("ed25519 ok")
}

fn fib(n) {
    if n < 2 {
        return n
    }
    fib(n - 1) + fib(n - 2)
}

fn collatz(start) {
    let mut n = start
    let mut steps = 0
    while n != 1 {
        if n % 2 == 0 {
            n = n / 2
        } else {
            n = n * 3 + 1
        }
        steps += 1
    }
    steps
}

fn sum_to(limit) {
    let mut total = 0
    let mut i = 0
    while i < limit {
        total += i
        i += 1
    }
    total
}

fn mix(a, b) {
    let x = -a + b * 2 - (a % 7)
    if x > 10 && a != b || !(b < 3) {
        return x
    }
    0 - x
}

fn nested(n) {
    let mut count = 0
    let mut i = 0
    while i < n {
        let mut j = 0
        while j < n {
            if j == 3 {
                j += 1
                continue
            }
            if i * j > 40 {
                break
            }
            count += 1
            j += 1
        }
        i += 1
    }
    count
}

fn early(n) {
    let mut i = 0
    loop {
        if i * i > n {
            return i
        }
        i += 1
    }
    0
}

fn main() {
    fib(10) + collatz(27) + sum_to(100) + mix(3, 9) + nested(12) + early(1000)
}

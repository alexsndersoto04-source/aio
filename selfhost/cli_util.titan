// Utilidades de las CLI de Titan (titan.titan, wasm_cmd.titan): salida por
// stderr y lectura de variables de entorno.

// std::env::get devuelve nil si la variable no existe.
fn cl_env(name: string) -> string {
    let v = std::env::get(name)
    if v == nil {
        return ""
    }
    v
}

// Arquitectura de la máquina ("aarch64" o "x86_64") a partir de dos datos: la
// máquina del ejecutable que corre (e_machine del ELF: 183 = AArch64,
// 62 = x86-64; -1 si no se pudo leer) y la salida de `uname -m`. Un Termux de
// 32 bits sobre un núcleo de 64 bits (p. ej. un Redmi 9C) contesta `armv8l` o
// `armv7l` aunque los binarios aarch64 sí corren ahí: en ese caso manda el ELF
// del propio ejecutable ("si este binario corre, otro de su arquitectura
// corre también"). Sin ELF, los nombres armv* se toman por aarch64: no existe
// un Titan de 32 bits, así que quien ejecuta el compilador en ARM corre 64.
fn cl_arch_from(machine: int, uname_out: string) -> string {
    if machine == 183 {
        return "aarch64"
    }
    if machine == 62 {
        return "x86_64"
    }
    if std::text::starts_with(uname_out, "aarch64") || std::text::starts_with(uname_out, "arm64") {
        return "aarch64"
    }
    if std::text::starts_with(uname_out, "armv8") || std::text::starts_with(uname_out, "armv7") || std::text::starts_with(uname_out, "armv6") {
        return "aarch64"
    }
    "x86_64"
}

// stderr: no hay un nativo para escribir en el descriptor 2, así que se abre
// /dev/stderr; si no se pudiera abrir (p. ej. un socket) se usa stdout.
fn cl_write_fd(path: string, data: any) -> bool {
    let r = std::try::catch(|| {
        std::fs::append(path, data)
    })
    let mut ok = false
    match r {
        Result::Ok(v) => {
            ok = true
        },
        Result::Err(e) => {
            ok = false
        },
    }
    ok
}

fn cl_text(data: any) -> string {
    let r = std::try::catch(|| {
        std::encoding::utf8_decode(data)
    })
    let mut text = "<binary output>"
    match r {
        Result::Ok(v) => {
            text = v
        },
        Result::Err(e) => {
            text = "<binary output>"
        },
    }
    text
}

fn cl_eprint(text: string) {
    if !cl_write_fd("/dev/stderr", std::encoding::utf8_encode(text + "\n")) {
        print(text)
    }
}

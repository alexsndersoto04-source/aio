// Genera selfhost/native/unicode_debug.titan: los caracteres que el `{:?}`
// de Rust (el `Debug` de str, usado en mensajes de error como
// `invalid type: string "..."`) escribe como \u{...}.
//
// La VM está compilada con rustc 1.98.1 (commit 48a229cea, se ve en las rutas
// /rustc/<commit>/ del binario), que usa Unicode 17.0.0. La regla está en
// core/src/char/methods.rs (escape_debug_ext): se escapa si el carácter es de
// control, de uso privado, espacio en blanco (White_Space), Grapheme_Extend,
// Default_Ignorable_Code_Point, de formato (Cf) o no asignado. Las tablas de
// abajo están copiadas tal cual de core/src/unicode/unicode_data.rs de esa
// versión (formato "skiplist": SHORT_OFFSET_RUNS con inicio << 21 | suma, y
// OFFSETS), y skip_search es la misma búsqueda.
//
// Se regenera con:
//   zett run selfhost/native/gen_unicode_debug.titan > selfhost/native/unicode_debug.titan

fn skip_search(c: int, runs: array, offsets: array) -> bool {
    // binary_search_by_key(needle << 11, header << 11) sobre u32
    let key = (c * 2048) % 4294967296
    let mut lo = 0
    let mut hi = len(runs)
    let mut found = -1
    while lo < hi {
        let mid = (lo + hi) / 2
        let k = (runs[mid] * 2048) % 4294967296
        if k == key {
            found = mid
            break
        }
        if k < key {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    let mut last = lo
    if found >= 0 {
        last = found + 1
    }
    let mut offset_idx = runs[last] / 2097152
    let mut length = len(offsets) - offset_idx
    if last + 1 < len(runs) {
        length = runs[last + 1] / 2097152 - offset_idx
    }
    let mut prev = 0
    if last > 0 {
        prev = runs[last - 1] % 2097152
    }
    let total = c - prev
    let mut prefix_sum = 0
    let mut k = 0
    while k < length - 1 {
        prefix_sum += offsets[offset_idx]
        if prefix_sum > total {
            break
        }
        offset_idx += 1
        k += 1
    }
    offset_idx % 2 == 1
}

fn is_assigned(c: int, cn_runs: array, cn_off: array) -> bool {
    if c <= 887 {
        return true
    }
    if c <= 262141 {
        return !skip_search(c, cn_runs, cn_off)
    }
    if c == 917505 {
        return true
    }
    let a = c >= 917536 && c <= 917631
    let b = c >= 917760 && c <= 917999
    let d = c >= 983040 && c <= 1048573
    let e = c >= 1048576 && c <= 1114109
    a || b || d || e
}

fn is_white_space(c: int) -> bool {
    let a = c == 133 || c == 160 || c == 5760 || c == 8232 || c == 8233
    let b = c == 8239 || c == 8287 || c == 12288
    let d = c >= 8192 && c <= 8202
    a || b || d
}

fn escaped(c: int, t: array) -> bool {
    if c >= 32 && c <= 126 {
        return false
    }
    let control = c < 32 || (c >= 127 && c <= 159)
    let private = (c >= 57344 && c <= 63743) || (c >= 983040 && c <= 1048573) || (c >= 1048576 && c <= 1114109)
    if control || private || is_white_space(c) {
        return true
    }
    if c > 767 && skip_search(c, t[0], t[1]) {
        return true
    }
    if c > 172 && skip_search(c, t[2], t[3]) {
        return true
    }
    if c > 172 && skip_search(c, t[4], t[5]) {
        return true
    }
    !is_assigned(c, t[6], t[7])
}

fn main() {
    let t = [ge_runs(), ge_offsets(), di_runs(), di_offsets(), cf_runs(), cf_offsets(), cn_runs(), cn_offsets()]
    let mut out = []
    let mut start = -1
    let mut c = 127
    while c <= 1114112 {
        let surrogate = c >= 55296 && c <= 57343
        let mut yes = false
        if c < 1114112 && !surrogate {
            yes = escaped(c, t)
        }
        if yes && start < 0 {
            start = c
        }
        // Los sustitutos (D800-DFFF) no son caracteres: no cortan un rango.
        if !yes && start >= 0 && !surrogate {
            out = std::array::push(out, start)
            out = std::array::push(out, c - 1)
            start = -1
        }
        c += 1
    }
    let n = len(out) / 2
    print("// GENERADO por selfhost/native/gen_unicode_debug.titan a partir de las")
    print("// tablas de Unicode 17.0.0 de rustc 1.98.1. No editar a mano.")
    print("// Caracteres (desde U+007F) que el Debug de str de Rust escribe como \\u{...}.")
    print("")
    print("// {n} rangos [inicio, fin] (inclusive).")
    print("fn uni_debug_escape() -> string {")
    let mut line = "    return \""
    let mut i = 0
    for v in out {
        line += "{v},"
        i += 1
        if i % 16 == 0 {
            print(line + "\" +")
            line = "        \""
        }
    }
    print(line + "\"")
    print("}")
}


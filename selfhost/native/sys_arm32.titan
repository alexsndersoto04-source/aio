// Llamadas al sistema en ARM de 32 bits (ARMv7 / armeabi-v7a: teléfonos Android antiguos, Termux de 32 bits).
//
// El runtime está escrito con los números y estructuras de Linux x86-64 (std::raw::syscall). En ARM32,
// el backend LLVM convierte cada std::raw::syscall en una llamada a rt_sys_arm32, que la traduce a la
// llamada equivalente de la ABI ARM EABI (std::raw::svc = instrucción `svc #0`, número en r7):
//   - números distintos (read 0 -> 3, write 1 -> 4, ...; los números de ARM32 vienen de
//     arch/arm/tools/syscall.tbl de Linux y se comprobaron contra las cabeceras `unistd-eabi.h`);
//   - llamadas con desplazamientos de 64 bits (lseek -> _llseek, pread64/pwrite64/ftruncate -> pares de
//     registros con relleno, mmap -> mmap2 con el desplazamiento en páginas);
//   - estructuras con otra forma: `struct stat` (144 bytes en x86-64, `stat64` de 104 en ARM32), `struct
//     epoll_event` (12 empaquetados -> 16), `timespec` (16 -> 8: tiempo de 32 bits), `iovec` (16 -> 8),
//     `sigaction` (32 -> 20), `statfs` (x86-64 -> `statfs64`), vectores argv/envp (punteros de 8 -> 4);
//   - llamadas que ARM32 no tiene como tal (open -> openat, poll -> ppoll, ...).
// Se evitan a propósito las llamadas "time64" (clock_gettime64, ...): Android las bloquea con seccomp
// (SIGSYS) en kernels que no las conocen. La hora de 32 bits llega hasta 2038.
// Una llamada que no esté en la tabla devuelve -ENOSYS (-38): nunca se inventa un resultado.
// Reutiliza utilidades de sys_arm64.titan (sa_scratch, sa_get8, sa_put8, sa_open_flags).
// Solo se compila para ARM32. Prefijo `sb_`.

fn sb_s32(v: int) -> int {
    if v >= 2147483648 {
        return v - 4294967296
    }
    v
}

fn sb_lo(v: int) -> int {
    v & 4294967295
}

fn sb_hi(v: int) -> int {
    std::raw::shr(v, 32) & 4294967295
}

// timespec x86-64 (i64, i64) -> ARM32 (i32, i32), en `dst`.
fn sb_ts_in(src: int, dst: int) {
    sa_put8(dst, std::raw::load(src), 4)
    sa_put8(dst + 4, std::raw::load(src + 8), 4)
}

// timespec ARM32 en `src` -> x86-64 en `dst`.
fn sb_ts_out(src: int, dst: int) {
    std::raw::store(dst, sb_s32(sa_get8(src, 4)))
    std::raw::store(dst + 8, sa_get8(src + 4, 4))
}

// struct stat64 de ARM32 (en `s`) -> struct stat de x86-64 (en `out`, 144 bytes).
//   ARM32:  dev@0 mode@16 nlink@20 uid@24 gid@28 rdev@32 size@48 blksize@56 blocks@64
//           atime@72/76 mtime@80/84 ctime@88/92 ino@96 (segundos y nanosegundos de 32 bits)
//   x86-64: dev@0 ino@8 nlink@16 mode@24 uid@28 gid@32 rdev@40 size@48 blksize@56 blocks@64
//           atime@72/80 mtime@88/96 ctime@104/112 (de 64 bits)
fn sb_stat_fix(s: int, out: int, r: int) -> int {
    if r < 0 {
        return r
    }
    std::raw::store(out, std::raw::load(s))
    std::raw::store(out + 8, std::raw::load(s + 96))
    std::raw::store(out + 16, sa_get8(s + 20, 4))
    sa_put8(out + 24, sa_get8(s + 16, 4), 4)
    sa_put8(out + 28, sa_get8(s + 24, 4), 4)
    sa_put8(out + 32, sa_get8(s + 28, 4), 4)
    std::raw::store(out + 40, std::raw::load(s + 32))
    std::raw::store(out + 48, std::raw::load(s + 48))
    std::raw::store(out + 56, sa_get8(s + 56, 4))
    std::raw::store(out + 64, std::raw::load(s + 64))
    std::raw::store(out + 72, sb_s32(sa_get8(s + 72, 4)))
    std::raw::store(out + 80, sa_get8(s + 76, 4))
    std::raw::store(out + 88, sb_s32(sa_get8(s + 80, 4)))
    std::raw::store(out + 96, sa_get8(s + 84, 4))
    std::raw::store(out + 104, sb_s32(sa_get8(s + 88, 4)))
    std::raw::store(out + 112, sa_get8(s + 92, 4))
    std::raw::store(out + 120, 0)
    std::raw::store(out + 128, 0)
    std::raw::store(out + 136, 0)
    r
}

// statfs x86-64 <- statfs64 de ARM32:
//   ARM32:  type:u32@0 bsize:u32@4 blocks@8 bfree@16 bavail@24 files@32 ffree@40 fsid@48 namelen:u32@56
//           frsize:u32@60 flags:u32@64
//   x86-64: type@0 bsize@8 blocks@16 bfree@24 bavail@32 files@40 ffree@48 fsid@56 namelen@64 frsize@72 flags@80
fn sb_statfs(path: int, out: int) -> int {
    let s = sa_scratch()
    let r = std::raw::svc(266, path, 88, s, 0, 0, 0)
    if r < 0 {
        return r
    }
    std::raw::store(out, sa_get8(s, 4))
    std::raw::store(out + 8, sa_get8(s + 4, 4))
    std::raw::store(out + 16, std::raw::load(s + 8))
    std::raw::store(out + 24, std::raw::load(s + 16))
    std::raw::store(out + 32, std::raw::load(s + 24))
    std::raw::store(out + 40, std::raw::load(s + 32))
    std::raw::store(out + 48, std::raw::load(s + 40))
    std::raw::store(out + 56, std::raw::load(s + 48))
    std::raw::store(out + 64, sa_get8(s + 56, 4))
    std::raw::store(out + 72, sa_get8(s + 60, 4))
    std::raw::store(out + 80, sa_get8(s + 64, 4))
    std::raw::store(out + 88, 0)
    std::raw::store(out + 96, 0)
    std::raw::store(out + 104, 0)
    std::raw::store(out + 112, 0)
    r
}

// epoll_event x86-64 (u32 events @0, u64 data @4; 12 bytes) -> ARM32 (u32 @0, u64 @8; 16 bytes).
fn sb_epoll_ctl(ep: int, op: int, fd: int, ev: int) -> int {
    if ev == 0 {
        return std::raw::svc(251, ep, op, fd, 0, 0, 0)
    }
    let s = sa_scratch()
    std::raw::store(s, sa_get8(ev, 4))
    std::raw::store(s + 8, sa_get8(ev + 4, 8))
    std::raw::svc(251, ep, op, fd, s, 0, 0)
}

fn sb_epoll_wait(ep: int, evs: int, max: int, ms: int) -> int {
    let mut buf = sa_scratch()
    let own = max > 32
    if own {
        buf = rt_alloc(16 * max)
    }
    let r = std::raw::svc(252, ep, buf, max, ms, 0, 0)
    let mut i = 0
    while i < r {
        sa_put8(evs + 12 * i, sa_get8(buf + 16 * i, 4), 4)
        sa_put8(evs + 12 * i + 4, std::raw::load(buf + 16 * i + 8), 8)
        i += 1
    }
    if own {
        rt_free_block(buf)
    }
    r
}

// poll(fds, n, ms) = ppoll(fds, n, ms < 0 ? NULL : {ms/1000, resto en ns}) con timespec de 32 bits.
fn sb_poll(fds: int, n: int, ms: int) -> int {
    if ms < 0 {
        return std::raw::svc(336, fds, n, 0, 0, 8, 0)
    }
    let ts = sa_scratch()
    sa_put8(ts, ms / 1000, 4)
    sa_put8(ts + 4, (ms % 1000) * 1000000, 4)
    std::raw::svc(336, fds, n, ts, 0, 8, 0)
}

fn sb_ppoll(fds: int, n: int, tmo: int, mask: int, size: int) -> int {
    if tmo == 0 {
        return std::raw::svc(336, fds, n, 0, mask, size, 0)
    }
    let ts = sa_scratch()
    sb_ts_in(tmo, ts)
    std::raw::svc(336, fds, n, ts, mask, size, 0)
}

fn sb_nanosleep(req: int, rem: int) -> int {
    let s = sa_scratch()
    sb_ts_in(req, s)
    let r = std::raw::svc(162, s, s + 16, 0, 0, 0, 0)
    if r < 0 && rem != 0 {
        sb_ts_out(s + 16, rem)
    }
    r
}

fn sb_clock_gettime(clock: int, out: int) -> int {
    let s = sa_scratch()
    let r = std::raw::svc(263, clock, s, 0, 0, 0, 0)
    if r >= 0 {
        sb_ts_out(s, out)
    }
    r
}

fn sb_dup2(a: int, b: int) -> int {
    if a == b {
        // dup2 con dos iguales solo comprueba que `a` sea válido.
        let r = std::raw::svc(221, a, 1, 0, 0, 0, 0)
        if r < 0 {
            return r
        }
        return b
    }
    std::raw::svc(63, a, b, 0, 0, 0, 0)
}

// Vector de punteros de 8 bytes (argv/envp del runtime) -> vector de 4 bytes. 0 si `p` es 0.
fn sb_ptrs(p: int) -> int {
    if p == 0 {
        return 0
    }
    let mut n = 0
    while std::raw::load(p + 8 * n) != 0 {
        n += 1
    }
    let q = rt_alloc(4 * (n + 1))
    let mut i = 0
    while i < n {
        sa_put8(q + 4 * i, std::raw::load(p + 8 * i), 4)
        i += 1
    }
    sa_put8(q + 4 * n, 0, 4)
    q
}

fn sb_free_ptrs(q: int) {
    if q != 0 {
        rt_free_block(q)
    }
}

fn sb_execve(path: int, argv: int, envp: int) -> int {
    let a = sb_ptrs(argv)
    let e = sb_ptrs(envp)
    let r = std::raw::svc(11, path, a, e, 0, 0, 0)
    sb_free_ptrs(a)
    sb_free_ptrs(e)
    r
}

fn sb_execveat(dirfd: int, path: int, argv: int, envp: int, flags: int) -> int {
    let a = sb_ptrs(argv)
    let e = sb_ptrs(envp)
    let r = std::raw::svc(387, dirfd, path, a, e, flags, 0)
    sb_free_ptrs(a)
    sb_free_ptrs(e)
    r
}

// writev: iovec x86-64 (base 8, len 8) -> ARM32 (base 4, len 4).
fn sb_writev(fd: int, iov: int, n: int) -> int {
    if n < 0 || n > 1024 {
        return -22
    }
    let q = rt_alloc(8 * (n + 1))
    let mut i = 0
    while i < n {
        sa_put8(q + 8 * i, std::raw::load(iov + 16 * i), 4)
        sa_put8(q + 8 * i + 4, std::raw::load(iov + 16 * i + 8), 4)
        i += 1
    }
    let r = std::raw::svc(146, fd, q, n, 0, 0, 0)
    rt_free_block(q)
    r
}

// rt_sigaction: struct sigaction x86-64 (handler@0 flags@8 restorer@16 mask@24) <-> ARM32 (handler@0
// flags@4 restorer@8 mask@12). Sin SA_RESTORER (0x04000000): el kernel de ARM usa su propio retorno.
fn sb_sigaction(sig: int, act: int, old: int, size: int) -> int {
    let s = sa_scratch()
    let mut pa = 0
    let mut po = 0
    if act != 0 {
        sa_put8(s, std::raw::load(act), 4)
        sa_put8(s + 4, std::raw::load(act + 8) & (-1 - 67108864), 4)
        sa_put8(s + 8, 0, 4)
        std::raw::store(s + 12, std::raw::load(act + 24))
        pa = s
    }
    if old != 0 {
        po = s + 32
    }
    let r = std::raw::svc(174, sig, pa, po, size, 0, 0)
    if r >= 0 && old != 0 {
        std::raw::store(old, sa_get8(po, 4))
        std::raw::store(old + 8, sa_get8(po + 4, 4))
        std::raw::store(old + 16, 0)
        std::raw::store(old + 24, std::raw::load(po + 12))
    }
    r
}

// Números que solo cambian (mismos argumentos), x86-64 -> ARM32; -1 si no.
fn sb_same_args(n: int) -> int {
    if n == 0 { return 3 }
    if n == 1 { return 4 }
    if n == 3 { return 6 }
    if n == 10 { return 125 }
    if n == 11 { return 91 }
    if n == 14 { return 175 }
    if n == 16 { return 54 }
    if n == 28 { return 220 }
    if n == 32 { return 41 }
    if n == 39 { return 20 }
    if n == 41 { return 281 }
    if n == 42 { return 283 }
    if n == 44 { return 290 }
    if n == 45 { return 292 }
    if n == 48 { return 293 }
    if n == 49 { return 282 }
    if n == 50 { return 284 }
    if n == 51 { return 286 }
    if n == 53 { return 288 }
    if n == 54 { return 294 }
    if n == 55 { return 295 }
    if n == 57 { return 2 }
    if n == 60 { return 1 }
    if n == 62 { return 37 }
    if n == 63 { return 122 }
    if n == 72 { return 221 }
    if n == 73 { return 143 }
    if n == 74 { return 118 }
    if n == 79 { return 183 }
    if n == 80 { return 12 }
    if n == 91 { return 94 }
    if n == 102 { return 199 }
    if n == 110 { return 64 }
    if n == 157 { return 172 }
    if n == 204 { return 242 }
    if n == 217 { return 217 }
    if n == 231 { return 248 }
    if n == 254 { return 317 }
    if n == 288 { return 366 }
    if n == 289 { return 355 }
    if n == 291 { return 357 }
    if n == 293 { return 359 }
    if n == 294 { return 360 }
    if n == 318 { return 384 }
    if n == 436 { return 436 }
    -1
}

fn rt_sys_arm32(n: int, a: int, b: int, c: int, d: int, e: int, f: int) -> int {
    let same = sb_same_args(n)
    if same >= 0 {
        return std::raw::svc(same, a, b, c, d, e, f)
    }
    let at = -100
    if n == 2 {
        // open = openat(AT_FDCWD, ...) con O_LARGEFILE (0x20000) para archivos de más de 2 GiB
        return std::raw::svc(322, at, a, sa_open_flags(b) | 131072, c, 0, 0)
    }
    if n == 4 {
        let s = sa_scratch()
        return sb_stat_fix(s, b, std::raw::svc(195, a, s, 0, 0, 0, 0))
    }
    if n == 5 {
        let s = sa_scratch()
        return sb_stat_fix(s, b, std::raw::svc(197, a, s, 0, 0, 0, 0))
    }
    if n == 6 {
        let s = sa_scratch()
        return sb_stat_fix(s, b, std::raw::svc(196, a, s, 0, 0, 0, 0))
    }
    if n == 262 {
        let s = sa_scratch()
        return sb_stat_fix(s, c, std::raw::svc(327, a, b, s, d, 0, 0))
    }
    if n == 137 {
        return sb_statfs(a, b)
    }
    if n == 7 {
        return sb_poll(a, b, c)
    }
    if n == 271 {
        return sb_ppoll(a, b, c, d, e)
    }
    if n == 8 {
        // lseek -> _llseek(fd, hi, lo, &resultado, whence)
        let s = sa_scratch()
        let r = std::raw::svc(140, a, sb_hi(b), sb_lo(b), s, c, 0)
        if r < 0 {
            return r
        }
        return std::raw::load(s)
    }
    if n == 9 {
        // mmap -> mmap2: el desplazamiento va en páginas de 4096 bytes
        if (f & 4095) != 0 {
            return -22
        }
        return std::raw::svc(192, a, b, c, d, e, f / 4096)
    }
    if n == 13 {
        return sb_sigaction(a, b, c, d)
    }
    if n == 17 {
        return std::raw::svc(180, a, b, c, 0, sb_lo(d), sb_hi(d))
    }
    if n == 18 {
        return std::raw::svc(181, a, b, c, 0, sb_lo(d), sb_hi(d))
    }
    if n == 77 {
        return std::raw::svc(194, a, 0, sb_lo(b), sb_hi(b), 0, 0)
    }
    if n == 20 {
        return sb_writev(a, b, c)
    }
    if n == 33 {
        return sb_dup2(a, b)
    }
    if n == 35 {
        return sb_nanosleep(a, b)
    }
    if n == 228 {
        return sb_clock_gettime(a, b)
    }
    if n == 59 {
        return sb_execve(a, b, c)
    }
    if n == 322 {
        return sb_execveat(a, b, c, d, e)
    }
    if n == 61 {
        // wait4: sin estructura rusage (su forma difiere en ARM32)
        return std::raw::svc(114, a, b, c, 0, 0, 0)
    }
    if n == 82 {
        return std::raw::svc(329, at, a, at, b, 0, 0)
    }
    if n == 83 {
        return std::raw::svc(323, at, a, b, 0, 0, 0)
    }
    if n == 87 {
        return std::raw::svc(328, at, a, 0, 0, 0, 0)
    }
    if n == 89 {
        return std::raw::svc(332, at, a, b, c, 0, 0)
    }
    if n == 232 {
        return sb_epoll_wait(a, b, c, d)
    }
    if n == 233 {
        return sb_epoll_ctl(a, b, c, d)
    }
    -38
}

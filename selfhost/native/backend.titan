    if k == "Index" {
        return bk_index(p, ctx)
    }
    if k == "GetField" {
        return bk_get_field(p, ctx, op.s)
    }
    if k == "NewStruct" {
        let fields = op.list
        let count = len(fields)
        let sorted = bk_sort_strings(fields)
        p = bk_push_str(p, op.s)
        p = pc_ref(p, x_mov_ri64(x_rax(), 0), 2, "schema", bk_join(sorted, "\n"), count)
        p = pc_add(p, x_push(x_rax()))
        p = pc_add(p, x_push_i(1))
        p = bk_push_int(p, count)
        p = pc_ref(p, x_call(0), 1, "rel", bk_rt(ctx, "rt_struct_new"), 0)
        p = pc_add(p, x_add_ri(rsp, 48))
        let mut j = 0
        while j < count {
            let src = 16 * (count - 1 - j)
            let dst = 32 + 16 * bk_index_of(sorted, fields[j])
            p = pc_add(p, x_load(x_r8(), rsp, src))
            p = pc_add(p, x_store(x_rdx(), dst, x_r8()))
            p = pc_add(p, x_load(x_r8(), rsp, src + 8))
            p = pc_add(p, x_store(x_rdx(), dst + 8, x_r8()))
            j += 1
        }
        if count > 0 {
            p = pc_add(p, x_add_ri(rsp, 16 * count))
        }
        return pc_add(pc_add(p, x_push(x_rdx())), x_push(x_rax()))
    }
    if k == "NewEnum" {
        if op.flag {
            p = bk_push_str(p, op.s)
            p = bk_push_str(p, op.s2)
            return bk_call_rt(p, ctx, "rt_enum_new", 3)
        }
        p = pc_ref(p, x_mov_ri64(x_rax(), 0), 2, "unit", op.s + "\n" + op.s2, 0)
        return pc_add(pc_add(p, x_push(x_rax())), x_push_i(11))
    }
    if k == "EnumIs" {
        p = bk_push_str(p, op.s)
        p = bk_push_str(p, op.s2)
        return bk_call_rt(p, ctx, "rt_enum_is", 3)
    }
    if k == "EnumPayload" {
        return bk_call_rt(p, ctx, "rt_enum_payload", 1)
    }
    if k == "Try" {
        p = pc_add(pc_add(p, x_push_m(rsp, 8)), x_push_m(rsp, 8))
        p = bk_inc_at(p, rsp, 0)
        p = pc_ref(p, x_call(0), 1, "rel", bk_rt(ctx, "rt_try_kind"), 0)
        p = pc_add(p, x_add_ri(rsp, 16))
        p = pc_add(p, x_test_rr(x_rdx(), x_rdx()))
        p = pc_jl(p, x_jcc(x_cc_e(), 0), "unwrap")
        p = bk_leave(p, ctx)
        p = pc_label(p, "unwrap")
        p = pc_add(p, x_load(x_rcx(), rsp, 8))
        p = pc_add(p, x_load(x_rax(), x_rcx(), 32))
        p = pc_add(p, x_load(x_rdx(), x_rcx(), 40))
        p = pc_add(p, x_store(rsp, 0, x_rax()))
        p = pc_add(p, x_store(rsp, 8, x_rdx()))
        // El contenido gana una referencia y el enum pierde la suya.
        p = pc_add(p, x_mov_rr(x_rdi(), x_rax()))
        p = pc_add(p, x_mov_rr(x_rsi(), x_rdx()))
        p = pc_ref(p, x_call(0), 1, "rel", "g_inc", 0)
        p = pc_add(p, x_mov_ri(x_rdi(), 11))
        p = pc_add(p, x_mov_rr(x_rsi(), x_rcx()))
        return pc_ref(p, x_call(0), 1, "rel", "g_dec", 0)
    }
    if k == "MakeClosure" {
        let f = ctx.funcs[n]
        let caps = op.list
        p = pc_ref(p, x_mov_ri64(x_rax(), 0), 2, "abs", ctx.prefix + "{n}", 0)
        p = pc_add(pc_add(p, x_push(x_rax())), x_push_i(1))
        p = bk_push_int(p, len(caps))
        p = bk_push_int(p, f.arity)
        p = bk_push_int(p, n)
        p = bk_push_str(p, f.name)
        p = pc_ref(p, x_call(0), 1, "rel", bk_rt(ctx, "rt_closure_new"), 0)
        p = pc_add(p, x_add_ri(rsp, 80))
        let mut i = 0
        for slot in caps {
            p = pc_add(p, x_load(x_r8(), rbp, bk_lt(slot)))
            p = pc_add(p, x_store(x_rdx(), 48 + 16 * i, x_r8()))
            p = pc_add(p, x_load(x_r8(), rbp, bk_lp(slot)))
            p = pc_add(p, x_store(x_rdx(), 56 + 16 * i, x_r8()))
            p = bk_inc_at(p, rbp, bk_lt(slot))
            i += 1
        }
        return pc_add(pc_add(p, x_push(x_rdx())), x_push(x_rax()))
    }
    if k == "CallValue" {
        let off = 16 * n
        p = pc_add(p, x_load(x_rax(), rsp, off))
        p = pc_add(p, x_cmp_ri(x_rax(), 12))
        p = pc_jl(p, x_jcc(x_cc_ne(), 0), "err")
        p = pc_add(p, x_load(x_r12(), rsp, off + 8))
        p = pc_add(p, x_cmp_mi(x_r12(), 24, n))
        p = pc_jl(p, x_jcc(x_cc_ne(), 0), "err")
        p = pc_add(p, x_load(x_rax(), x_r12(), 8))
        p = pc_add(p, x_call_r(x_rax()))
        if n > 0 {
            p = pc_add(p, x_add_ri(rsp, 16 * n))
        }
        p = pc_add(pc_add(p, x_pop(x_rdi())), x_pop(x_rsi()))
        p = pc_add(pc_add(p, x_push(x_rdx())), x_push(x_rax()))
        p = pc_ref(p, x_call(0), 1, "rel", "g_dec", 0)
        p = pc_jl(p, x_jmp(0), "done")
        p = pc_label(p, "err")
        p = pc_add(pc_add(p, x_push_m(rsp, off + 8)), x_push_m(rsp, off + 8))
        p = bk_push_int(p, n)
        p = bk_call_rt(p, ctx, "rt_call_error", 2)
        return pc_label(p, "done")
    }
    if k == "CallMethod" {
        return bk_call_method(p, ctx, op.s, n)
    }
    if k == "TryCall" {
        // std::try::catch(f, args...): como la VM, un error dentro de la
        // llamada se devuelve como Result::Err(mensaje) y el éxito como
        // Result::Ok(valor). Antes de llamar se deja un registro de 32 bytes
        // justo encima del cierre: [manejador anterior][rbp][profundidad]
        // [dirección de reanudación], y [r15+24] apunta a él; rt_fatal salta
        // ahí (std::raw::throw) con el mensaje en rax/rdx.
        let off = 16 * n
        let rax = x_rax()
        let rcx = x_rcx()
        let r15 = x_r15()
        p = pc_add(p, x_load(rax, rsp, off))
        p = pc_add(p, x_cmp_ri(rax, 12))
        p = pc_jl(p, x_jcc(x_cc_ne(), 0), "noclo")
        p = pc_add(p, x_sub_ri(rsp, 32))
        let mut w = 0
        while w < 2 * (n + 1) {
            p = pc_add(p, x_load(rax, rsp, 32 + 8 * w))
            p = pc_add(p, x_store(rsp, 8 * w, rax))
            w += 1
        }
        p = pc_add(p, x_lea(rcx, rsp, off + 16))
        p = pc_add(p, x_load(rax, r15, 24))
        p = pc_add(p, x_store(rcx, 0, rax))
        p = pc_add(p, x_store(rcx, 8, x_rbp()))
        p = pc_add(p, x_load(rax, r15, 16))
        p = pc_add(p, x_store(rcx, 16, rax))
        p = pc_jl(p, [72, 141, 5, 0, 0, 0, 0], "resume")
        p = pc_add(p, x_store(rcx, 24, rax))
        p = pc_add(p, x_store(r15, 24, rcx))
        p = pc_add(p, x_load(x_r12(), rsp, off + 8))
        p = pc_add(p, x_cmp_mi(x_r12(), 24, n))
        p = pc_jl(p, x_jcc(x_cc_ne(), 0), "err")
        p = pc_add(p, x_load(rax, x_r12(), 8))
        p = pc_add(p, x_call_r(rax))
        if n > 0 {
            p = pc_add(p, x_add_ri(rsp, off))
        }
        p = pc_add(pc_add(p, x_pop(x_rdi())), x_pop(x_rsi()))
        p = pc_add(p, x_load(rcx, rsp, 0))
        p = pc_add(p, x_store(r15, 24, rcx))
        p = pc_add(p, x_add_ri(rsp, 32))
        p = pc_add(pc_add(p, x_push(x_rdx())), x_push(rax))
        p = pc_ref(p, x_call(0), 1, "rel", "g_dec", 0)
        p = bk_call_rt(p, ctx, "rt_try_ok", 1)
        p = pc_jl(p, x_jmp(0), "done")
        // Aridad distinta: el error pasa por rt_fatal con el registro puesto,
        // así que termina en "resume" como cualquier otro.
        p = pc_label(p, "err")
        p = pc_add(pc_add(p, x_push_m(rsp, off + 8)), x_push_m(rsp, off + 8))
        p = bk_push_int(p, n)
        p = bk_call_rt(p, ctx, "rt_call_error", 2)
        p = pc_add(p, x_ud2())
        // Reanudación: rsp = registro, rbp y profundidad ya restaurados.
        p = pc_label(p, "resume")
        p = pc_add(p, x_load(rcx, rsp, 0))
        p = pc_add(p, x_store(r15, 24, rcx))
        p = pc_add(p, x_add_ri(rsp, 32))
        p = pc_add(pc_add(p, x_push(x_rdx())), x_push(rax))
        p = bk_call_rt(p, ctx, "rt_try_err", 1)
        p = pc_jl(p, x_jmp(0), "done")
        p = pc_label(p, "noclo")
        w = 0
        while w <= n {
            p = bk_dec_at(p, rsp, 0)
            p = pc_add(p, x_add_ri(rsp, 16))
            w += 1
        }
        p = bk_push_str(p, "std::try::catch expected a closure")
        p = bk_call_rt(p, ctx, "rt_try_err", 1)
        return pc_label(p, "done")
    }
    pc_error(p, "instruction " + k + " is not supported by the native backend yet")
}

// Implementaciones por struct de `method`: (nombre del struct, índice de la función).
fn bk_method_candidates(ctx: Ctx, method: string) -> array {
    let suffix = "::" + method
    let mut out = []
    for key in bk_sort_strings(std::map::keys(ctx.methods)) {
        if std::text::ends_with(key, suffix) {
            let owner = std::text::substring(key, 0, len(key) - len(suffix))
            out = std::array::push(out, (owner, std::map::get(ctx.methods, key)))
        }
    }
    out
}

// Función del runtime que implementa el método de colección `method` con `argc`
// argumentos (sin contar el receptor), o "" si no existe.
fn bk_collection_method(method: string, argc: int) -> string {
    if argc == 0 && method == "len" {
        return "rt_len"
    }
    if argc == 1 {
        if method == "map" {
            return "rt_m_map"
        }
        if method == "filter" {
            return "rt_m_filter"
        }
        if method == "find" {
            return "rt_m_find"
        }
        if method == "any" {
            return "rt_m_any"
        }
        if method == "all" {
            return "rt_m_all"
        }
        if method == "sort_by" {
            return "rt_sort_by"
        }
    }
    if argc == 2 && method == "fold" {
        return "rt_m_fold"
    }
    ""
}

// recv.method(args): la pila trae [receptor, arg1..argN]. Un struct usa la
// implementación registrada como "<Struct>::<método>" (se compara su nombre, que
// es un string estático único, con cada candidato conocido en tiempo de
// compilación; se llama igual que a una función normal, con el receptor como primer
// argumento). Cualquier otro valor usa la operación de colección del mismo nombre
// y aridad si existe. Si no, error como el de la VM.
fn bk_call_method(p0: Pc, ctx: Ctx, method: string, n: int) -> Pc {
    let rsp = x_rsp()
    let rax = x_rax()
    let rcx = x_rcx()
    let off = 16 * n
    let mut p = pc_add(p0, x_cmp_mi(rsp, off, 10))
    p = pc_jl(p, x_jcc(x_cc_ne(), 0), "builtin")
    let cands = bk_method_candidates(ctx, method)
    if len(cands) > 0 {
        p = pc_add(p, x_load(rcx, rsp, off + 8))
        p = pc_add(p, x_load(rcx, rcx, 8))
        let mut i = 0
        for c in cands {
            let (owner, index) = c
            p = pc_ref(p, x_mov_ri64(rax, 0), 2, "str", owner, 0)
            p = pc_add(p, x_cmp_rr(rax, rcx))
            p = pc_jl(p, x_jcc(x_cc_ne(), 0), "next{i}")
            let target = ctx.funcs[index]
            if target.arity != n + 1 {
                // Como la VM: la aridad se comprueba al entrar en la función.
                p = bk_push_str(p, target.name)
                p = bk_push_int(p, target.arity)
                p = bk_push_int(p, n + 1)
                p = bk_call_rt(p, ctx, "rt_arity_error", 3)
                p = pc_add(p, x_ud2())
            } else {
                p = pc_ref(p, x_call(0), 1, "rel", ctx.prefix + "{index}", 0)
                p = pc_add(p, x_add_ri(rsp, 16 * (n + 1)))
                p = pc_add(pc_add(p, x_push(x_rdx())), x_push(x_rax()))
                p = pc_jl(p, x_jmp(0), "done")
            }
            p = pc_label(p, "next{i}")
            i += 1
        }
    }
    p = pc_label(p, "err")
    p = pc_add(pc_add(p, x_push_m(rsp, off + 8)), x_push_m(rsp, off + 8))
    p = bk_push_str(p, method)
    p = bk_call_rt(p, ctx, "rt_method_error", 2)
    p = pc_add(p, x_ud2())
    p = pc_label(p, "builtin")
    let target = bk_collection_method(method, n)
    if target == "" {
        p = pc_jl(p, x_jmp(0), "err")
    } else {
        p = bk_call_rt(p, ctx, target, n + 1)
    }
    pc_label(p, "done")
}

// ------------------------------------------------------------ funciones

fn bk_prologue(ctx: Ctx, f: Func) -> Pc {
    let mut p = pc_new()
    let rbp = x_rbp()
    p = pc_add(p, x_push(rbp))
    p = pc_add(p, x_mov_rr(rbp, x_rsp()))
    if ctx.locals > 0 {
        p = pc_add(p, x_sub_ri(x_rsp(), 16 * ctx.locals))
    }
    if !ctx.runtime {
        p = pc_add(p, x_load(x_rax(), x_r15(), 16))
        p = pc_add(p, x_cmp_ri(x_rax(), 4096))
        p = pc_ref(p, x_jcc(x_cc_ge(), 0), 2, "rel", "g_depth", 0)
        p = pc_add(p, x_add_ri(x_rax(), 1))
        p = pc_add(p, x_store(x_r15(), 16, x_rax()))
    }
    let c = f.captures
    let a = f.arity
    let mut i = c + a
    while i < ctx.locals {
        p = pc_add(p, x_store_i(rbp, bk_lt(i), 0))
        p = pc_add(p, x_store_i(rbp, bk_lp(i), 0))
        i += 1
    }
    i = 0
    while i < c {
        p = pc_add(p, x_load(x_rax(), x_r12(), 48 + 16 * i))
        p = pc_add(p, x_store(rbp, bk_lt(i), x_rax()))
        p = pc_add(p, x_load(x_rax(), x_r12(), 56 + 16 * i))
        p = pc_add(p, x_store(rbp, bk_lp(i), x_rax()))
        p = bk_inc_at(p, rbp, bk_lt(i))
        i += 1
    }
    i = 0
    while i < a {
        let src = 16 + 16 * (a - 1 - i)
        p = pc_add(p, x_load(x_rax(), rbp, src))
        p = pc_add(p, x_store(rbp, bk_lt(c + i), x_rax()))
        p = pc_add(p, x_load(x_rax(), rbp, src + 8))
        p = pc_add(p, x_store(rbp, bk_lp(c + i), x_rax()))
        i += 1
    }
    pc_finish(p)
}

// Gancho del depurador antes de la instrucción `pc`: rt_dbg_hook(función, instrucción, rbp,
// rsp, tabla). La pila de operandos es la pila de la máquina y los locales están en el marco,
// así que el gancho lee el estado exacto de la VM con (rbp, rsp). No deja nada apilado.
fn bk_debug_hook(ctx: Ctx, pc: int) -> Pc {
    let mut p = pc_add(pc_new(), x_mov_rr(x_rax(), x_rsp()))
    p = bk_push_int(p, ctx.fid)
    p = bk_push_int(p, pc)
    p = pc_add(p, x_push(x_rbp()))
    p = pc_add(p, x_push_i(1))
    p = pc_add(p, x_push(x_rax()))
    p = pc_add(p, x_push_i(1))
    p = bk_push_str(p, ctx.dbg)
    p = pc_ref(p, x_call(0), 1, "rel", bk_rt(ctx, "rt_dbg_hook"), 0)
    pc_add(p, x_add_ri(x_rsp(), 16 * 5))
}

// Compila una función: Pc con referencias globales relativas a su inicio.
fn bk_function(ctx0: Ctx, f: Func, fid: int) -> Pc {
    let mut locals = f.locals
    if f.arity + f.captures > locals {
        locals = f.arity + f.captures
    }
    let ctx = Ctx { prefix: ctx0.prefix, runtime: ctx0.runtime, locals: locals, funcs: ctx0.funcs, table: ctx0.table, rt: ctx0.rt, rt_arity: ctx0.rt_arity, methods: ctx0.methods, epi: len(f.code) + 1, dbg: ctx0.dbg, fid: fid }
    let head = bk_prologue(ctx, f)
    let mut code = head.b
    let mut fx = head.fx
    let mut offs = []
    let mut pc = 0
    for op in f.code {
        offs = std::array::push(offs, len(code))
        if ctx.dbg != "" {
            let hook = pc_finish(bk_debug_hook(ctx, pc))
            let hbase = len(code)
            for r in hook.fx {
                fx = std::array::push(fx, Fx { off: r.off + hbase, kind: r.kind, target: r.target, n: r.n })
            }
            code = std::array::concat(code, hook.b)
        }
        let piece = pc_finish(bk_op(ctx, op, pc))
        let base = len(code)
        for r in piece.fx {
            fx = std::array::push(fx, Fx { off: r.off + base, kind: r.kind, target: r.target, n: r.n })
        }
        code = std::array::concat(code, piece.b)
        pc += 1
    }
    // Salir por el final devuelve la cima o nil, como la VM.
    offs = std::array::push(offs, len(code))
    let tail = pc_finish(bk_ret(pc_new(), ctx, ""))
    let tail_base = len(code)
    for r in tail.fx {
        fx = std::array::push(fx, Fx { off: r.off + tail_base, kind: r.kind, target: r.target, n: r.n })
    }
    code = std::array::concat(code, tail.b)
    offs = std::array::push(offs, len(code))
    let epi = pc_finish(bk_epilogue(ctx))
    let epi_base = len(code)
    for r in epi.fx {
        fx = std::array::push(fx, Fx { off: r.off + epi_base, kind: r.kind, target: r.target, n: r.n })
    }
    code = std::array::concat(code, epi.b)
    let mut rest = []
    for r in fx {
        if r.kind == "jmp" {
            let rel = x_i32(offs[r.n] - (r.off + 4))
            let mut i = 0
            while i < 4 {
                code = std::array::set(code, r.off + i, rel[i])
                i += 1
            }
        } else {
            rest = std::array::push(rest, r)
        }
    }
    Pc { b: code, fx: rest, lab: std::map::new() }
}

// ------------------------------------------------------------ enlazado

fn bk_glue(ctx: Ctx, entry: string, dbg: string) -> array {
    let rax = x_rax()
    let rsp = x_rsp()
    let mut pieces = []
    // g_raise: rax = string con el mensaje del error.
    let mut p = pc_label(pc_new(), "g_raise")
    p = pc_add(p, x_push(rax))
    p = pc_add(p, x_push_i(5))
    let mut fatal = "rt_fatal"
    if dbg != "" {
        fatal = "rt_dbg_fatal"
    }
    p = pc_ref(p, x_call(0), 1, "rel", bk_rt(ctx, fatal), 0)
    p = pc_add(p, x_ud2())
    pieces = std::array::push(pieces, p)
    for pair in [("g_overflow", "integer overflow"), ("g_divzero", "division by zero"), ("g_depth", "call depth limit exceeded")] {
        let (label, message) = pair
        let mut q = pc_label(pc_new(), label)
        q = pc_ref(q, x_mov_ri64(rax, 0), 2, "str", message, 0)
        q = pc_ref(q, x_jmp(0), 1, "rel", "g_raise", 0)
        pieces = std::array::push(pieces, q)
    }
    // g_inc (rdi = etiqueta, rsi = contenido): suma una referencia si es un
    // objeto contado (etiqueta >= 5 y cuenta > 0; -1 = inmortal). Solo usa r11.
    let rdi = x_rdi()
    let rsi = x_rsi()
    let r11 = x_r11()
    let mut gi = pc_label(pc_new(), "g_inc")
    gi = pc_add(gi, x_cmp_ri(rdi, 5))
    gi = pc_jl(gi, x_jcc(x_cc_l(), 0), "out")
    gi = pc_add(gi, x_load(r11, rsi, 0))
    gi = pc_add(gi, x_cmp_ri(r11, 1))
    gi = pc_jl(gi, x_jcc(x_cc_l(), 0), "out")
    gi = pc_add(gi, x_add_ri(r11, 1))
    gi = pc_add(gi, x_store(rsi, 0, r11))
    gi = pc_label(gi, "out")
    gi = pc_add(gi, x_ret())
    pieces = std::array::push(pieces, gi)
    // g_dec (rdi, rsi): resta una referencia; si llega a 0 llama a
    // rt_free(etiqueta, dirección). Conserva rax, rcx, rdx, rsi, rdi y r8.
    let mut gd = pc_label(pc_new(), "g_dec")
    gd = pc_add(gd, x_cmp_ri(rdi, 5))
    gd = pc_jl(gd, x_jcc(x_cc_l(), 0), "out")
    gd = pc_add(gd, x_load(r11, rsi, 0))
    gd = pc_add(gd, x_cmp_ri(r11, 1))
    gd = pc_jl(gd, x_jcc(x_cc_l(), 0), "out")
    gd = pc_jl(gd, x_jcc(x_cc_e(), 0), "free")
    gd = pc_add(gd, x_sub_ri(r11, 1))
    gd = pc_add(gd, x_store(rsi, 0, r11))
    gd = pc_add(gd, x_ret())
    gd = pc_label(gd, "free")
    gd = pc_add(gd, x_store_i(rsi, 0, 0))
    for r in [rax, x_rdx(), x_rcx(), x_r8(), rdi, rsi] {
        gd = pc_add(gd, x_push(r))
    }
    gd = pc_add(gd, x_push(rdi))
    gd = pc_add(gd, x_push_i(1))
    gd = pc_add(gd, x_push(rsi))
    gd = pc_add(gd, x_push_i(1))
    gd = pc_ref(gd, x_call(0), 1, "rel", bk_rt(ctx, "rt_free"), 0)
    gd = pc_add(gd, x_add_ri(rsp, 32))
    for r in [rsi, rdi, x_r8(), x_rcx(), x_rdx(), rax] {
        gd = pc_add(gd, x_pop(r))
    }
    gd = pc_label(gd, "out")
    gd = pc_add(gd, x_ret())
    pieces = std::array::push(pieces, gd)
    // g_drop (r8 = primer hueco, rcx = cuántos): g_dec de cada variable
    // local al salir de una función. Conserva rax y rdx (el resultado).
    let mut gp = pc_label(pc_new(), "g_drop")
    gp = pc_add(gp, x_test_rr(x_rcx(), x_rcx()))
    gp = pc_jl(gp, x_jcc(x_cc_e(), 0), "out")
    gp = pc_label(gp, "loop")
    gp = pc_add(gp, x_load(rdi, x_r8(), 0))
    gp = pc_add(gp, x_cmp_ri(rdi, 5))
    gp = pc_jl(gp, x_jcc(x_cc_l(), 0), "next")
    gp = pc_add(gp, x_load(rsi, x_r8(), 8))
    gp = pc_ref(gp, x_call(0), 1, "rel", "g_dec", 0)
    gp = pc_label(gp, "next")
    gp = pc_add(gp, x_add_ri(x_r8(), 16))
    gp = pc_add(gp, x_sub_ri(x_rcx(), 1))
    gp = pc_jl(gp, x_jcc(x_cc_ne(), 0), "loop")
    gp = pc_label(gp, "out")
    gp = pc_add(gp, x_ret())
    pieces = std::array::push(pieces, gp)
    // g_switch (rdi = dónde guardar rsp, rsi = rsp nuevo): cambio de contexto
    // entre fibras (tareas). Deja rbp y la dirección de retorno en la pila que
    // abandona y continúa en la que entra (pop rbp; ret). r15 es común.
    let mut sw = pc_label(pc_new(), "g_switch")
    sw = pc_add(sw, x_push(x_rbp()))
    sw = pc_add(sw, x_store(rdi, 0, rsp))
    sw = pc_add(sw, x_mov_rr(rsp, rsi))
    sw = pc_add(sw, x_pop(x_rbp()))
    sw = pc_add(sw, x_ret())
    pieces = std::array::push(pieces, sw)
    // g_start: globales, pila propia de 1 GiB (reservada, no ocupada) y main.
    let size = 1073741824
    let mut s = pc_label(pc_new(), "g_start")
    s = pc_ref(s, x_mov_ri64(x_r15(), 0), 2, "glob", "", 0)
    s = pc_add(s, x_store(x_r15(), 32, rsp))
    s = pc_add(s, x_mov_ri(rax, 9))
    s = pc_add(s, x_mov_ri(x_rdi(), 0))
    s = pc_add(s, x_mov_ri(x_rsi(), size))
    s = pc_add(s, x_mov_ri(x_rdx(), 3))
    s = pc_add(s, x_mov_ri(x_r10(), 16418))
    s = pc_add(s, x_mov_ri(x_r8(), -1))
    s = pc_add(s, x_mov_ri(x_r9(), 0))
    s = pc_add(s, x_syscall())
    s = pc_add(s, x_lea(rsp, rax, size))
    if dbg != "" {
        // Depurador: rt_dbg_init(tabla) antes de entrar en main.
        s = bk_push_str(s, dbg)
        s = pc_ref(s, x_call(0), 1, "rel", bk_rt(ctx, "rt_dbg_init"), 0)
        s = pc_add(s, x_add_ri(rsp, 16))
    }
    s = pc_ref(s, x_call(0), 1, "rel", entry, 0)
    s = pc_add(s, x_push(x_rdx()))
    s = pc_add(s, x_push(rax))
    let mut finish = "rt_finish"
    if dbg != "" {
        finish = "rt_dbg_finish"
    }
    s = pc_ref(s, x_call(0), 1, "rel", bk_rt(ctx, finish), 0)
    s = pc_add(s, x_ud2())
    pieces = std::array::push(pieces, s)
    pieces
}

// "a\nb" -> ["a", "b"]
fn bk_split_lines(s: string) -> array {
    let mut out = []
    let mut cur = ""
    for c in s {
        if c == '\n' {
            out = std::array::push(out, cur)
            cur = ""
        } else {
            cur += c
        }
    }
    std::array::push(out, cur)
}

fn bk_utf8(s: string) -> array {
    std::bytes::to_array(std::encoding::utf8_encode(s))
}

fn bk_align(v: int, a: int) -> int {
    return ((v + a - 1) / a) * a
}

// Índices de las funciones del runtime por nombre, y sus aridades.
fn bk_rt_tables(gr: G) -> (map, map) {
    let mut names = std::map::new()
    let mut arity = std::map::new()
    let mut i = 0
    for f in gr.funcs {
        names = std::map::insert(names, f.name, i)
        arity = std::map::insert(arity, f.name, f.arity)
        i += 1
    }
    return (names, arity)
}

// Programa (gu) + runtime (gr) -> Result::Ok(bytes del ELF) o Err(mensajes).
// "r" seguido solo de cifras: etiqueta de una función del runtime.
fn bk_is_rt_label(t: string) -> bool {
    if len(t) < 2 || !std::text::starts_with(t, "r") {
        return false
    }
    for c in std::text::chars(std::text::substring(t, 1, len(t))) {
        if c < '0' || c > '9' {
            return false
        }
    }
    true
}

fn bk_label_index(t: string) -> int {
    match std::text::parse_int(std::text::substring(t, 1, len(t))) {
        Option::Some(v) => v,
        Option::None => -1,
    }
}

fn bk_build(gu: G, gr: G) -> Result {
    bk_build_with(gu, gr, "")
}

// `dbg` no vacío = ejecutable de depuración: antes de cada instrucción de las funciones del
// usuario se llama a `rt_dbg_hook` (native/std_debug.titan); `dbg` es la tabla de funciones y
// posiciones que ese gancho lee (ver `dbg_table` en selfhost/debug_table.titan).
fn bk_build_with(gu: G, gr: G, dbg: string) -> Result {
    let (rt, rt_arity) = bk_rt_tables(gr)
    let uctx = Ctx { prefix: "u", runtime: false, locals: 0, funcs: gu.funcs, table: gu.table, rt: rt, rt_arity: rt_arity, methods: gu.methods, epi: 0, dbg: dbg, fid: 0 }
    let rctx = Ctx { prefix: "r", runtime: true, locals: 0, funcs: gr.funcs, table: gr.table, rt: rt, rt_arity: rt_arity, methods: std::map::new(), epi: 0, dbg: "", fid: 0 }
    let mut code = []
    let mut fx = []
    let mut labels = std::map::new()
    let mut units = []
    // Mapa de símbolos (posición en el código y nombre de cada función),
    // para perfiles y depuración.
    let mut syms = []
    let entry_index = gu.entry
    for piece in bk_glue(rctx, "u{entry_index}", dbg) {
        let base = len(code)
        for name in std::map::keys(piece.lab) {
            labels = std::map::insert(labels, name, base + std::map::get(piece.lab, name))
            if std::text::starts_with(name, "g_") {
                syms = std::array::push(syms, (base + std::map::get(piece.lab, name), "glue:" + name))
            }
        }
        let done = pc_finish(piece)
        for r in done.fx {
            fx = std::array::push(fx, Fx { off: r.off + base, kind: r.kind, target: r.target, n: r.n })
        }
        code = std::array::concat(code, done.b)
    }
    let mut i = 0
    for f in gu.funcs {
        labels = std::map::insert(labels, "u{i}", len(code))
        syms = std::array::push(syms, (len(code), f.name))
        let piece = bk_function(uctx, f, i)
        let base = len(code)
        for r in piece.fx {
            fx = std::array::push(fx, Fx { off: r.off + base, kind: r.kind, target: r.target, n: r.n })
        }
        code = std::array::concat(code, piece.b)
        i += 1
    }
    // Del runtime solo entran las funciones que se usan (como un enlazador):
    // se recorren las referencias ya emitidas y cada función "rN" nueva se
    // traduce y añade, con sus propias referencias, hasta que no queda ninguna.
    let mut emitted = std::map::new()
    let mut scan = 0
    while scan < len(fx) {
        let target = fx[scan].target
        let kind = fx[scan].kind
        scan += 1
        // Solo las referencias a etiquetas de código: el texto de un string
        // (kind "str") puede parecerse a una etiqueta, p. ej. "r70000".
        if (kind != "rel" && kind != "abs") || !bk_is_rt_label(target) || std::map::contains(emitted, target) {
            continue
        }
        emitted = std::map::insert(emitted, target, true)
        let index = bk_label_index(target)
        let f = gr.funcs[index]
        labels = std::map::insert(labels, target, len(code))
        syms = std::array::push(syms, (len(code), "runtime:" + f.name))
        let piece = bk_function(rctx, f, index)
        let base = len(code)
        for r in piece.fx {
            fx = std::array::push(fx, Fx { off: r.off + base, kind: r.kind, target: r.target, n: r.n })
        }
        code = std::array::concat(code, piece.b)
    }
    // Errores: construcciones que el compilador nativo aún no admite.
    let mut errors = []
    let mut seen = std::map::new()
    for r in fx {
        if r.kind == "error" && !std::map::contains(seen, r.target) {
            errors = std::array::push(errors, r.target)
            seen = std::map::insert(seen, r.target, true)
        }
        if r.kind == "rel" && std::text::starts_with(r.target, "missing:") && !std::map::contains(seen, r.target) {
            errors = std::array::push(errors, "native runtime function '" + std::text::substring(r.target, 8, len(r.target)) + "' not found")
            seen = std::map::insert(seen, r.target, true)
        }
    }
    if len(errors) > 0 {
        return Result::Err(bk_join(errors, "\n"))
    }
    // Datos: primero todos los strings (una vez cada texto), luego esquemas y
    // enums sin contenido, que apuntan a strings.
    let code_base = el_code_address()
    let data_base = bk_align(code_base + len(code), 16)
    let mut texts = []
    let mut want = std::map::new()
    for r in fx {
        let mut needed = []
        if r.kind == "str" {
            needed = [r.target]
        } else if r.kind == "schema" {
            if r.n > 0 {
                needed = bk_split_lines(r.target)
            }
        } else if r.kind == "unit" {
            needed = bk_split_lines(r.target)
        }
        for t in needed {
            if !std::map::contains(want, t) {
                want = std::map::insert(want, t, true)
                texts = std::array::push(texts, t)
            }
        }
    }
    let mut data = []
    let mut addr = std::map::new()
    for t in texts {
        let bytes = bk_utf8(t)
        addr = std::map::insert(addr, t, data_base + len(data))
        data = std::array::concat(data, x_i64(-1))
        data = std::array::concat(data, x_i64(len(bytes)))
        data = std::array::concat(data, bytes)
        while len(data) % 16 != 0 {
            data = std::array::push(data, 0)
        }
    }
    let mut objects = std::map::new()
    for r in fx {
        if (r.kind == "schema" || r.kind == "unit") && !std::map::contains(objects, r.kind + ":" + r.target) {
            objects = std::map::insert(objects, r.kind + ":" + r.target, data_base + len(data))
            if r.kind == "schema" {
                let mut names = []
                if r.n > 0 {
                    names = bk_split_lines(r.target)
                }
                data = std::array::concat(data, x_i64(len(names)))
                for t in names {
                    data = std::array::concat(data, x_i64(std::map::get(addr, t)))
                }
            } else {
                let parts = bk_split_lines(r.target)
                data = std::array::concat(data, x_i64(-1))
                data = std::array::concat(data, x_i64(std::map::get(addr, parts[0])))
                data = std::array::concat(data, x_i64(std::map::get(addr, parts[1])))
                data = std::array::concat(data, x_i64(0))
                data = std::array::concat(data, x_i64(0))
                data = std::array::concat(data, x_i64(0))
            }
            while len(data) % 16 != 0 {
                data = std::array::push(data, 0)
            }
        }
    }
    let globals = bk_align(data_base + len(data), 16)
    for r in fx {
        let mut bytes = []
        if r.kind == "rel" {
            let target = std::map::get(labels, r.target)
            bytes = x_i32(target - (r.off + 4))
        } else if r.kind == "abs" {
            bytes = x_i64(code_base + std::map::get(labels, r.target))
        } else if r.kind == "str" {
            bytes = x_i64(std::map::get(addr, r.target))
        } else if r.kind == "schema" || r.kind == "unit" {
            bytes = x_i64(std::map::get(objects, r.kind + ":" + r.target))
        } else if r.kind == "glob" {
            bytes = x_i64(globals)
        }
        let mut j = 0
        while j < len(bytes) {
            code = std::array::set(code, r.off + j, bytes[j])
            j += 1
        }
    }
    let mut body = code
    while code_base + len(body) < data_base {
        body = std::array::push(body, 0)
    }
    body = std::array::concat(body, data)
    let entry = code_base + std::map::get(labels, "g_start")
    let mut map_lines = []
    for sym in syms {
        let (off, name) = sym
        let address = code_base + off
        map_lines = std::array::push(map_lines, "{address} " + name)
    }
    let image = el_image(body, entry, globals - (code_base + len(body)) + 4096)
    Result::Ok((image, bk_join(map_lines, "\n") + "\n"))
}

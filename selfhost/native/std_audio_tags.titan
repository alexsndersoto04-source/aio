// Metadata reader for MP3/ID3, RIFF/WAVE, FLAC, Ogg Vorbis and Opus.
// tags() and duration() use the same bounded head/tail as audio_tags.rs;
// cover() seeks through metadata on demand with a 64 MiB scan limit.
// Directory walks use real stat/getdents/open syscalls, retaining raw child
// path bytes for I/O and converting only the public path to lossy UTF-8.

const AT_COVER_SCAN_MAX_BYTES: int = 67108864
const AT_SCAN_MAX_ENTRIES: int = 5000

fn at_mp3_bitrate(is_v1: bool, layer: int, index: int) -> int {
    if index <= 0 || index >= 15 { return 0 }
    if is_v1 {
        if layer == 1 {
            let rates = [0, 32, 64, 96, 128, 160, 192, 224, 256, 288, 320, 352, 384, 416, 448]
            return rates[index]
        }
        if layer == 2 {
            let rates = [0, 32, 48, 56, 64, 80, 96, 112, 128, 160, 192, 224, 256, 320, 384]
            return rates[index]
        }
        let rates = [0, 32, 40, 48, 56, 64, 80, 96, 112, 128, 160, 192, 224, 256, 320]
        return rates[index]
    }
    if layer == 1 {
        let rates = [0, 32, 48, 56, 64, 80, 96, 112, 128, 144, 160, 176, 192, 224, 256]
        return rates[index]
    }
    let rates = [0, 8, 16, 24, 32, 40, 48, 56, 64, 80, 96, 112, 128, 144, 160]
    rates[index]
}

fn at_mp3_frame(data: any, at: int) -> any {
    if at < 0 || at + 4 > rt_slen(data) { return nil }
    let b0 = at_u8(data, at)
    let b1 = at_u8(data, at + 1)
    let b2 = at_u8(data, at + 2)
    let b3 = at_u8(data, at + 3)
    if b0 != 255 || (b1 & 224) != 224 { return nil }
    let version = (b1 / 8) & 3
    let layer_bits = (b1 / 2) & 3
    if version == 1 || layer_bits == 0 { return nil }
    let br_idx = b2 / 16
    let sr_idx = (b2 / 4) & 3
    if br_idx == 0 || br_idx >= 15 || sr_idx >= 3 { return nil }
    let is_v1 = version == 3
    let layer = if layer_bits == 3 { 1 } else if layer_bits == 2 { 2 } else { 3 }
    let kbps = at_mp3_bitrate(is_v1, layer, br_idx)
    let rate = if version == 3 {
        let rates = [44100, 48000, 32000]
        rates[sr_idx]
    } else if version == 2 {
        let rates = [22050, 24000, 16000]
        rates[sr_idx]
    } else {
        let rates = [11025, 12000, 8000]
        rates[sr_idx]
    }
    if rate == 0 || kbps == 0 { return nil }
    let samples = if is_v1 { if layer == 1 { 384 } else { 1152 } } else if layer == 1 { 384 } else if layer == 2 { 1152 } else { 576 }
    let padding = (b2 / 2) & 1
    let frame_len = if layer == 1 {
        (12 * kbps * 1000 / rate + padding) * 4
    } else if is_v1 || layer == 2 {
        144 * kbps * 1000 / rate + padding
    } else {
        72 * kbps * 1000 / rate + padding
    }
    if frame_len < 24 { return nil }
    let channels = if b3 / 64 == 3 { 1 } else { 2 }
    let f = std::map::new()
    let f = std::map::insert(f, "kbps", kbps)
    let f = std::map::insert(f, "rate", rate)
    let f = std::map::insert(f, "channels", channels)
    let f = std::map::insert(f, "samples", samples)
    let f = std::map::insert(f, "at", at)
    let f = std::map::insert(f, "is_v1", is_v1)
    f
}

fn at_find_mp3_frame(data: any, from: int) -> any {
    let n = rt_slen(data)
    if n < 4 { return nil }
    let mut i = from
    if i < 0 { i = 0 }
    let limit = n - 4
    let mut scanned = 0
    while i <= limit && scanned < 65536 {
        if at_u8(data, i) == 255 && (at_u8(data, i + 1) & 224) == 224 {
            let frame = at_mp3_frame(data, i)
            if frame != nil { return frame }
        }
        i += 1
        scanned += 1
    }
    nil
}

fn at_mp3_tags(path: string, head: any, tail: any, file_len: int) -> any {
    let mut tags = at_empty_tags(path, "mp3")
    let n = rt_slen(head)
    let mut audio_start = 0
    if n >= 10 && at_match(head, 0, "ID3") {
        let major = at_u8(head, 3)
        let flags = at_u8(head, 5)
        let size0 = at_syncsafe(head, 6)
        let size = if size0 < 0 { 0 } else { size0 }
        let footer = if (flags & 16) != 0 { 10 } else { 0 }
        audio_start = 10 + size + footer
        let end = if audio_start < n { audio_start } else { n }
        let raw = at_slice(head, 10, end)
        let payload = if (flags & 128) != 0 { at_de_unsync(raw) } else { raw }
        tags = at_parse_id3_frames(payload, major, flags, tags)
    }
    if std::map::get(tags, "title") == nil || std::map::get(tags, "artist") == nil || std::map::get(tags, "album") == nil {
        tags = at_id3v1(tail, tags)
    }
    let frame = at_find_mp3_frame(head, audio_start)
    if frame == nil { return tags }
    let rate = std::map::get(frame, "rate")
    let channels = std::map::get(frame, "channels")
    let kbps = std::map::get(frame, "kbps")
    tags = std::map::insert(tags, "sample_rate", rate)
    tags = std::map::insert(tags, "channels", channels)
    tags = std::map::insert(tags, "bitrate_kbps", kbps)
    let side = if std::map::get(frame, "is_v1") {
        if channels == 1 { 17 } else { 32 }
    } else if channels == 1 { 9 } else { 17 }
    let xing_at = std::map::get(frame, "at") + 4 + side
    let mut duration = 0.0
    if xing_at + 16 <= n && (at_match(head, xing_at, "Xing") || at_match(head, xing_at, "Info")) {
        let xflags = at_u32be(head, xing_at + 4)
        if xflags >= 0 && (xflags & 1) != 0 {
            let frames = at_u32be(head, xing_at + 8)
            if frames > 0 && rate > 0 {
                duration = at_f64_ratio(frames * std::map::get(frame, "samples"), rate)
            }
        }
    }
    if duration == 0.0 && kbps > 0 {
        let audio_bytes = if file_len > audio_start { file_len - audio_start } else { 0 }
        let tail_len = rt_slen(tail)
        let has_v1 = tail_len >= 128 && at_match(tail, tail_len - 128, "TAG")
        let audio_len = if has_v1 && audio_bytes > 128 { audio_bytes - 128 } else if has_v1 { 0 } else { audio_bytes }
        if audio_len > 0 {
            duration = at_f64_ratio(audio_len * 8, kbps * 1000)
        }
    }
    std::map::insert(tags, "duration_secs", duration)
}

fn at_parse_vorbis_comments(data: any, start: int, tags0: any) -> any {
    let mut tags = tags0
    let end = rt_slen(data)
    let vendor_len = at_u32le(data, start)
    if vendor_len < 0 || vendor_len > end - start - 4 { return tags }
    let mut pos = start + 4 + vendor_len
    let count0 = at_u32le(data, pos)
    if count0 < 0 { return tags }
    let count = if count0 > 4096 { 4096 } else { count0 }
    pos += 4
    let mut i = 0
    while i < count {
        let len = at_u32le(data, pos)
        if len < 0 { break }
        pos += 4
        if len > 16777216 || len > end - pos { break }
        let entry = at_bytes_text_lossy(data, pos, pos + len)
        pos += len
        let eb = std::encoding::utf8_encode(entry)
        let mut eq = -1
        let mut j = 0
        while j < rt_slen(eb) {
            if at_u8(eb, j) == 61 { eq = j; break }
            j += 1
        }
        if eq >= 0 {
            let key0 = at_bytes_text_lossy(eb, 0, eq)
            let key_bytes = std::encoding::utf8_encode(key0)
            let key_buf = sb_new(rt_slen(key_bytes))
            j = 0
            while j < rt_slen(key_bytes) {
                let c = at_u8(key_bytes, j)
                sb_byte(key_buf, if c >= 97 && c <= 122 { c - 32 } else { c })
                j += 1
            }
            let key = sb_finish(key_buf)
            let value = at_bytes_text_lossy(eb, eq + 1, rt_slen(eb))
            tags = at_set_vorbis(tags, key, value)
        }
        i += 1
    }
    tags
}

fn at_flac_picture(data: any, start: int, size: int) -> any {
    let end = start + size
    let mime_len = at_u32be(data, start + 4)
    if mime_len < 0 || mime_len > end - start - 8 { return std::bytes::from_array([]) }
    let mut pos = start + 8 + mime_len
    let desc_len = at_u32be(data, pos)
    if desc_len < 0 || desc_len > end - pos - 4 { return std::bytes::from_array([]) }
    pos += 4 + desc_len
    if pos + 16 > end { return std::bytes::from_array([]) }
    pos += 16
    let image_len = at_u32be(data, pos)
    pos += 4
    if image_len <= 0 || image_len > end - pos { return std::bytes::from_array([]) }
    at_slice(data, pos, pos + image_len)
}

fn at_flac_tags(path: string, data: any) -> any {
    let mut tags = at_empty_tags(path, "flac")
    let mut pos = 4
    let mut guard = 0
    while pos + 4 <= rt_slen(data) && guard < 256 {
        guard += 1
        let h = at_u8(data, pos)
        let block_type = h & 127
        let last = (h & 128) != 0
        let size = at_u8(data, pos + 1) * 65536 + at_u8(data, pos + 2) * 256 + at_u8(data, pos + 3)
        let start = pos + 4
        if block_type == 6 { tags = std::map::insert(tags, "has_cover", true) }
        if size > rt_slen(data) - start { break }
        if block_type == 0 && size >= 18 {
            let rate = at_u8(data, start + 10) * 4096 + at_u8(data, start + 11) * 16 + at_u8(data, start + 12) / 16
            let channels = ((at_u8(data, start + 12) / 2) & 7) + 1
            let total = (at_u8(data, start + 13) & 15) * 4294967296 + at_u8(data, start + 14) * 16777216 + at_u8(data, start + 15) * 65536 + at_u8(data, start + 16) * 256 + at_u8(data, start + 17)
            tags = std::map::insert(tags, "sample_rate", rate)
            tags = std::map::insert(tags, "channels", channels)
            if rate > 0 && total > 0 {
                tags = std::map::insert(tags, "duration_secs", at_f64_ratio(total, rate))
            }
        } else if block_type == 4 {
            tags = at_parse_vorbis_comments(at_slice(data, start, start + size), 0, tags)
        } else if block_type == 6 {
            tags = at_set_cover(tags, at_flac_picture(data, start, size))
        }
        pos = start + size
        if last { break }
    }
    tags
}

fn at_find_vorbis_ident(data: any) -> int {
    let mut i = 4
    while i + 6 <= rt_slen(data) {
        if at_match(data, i, "vorbis") && at_u8(data, i - 4) == 0 && at_u8(data, i - 3) == 0 && at_u8(data, i - 2) == 0 && at_u8(data, i - 1) == 0 {
            return i - 4
        }
        i += 1
    }
    -1
}

fn at_find_vorbis_comments(data: any) -> int {
    let mut i = 0
    while i + 7 <= rt_slen(data) {
        if at_u8(data, i) == 3 && at_match(data, i + 1, "vorbis") { return i + 7 }
        i += 1
    }
    -1
}

fn at_last_granule(data: any) -> any {
    let mut found = -1
    let mut i = 0
    while i + 5 <= rt_slen(data) {
        if at_match(data, i, "OggS") && at_u8(data, i + 4) == 0 { found = i }
        i += 1
    }
    if found < 0 { return nil }
    at_u64le_parts(data, found + 6)
}

fn at_ogg_tags(path: string, head: any, tail: any) -> any {
    let mut tags = at_empty_tags(path, "ogg")
    let opus = at_find(head, "OpusHead")
    let mut format = "ogg"
    let mut rate = 0
    let mut channels = 0
    let mut preskip = 0
    if opus >= 0 {
        format = "opus"
        if opus + 12 <= rt_slen(head) {
            channels = at_u8(head, opus + 9)
            preskip = at_u16le(head, opus + 10)
        }
    } else {
        let ident = at_find_vorbis_ident(head)
        if ident >= 0 && ident + 16 <= rt_slen(head) {
            channels = at_u8(head, ident + 10)
            rate = at_u32le(head, ident + 11)
        }
    }
    tags = std::map::insert(tags, "format", format)
    tags = std::map::insert(tags, "sample_rate", rate)
    tags = std::map::insert(tags, "channels", channels)
    let opus_tags = at_find(head, "OpusTags")
    let comment_at = if opus_tags >= 0 { opus_tags + 8 } else { at_find_vorbis_comments(head) }
    if comment_at >= 0 && comment_at < rt_slen(head) {
        tags = at_parse_vorbis_comments(head, comment_at, tags)
    }
    let granule = at_last_granule(tail)
    if granule != nil {
        let low = std::map::get(granule, "low")
        let high = std::map::get(granule, "high")
        if format == "opus" {
            tags = std::map::insert(tags, "duration_secs", at_u64_duration(low, high, preskip, 48000))
        } else if rate > 0 {
            tags = std::map::insert(tags, "duration_secs", at_u64_duration(low, high, 0, rate))
        }
    }
    tags
}

fn at_wav_tags(path: string, data: any) -> any {
    let tags = at_empty_tags(path, "wav")
    let mut pos = 12
    let mut rate = 0
    let mut channels = 0
    let mut bits = 0
    let mut data_size = -1
    let mut guard = 0
    let n = rt_slen(data)
    let mut result = tags
    while pos + 8 <= n && guard < 10000 {
        guard += 1
        let size = at_u32le(data, pos + 4)
        if size < 0 { break }
        let start = pos + 8
        if at_match(data, pos, "data") {
            if data_size < 0 { data_size = size }
            if rate > 0 && channels > 0 && bits > 0 {
                let rate_channels = std::raw::fmul(std::raw::ffromint(rate), std::raw::ffromint(channels))
                let byte_rate = std::raw::fdiv(
                    std::raw::fmul(rate_channels, std::raw::ffromint(bits)),
                    std::raw::ffromint(8)
                )
                let duration = std::raw::value(2, std::raw::fdiv(std::raw::ffromint(data_size), byte_rate))
                result = std::map::insert(result, "duration_secs", duration)
            }
            // A WAVE file may place metadata after audio. Seek across samples
            // without parsing them, then continue with any following chunks.
            pos = start + size + (size & 1)
            continue
        }
        if size > n - start {
            if at_match(data, pos, "id3 ") || at_match(data, pos, "ID3 ") {
                let id3_tags = at_empty_tags(path, "wav")
                let parsed = at_parse_id3_whole(at_slice(data, start, n), id3_tags)
                result = at_merge_missing(result, parsed)
            }
            break
        }
        if at_match(data, pos, "fmt ") && size >= 16 {
            channels = at_u16le(data, start + 2)
            rate = at_u32le(data, start + 4)
            bits = at_u16le(data, start + 14)
            result = std::map::insert(result, "sample_rate", rate)
            result = std::map::insert(result, "channels", channels)
            if data_size >= 0 && rate > 0 && channels > 0 && bits > 0 {
                let rate_channels = std::raw::fmul(std::raw::ffromint(rate), std::raw::ffromint(channels))
                let byte_rate = std::raw::fdiv(
                    std::raw::fmul(rate_channels, std::raw::ffromint(bits)),
                    std::raw::ffromint(8)
                )
                let duration = std::raw::value(2, std::raw::fdiv(std::raw::ffromint(data_size), byte_rate))
                result = std::map::insert(result, "duration_secs", duration)
            }
        } else if at_match(data, pos, "LIST") && size >= 4 && at_match(data, start, "INFO") {
            let mut sub = start + 4
            let end = start + size
            let mut sguard = 0
            while sub + 8 <= end && sguard < 256 {
                sguard += 1
                let subsize = at_u32le(data, sub + 4)
                if subsize < 0 || subsize > end - sub - 8 { break }
                let sstart = sub + 8
                let raw = at_bytes_text_lossy(data, sstart, sstart + subsize)
                if at_match(data, sub, "INAM") {
                    result = at_set_text(result, "title", raw)
                } else if at_match(data, sub, "IART") {
                    result = at_set_text(result, "artist", raw)
                } else if at_match(data, sub, "IPRD") {
                    result = at_set_text(result, "album", raw)
                } else if at_match(data, sub, "IGNR") {
                    result = at_set_text(result, "genre", raw)
                } else if at_match(data, sub, "ICRD") {
                    result = at_set_text(result, "year", raw)
                } else if at_match(data, sub, "ITRK") {
                    result = std::map::insert(result, "track", at_track_number(raw))
                }
                sub = sstart + subsize + (subsize & 1)
            }
        } else if at_match(data, pos, "id3 ") || at_match(data, pos, "ID3 ") {
            let id3_tags = at_empty_tags(path, "wav")
            let parsed = at_parse_id3_whole(at_slice(data, start, start + size), id3_tags)
            result = at_merge_missing(result, parsed)
        }
        pos = start + size + (size & 1)
    }
    result
}

fn at_fail(function: string, message: string) -> any {
    rt_native_fail(function, message)
}

fn at_u8(data: any, at: int) -> int {
    if at < 0 || at >= rt_slen(data) {
        return -1
    }
    std::raw::load8(rt_bdata(data) + at)
}

fn at_slice(data: any, start: int, end: int) -> any {
    if start < 0 || end < start || end > rt_slen(data) {
        return std::bytes::from_array([])
    }
    rt_bytes_from(rt_bdata(data) + start, end - start)
}

fn at_match(data: any, at: int, text: string) -> bool {
    let n = rt_slen(text)
    if at < 0 || at + n > rt_slen(data) {
        return false
    }
    let p = rt_bdata(data) + at
    let q = std::raw::bits(text) + 16
    let mut i = 0
    while i < n {
        if std::raw::load8(p + i) != std::raw::load8(q + i) {
            return false
        }
        i += 1
    }
    true
}

fn at_find(data: any, text: string) -> int {
    let n = rt_slen(data)
    let m = rt_slen(text)
    if m == 0 || m > n {
        return -1
    }
    let mut i = 0
    while i <= n - m {
        if at_match(data, i, text) {
            return i
        }
        i += 1
    }
    -1
}

fn at_u16le(data: any, at: int) -> int {
    let a = at_u8(data, at)
    let b = at_u8(data, at + 1)
    if a < 0 || b < 0 {
        return -1
    }
    a + b * 256
}

fn at_u32le(data: any, at: int) -> int {
    let a = at_u8(data, at)
    let b = at_u8(data, at + 1)
    let c = at_u8(data, at + 2)
    let d = at_u8(data, at + 3)
    if a < 0 || b < 0 || c < 0 || d < 0 {
        return -1
    }
    a + b * 256 + c * 65536 + d * 16777216
}

fn at_u32be(data: any, at: int) -> int {
    let a = at_u8(data, at)
    let b = at_u8(data, at + 1)
    let c = at_u8(data, at + 2)
    let d = at_u8(data, at + 3)
    if a < 0 || b < 0 || c < 0 || d < 0 {
        return -1
    }
    a * 16777216 + b * 65536 + c * 256 + d
}

fn at_u64le_parts(data: any, at: int) -> any {
    let lo = at_u32le(data, at)
    let hi = at_u32le(data, at + 4)
    if lo < 0 || hi < 0 { return nil }
    let parts = std::map::new()
    let parts = std::map::insert(parts, "low", lo)
    std::map::insert(parts, "high", hi)
}

fn at_u64_duration(low0: int, high: int, subtract: int, rate: int) -> float {
    let mut low = low0
    let mut upper = high
    if subtract > 0 {
        if upper == 0 && low < subtract {
            low = 0
        } else if low < subtract {
            upper -= 1
            low = low + 4294967296 - subtract
        } else {
            low -= subtract
        }
    }
    let scaled = std::raw::fadd(
        std::raw::fmul(std::raw::ffromint(upper), std::raw::ffromint(4294967296)),
        std::raw::ffromint(low)
    )
    std::raw::value(2, std::raw::fdiv(scaled, std::raw::ffromint(rate)))
}

fn at_syncsafe(data: any, at: int) -> int {
    let a = at_u8(data, at)
    let b = at_u8(data, at + 1)
    let c = at_u8(data, at + 2)
    let d = at_u8(data, at + 3)
    if a < 0 || b < 0 || c < 0 || d < 0 {
        return -1
    }
    a * 2097152 + b * 16384 + c * 128 + d
}

fn at_f64_ratio(numerator: int, denominator: int) -> float {
    if denominator == 0 {
        return 0.0
    }
    std::raw::value(2, std::raw::fdiv(std::raw::ffromint(numerator), std::raw::ffromint(denominator)))
}

fn at_bytes_text_lossy(data: any, start: int, end: int) -> string {
    let b = sb_new(end - start + 4)
    let mut i = start
    while i < end {
        let c = at_u8(data, i)
        if c < 128 {
            sb_byte(b, c)
            i += 1
        } else if c >= 194 && c <= 223 {
            if i + 1 >= end {
                sb_cp(b, 65533)
                i = end
            } else {
                let c1 = at_u8(data, i + 1)
                if c1 >= 128 && c1 <= 191 {
                    sb_byte(b, c)
                    sb_byte(b, c1)
                    i += 2
                } else {
                    sb_cp(b, 65533)
                    i += 1
                }
            }
        } else if c >= 224 && c <= 239 {
            if i + 1 >= end {
                sb_cp(b, 65533)
                i = end
            } else {
                let c1 = at_u8(data, i + 1)
                let second_ok = c1 >= 128 && c1 <= 191 && !(c == 224 && c1 < 160) && !(c == 237 && c1 >= 160)
                if !second_ok {
                    sb_cp(b, 65533)
                    i += 1
                } else if i + 2 >= end {
                    sb_cp(b, 65533)
                    i = end
                } else {
                    let c2 = at_u8(data, i + 2)
                    if c2 >= 128 && c2 <= 191 {
                        sb_byte(b, c)
                        sb_byte(b, c1)
                        sb_byte(b, c2)
                        i += 3
                    } else {
                        sb_cp(b, 65533)
                        i += 2
                    }
                }
            }
        } else if c >= 240 && c <= 244 {
            if i + 1 >= end {
                sb_cp(b, 65533)
                i = end
            } else {
                let c1 = at_u8(data, i + 1)
                let second_ok = c1 >= 128 && c1 <= 191 && !(c == 240 && c1 < 144) && !(c == 244 && c1 >= 144)
                if !second_ok {
                    sb_cp(b, 65533)
                    i += 1
                } else if i + 2 >= end {
                    sb_cp(b, 65533)
                    i = end
                } else {
                    let c2 = at_u8(data, i + 2)
                    if c2 < 128 || c2 > 191 {
                        sb_cp(b, 65533)
                        i += 2
                    } else if i + 3 >= end {
                        sb_cp(b, 65533)
                        i = end
                    } else {
                        let c3 = at_u8(data, i + 3)
                        if c3 >= 128 && c3 <= 191 {
                            sb_byte(b, c)
                            sb_byte(b, c1)
                            sb_byte(b, c2)
                            sb_byte(b, c3)
                            i += 4
                        } else {
                            sb_cp(b, 65533)
                            i += 3
                        }
                    }
                }
            }
        } else {
            sb_cp(b, 65533)
            i += 1
        }
    }
    sb_finish(b)
}

fn at_bytes_latin1(data: any, start: int, end: int) -> string {
    let b = sb_new(end - start + 4)
    let mut i = start
    while i < end {
        sb_cp(b, at_u8(data, i))
        i += 1
    }
    sb_finish(b)
}

fn at_clean(raw: string) -> any {
    let b = std::encoding::utf8_encode(raw)
    let mut start = 0
    let mut end = rt_slen(b)
    while start < end && at_u8(b, start) == 0 {
        start += 1
    }
    while end > start && at_u8(b, end - 1) == 0 {
        end -= 1
    }
    let value = std::text::trim(std::encoding::utf8_decode(at_slice(b, start, end)))
    if value == "" {
        nil
    } else {
        value
    }
}

fn at_decode_utf16(data: any, start: int, end: int, little: bool) -> string {
    let b = sb_new(end - start + 4)
    let mut i = start
    while i + 1 < end {
        let a = at_u8(data, i)
        let c = at_u8(data, i + 1)
        let u = if little { a + c * 256 } else { a * 256 + c }
        i += 2
        if u >= 55296 && u <= 56319 {
            if i + 1 < end {
                let d = at_u8(data, i)
                let e = at_u8(data, i + 1)
                let v = if little { d + e * 256 } else { d * 256 + e }
                if v >= 56320 && v <= 57343 {
                    sb_cp(b, 65536 + (u - 55296) * 1024 + (v - 56320))
                    i += 2
                    0
                } else {
                    sb_cp(b, 65533)
                    0
                }
                0
            } else {
                sb_cp(b, 65533)
                0
            }
            0
        } else if u >= 56320 && u <= 57343 {
            sb_cp(b, 65533)
            0
        } else {
            sb_cp(b, u)
            0
        }
    }
    sb_finish(b)
}

fn at_decode_text(data: any, enc: int, start: int, end: int) -> any {
    if enc == 0 {
        return at_bytes_latin1(data, start, end)
    }
    if enc == 3 {
        return at_bytes_text_lossy(data, start, end)
    }
    if enc == 2 {
        return at_decode_utf16(data, start, end, false)
    }
    if enc == 1 {
        if start + 1 < end && at_u8(data, start) == 255 && at_u8(data, start + 1) == 254 {
            return at_decode_utf16(data, start + 2, end, true)
        }
        if start + 1 < end && at_u8(data, start) == 254 && at_u8(data, start + 1) == 255 {
            return at_decode_utf16(data, start + 2, end, false)
        }
        return at_decode_utf16(data, start, end, true)
    }
    nil
}

fn at_track_number(value: string) -> any {
    let bytes = std::encoding::utf8_encode(value)
    let mut slash = -1
    let mut i = 0
    while i < rt_slen(bytes) {
        if at_u8(bytes, i) == 47 {
            slash = i
            break
        }
        i += 1
    }
    let end = if slash < 0 { rt_slen(bytes) } else { slash }
    let first = at_bytes_text_lossy(bytes, 0, end)
    let parsed = std::text::parse_int(std::text::trim(first))
    match parsed {
        Option::Some(number) => {
            if number >= 0 && number <= 4294967295 { number } else { nil }
        },
        Option::None => nil,
    }
}

fn at_lossy_path(path: string) -> string {
    let bytes = std::encoding::utf8_encode(path)
    at_bytes_text_lossy(bytes, 0, rt_slen(bytes))
}

fn at_empty_tags(path: string, format: string) -> any {
    let m = std::map::new()
    let m = std::map::insert(m, "path", at_lossy_path(path))
    let m = std::map::insert(m, "format", format)
    let m = std::map::insert(m, "title", nil)
    let m = std::map::insert(m, "artist", nil)
    let m = std::map::insert(m, "album", nil)
    let m = std::map::insert(m, "album_artist", nil)
    let m = std::map::insert(m, "genre", nil)
    let m = std::map::insert(m, "year", nil)
    let m = std::map::insert(m, "track", nil)
    let m = std::map::insert(m, "duration_secs", 0.0)
    let m = std::map::insert(m, "sample_rate", 0)
    let m = std::map::insert(m, "channels", 0)
    let m = std::map::insert(m, "bitrate_kbps", 0)
    let m = std::map::insert(m, "has_cover", false)
    std::map::insert(m, "_cover_bytes", std::bytes::from_array([]))
}

fn at_set_cover(tags: any, image: any) -> any {
    if image == nil { return tags }
    if std::bytes::length(std::map::get(tags, "_cover_bytes")) == 0 && std::bytes::length(image) > 0 {
        return std::map::insert(tags, "_cover_bytes", image)
    }
    tags
}

fn at_set_text(tags: any, key: string, text: string) -> any {
    std::map::insert(tags, key, at_clean(text))
}

fn at_set_id3(tags0: any, id: string, value: string) -> any {
    let tags = tags0
    if id == "TIT2" || id == "TT2" { return at_set_text(tags, "title", value) }
    if id == "TPE1" || id == "TP1" { return at_set_text(tags, "artist", value) }
    if id == "TALB" || id == "TAL" { return at_set_text(tags, "album", value) }
    if id == "TPE2" || id == "TP2" { return at_set_text(tags, "album_artist", value) }
    if id == "TCON" || id == "TCO" { return at_set_text(tags, "genre", value) }
    if id == "TYER" || id == "TYE" || id == "TDRC" {
        let year = at_clean(value)
        if year != nil || std::map::get(tags, "year") == nil {
            return std::map::insert(tags, "year", year)
        }
        return tags
    }
    if id == "TRCK" || id == "TRK" { return std::map::insert(tags, "track", at_track_number(value)) }
    tags
}

fn at_set_vorbis(tags0: any, key: string, value: string) -> any {
    let tags = tags0
    if key == "TITLE" { return at_set_text(tags, "title", value) }
    if key == "ARTIST" { return at_set_text(tags, "artist", value) }
    if key == "ALBUM" { return at_set_text(tags, "album", value) }
    if key == "ALBUMARTIST" || key == "ALBUM ARTIST" { return at_set_text(tags, "album_artist", value) }
    if key == "GENRE" { return at_set_text(tags, "genre", value) }
    if key == "DATE" || key == "YEAR" { return at_set_text(tags, "year", value) }
    if key == "TRACKNUMBER" { return std::map::insert(tags, "track", at_track_number(value)) }
    tags
}

fn at_merge_missing(dst0: any, src: any) -> any {
    let mut dst = dst0
    for key in ["title", "artist", "album", "album_artist", "genre", "year", "track"] {
        if std::map::get(dst, key) == nil {
            let value = std::map::get(src, key)
            if value != nil { dst = std::map::insert(dst, key, value) }
        }
    }
    if std::map::get(dst, "has_cover") == false && std::map::get(src, "has_cover") == true {
        dst = std::map::insert(dst, "has_cover", true)
    }
    dst = at_set_cover(dst, std::map::get(src, "_cover_bytes"))
    dst
}

fn at_de_unsync(data: any) -> any {
    let b = sb_new(rt_slen(data))
    let mut i = 0
    while i < rt_slen(data) {
        let x = at_u8(data, i)
        sb_byte(b, x)
        if x == 255 && i + 1 < rt_slen(data) && at_u8(data, i + 1) == 0 {
            i += 2
        } else {
            i += 1
        }
    }
    sb_finish_bytes(b)
}

fn at_frame_id_valid(data: any, pos: int, n: int) -> bool {
    let mut i = 0
    while i < n {
        let c = at_u8(data, pos + i)
        if !((c >= 65 && c <= 90) || (c >= 48 && c <= 57)) { return false }
        i += 1
    }
    true
}

fn at_apic_image(data: any, id: string) -> any {
    let n = rt_slen(data)
    if id == "PIC" {
        if n > 3 { return at_slice(data, 3, n) }
        return std::bytes::from_array([])
    }
    if n < 4 { return std::bytes::from_array([]) }
    let mut mime_end = -1
    let mut i = 1
    while i < n {
        if at_u8(data, i) == 0 { mime_end = i; break }
        i += 1
    }
    if mime_end < 0 { return std::bytes::from_array([]) }
    let enc = at_u8(data, 0)
    let desc_start = mime_end + 2
    if desc_start >= n { return std::bytes::from_array([]) }
    let mut desc_end = -1
    if enc == 1 || enc == 2 {
        // Both UTF-16 encodings use a two-byte terminator. Keep scanning on
        // code-unit boundaries to avoid mistaking a character byte for NUL.
        i = desc_start
        while i + 1 < n {
            if at_u8(data, i) == 0 && at_u8(data, i + 1) == 0 { desc_end = i + 2; break }
            i += 2
        }
    } else {
        i = desc_start
        while i < n {
            if at_u8(data, i) == 0 { desc_end = i + 1; break }
            i += 1
        }
    }
    let start = if desc_end >= 0 { desc_end } else { desc_start }
    if start < n { at_slice(data, start, n) } else { std::bytes::from_array([]) }
}

fn at_parse_id3_frames(data0: any, major: int, flags: int, tags0: any) -> any {
    let mut tags = tags0
    if major < 2 || major > 4 { return tags }
    let id_len = if major == 2 { 3 } else { 4 }
    let hdr_len = if major == 2 { 6 } else { 10 }
    let mut pos = 0
    let end = rt_slen(data0)
    if major != 2 && (flags & 64) != 0 {
        if major == 4 {
            pos = at_syncsafe(data0, 0)
        } else {
            let sz = at_u32be(data0, 0)
            if sz < 0 { return tags }
            pos = 4 + sz
        }
        if pos < 0 || pos > end { return tags }
    }
    let mut guard = 0
    while pos + hdr_len <= end && guard < 4096 {
        guard += 1
        if !at_frame_id_valid(data0, pos, id_len) { break }
        let id = at_bytes_latin1(data0, pos, pos + id_len)
        let mut fsize = 0
        let mut fflags = 0
        if major == 2 {
            fsize = at_u8(data0, pos + 3) * 65536 + at_u8(data0, pos + 4) * 256 + at_u8(data0, pos + 5)
        } else if major == 4 {
            fsize = at_syncsafe(data0, pos + 4)
            fflags = at_u8(data0, pos + 9)
        } else {
            fsize = at_u32be(data0, pos + 4)
            fflags = at_u8(data0, pos + 9)
        }
        let broken = (major == 3 && (fflags & 192) != 0) || (major == 4 && (fflags & 12) != 0)
        let is_cover = id == "APIC" || id == "PIC"
        if is_cover { tags = std::map::insert(tags, "has_cover", true) }
        let start = pos + hdr_len
        if fsize <= 0 || fsize > end - start { break }
        pos = start + fsize
        if broken { continue }
        let mut content = at_slice(data0, start, start + fsize)
        if major == 4 && (fflags & 1) != 0 && rt_slen(content) > 4 {
            content = at_slice(content, 4, rt_slen(content))
        }
        if major == 4 && (fflags & 2) != 0 { content = at_de_unsync(content) }
        if is_cover {
            tags = at_set_cover(tags, at_apic_image(content, id))
        } else if at_u8(std::encoding::utf8_encode(id), 0) == 84 && rt_slen(content) > 0 {
            let text = at_decode_text(content, at_u8(content, 0), 1, rt_slen(content))
            if text != nil { tags = at_set_id3(tags, id, text) }
        }
    }
    tags
}

fn at_parse_id3_whole(data: any, tags0: any) -> any {
    let tags = tags0
    if rt_slen(data) < 10 || !at_match(data, 0, "ID3") { return tags }
    let major = at_u8(data, 3)
    let flags = at_u8(data, 5)
    let size = at_syncsafe(data, 6)
    if size < 0 { return tags }
    let end = if 10 + size < rt_slen(data) { 10 + size } else { rt_slen(data) }
    let raw = at_slice(data, 10, end)
    let payload = if (flags & 128) != 0 { at_de_unsync(raw) } else { raw }
    at_parse_id3_frames(payload, major, flags, tags)
}

fn at_id3_genre(index: int) -> any {
    let genres = ["Blues", "Classic Rock", "Country", "Dance", "Disco", "Funk", "Grunge", "Hip-Hop", "Jazz", "Metal", "New Age", "Oldies", "Other", "Pop", "R&B", "Rap", "Reggae", "Rock", "Techno", "Industrial", "Alternative", "Ska", "Death Metal", "Pranks", "Soundtrack", "Euro-Techno", "Ambient", "Trip-Hop", "Vocal", "Jazz+Funk", "Fusion", "Trance", "Classical", "Instrumental", "Acid", "House", "Game", "Sound Clip", "Gospel", "Noise", "Alt Rock", "Bass", "Soul", "Punk", "Space", "Meditative", "Instrumental Pop", "Instrumental Rock", "Ethnic", "Gothic", "Darkwave", "Techno-Industrial", "Electronic", "Pop-Folk", "Eurodance", "Dream", "Southern Rock", "Comedy", "Cult", "Gangsta", "Top 40", "Christian Rap", "Pop/Funk", "Jungle", "Native American", "Cabaret", "New Wave", "Psychedelic", "Rave", "Showtunes", "Trailer", "Lo-Fi", "Tribal", "Acid Punk", "Acid Jazz", "Polka", "Retro", "Musical", "Rock & Roll", "Hard Rock"]
    if index >= 0 && index < len(genres) { genres[index] } else { nil }
}

fn at_id3v1_text(data: any, start: int, end: int) -> any {
    let mut stop = start
    while stop < end && at_u8(data, stop) != 0 { stop += 1 }
    at_clean(at_bytes_text_lossy(data, start, stop))
}

fn at_id3v1(data: any, tags0: any) -> any {
    let tags = tags0
    let n = rt_slen(data)
    if n < 128 || !at_match(data, n - 128, "TAG") { return tags }
    let p = n - 128
    let title = at_id3v1_text(data, p + 3, p + 33)
    let artist = at_id3v1_text(data, p + 33, p + 63)
    let album = at_id3v1_text(data, p + 63, p + 93)
    let year = at_id3v1_text(data, p + 93, p + 97)
    let mut src = std::map::new()
    src = std::map::insert(src, "title", title)
    src = std::map::insert(src, "artist", artist)
    src = std::map::insert(src, "album", album)
    src = std::map::insert(src, "album_artist", nil)
    src = std::map::insert(src, "genre", at_id3_genre(at_u8(data, p + 127)))
    src = std::map::insert(src, "year", year)
    let track: any = if at_u8(data, p + 125) == 0 && at_u8(data, p + 126) != 0 { at_u8(data, p + 126) } else { nil }
    src = std::map::insert(src, "track", track)
    at_merge_missing(tags, src)
}

fn at_read_exact_fd(fd: int, count: int) -> any {
    let builder = sb_new(count)
    let buffer = rt_alloc(65536)
    let mut total = 0
    let mut error = ""
    while total < count {
        let remaining = count - total
        let wanted = if remaining > 65536 { 65536 } else { remaining }
        let got = std::raw::syscall(0, fd, buffer, wanted, 0, 0, 0)
        if got == -4 {
            continue
        }
        if got < 0 {
            error = rt_os_error(0 - got)
            break
        }
        if got == 0 {
            error = "failed to fill whole buffer"
            break
        }
        sb_raw(builder, buffer, got)
        total += got
    }
    rt_free_block(buffer)
    if error != "" {
        rt_free_block(std::raw::load(builder + 16))
        rt_free_block(builder)
        let result = std::map::new()
        let result = std::map::insert(result, "error", error)
        return std::map::insert(result, "data", std::bytes::from_array([]))
    }
    let result = std::map::new()
    let result = std::map::insert(result, "error", "")
    std::map::insert(result, "data", sb_finish_bytes(builder))
}

fn at_read_head_tail(path: string, function: string) -> (any, any, int) {
    let fd = rt_open(path, 524288, 0)
    if fd < 0 {
        at_fail(function, "audio I/O error: " + rt_os_error(0 - fd))
    }
    let stat = rt_alloc(144)
    let metadata = std::raw::syscall(5, fd, stat, 0, 0, 0, 0)
    if metadata < 0 {
        rt_free_block(stat)
        std::raw::syscall(3, fd, 0, 0, 0, 0, 0)
        at_fail(function, "audio I/O error: " + rt_os_error(0 - metadata))
    }
    let file_len = std::raw::load(stat + 48)
    rt_free_block(stat)
    let head_len = if file_len > 1048576 { 1048576 } else { file_len }
    let head_result = at_read_exact_fd(fd, head_len)
    if std::map::get(head_result, "error") != "" {
        std::raw::syscall(3, fd, 0, 0, 0, 0, 0)
        at_fail(function, "audio I/O error: " + std::map::get(head_result, "error"))
    }
    let head = std::map::get(head_result, "data")
    // Keep an EOF sample even when the complete file fits in `head`: ID3v1
    // tags and the final OGG page are defined relative to EOF.
    let tail_len = if file_len > 131072 { 131072 } else { file_len }
    let mut tail = std::bytes::from_array([])
    if tail_len > 0 {
        let seek = std::raw::syscall(8, fd, 0 - tail_len, 2, 0, 0, 0)
        if seek < 0 {
            std::raw::syscall(3, fd, 0, 0, 0, 0, 0)
            at_fail(function, "audio I/O error: " + rt_os_error(0 - seek))
        }
        let tail_result = at_read_exact_fd(fd, tail_len)
        if std::map::get(tail_result, "error") != "" {
            std::raw::syscall(3, fd, 0, 0, 0, 0, 0)
            at_fail(function, "audio I/O error: " + std::map::get(tail_result, "error"))
        }
        tail = std::map::get(tail_result, "data")
    }
    let close_status = std::raw::syscall(3, fd, 0, 0, 0, 0, 0)
    return (head, tail, file_len)
}

fn at_cover_result(data: any, error: string) -> any {
    let result = std::map::new()
    let result = std::map::insert(result, "data", data)
    std::map::insert(result, "error", error)
}

fn at_cover_empty() -> any {
    at_cover_result(std::bytes::from_array([]), "")
}

fn at_cover_error(message: string) -> any {
    at_cover_result(std::bytes::from_array([]), message)
}

fn at_cover_limit_error() -> any {
    at_cover_error("invalid parameter: cover metadata exceeds the 67108864-byte scan limit")
}

fn at_cover_mp3_fd(fd: int, file_len: int) -> any {
    if file_len < 10 { return at_cover_empty() }
    let header_result = at_read_exact_fd(fd, 10)
    if std::map::get(header_result, "error") != "" {
        return at_cover_error("audio I/O error: " + std::map::get(header_result, "error"))
    }
    let header = std::map::get(header_result, "data")
    if !at_match(header, 0, "ID3") { return at_cover_empty() }
    let major = at_u8(header, 3)
    let flags = at_u8(header, 5)
    let size0 = at_syncsafe(header, 6)
    let size = if size0 < 0 { 0 } else { size0 }
    let footer = if (flags & 16) != 0 { 10 } else { 0 }
    let tag_end = 10 + size + footer
    if tag_end > file_len { return at_cover_empty() }
    if tag_end > AT_COVER_SCAN_MAX_BYTES {
        return at_cover_limit_error()
    }
    let body_result = at_read_exact_fd(fd, size)
    if std::map::get(body_result, "error") != "" {
        return at_cover_error("audio I/O error: " + std::map::get(body_result, "error"))
    }
    let raw = std::map::get(body_result, "data")
    let payload = if (flags & 128) != 0 { at_de_unsync(raw) } else { raw }
    let tags = at_parse_id3_frames(payload, major, flags, at_empty_tags("", "mp3"))
    at_cover_result(std::map::get(tags, "_cover_bytes"), "")
}

fn at_cover_flac_fd(fd: int, file_len: int) -> any {
    if file_len < 4 { return at_cover_empty() }
    let magic_result = at_read_exact_fd(fd, 4)
    if std::map::get(magic_result, "error") != "" {
        return at_cover_error("audio I/O error: " + std::map::get(magic_result, "error"))
    }
    let magic = std::map::get(magic_result, "data")
    if !at_match(magic, 0, "fLaC") { return at_cover_empty() }
    let mut pos = 4
    let mut guard = 0
    while guard < 256 {
        guard += 1
        if pos + 4 > file_len { return at_cover_empty() }
        let header_result = at_read_exact_fd(fd, 4)
        if std::map::get(header_result, "error") != "" {
            return at_cover_error("audio I/O error: " + std::map::get(header_result, "error"))
        }
        let header = std::map::get(header_result, "data")
        let first = at_u8(header, 0)
        let block_type = first & 127
        let last = (first & 128) != 0
        let size = at_u8(header, 1) * 65536 + at_u8(header, 2) * 256 + at_u8(header, 3)
        let body_end = pos + 4 + size
        if body_end > file_len { return at_cover_empty() }
        if block_type == 6 {
            if body_end > AT_COVER_SCAN_MAX_BYTES {
                return at_cover_limit_error()
            }
            let body_result = at_read_exact_fd(fd, size)
            if std::map::get(body_result, "error") != "" {
                return at_cover_error("audio I/O error: " + std::map::get(body_result, "error"))
            }
            let body = std::map::get(body_result, "data")
            let image = at_flac_picture(body, 0, size)
            if std::bytes::length(image) > 0 { return at_cover_result(image, "") }
            if last { return at_cover_empty() }
            pos = body_end
            continue
        }
        if last { return at_cover_empty() }
        if body_end > AT_COVER_SCAN_MAX_BYTES {
            return at_cover_limit_error()
        }
        let seek = std::raw::syscall(8, fd, size, 1, 0, 0, 0)
        if seek < 0 { return at_cover_error("audio I/O error: " + rt_os_error(0 - seek)) }
        pos = body_end
    }
    at_cover_empty()
}

fn at_cover_wav_fd(fd: int, file_len: int) -> any {
    if file_len < 12 { return at_cover_empty() }
    let header_result = at_read_exact_fd(fd, 12)
    if std::map::get(header_result, "error") != "" {
        return at_cover_error("audio I/O error: " + std::map::get(header_result, "error"))
    }
    let header = std::map::get(header_result, "data")
    if !at_match(header, 0, "RIFF") || !at_match(header, 8, "WAVE") { return at_cover_empty() }
    let mut pos = 12
    let mut scanned = 12
    let mut guard = 0
    while guard < 10000 {
        guard += 1
        if scanned + 8 > AT_COVER_SCAN_MAX_BYTES {
            return at_cover_limit_error()
        }
        if pos + 8 > file_len { return at_cover_empty() }
        let chunk_result = at_read_exact_fd(fd, 8)
        if std::map::get(chunk_result, "error") != "" {
            return at_cover_error("audio I/O error: " + std::map::get(chunk_result, "error"))
        }
        let chunk = std::map::get(chunk_result, "data")
        scanned += 8
        let size = at_u32le(chunk, 4)
        let body_end = pos + 8 + size
        if body_end > file_len { return at_cover_empty() }
        let padding = size & 1
        if at_match(chunk, 0, "data") {
            // Audio payload is skipped with lseek and does not consume the
            // metadata scan budget. Metadata chunks may follow it in RIFF.
            let skip = size + padding
            let seek = std::raw::syscall(8, fd, skip, 1, 0, 0, 0)
            if seek < 0 { return at_cover_error("audio I/O error: " + rt_os_error(0 - seek)) }
            pos = body_end + padding
            continue
        }
        if at_match(chunk, 0, "id3 ") || at_match(chunk, 0, "ID3 ") {
            if scanned + size + padding > AT_COVER_SCAN_MAX_BYTES {
                return at_cover_limit_error()
            }
            let body_result = at_read_exact_fd(fd, size)
            if std::map::get(body_result, "error") != "" {
                return at_cover_error("audio I/O error: " + std::map::get(body_result, "error"))
            }
            let body = std::map::get(body_result, "data")
            let parsed = at_parse_id3_whole(body, at_empty_tags("", "wav"))
            let image = std::map::get(parsed, "_cover_bytes")
            if std::bytes::length(image) > 0 { return at_cover_result(image, "") }
            if padding > 0 {
                let pad_seek = std::raw::syscall(8, fd, padding, 1, 0, 0, 0)
                if pad_seek < 0 { return at_cover_error("audio I/O error: " + rt_os_error(0 - pad_seek)) }
            }
            pos = body_end + padding
            scanned += size + padding
            continue
        }
        if scanned + size + padding > AT_COVER_SCAN_MAX_BYTES {
            return at_cover_limit_error()
        }
        let skip = size + padding
        let seek = std::raw::syscall(8, fd, skip, 1, 0, 0, 0)
        if seek < 0 { return at_cover_error("audio I/O error: " + rt_os_error(0 - seek)) }
        pos = body_end + padding
        scanned += size + padding
    }
    at_cover_empty()
}

fn at_cover_from_file(path: string, format: string, function: string) -> any {
    let fd = rt_open(path, 524288, 0)
    if fd < 0 { at_fail(function, "audio I/O error: " + rt_os_error(0 - fd)) }
    let stat = rt_alloc(144)
    let metadata = std::raw::syscall(5, fd, stat, 0, 0, 0, 0)
    if metadata < 0 {
        rt_free_block(stat)
        std::raw::syscall(3, fd, 0, 0, 0, 0, 0)
        at_fail(function, "audio I/O error: " + rt_os_error(0 - metadata))
    }
    let file_len = std::raw::load(stat + 48)
    rt_free_block(stat)
    let mut result = at_cover_empty()
    if format == "mp3" { result = at_cover_mp3_fd(fd, file_len) }
    else if format == "flac" { result = at_cover_flac_fd(fd, file_len) }
    else if format == "wav" { result = at_cover_wav_fd(fd, file_len) }
    std::raw::syscall(3, fd, 0, 0, 0, 0, 0)
    let error = std::map::get(result, "error")
    if error != "" { at_fail(function, error) }
    std::map::get(result, "data")
}

fn at_track_info(path: string, function: string) -> any {
    rt_expect_str(path, function)
    let (head, tail, file_len) = at_read_head_tail(path, function)
    let n = rt_slen(head)
    if n == 0 {
        at_fail(function, "unsupported or corrupt audio file: " + path)
    }
    if n >= 12 && at_match(head, 0, "RIFF") && at_match(head, 8, "WAVE") {
        return at_wav_tags(path, head)
    }
    if n >= 4 && at_match(head, 0, "fLaC") {
        return at_flac_tags(path, head)
    }
    if n >= 4 && at_match(head, 0, "OggS") {
        return at_ogg_tags(path, head, tail)
    }
    if at_match(head, 0, "ID3") || (n >= 2 && at_u8(head, 0) == 255 && (at_u8(head, 1) & 224) == 224) {
        return at_mp3_tags(path, head, tail, file_len)
    }
    at_fail(function, "unsupported or corrupt audio file: unsupported audio file: " + path)
}

fn std__audio__tags(path: string) -> any {
    std::map::remove(at_track_info(path, "std::audio::tags"), "_cover_bytes")
}

fn std__audio__duration(path: string) -> any {
    std::map::get(at_track_info(path, "std::audio::duration"), "duration_secs")
}

fn std__audio__cover(path: string) -> any {
    let info = at_track_info(path, "std::audio::cover")
    // Always use the bounded range reader, even when the 1 MiB tag head
    // happened to contain a complete APIC/PICTURE frame. This makes Titan
    // enforce the same declared-metadata limit as Rust on every path.
    at_cover_from_file(path, std::map::get(info, "format"), "std::audio::cover")
}

fn at_ascii_lower(value: string) -> string {
    let bytes = std::encoding::utf8_encode(value)
    let b = sb_new(rt_slen(bytes))
    let mut i = 0
    while i < rt_slen(bytes) {
        let c = at_u8(bytes, i)
        sb_byte(b, if c >= 65 && c <= 90 { c + 32 } else { c })
        i += 1
    }
    sb_finish(b)
}

fn at_audio_extension(path: string) -> bool {
    let ext = std__path__extension(path)
    if ext == nil { return false }
    let lower = at_ascii_lower(ext)
    lower == "mp3" || lower == "wav" || lower == "flac" || lower == "ogg" || lower == "oga" || lower == "opus"
}

// Rust keeps every TrackInfo even when distinct non-UTF-8 filesystem names
// collapse to the same lossy display path. Store a stable list per display
// path instead of a single value, then flatten the lexically ordered map.
fn at_scan_add(groups0: any, path: string, info: any) -> any {
    let previous = std::map::get(groups0, path)
    let group = if previous == nil { [] } else { previous }
    std::map::insert(groups0, path, std::array::push(group, info))
}

fn at_scan_walk(dir: string, depth: int, groups0: any, examined0: int) -> (any, int) {
    let mut groups = groups0
    let mut examined = examined0
    if depth > 8 || examined >= AT_SCAN_MAX_ENTRIES { return (groups, examined) }
    // Stream getdents64 instead of calling rt_read_dir, which materializes an
    // entire directory. This keeps both the visited-entry budget and memory
    // bounded even when a directory contains millions of names.
    let fd = rt_open(dir, 589824, 0)
    if fd < 0 { return (groups, examined) }
    let buffer = rt_alloc(32768)
    let mut available = 0
    let mut offset = 0
    loop {
        if examined >= AT_SCAN_MAX_ENTRIES { break }
        if offset >= available {
            available = std::raw::syscall(217, fd, buffer, 32768, 0, 0, 0)
            if available == -4 { continue }
            if available <= 0 { break }
            offset = 0
        }
        let entry = buffer + offset
        let reclen = std::raw::load8(entry + 16) + 256 * std::raw::load8(entry + 17)
        if reclen < 19 || offset + reclen > available { break }
        let name = rt_from_cstr(entry + 19)
        offset += reclen
        if name == "." || name == ".." { continue }
        examined += 1
        let path = std__path__join(dir, name)
        if std__fs__is_dir(path) {
            let (next_groups, next_examined) = at_scan_walk(path, depth + 1, groups, examined)
            groups = next_groups
            examined = next_examined
            0
        } else if at_audio_extension(path) {
            match std::try::catch(|| at_track_info(path, "std::audio::scan_library")) {
                Result::Ok(info) => {
                    groups = at_scan_add(groups, at_lossy_path(path), std::map::remove(info, "_cover_bytes"))
                    0
                },
                Result::Err(_) => 0,
            }
        } else {
            0
        }
    }
    rt_free_block(buffer)
    std::raw::syscall(3, fd, 0, 0, 0, 0, 0)
    return (groups, examined)
}

fn std__audio__scan_library(dir: string) -> any {
    rt_expect_str(dir, "std::audio::scan_library")
    if !std__fs__is_dir(dir) {
        at_fail("std::audio::scan_library", "invalid parameter: '" + dir + "' is not a directory")
    }
    let (groups, _count) = at_scan_walk(dir, 0, std::map::new(), 0)
    let mut tracks = []
    for group in std::map::values(groups) {
        for info in group {
            tracks = std::array::push(tracks, info)
        }
    }
    tracks
}

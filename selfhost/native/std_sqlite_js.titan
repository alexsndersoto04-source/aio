// std::sqlite en Titan, parte 18: funciones JSON (json, json_array, json_object, json_extract, ->, ->>,
// json_type, json_array_length, json_quote, json_set/insert/replace/remove/patch/pretty, json_valid,
// json_group_array/object) y funciones con valores de tabla json_each / json_tree. Prefijo `sj`.
// Los subtipos JSON de SQLite se simulan con un prefijo (byte 1) que solo ponen las llamadas anidadas.

struct Jv {
    k: int,
    s: string,
    r: string,
    a: array,
    b: array,
    c: array,
    p: int,
}

// k: 0 null, 1 true, 2 false, 3 entero, 4 real, 5 texto, 6 arreglo, 7 objeto
fn sj_pint(s: string) -> int {
    match std::text::parse_int(s) {
        Option::Some(x) => x,
        _ => 0,
    }
}

fn sj_blen(s: string) -> int {
    len(sq_utf8(s))
}

fn sj_hdr(n: int) -> int {
    if n <= 11 {
        return 1
    }
    if n <= 255 {
        return 2
    }
    if n <= 65535 {
        return 3
    }
    5
}

fn sj_z(v: Jv) -> int {
    sj_hdr(v.p) + v.p
}

fn sj_keyz(raw: string) -> int {
    let n = sj_blen(raw)
    sj_hdr(n) + n
}

fn sj_psize(k: int, s: string, r: string, a: array, c: array) -> int {
    if k <= 2 {
        return 0
    }
    if k == 3 || k == 4 {
        return sj_blen(s)
    }
    if k == 5 {
        return sj_blen(r)
    }
    let mut t = 0
    let mut i = 0
    while i < len(a) {
        t += sj_z(a[i])
        if k == 7 {
            t += sj_keyz(c[i])
        }
        i += 1
    }
    t
}

fn sj_mk(k: int, s: string, r: string, a: array, b: array, c: array) -> Jv {
    Jv { k: k, s: s, r: r, a: a, b: b, c: c, p: sj_psize(k, s, r, a, c) }
}

fn sj_null() -> Jv {
    sj_mk(0, "", "", [], [], [])
}

fn sj_hexv(c: int) -> int {
    if c >= 48 && c <= 57 {
        return c - 48
    }
    if c >= 97 && c <= 102 {
        return c - 87
    }
    if c >= 65 && c <= 70 {
        return c - 55
    }
    -1
}

fn sj_hex4(cp: int) -> string {
    let d = "0123456789abcdef"
    let ch = std::text::chars(d)
    let mut s = "\\u"
    let mut sh = 4096
    while sh >= 1 {
        s = s + ch[(cp / sh) % 16]
        sh = sh / 16
    }
    s
}

fn sj_utf8_push(db: array, cp: int) -> array {
    if cp < 128 {
        return std::array::push(db, cp)
    }
    if cp < 2048 {
        return std::array::push(std::array::push(db, 192 + cp / 64), 128 + cp % 64)
    }
    if cp < 65536 {
        return std::array::push(std::array::push(std::array::push(db, 224 + cp / 4096), 128 + (cp / 64) % 64), 128 + cp % 64)
    }
    std::array::push(std::array::push(std::array::push(std::array::push(db, 240 + cp / 262144), 128 + (cp / 4096) % 64), 128 + (cp / 64) % 64), 128 + cp % 64)
}

// escapa un byte de control como lo hace SQLite
fn sj_esc_ctl(db: array, c: int) -> array {
    let mut o = db
    if c == 8 {
        return std::array::push(std::array::push(o, 92), 98)
    }
    if c == 12 {
        return std::array::push(std::array::push(o, 92), 102)
    }
    if c == 10 {
        return std::array::push(std::array::push(o, 92), 110)
    }
    if c == 13 {
        return std::array::push(std::array::push(o, 92), 114)
    }
    if c == 9 {
        return std::array::push(std::array::push(o, 92), 116)
    }
    let h = sj_hex4(c)
    for x in sq_utf8(h) {
        o = std::array::push(o, x)
    }
    o
}

// texto -> contenido de cadena JSON escapado (sin comillas)
fn sj_escape(s: string) -> string {
    let bs = sq_utf8(s)
    let mut o = []
    for c in bs {
        if c == 34 {
            o = std::array::push(std::array::push(o, 92), 34)
        } else if c == 92 {
            o = std::array::push(std::array::push(o, 92), 92)
        } else if c < 32 {
            o = sj_esc_ctl(o, c)
        } else {
            o = std::array::push(o, c)
        }
    }
    sq_dec_text(o, 0, len(o))
}

fn sj_str_lit(s: string) -> string {
    "\"" + sj_escape(s) + "\""
}

fn sj_join(parts: array, sep: string) -> string {
    let mut s = ""
    let mut i = 0
    for x in parts {
        if i > 0 {
            s = s + sep
        }
        s = s + x
        i += 1
    }
    s
}

// ------------------------------------------------------------ análisis

fn sj_ws(b: array, i: int, strict: bool) -> int {
    let n = len(b)
    let mut j = i
    while j < n {
        let c = b[j]
        if c == 32 || c == 9 || c == 10 || c == 13 {
            j += 1
        } else if !strict && (c == 11 || c == 12) {
            j += 1
        } else if !strict && c == 47 && j + 1 < n && b[j + 1] == 47 {
            j += 2
            while j < n && b[j] != 10 {
                j += 1
            }
        } else if !strict && c == 47 && j + 1 < n && b[j + 1] == 42 {
            j += 2
            let mut done = false
            while j + 1 < n && !done {
                if b[j] == 42 && b[j + 1] == 47 {
                    done = true
                    j += 2
                } else {
                    j += 1
                }
            }
            if !done {
                return -1
            }
        } else {
            return j
        }
    }
    j
}

fn sj_lit_at(b: array, i: int, w: string) -> bool {
    let wb = sq_utf8(w)
    if i + len(wb) > len(b) {
        return false
    }
    let mut k = 0
    while k < len(wb) {
        if b[i + k] != wb[k] {
            return false
        }
        k += 1
    }
    true
}

fn sj_isdig(c: int) -> bool {
    c >= 48 && c <= 57
}

fn sj_isid0(c: int) -> bool {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 || c == 36 || c >= 128
}

// devuelve (decodificado, crudo, siguiente); siguiente < 0 = error
fn sj_pstr(b: array, i: int, strict: bool) -> (string, string, int) {
    let n = len(b)
    let q = b[i]
    let mut j = i + 1
    let mut db = []
    let mut rb = []
    while true {
        if j >= n {
            return ("", "", -1)
        }
        let c = b[j]
        if c == q {
            return (sq_dec_text(db, 0, len(db)), sq_dec_text(rb, 0, len(rb)), j + 1)
        }
        if c == 92 {
            if j + 1 >= n {
                return ("", "", -1)
            }
            let e = b[j + 1]
            if e == 34 || e == 92 || e == 47 {
                db = std::array::push(db, e)
                rb = std::array::push(std::array::push(rb, 92), e)
                j += 2
            } else if e == 98 {
                db = std::array::push(db, 8)
                rb = std::array::push(std::array::push(rb, 92), 98)
                j += 2
            } else if e == 102 {
                db = std::array::push(db, 12)
                rb = std::array::push(std::array::push(rb, 92), 102)
                j += 2
            } else if e == 110 {
                db = std::array::push(db, 10)
                rb = std::array::push(std::array::push(rb, 92), 110)
                j += 2
            } else if e == 114 {
                db = std::array::push(db, 13)
                rb = std::array::push(std::array::push(rb, 92), 114)
                j += 2
            } else if e == 116 {
                db = std::array::push(db, 9)
                rb = std::array::push(std::array::push(rb, 92), 116)
                j += 2
            } else if e == 117 {
                if j + 5 >= n {
                    return ("", "", -1)
                }
                let mut cp = 0
                let mut k = 0
                while k < 4 {
                    let hv = sj_hexv(b[j + 2 + k])
                    if hv < 0 {
                        return ("", "", -1)
                    }
                    cp = cp * 16 + hv
                    k += 1
                }
                let mut used = 6
                if cp >= 55296 && cp <= 56319 && j + 11 < n + 0 && b[j + 6] == 92 && b[j + 7] == 117 {
                    let mut lo = 0
                    let mut k2 = 0
                    let mut okh = true
                    while k2 < 4 {
                        let hv2 = sj_hexv(b[j + 8 + k2])
                        if hv2 < 0 {
                            okh = false
                        } else {
                            lo = lo * 16 + hv2
                        }
                        k2 += 1
                    }
                    if okh && lo >= 56320 && lo <= 57343 {
                        cp = 65536 + (cp - 55296) * 1024 + (lo - 56320)
                        used = 12
                    }
                }
                db = sj_utf8_push(db, cp)
                let mut k3 = 0
                while k3 < used {
                    rb = std::array::push(rb, b[j + k3])
                    k3 += 1
                }
                j += used
            } else if !strict && e == 120 {
                if j + 3 >= n {
                    return ("", "", -1)
                }
                let h1 = sj_hexv(b[j + 2])
                let h2 = sj_hexv(b[j + 3])
                if h1 < 0 || h2 < 0 {
                    return ("", "", -1)
                }
                let cp = h1 * 16 + h2
                db = sj_utf8_push(db, cp)
                for x in sq_utf8(sj_hex4(cp)) {
                    rb = std::array::push(rb, x)
                }
                j += 4
            } else if !strict && e == 39 {
                db = std::array::push(db, 39)
                rb = std::array::push(rb, 39)
                j += 2
            } else if !strict && e == 118 {
                db = std::array::push(db, 11)
                for x in sq_utf8(sj_hex4(11)) {
                    rb = std::array::push(rb, x)
                }
                j += 2
            } else if !strict && e == 48 && !(j + 2 < n && sj_isdig(b[j + 2])) {
                db = std::array::push(db, 0)
                for x in sq_utf8(sj_hex4(0)) {
                    rb = std::array::push(rb, x)
                }
                j += 2
            } else if !strict && e == 10 {
                j += 2
            } else {
                return ("", "", -1)
            }
        } else if c < 32 {
            if strict {
                return ("", "", -1)
            }
            db = std::array::push(db, c)
            rb = sj_esc_ctl(rb, c)
            j += 1
        } else if c == 34 && q == 39 {
            db = std::array::push(db, 34)
            rb = std::array::push(std::array::push(rb, 92), 34)
            j += 1
        } else {
            db = std::array::push(db, c)
            rb = std::array::push(rb, c)
            j += 1
        }
    }
    return ("", "", -1)
}

fn sj_digits(b: array, i: int) -> (string, int) {
    let mut j = i
    let mut o = []
    while j < len(b) && sj_isdig(b[j]) {
        o = std::array::push(o, b[j])
        j += 1
    }
    return (sq_dec_text(o, 0, len(o)), j)
}

fn sj_pnum(b: array, i: int, strict: bool) -> (Jv, int) {
    let n = len(b)
    let mut j = i
    let mut neg = ""
    if b[j] == 45 {
        neg = "-"
        j += 1
    } else if b[j] == 43 && !strict {
        j += 1
    }
    if j >= n {
        return (sj_null(), -1)
    }
    if !strict && sj_lit_at(b, j, "Infinity") {
        return (sj_mk(4, neg + "9e999", "", [], [], []), j + 8)
    }
    if !strict && sj_lit_at(b, j, "NaN") {
        return (sj_null(), j + 3)
    }
    if !strict && b[j] == 48 && j + 1 < n && (b[j + 1] == 120 || b[j + 1] == 88) {
        let mut v = 0
        let mut k = j + 2
        let mut cnt = 0
        while k < n && sj_hexv(b[k]) >= 0 {
            v = v * 16 + sj_hexv(b[k])
            k += 1
            cnt += 1
        }
        if cnt == 0 {
            return (sj_null(), -1)
        }
        return (sj_mk(3, neg + "{v}", "", [], [], []), k)
    }
    let (ip, j1) = sj_digits(b, j)
    j = j1
    if len(sq_utf8(ip)) > 1 && b[j - len(sq_utf8(ip))] == 48 {
        return (sj_null(), -1)
    }
    let mut isreal = false
    let mut fp = ""
    let mut dot = false
    if j < n && b[j] == 46 {
        dot = true
        isreal = true
        let (f2, j2) = sj_digits(b, j + 1)
        fp = f2
        j = j2
    }
    if ip == "" && fp == "" {
        return (sj_null(), -1)
    }
    if strict && (ip == "" || (dot && fp == "")) {
        return (sj_null(), -1)
    }
    let mut ex = ""
    if j < n && (b[j] == 101 || b[j] == 69) {
        isreal = true
        let mut k = j + 1
        let mut sg = ""
        if k < n && (b[k] == 43 || b[k] == 45) {
            sg = sq_dec_text(b, k, 1)
            k += 1
        }
        let (ed, k2) = sj_digits(b, k)
        if ed == "" {
            return (sj_null(), -1)
        }
        ex = sq_dec_text(b, j, 1) + sg + ed
        j = k2
    }
    let mut txt = neg
    if ip == "" {
        txt = txt + "0"
    } else {
        txt = txt + ip
    }
    if dot {
        if fp == "" {
            txt = txt + ".0"
        } else {
            txt = txt + "." + fp
        }
    }
    txt = txt + ex
    if isreal {
        return (sj_mk(4, txt, "", [], [], []), j)
    }
    return (sj_mk(3, txt, "", [], [], []), j)
}

fn sj_pv(b: array, i0: int, strict: bool, depth: int) -> (Jv, int) {
    if depth > 1000 {
        return (sj_null(), -1)
    }
    let n = len(b)
    let i = sj_ws(b, i0, strict)
    if i < 0 || i >= n {
        return (sj_null(), -1)
    }
    let c = b[i]
    if c == 91 {
        let mut vals = []
        let mut j = sj_ws(b, i + 1, strict)
        if j < 0 || j >= n {
            return (sj_null(), -1)
        }
        if b[j] == 93 {
            return (sj_mk(6, "", "", [], [], []), j + 1)
        }
        while true {
            let (v, j2) = sj_pv(b, j, strict, depth + 1)
            if j2 < 0 {
                return (sj_null(), -1)
            }
            vals = std::array::push(vals, v)
            j = sj_ws(b, j2, strict)
            if j < 0 || j >= n {
                return (sj_null(), -1)
            }
            if b[j] == 44 {
                j = sj_ws(b, j + 1, strict)
                if j < 0 || j >= n {
                    return (sj_null(), -1)
                }
                if b[j] == 93 && !strict {
                    return (sj_mk(6, "", "", vals, [], []), j + 1)
                }
            } else if b[j] == 93 {
                return (sj_mk(6, "", "", vals, [], []), j + 1)
            } else {
                return (sj_null(), -1)
            }
        }
        return (sj_null(), -1)
    }
    if c == 123 {
        let mut vals = []
        let mut ks = []
        let mut rs = []
        let mut j = sj_ws(b, i + 1, strict)
        if j < 0 || j >= n {
            return (sj_null(), -1)
        }
        if b[j] == 125 {
            return (sj_mk(7, "", "", [], [], []), j + 1)
        }
        while true {
            let mut key = ""
            let mut raw = ""
            if b[j] == 34 || (b[j] == 39 && !strict) {
                let (kd, kr, j3) = sj_pstr(b, j, strict)
                if j3 < 0 {
                    return (sj_null(), -1)
                }
                key = kd
                raw = kr
                j = j3
            } else if !strict && sj_isid0(b[j]) {
                let mut k = j
                while k < n && (sj_isid0(b[k]) || sj_isdig(b[k])) {
                    k += 1
                }
                key = sq_dec_text(b, j, k - j)
                raw = sj_escape(key)
                j = k
            } else {
                return (sj_null(), -1)
            }
            j = sj_ws(b, j, strict)
            if j < 0 || j >= n || b[j] != 58 {
                return (sj_null(), -1)
            }
            let (v, j2) = sj_pv(b, j + 1, strict, depth + 1)
            if j2 < 0 {
                return (sj_null(), -1)
            }
            ks = std::array::push(ks, key)
            rs = std::array::push(rs, raw)
            vals = std::array::push(vals, v)
            j = sj_ws(b, j2, strict)
            if j < 0 || j >= n {
                return (sj_null(), -1)
            }
            if b[j] == 44 {
                j = sj_ws(b, j + 1, strict)
                if j < 0 || j >= n {
                    return (sj_null(), -1)
                }
                if b[j] == 125 && !strict {
                    return (sj_mk(7, "", "", vals, ks, rs), j + 1)
                }
            } else if b[j] == 125 {
                return (sj_mk(7, "", "", vals, ks, rs), j + 1)
            } else {
                return (sj_null(), -1)
            }
        }
        return (sj_null(), -1)
    }
    if c == 34 || (c == 39 && !strict) {
        let (d, r, j) = sj_pstr(b, i, strict)
        if j < 0 {
            return (sj_null(), -1)
        }
        return (sj_mk(5, d, r, [], [], []), j)
    }
    if c == 116 && sj_lit_at(b, i, "true") {
        return (sj_mk(1, "", "", [], [], []), i + 4)
    }
    if c == 102 && sj_lit_at(b, i, "false") {
        return (sj_mk(2, "", "", [], [], []), i + 5)
    }
    if c == 110 && sj_lit_at(b, i, "null") {
        return (sj_null(), i + 4)
    }
    if sj_isdig(c) || c == 45 || (!strict && (c == 43 || c == 46 || c == 73 || c == 78)) {
        return sj_pnum(b, i, strict)
    }
    return (sj_null(), -1)
}

// (valor, ok)
fn sj_parse(text: string, strict: bool) -> (Jv, bool) {
    let b = sq_utf8(text)
    let (v, j) = sj_pv(b, 0, strict, 0)
    if j < 0 {
        return (sj_null(), false)
    }
    let e = sj_ws(b, j, strict)
    if e < 0 || e != len(b) {
        return (sj_null(), false)
    }
    return (v, true)
}

// ------------------------------------------------------------ salida

fn sj_render(v: Jv) -> string {
    if v.k == 0 {
        return "null"
    }
    if v.k == 1 {
        return "true"
    }
    if v.k == 2 {
        return "false"
    }
    if v.k == 3 || v.k == 4 {
        return v.s
    }
    if v.k == 5 {
        return "\"" + v.r + "\""
    }
    let mut parts = []
    let mut i = 0
    while i < len(v.a) {
        if v.k == 7 {
            parts = std::array::push(parts, "\"" + v.c[i] + "\":" + sj_render(v.a[i]))
        } else {
            parts = std::array::push(parts, sj_render(v.a[i]))
        }
        i += 1
    }
    if v.k == 6 {
        return "[" + sj_join(parts, ",") + "]"
    }
    "{" + sj_join(parts, ",") + "}"
}

fn sj_pad(n: int) -> string {
    let mut s = ""
    let mut i = 0
    while i < n {
        s = s + "    "
        i += 1
    }
    s
}

fn sj_pretty(v: Jv, ind: int) -> string {
    if v.k < 6 {
        return sj_render(v)
    }
    if len(v.a) == 0 {
        if v.k == 6 {
            return "[]"
        }
        return "{}"
    }
    let mut parts = []
    let mut i = 0
    while i < len(v.a) {
        let mut line = sj_pad(ind + 1)
        if v.k == 7 {
            line = line + "\"" + v.c[i] + "\": "
        }
        parts = std::array::push(parts, line + sj_pretty(v.a[i], ind + 1))
        i += 1
    }
    let mut open = "["
    let mut close = "]"
    if v.k == 7 {
        open = "{"
        close = "}"
    }
    open + "\n" + sj_join(parts, ",\n") + "\n" + sj_pad(ind) + close
}

fn sj_real_text(f: float) -> string {
    if f > 1.7976931348623157e308 {
        return "9.0e+999"
    }
    if f < -1.7976931348623157e308 {
        return "-9.0e+999"
    }
    sc_fmt_real(f)
}

// valor SQL -> valor SQL a partir de un nodo
fn sj_to_sv(v: Jv) -> Sv {
    if v.k == 0 {
        return Sv::SNull
    }
    if v.k == 1 {
        return Sv::SInt(1)
    }
    if v.k == 2 {
        return Sv::SInt(0)
    }
    if v.k == 3 {
        return sc_num(Sv::SText(v.s))
    }
    if v.k == 4 {
        let n = sc_num(Sv::SText(v.s))
        match n {
            Sv::SInt(i) => {
                return Sv::SReal(std::math::to_float(i))
            },
            _ => {
                return n
            },
        }
    }
    if v.k == 5 {
        return Sv::SText(v.s)
    }
    Sv::SText(sj_render(v))
}

fn sj_type_name(v: Jv) -> string {
    if v.k == 0 {
        return "null"
    }
    if v.k == 1 {
        return "true"
    }
    if v.k == 2 {
        return "false"
    }
    if v.k == 3 {
        return "integer"
    }
    if v.k == 4 {
        return "real"
    }
    if v.k == 5 {
        return "text"
    }
    if v.k == 6 {
        return "array"
    }
    "object"
}

// ------------------------------------------------------------ valores SQL

fn sj_marked(v: Sv) -> bool {
    match v {
        Sv::SText(s) => {
            let bs = sq_utf8(s)
            len(bs) > 0 && bs[0] == 1
        },
        _ => false,
    }
}

fn sj_unmark(v: Sv) -> Sv {
    match v {
        Sv::SText(s) => {
            let bs = sq_utf8(s)
            if len(bs) > 0 && bs[0] == 1 {
                return Sv::SText(sq_dec_text(bs, 1, len(bs) - 1))
            }
            v
        },
        _ => v,
    }
}

fn sj_mark_sv(v: Sv) -> Sv {
    match v {
        Sv::SText(s) => sj_mark_text(s),
        _ => v,
    }
}

fn sj_mark_text(s: string) -> Sv {
    Sv::SText(sx_chr(1) + s)
}

fn sj_text_of(v: Sv) -> string {
    sc_to_text(sj_unmark(v))
}

// SQL -> nodo JSON ("nil" = blob)
fn sj_from_sv(v: Sv) -> Jv {
    match v {
        Sv::SNull => sj_null(),
        Sv::SInt(i) => sj_mk(3, "{i}", "", [], [], []),
        Sv::SReal(f) => sj_mk(4, sj_real_text(f), "", [], [], []),
        Sv::SText(s) => {
            if sj_marked(v) {
                let (j, ok) = sj_parse(sj_text_of(v), false)
                if ok {
                    return j
                }
            }
            sj_mk(5, s, sj_escape(s), [], [], [])
        },
        _ => sj_null(),
    }
}

fn sj_isblob(v: Sv) -> bool {
    match v {
        Sv::SBlob(_) => true,
        _ => false,
    }
}

// texto JSON de un valor SQL (para json_array, json_object y agregados)
fn sj_to_json(v: Sv) -> string {
    match v {
        Sv::SNull => "null",
        Sv::SInt(i) => "{i}",
        Sv::SReal(f) => sj_real_text(f),
        Sv::SText(s) => {
            if sj_marked(v) {
                return sj_text_of(v)
            }
            sj_str_lit(s)
        },
        _ => "null",
    }
}

// ------------------------------------------------------------ rutas

// componentes: (tipo, clave, n)  tipo 0 clave, 1 índice, 2 desde el final (#-n; # = n 0)
fn sj_ppath(p: string) -> (array, bool) {
    let b = sq_utf8(p)
    let n = len(b)
    if n == 0 || b[0] != 36 {
        return ([], false)
    }
    let mut comps = []
    let mut j = 1
    while j < n {
        let c = b[j]
        if c == 46 {
            j += 1
            if j >= n {
                return ([], false)
            }
            if b[j] == 34 {
                let mut k = j + 1
                while k < n && b[k] != 34 {
                    k += 1
                }
                if k >= n {
                    return ([], false)
                }
                comps = std::array::push(comps, (0, sq_dec_text(b, j + 1, k - j - 1), 0))
                j = k + 1
            } else {
                let mut k = j
                while k < n && b[k] != 46 && b[k] != 91 {
                    k += 1
                }
                if k == j {
                    return ([], false)
                }
                comps = std::array::push(comps, (0, sq_dec_text(b, j, k - j), 0))
                j = k
            }
        } else if c == 91 {
            j += 1
            if j >= n {
                return ([], false)
            }
            if b[j] == 35 {
                j += 1
                let mut m = 0
                if j < n && b[j] == 45 {
                    let (ds, j2) = sj_digits(b, j + 1)
                    if ds == "" {
                        return ([], false)
                    }
                    m = sj_pint(ds)
                    j = j2
                }
                if j >= n || b[j] != 93 {
                    return ([], false)
                }
                comps = std::array::push(comps, (2, "", m))
                j += 1
            } else {
                let (ds, j2) = sj_digits(b, j)
                if ds == "" || j2 >= n || b[j2] != 93 {
                    return ([], false)
                }
                comps = std::array::push(comps, (1, "", sj_pint(ds)))
                j = j2 + 1
            }
        } else {
            return ([], false)
        }
    }
    return (comps, true)
}

fn sj_keyidx(v: Jv, key: string) -> int {
    let mut i = 0
    while i < len(v.b) {
        if v.b[i] == key {
            return i
        }
        i += 1
    }
    -1
}

// índice de un componente dentro de un contenedor; -1 si no existe
fn sj_compidx(v: Jv, c: (int, string, int)) -> int {
    if c.0 == 0 {
        if v.k != 7 {
            return -1
        }
        return sj_keyidx(v, c.1)
    }
    if v.k != 6 {
        return -1
    }
    if c.0 == 1 {
        return c.2
    }
    len(v.a) - c.2
}

fn sj_find(v: Jv, comps: array, ci: int) -> (bool, Jv) {
    if ci >= len(comps) {
        return (true, v)
    }
    let idx = sj_compidx(v, comps[ci])
    if idx < 0 || idx >= len(v.a) {
        return (false, sj_null())
    }
    sj_find(v.a[idx], comps, ci + 1)
}

fn sj_piece(key: string) -> string {
    let bs = sq_utf8(key)
    let mut ok = len(bs) > 0
    let mut i = 0
    while i < len(bs) {
        let c = bs[i]
        let al = (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
        let dg = c >= 48 && c <= 57
        if i == 0 {
            if !al {
                ok = false
            }
        } else if !al && !dg {
            ok = false
        }
        i += 1
    }
    if ok {
        return "." + key
    }
    ".\"" + key + "\""
}

fn sj_comps_str(comps: array, upto: int) -> string {
    let mut s = "$"
    let mut i = 0
    while i < upto {
        let c = comps[i]
        if c.0 == 0 {
            s = s + sj_piece(c.1)
        } else if c.0 == 1 {
            let m1 = c.2
            s = s + "[" + "{m1}" + "]"
        } else if c.2 == 0 {
            s = s + "[#]"
        } else {
            let m2 = c.2
            s = s + "[#-" + "{m2}" + "]"
        }
        i += 1
    }
    s
}

// ------------------------------------------------------------ modificación

fn sj_arr(a: array) -> Jv {
    sj_mk(6, "", "", a, [], [])
}

fn sj_obj_empty() -> Jv {
    sj_mk(7, "", "", [], [], [])
}

fn sj_with_child(v: Jv, idx: int, ch: Jv) -> Jv {
    sj_mk(v.k, v.s, v.r, std::array::set(v.a, idx, ch), v.b, v.c)
}

fn sj_remove_at(v: Jv, idx: int) -> Jv {
    let mut na = []
    let mut nb = []
    let mut nc = []
    let mut i = 0
    while i < len(v.a) {
        if i != idx {
            na = std::array::push(na, v.a[i])
            if v.k == 7 {
                nb = std::array::push(nb, v.b[i])
                nc = std::array::push(nc, v.c[i])
            }
        }
        i += 1
    }
    sj_mk(v.k, v.s, v.r, na, nb, nc)
}

fn sj_append(v: Jv, comp: (int, string, int), nv: Jv) -> Jv {
    if v.k == 7 {
        return sj_mk(7, "", "", std::array::push(v.a, nv), std::array::push(v.b, comp.1), std::array::push(v.c, sj_escape(comp.1)))
    }
    sj_mk(6, "", "", std::array::push(v.a, nv), [], [])
}

// modo: 0 insert, 1 replace, 2 set
fn sj_put(v: Jv, comps: array, ci: int, nv: Jv, mode: int) -> Jv {
    if ci >= len(comps) {
        return nv
    }
    let c = comps[ci]
    if c.0 == 0 && v.k != 7 {
        return v
    }
    if c.0 != 0 && v.k != 6 {
        return v
    }
    let idx = sj_compidx(v, c)
    let last = ci == len(comps) - 1
    if idx >= 0 && idx < len(v.a) {
        if last {
            if mode == 0 {
                return v
            }
            return sj_with_child(v, idx, nv)
        }
        let ch = sj_put(v.a[idx], comps, ci + 1, nv, mode)
        return sj_with_child(v, idx, ch)
    }
    if c.0 != 0 && idx != len(v.a) {
        return v
    }
    if mode == 1 {
        return v
    }
    if last {
        return sj_append(v, c, nv)
    }
    let nx = comps[ci + 1]
    let mut empty = sj_obj_empty()
    if nx.0 != 0 {
        empty = sj_arr([])
    }
    let ch2 = sj_put(empty, comps, ci + 1, nv, mode)
    if sj_z(ch2) == sj_z(empty) && len(ch2.a) == 0 {
        return v
    }
    sj_append(v, c, ch2)
}

fn sj_del(v: Jv, comps: array, ci: int) -> Jv {
    let c = comps[ci]
    let idx = sj_compidx(v, c)
    if idx < 0 || idx >= len(v.a) {
        return v
    }
    if ci == len(comps) - 1 {
        return sj_remove_at(v, idx)
    }
    sj_with_child(v, idx, sj_del(v.a[idx], comps, ci + 1))
}

fn sj_patch(t: Jv, p: Jv) -> Jv {
    if p.k != 7 {
        return p
    }
    let mut base = sj_obj_empty()
    if t.k == 7 {
        base = t
    }
    let mut i = 0
    while i < len(p.a) {
        let key = p.b[i]
        let pv = p.a[i]
        let idx = sj_keyidx(base, key)
        if pv.k == 0 {
            if idx >= 0 {
                base = sj_remove_at(base, idx)
            }
        } else {
            let mut ex = sj_null()
            if idx >= 0 {
                ex = base.a[idx]
            }
            let nv = sj_patch(ex, pv)
            if idx >= 0 {
                base = sj_with_child(base, idx, nv)
            } else {
                base = sj_mk(7, "", "", std::array::push(base.a, nv), std::array::push(base.b, key), std::array::push(base.c, p.c[i]))
            }
        }
        i += 1
    }
    base
}

// ------------------------------------------------------------ funciones escalares

// (estado, nodo) estado: 0 ok, 1 nulo, 2 mal formado
fn sj_doc(v: Sv) -> (int, Jv) {
    let u = sj_unmark(v)
    if sx_isnull(u) {
        return (1, sj_null())
    }
    let (j, ok) = sj_parse(sc_to_text(u), false)
    if !ok {
        return (2, sj_null())
    }
    return (0, j)
}

fn sj_path_of(v: Sv) -> (array, bool) {
    sj_ppath(sc_to_text(sj_unmark(v)))
}

fn sj_bad_path(v: Sv) -> Sv {
    Sv::SErr("bad JSON path: '" + sc_to_text(sj_unmark(v)) + "'")
}

fn sj_extract_one(root: Jv, comps: array) -> (bool, Jv) {
    sj_find(root, comps, 0)
}

fn sj_func(cx: Cx, name: string, args: array) -> Option {
    let n = len(args)
    if name == "json" {
        let (st, j) = sj_doc(args[0])
        if st == 1 {
            return Option::Some(Sv::SNull)
        }
        if st == 2 {
            return Option::Some(Sv::SErr("malformed JSON"))
        }
        return Option::Some(Sv::SText(sj_render(j)))
    }
    if name == "json_valid" {
        let u = sj_unmark(args[0])
        if sx_isnull(u) {
            return Option::Some(Sv::SNull)
        }
        let mut flags = 1
        if n > 1 {
            flags = sc_to_int(args[1])
        }
        if flags < 1 || flags > 15 {
            return Option::Some(Sv::SErr("FLAGS parameter to json_valid() must be between 1 and 15"))
        }
        let text = sc_to_text(u)
        let mut ok = false
        if flags % 2 == 1 {
            let (j1, ok1) = sj_parse(text, true)
            if ok1 {
                ok = true
            }
        }
        if !ok && (flags / 2) % 2 == 1 {
            let (j2, ok2) = sj_parse(text, false)
            if ok2 {
                ok = true
            }
        }
        if ok {
            return Option::Some(Sv::SInt(1))
        }
        return Option::Some(Sv::SInt(0))
    }
    if name == "json_array" {
        let mut parts = []
        for a in args {
            parts = std::array::push(parts, sj_to_json(a))
        }
        return Option::Some(Sv::SText("[" + sj_join(parts, ",") + "]"))
    }
    if name == "json_object" {
        if n % 2 == 1 {
            return Option::Some(Sv::SErr("json_object() requires an even number of arguments"))
        }
        let mut parts = []
        let mut i = 0
        while i < n {
            let lab = sj_unmark(args[i])
            let mut ok = false
            match lab {
                Sv::SText(_) => {
                    ok = true
                },
                _ => {},
            }
            if !ok {
                return Option::Some(Sv::SErr("json_object() labels must be TEXT"))
            }
            parts = std::array::push(parts, sj_str_lit(sc_to_text(lab)) + ":" + sj_to_json(args[i + 1]))
            i += 2
        }
        return Option::Some(Sv::SText("{" + sj_join(parts, ",") + "}"))
    }
    if name == "json_quote" {
        return Option::Some(Sv::SText(sj_to_json(args[0])))
    }
    if name == "json_extract" {
        let (st, j) = sj_doc(args[0])
        if st == 2 {
            return Option::Some(Sv::SErr("malformed JSON"))
        }
        if n < 2 {
            return Option::Some(Sv::SNull)
        }
        let mut results = []
        let mut i = 1
        while i < n {
            if sx_isnull(args[i]) {
                if n == 2 {
                    return Option::Some(Sv::SNull)
                }
                results = std::array::push(results, sj_null())
            } else {
                let (comps, okp) = sj_path_of(args[i])
                if !okp {
                    return Option::Some(sj_bad_path(args[i]))
                }
                if st == 1 {
                    return Option::Some(Sv::SNull)
                }
                let (found, nd) = sj_extract_one(j, comps)
                if n == 2 {
                    if !found {
                        return Option::Some(Sv::SNull)
                    }
                    return Option::Some(sj_to_sv(nd))
                }
                if found {
                    results = std::array::push(results, nd)
                } else {
                    results = std::array::push(results, sj_null())
                }
            }
            i += 1
        }
        if st == 1 {
            return Option::Some(Sv::SNull)
        }
        let mut parts = []
        for r in results {
            parts = std::array::push(parts, sj_render(r))
        }
        return Option::Some(Sv::SText("[" + sj_join(parts, ",") + "]"))
    }
    if name == "json_type" || name == "json_array_length" {
        let (st, j) = sj_doc(args[0])
        if st == 2 {
            return Option::Some(Sv::SErr("malformed JSON"))
        }
        let mut nd = j
        if n > 1 {
            if sx_isnull(args[1]) {
                return Option::Some(Sv::SNull)
            }
            let (comps, okp) = sj_path_of(args[1])
            if !okp {
                return Option::Some(sj_bad_path(args[1]))
            }
            if st == 1 {
                return Option::Some(Sv::SNull)
            }
            let (found, nd2) = sj_find(j, comps, 0)
            if !found {
                return Option::Some(Sv::SNull)
            }
            nd = nd2
        }
        if st == 1 {
            return Option::Some(Sv::SNull)
        }
        if name == "json_type" {
            return Option::Some(Sv::SText(sj_type_name(nd)))
        }
        if nd.k == 6 {
            return Option::Some(Sv::SInt(len(nd.a)))
        }
        return Option::Some(Sv::SInt(0))
    }
    if name == "json_set" || name == "json_insert" || name == "json_replace" {
        if n % 2 == 0 {
            return Option::Some(Sv::SErr(name + "() needs an odd number of arguments"))
        }
        let (st, j) = sj_doc(args[0])
        if st == 2 {
            return Option::Some(Sv::SErr("malformed JSON"))
        }
        if st == 1 {
            return Option::Some(Sv::SNull)
        }
        let mut mode = 2
        if name == "json_insert" {
            mode = 0
        }
        if name == "json_replace" {
            mode = 1
        }
        let mut cur = j
        let mut i = 1
        while i < n {
            if !sx_isnull(args[i]) {
                let (comps, okp) = sj_path_of(args[i])
                if !okp {
                    return Option::Some(sj_bad_path(args[i]))
                }
                if sj_isblob(args[i + 1]) {
                    return Option::Some(Sv::SErr("JSON cannot hold BLOB values"))
                }
                let nv = sj_from_sv(args[i + 1])
                if len(comps) == 0 {
                    if mode != 0 {
                        cur = nv
                    }
                } else {
                    cur = sj_put(cur, comps, 0, nv, mode)
                }
            }
            i += 2
        }
        return Option::Some(Sv::SText(sj_render(cur)))
    }
    if name == "json_remove" {
        let (st, j) = sj_doc(args[0])
        if st == 2 {
            return Option::Some(Sv::SErr("malformed JSON"))
        }
        if st == 1 {
            return Option::Some(Sv::SNull)
        }
        let mut cur = j
        let mut i = 1
        while i < n {
            if sx_isnull(args[i]) {
                return Option::Some(Sv::SNull)
            }
            let (comps, okp) = sj_path_of(args[i])
            if !okp {
                return Option::Some(sj_bad_path(args[i]))
            }
            if len(comps) == 0 {
                return Option::Some(Sv::SNull)
            }
            cur = sj_del(cur, comps, 0)
            i += 1
        }
        return Option::Some(Sv::SText(sj_render(cur)))
    }
    if name == "json_patch" {
        let (st, j) = sj_doc(args[0])
        if st == 2 {
            return Option::Some(Sv::SErr("malformed JSON"))
        }
        let (st2, p) = sj_doc(args[1])
        if st2 == 2 {
            return Option::Some(Sv::SErr("malformed JSON"))
        }
        if st == 1 || st2 == 1 {
            return Option::Some(Sv::SNull)
        }
        return Option::Some(Sv::SText(sj_render(sj_patch(j, p))))
    }
    if name == "json_pretty" {
        let (st, j) = sj_doc(args[0])
        if st == 2 {
            return Option::Some(Sv::SErr("malformed JSON"))
        }
        if st == 1 {
            return Option::Some(Sv::SNull)
        }
        return Option::Some(Sv::SText(sj_pretty(j, 0)))
    }
    if name == "json_error_position" {
        let u = sj_unmark(args[0])
        if sx_isnull(u) {
            return Option::Some(Sv::SNull)
        }
        let (j, ok) = sj_parse(sc_to_text(u), false)
        if ok {
            return Option::Some(Sv::SInt(0))
        }
        return Option::Some(Sv::SInt(1))
    }
    Option::None
}

fn sj_arity(name: string) -> (int, int) {
    if name == "json" || name == "json_quote" || name == "json_error_position" {
        return (1, 1)
    }
    if name == "json_valid" || name == "json_type" || name == "json_array_length" || name == "json_pretty" {
        return (1, 2)
    }
    if name == "json_array" || name == "json_object" {
        return (0, -1)
    }
    if name == "json_extract" || name == "json_remove" || name == "json_set" || name == "json_insert" || name == "json_replace" {
        return (1, -1)
    }
    if name == "json_patch" {
        return (2, 2)
    }
    return (-2, 0)
}

// `->` y `->>`
fn sj_arrow(op: string, a: Sv, b: Sv) -> Sv {
    let (st, j) = sj_doc(a)
    if st == 2 {
        return Sv::SErr("malformed JSON")
    }
    let rb = sj_unmark(b)
    if sx_isnull(rb) {
        return Sv::SNull
    }
    let mut comps = []
    match rb {
        Sv::SInt(i) => {
            if i < 0 {
                return Sv::SErr("bad JSON path: '{i}'")
            }
            comps = [(1, "", i)]
        },
        Sv::SText(s) => {
            let bs = sq_utf8(s)
            if len(bs) == 0 {
                return Sv::SErr("bad JSON path: ''")
            }
            if bs[0] == 36 || bs[0] == 91 {
                let mut ps = s
                if bs[0] == 91 {
                    ps = "$" + s
                }
                let (c2, ok) = sj_ppath(ps)
                if !ok {
                    return Sv::SErr("bad JSON path: '" + s + "'")
                }
                comps = c2
            } else {
                comps = [(0, s, 0)]
            }
        },
        _ => {
            comps = [(0, sc_to_text(rb), 0)]
        },
    }
    if st == 1 {
        return Sv::SNull
    }
    let (found, nd) = sj_find(j, comps, 0)
    if !found {
        return Sv::SNull
    }
    if op == "->>" {
        return sj_to_sv(nd)
    }
    Sv::SText(sj_render(nd))
}

// ------------------------------------------------------------ marcado de subtipo

fn sj_is_jfn(name: string) -> bool {
    name == "json" || name == "json_array" || name == "json_object" || name == "json_insert" || name == "json_replace" || name == "json_set" || name == "json_remove" || name == "json_patch" || name == "json_quote" || name == "json_group_array" || name == "json_group_object" || name == "json_pretty"
}

fn sj_is_jexpr(cx: Cx, e: Ex, v: Sv) -> bool {
    match e {
        Ex::EAgg(i) => {
            return sj_marked(cx.aggs[i])
        },
        Ex::EFn(p) => {
            let nm = sx_lc(p.0)
            if sj_is_jfn(nm) {
                return true
            }
            if nm == "json_extract" {
                return sj_starts_container(v)
            }
            false
        },
        Ex::EBin(p) => {
            if p.0 == "->" {
                return sj_starts_container(v)
            }
            false
        },
        _ => false,
    }
}

fn sj_starts_container(v: Sv) -> bool {
    match v {
        Sv::SText(s) => {
            let bs = sq_utf8(s)
            len(bs) > 0 && (bs[0] == 91 || bs[0] == 123)
        },
        _ => false,
    }
}

// Marca los argumentos que son resultados directos de otra función JSON.
fn sj_mark(cx: Cx, name: string, exprs: array, args: array) -> array {
    if !std::text::starts_with(name, "json") {
        return args
    }
    let mut out = []
    let mut i = 0
    while i < len(args) {
        let a = args[i]
        let mut marked = false
        match a {
            Sv::SText(s) => {
                if i < len(exprs) && sj_is_jexpr(cx, exprs[i], a) {
                    marked = true
                }
            },
            _ => {},
        }
        if marked {
            out = std::array::push(out, sj_mark_text(sc_to_text(a)))
        } else {
            out = std::array::push(out, a)
        }
        i += 1
    }
    out
}

// ------------------------------------------------------------ json_each / json_tree

fn sj_table_cols(name: string) -> (array, string) {
    let nm = sx_lc(name)
    if nm == "json_each" || nm == "json_tree" {
        return (["key", "value", "type", "atom", "id", "parent", "fullkey", "path", "json", "root"], "")
    }
    return ([], "no such table: " + name)
}

fn sj_row(key: Sv, v: Jv, id: int, parent: Sv, fullkey: string, path: string, jtext: string, root: string) -> array {
    let val = sj_to_sv(v)
    let mut atom = Sv::SNull
    if v.k < 6 {
        atom = val
    }
    return [key, val, Sv::SText(sj_type_name(v)), atom, Sv::SInt(id), parent, Sv::SText(fullkey), Sv::SText(path), Sv::SText(jtext), Sv::SText(root)]
}

// offset del primer hijo dentro del contenedor cuyo encabezado está en voff
fn sj_pstart(v: Jv, voff: int) -> int {
    voff + sj_hdr(v.p)
}

fn sj_child_key(v: Jv, i: int) -> Sv {
    if v.k == 7 {
        return Sv::SText(v.b[i])
    }
    Sv::SInt(i)
}

fn sj_walk(v: Jv, voff: int, fullkey: string, myid: int, jtext: string, root: string, rows: array) -> array {
    let mut out = rows
    if v.k < 6 {
        return out
    }
    let mut off = sj_pstart(v, voff)
    let mut i = 0
    while i < len(v.a) {
        let ch = v.a[i]
        let mut kz = 0
        let mut piece = "[" + "{i}" + "]"
        if v.k == 7 {
            kz = sj_keyz(v.c[i])
            piece = sj_piece(v.b[i])
        }
        let fk = fullkey + piece
        out = std::array::push(out, sj_row(sj_child_key(v, i), ch, off, Sv::SInt(myid), fk, fullkey, jtext, root))
        out = sj_walk(ch, off + kz, fk, off, jtext, root, out)
        off += kz + sj_z(ch)
        i += 1
    }
    out
}

fn sj_table_rows(cx: Cx, name: string, argv: array) -> (array, string) {
    let nm = sx_lc(name)
    if len(argv) > 2 {
        return ([], "too many arguments on " + nm + "() - max 2")
    }
    if len(argv) == 0 {
        return ([], "")
    }
    let a0 = sj_unmark(argv[0])
    if sx_isnull(a0) {
        return ([], "")
    }
    let jtext = sc_to_text(a0)
    let (j, ok) = sj_parse(jtext, false)
    if !ok {
        return ([], "malformed JSON")
    }
    let mut root = "$"
    if len(argv) > 1 {
        if sx_isnull(argv[1]) {
            return ([], "")
        }
        root = sc_to_text(sj_unmark(argv[1]))
    }
    let (comps, okp) = sj_ppath(root)
    if !okp {
        return ([], "bad JSON path: '" + root + "'")
    }
    // localizar el destino con sus desplazamientos
    let mut cur = j
    let mut voff = 0
    let mut eoff = 0
    let mut ci = 0
    let mut lastkey = Sv::SNull
    while ci < len(comps) {
        let c = comps[ci]
        let idx = sj_compidx(cur, c)
        if idx < 0 || idx >= len(cur.a) {
            return ([], "")
        }
        let mut off = sj_pstart(cur, voff)
        let mut i = 0
        while i < idx {
            if cur.k == 7 {
                off += sj_keyz(cur.c[i])
            }
            off += sj_z(cur.a[i])
            i += 1
        }
        eoff = off
        lastkey = sj_child_key(cur, idx)
        if cur.k == 7 {
            off += sj_keyz(cur.c[idx])
        }
        voff = off
        cur = cur.a[idx]
        ci += 1
    }
    let mut rows = []
    if nm == "json_tree" {
        let mut path = "$"
        if len(comps) > 0 {
            path = sj_comps_str(comps, len(comps) - 1)
        }
        rows = std::array::push(rows, sj_row(lastkey, cur, eoff, Sv::SNull, root, path, jtext, root))
        rows = sj_walk(cur, voff, root, eoff, jtext, root, rows)
        return (rows, "")
    }
    if cur.k < 6 {
        rows = std::array::push(rows, sj_row(Sv::SNull, cur, eoff, Sv::SNull, root, root, jtext, root))
        return (rows, "")
    }
    let mut off = sj_pstart(cur, voff)
    let mut i = 0
    while i < len(cur.a) {
        let ch = cur.a[i]
        let mut kz = 0
        let mut piece = "[" + "{i}" + "]"
        if cur.k == 7 {
            kz = sj_keyz(cur.c[i])
            piece = sj_piece(cur.b[i])
        }
        rows = std::array::push(rows, sj_row(sj_child_key(cur, i), ch, off, Sv::SNull, root + piece, root, jtext, root))
        off += kz + sj_z(ch)
        i += 1
    }
    return (rows, "")
}

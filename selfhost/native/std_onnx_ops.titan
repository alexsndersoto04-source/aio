// std::onnx, operadores de los transformers (BERT y familia): comparaciones y lógica (tensores BOOL,
// dt 9, guardados como 0/1), Where, Expand, ConstantOfShape, GatherElements, GatherND, Slice, Range,
// Split, Pow, Min/Max, Erf, Gelu, LayerNormalization, Reciprocal, Floor, Ceil, Not.
// Mismas reglas que std_onnx_engine.titan: f64 con redondeo a f32 al salir de cada operador y errores
// explícitos para lo que no se soporta. Prefijo `ox` (comparte el espacio de nombres del motor).

fn ox_zip_code(op: string) -> int {
    if op == "Equal" {
        return 10
    }
    if op == "Less" {
        return 11
    }
    if op == "Greater" {
        return 12
    }
    if op == "LessOrEqual" {
        return 13
    }
    if op == "GreaterOrEqual" {
        return 14
    }
    if op == "And" {
        return 15
    }
    if op == "Or" {
        return 16
    }
    if op == "Pow" {
        return 17
    }
    if op == "Max" {
        return 18
    }
    if op == "Min" {
        return 19
    }
    if op == "Xor" {
        return 20
    }
    -1
}

fn ox_b2i(b: bool) -> int {
    if b {
        return 1
    }
    0
}

fn ox_ipow(a: int, b: int) -> int {
    let mut r = 1
    let mut i = 0
    while i < b {
        r = r * a
        i += 1
    }
    r
}

fn ox_apply2(code: int, a, b) -> any {
    if code == 10 {
        return ox_b2i(a == b)
    }
    if code == 11 {
        return ox_b2i(a < b)
    }
    if code == 12 {
        return ox_b2i(a > b)
    }
    if code == 13 {
        return ox_b2i(a <= b)
    }
    if code == 14 {
        return ox_b2i(a >= b)
    }
    if code == 15 {
        return ox_b2i(a != 0 && b != 0)
    }
    if code == 16 {
        return ox_b2i(a != 0 || b != 0)
    }
    if code == 17 {
        return std::math::pow(a, b)
    }
    if code == 18 {
        if a > b {
            return a
        }
        return b
    }
    if code == 19 {
        if a < b {
            return a
        }
        return b
    }
    ox_b2i((a != 0) != (b != 0))
}

// Operadores binarios con difusión que dan BOOL (comparaciones, lógica) o conservan el tipo (Pow, Min, Max).
fn ox_zip(op: string, x0: OxT, y0: OxT) -> Result {
    let code = ox_zip_code(op)
    let mut x = x0
    let mut y = y0
    if code == 17 {
        // Pow: el exponente puede ser entero con base real
        if x.dt == 1 && y.dt != 1 {
            y = ox_cast(y, 1)?
        }
        if x.dt != 1 && y.dt == 1 {
            return Result::Err("Pow: an integer base needs an integer exponent")
        }
    }
    if code >= 15 && code <= 16 || code == 20 {
        if x.dt != 9 || y.dt != 9 {
            return Result::Err(op + ": operands must be boolean")
        }
    } else if (x.dt == 1) != (y.dt == 1) {
        return Result::Err(op + ": operands have different types")
    }
    let shape = ox_broadcast(x.shape, y.shape)?
    let n = ox_numel(shape)
    let xd = x.data
    let yd = y.data
    let int_pow = code == 17 && x.dt != 1
    let mut out = []
    if ox_same_shape(x.shape, y.shape) {
        let mut i = 0
        while i < n {
            if int_pow {
                if yd[i] < 0 {
                    return Result::Err("Pow: negative integer exponent")
                }
                out = std::array::push(out, ox_ipow(xd[i], yd[i]))
            } else {
                out = std::array::push(out, ox_apply2(code, xd[i], yd[i]))
            }
            i += 1
        }
    } else {
        let ostr = ox_strides(shape)
        let sx = ox_bstrides(x.shape, shape)
        let sy = ox_bstrides(y.shape, shape)
        let mut i = 0
        while i < n {
            let a = xd[ox_offset(i, shape, ostr, sx)]
            let b = yd[ox_offset(i, shape, ostr, sy)]
            if int_pow {
                if b < 0 {
                    return Result::Err("Pow: negative integer exponent")
                }
                out = std::array::push(out, ox_ipow(a, b))
            } else {
                out = std::array::push(out, ox_apply2(code, a, b))
            }
            i += 1
        }
    }
    if code >= 10 && code <= 16 || code == 20 {
        return Result::Ok(OxT { dt: 9, shape: shape, data: out })
    }
    Result::Ok(ox_round(OxT { dt: x.dt, shape: shape, data: out }))
}

fn ox_not(x: OxT) -> Result {
    if x.dt != 9 {
        return Result::Err("Not: operand must be boolean")
    }
    let mut out = []
    for v in x.data {
        out = std::array::push(out, 1 - v)
    }
    Result::Ok(OxT { dt: 9, shape: x.shape, data: out })
}

fn ox_where(c: OxT, x: OxT, y: OxT) -> Result {
    if c.dt != 9 {
        return Result::Err("Where: the condition must be boolean")
    }
    if (x.dt == 1) != (y.dt == 1) {
        return Result::Err("Where: operands have different types")
    }
    let s1 = ox_broadcast(c.shape, x.shape)?
    let shape = ox_broadcast(s1, y.shape)?
    let n = ox_numel(shape)
    let ostr = ox_strides(shape)
    let sc = ox_bstrides(c.shape, shape)
    let sx = ox_bstrides(x.shape, shape)
    let sy = ox_bstrides(y.shape, shape)
    let cd = c.data
    let xd = x.data
    let yd = y.data
    let mut out = []
    let mut i = 0
    while i < n {
        if cd[ox_offset(i, shape, ostr, sc)] != 0 {
            out = std::array::push(out, xd[ox_offset(i, shape, ostr, sx)])
        } else {
            out = std::array::push(out, yd[ox_offset(i, shape, ostr, sy)])
        }
        i += 1
    }
    Result::Ok(OxT { dt: x.dt, shape: shape, data: out })
}

fn ox_expand(x: OxT, target: OxT) -> Result {
    if target.dt != 7 {
        return Result::Err("Expand: the shape must be an integer tensor")
    }
    for d in target.data {
        if d < 0 {
            return Result::Err("Expand: negative dimension in the target shape")
        }
    }
    let shape = ox_broadcast(x.shape, target.data)?
    let n = ox_numel(shape)
    let ostr = ox_strides(shape)
    let sx = ox_bstrides(x.shape, shape)
    let xd = x.data
    let mut out = []
    let mut i = 0
    while i < n {
        out = std::array::push(out, xd[ox_offset(i, shape, ostr, sx)])
        i += 1
    }
    Result::Ok(OxT { dt: x.dt, shape: shape, data: out })
}

fn ox_const_of_shape(n: OxN, s: OxT) -> Result {
    if s.dt != 7 {
        return Result::Err("ConstantOfShape: the shape must be an integer tensor")
    }
    let mut dt = 1
    let mut v: any = 0.0
    if ox_has(n, "value") {
        let a = std::map::get(n.attrs, "value")
        if std::map::contains(a, "t") {
            let t = std::map::get(a, "t")
            if len(t.data) != 1 {
                return Result::Err("ConstantOfShape: the value must have exactly one element")
            }
            dt = t.dt
            v = t.data[0]
        }
    }
    for d in s.data {
        if d < 0 {
            return Result::Err("ConstantOfShape: negative dimension")
        }
    }
    let count = ox_numel(s.data)
    if count > 67108864 {
        return Result::Err("ConstantOfShape: the tensor is too large")
    }
    Result::Ok(OxT { dt: dt, shape: s.data, data: std::array::filled(count, v) })
}

fn ox_gather_elements(x: OxT, idx: OxT, axis0: int) -> Result {
    let rank = len(x.shape)
    let axis = ox_axis(axis0, rank)
    if axis < 0 || axis >= rank {
        return Result::Err("GatherElements: axis out of range")
    }
    if idx.dt != 7 || len(idx.shape) != rank {
        return Result::Err("GatherElements: the indices must be an integer tensor of the same rank")
    }
    let mut d = 0
    while d < rank {
        if d != axis && idx.shape[d] > x.shape[d] {
            return Result::Err("GatherElements: the indices do not fit the data")
        }
        d += 1
    }
    let xs = ox_strides(x.shape)
    let istr = ox_strides(idx.shape)
    let xd = x.data
    let dim = x.shape[axis]
    let total = len(idx.data)
    let mut out = []
    let mut i = 0
    while i < total {
        let mut off = 0
        let mut k = 0
        while k < rank {
            let mut c = (i / istr[k]) % idx.shape[k]
            if k == axis {
                c = idx.data[i]
                if c < 0 {
                    c = c + dim
                }
                if c < 0 || c >= dim {
                    return Result::Err("GatherElements: index out of range")
                }
            }
            off = off + c * xs[k]
            k += 1
        }
        out = std::array::push(out, xd[off])
        i += 1
    }
    Result::Ok(OxT { dt: x.dt, shape: idx.shape, data: out })
}

fn ox_gather_nd(x: OxT, idx: OxT, bd: int) -> Result {
    let rx = len(x.shape)
    let ri = len(idx.shape)
    if idx.dt != 7 || ri < 1 {
        return Result::Err("GatherND: the indices must be an integer tensor of rank 1 or more")
    }
    if bd < 0 || bd >= rx || bd >= ri {
        return Result::Err("GatherND: invalid batch_dims")
    }
    let k = idx.shape[ri - 1]
    if k < 1 || bd + k > rx {
        return Result::Err("GatherND: the last dimension of the indices is out of range")
    }
    let mut b = 1
    let mut i = 0
    while i < bd {
        if x.shape[i] != idx.shape[i] {
            return Result::Err("GatherND: the batch dimensions differ")
        }
        b = b * x.shape[i]
        i += 1
    }
    let xs = ox_strides(x.shape)
    let slice = ox_numel(std::array::slice(x.shape, bd + k, rx))
    let mut mid = 1
    i = bd
    while i < ri - 1 {
        mid = mid * idx.shape[i]
        i += 1
    }
    let xd = x.data
    let mut out = []
    let mut bi = 0
    while bi < b {
        let mut mi = 0
        while mi < mid {
            let mut off = 0
            let mut j = 0
            while j < k {
                let dim = x.shape[bd + j]
                let mut c = idx.data[(bi * mid + mi) * k + j]
                if c < 0 {
                    c = c + dim
                }
                if c < 0 || c >= dim {
                    return Result::Err("GatherND: index out of range")
                }
                off = off + c * xs[bd + j]
                j += 1
            }
            // los índices de lote ocupan las primeras `bd` dimensiones de x
            let mut boff = 0
            let mut rem = bi
            let mut q = bd - 1
            while q >= 0 {
                boff = boff + (rem % x.shape[q]) * xs[q]
                rem = rem / x.shape[q]
                q -= 1
            }
            let mut e = 0
            while e < slice {
                out = std::array::push(out, xd[boff + off + e])
                e += 1
            }
            mi += 1
        }
        bi += 1
    }
    let mut shape = std::array::slice(idx.shape, 0, ri - 1)
    shape = std::array::concat(shape, std::array::slice(x.shape, bd + k, rx))
    Result::Ok(OxT { dt: x.dt, shape: shape, data: out })
}

fn ox_clamp(v: int, lo: int, hi: int) -> int {
    if v < lo {
        return lo
    }
    if v > hi {
        return hi
    }
    v
}

// Slice con entradas starts/ends/axes/steps (arrays de enteros; axes y steps pueden ser nil).
fn ox_slice(x: OxT, starts: array, ends: array, axes: any, steps: any) -> Result {
    let rank = len(x.shape)
    if len(starts) != len(ends) {
        return Result::Err("Slice: starts and ends have different lengths")
    }
    let mut lo = std::array::filled(rank, 0)
    let mut st = std::array::filled(rank, 1)
    let mut cnt = x.shape
    let mut a = 0
    while a < len(starts) {
        let mut ax = a
        if axes != nil {
            ax = ox_axis(axes[a], rank)
        }
        if ax < 0 || ax >= rank {
            return Result::Err("Slice: axis out of range")
        }
        let mut step = 1
        if steps != nil {
            step = steps[a]
        }
        if step == 0 {
            return Result::Err("Slice: step must not be zero")
        }
        let d = x.shape[ax]
        let mut s = starts[a]
        let mut e = ends[a]
        if s < 0 {
            s = s + d
        }
        if e < 0 {
            e = e + d
        }
        let mut count = 0
        if step > 0 {
            s = ox_clamp(s, 0, d)
            e = ox_clamp(e, 0, d)
            if e > s {
                count = (e - s + step - 1) / step
            }
        } else {
            s = ox_clamp(s, 0, d - 1)
            e = ox_clamp(e, -1, d - 1)
            if s > e {
                count = (s - e - step - 1) / (0 - step)
            }
        }
        lo = std::array::set(lo, ax, s)
        st = std::array::set(st, ax, step)
        cnt = std::array::set(cnt, ax, count)
        a += 1
    }
    let n = ox_numel(cnt)
    let ostr = ox_strides(cnt)
    let xs = ox_strides(x.shape)
    let xd = x.data
    let mut out = []
    let mut i = 0
    while i < n {
        let mut off = 0
        let mut k = 0
        while k < rank {
            let c = (i / ostr[k]) % cnt[k]
            off = off + (lo[k] + c * st[k]) * xs[k]
            k += 1
        }
        out = std::array::push(out, xd[off])
        i += 1
    }
    Result::Ok(OxT { dt: x.dt, shape: cnt, data: out })
}

fn ox_range(a: OxT, b: OxT, c: OxT) -> Result {
    if len(a.data) != 1 || len(b.data) != 1 || len(c.data) != 1 {
        return Result::Err("Range: the inputs must be scalars")
    }
    if a.dt != b.dt || b.dt != c.dt {
        return Result::Err("Range: the inputs have different types")
    }
    let s = a.data[0]
    let l = b.data[0]
    let d = c.data[0]
    if d == 0 {
        return Result::Err("Range: delta must not be zero")
    }
    let mut out = []
    if a.dt == 1 {
        let cntf = std::math::ceil((l - s) / d)
        let mut count = 0
        if cntf > 0.0 {
            count = std::math::to_int(cntf)
        }
        if count > 67108864 {
            return Result::Err("Range: the tensor is too large")
        }
        let mut i = 0
        while i < count {
            out = std::array::push(out, ox_f32(s + std::math::to_float(i) * d))
            i += 1
        }
        return Result::Ok(OxT { dt: 1, shape: [count], data: out })
    }
    let mut count = 0
    if d > 0 && l > s {
        count = (l - s + d - 1) / d
    } else if d < 0 && s > l {
        count = (s - l - d - 1) / (0 - d)
    }
    if count > 67108864 {
        return Result::Err("Range: the tensor is too large")
    }
    let mut i = 0
    while i < count {
        out = std::array::push(out, s + i * d)
        i += 1
    }
    Result::Ok(OxT { dt: a.dt, shape: [count], data: out })
}

// Split: devuelve el array de tensores de salida.
fn ox_split(n: OxN, x: OxT, split: any, opset: int) -> Result {
    let rank = len(x.shape)
    let axis = ox_axis(ox_a_int(n, "axis", 0), rank)
    if axis < 0 || axis >= rank {
        return Result::Err("Split: axis out of range")
    }
    let dim = x.shape[axis]
    let nout = len(n.outs)
    let mut sizes = []
    if split != nil {
        sizes = split
    } else {
        let mut parts = nout
        if ox_has(n, "num_outputs") {
            parts = ox_a_int(n, "num_outputs", nout)
        }
        if parts < 1 {
            return Result::Err("Split: invalid number of outputs")
        }
        let each = (dim + parts - 1) / parts
        let mut left = dim
        let mut p = 0
        while p < parts {
            let mut take = each
            if take > left {
                take = left
            }
            sizes = std::array::push(sizes, take)
            left = left - take
            p += 1
        }
        if split == nil && !ox_has(n, "num_outputs") && dim % nout != 0 {
            return Result::Err("Split: the dimension is not divisible by the number of outputs")
        }
    }
    if len(sizes) != nout {
        return Result::Err("Split: the number of sizes differs from the number of outputs")
    }
    let mut total = 0
    for s in sizes {
        total = total + s
    }
    if total != dim {
        return Result::Err("Split: the sizes do not add up to the dimension")
    }
    let mut res = []
    let mut start = 0
    for s in sizes {
        let part = ox_slice(x, [start], [start + s], [axis], nil)?
        res = std::array::push(res, part)
        start = start + s
    }
    Result::Ok(res)
}

// erf en doble precisión: serie de Taylor para |x| < 2,5 y fracción continua de erfc más allá.
fn ox_erf(x: float) -> float {
    let mut ax = x
    if x < 0.0 {
        ax = 0.0 - x
    }
    let mut r = 1.0
    if ax < 2.5 {
        let mut term = ax
        let mut sum = ax
        let mut k = 1
        while k < 200 {
            term = term * (0.0 - ax * ax) / std::math::to_float(k)
            let add = term / std::math::to_float(2 * k + 1)
            sum = sum + add
            if add < 1e-18 && add > -1e-18 {
                break
            }
            k += 1
        }
        r = 1.1283791670955126 * sum
    } else if ax < 6.0 {
        let mut f = ax
        let mut k = 100
        while k >= 1 {
            f = ax + (std::math::to_float(k) / 2.0) / f
            k -= 1
        }
        r = 1.0 - std::math::exp(0.0 - ax * ax) / (1.7724538509055159 * f)
    }
    if x < 0.0 {
        return 0.0 - r
    }
    r
}

fn ox_unary2(n: OxN, x: OxT) -> Result {
    let op = n.op
    if x.dt != 1 {
        return Result::Err(op + ": only float tensors are supported")
    }
    let mut approx_tanh = false
    if op == "Gelu" {
        let a = ox_a_str(n, "approximate", "none")
        if a == "tanh" {
            approx_tanh = true
        } else if a != "none" {
            return Result::Err("Gelu: unknown approximation '" + a + "'")
        }
    }
    let src = x.data
    let count = len(src)
    let mut out = []
    let mut i = 0
    while i < count {
        let v = src[i]
        let mut r = v
        if op == "Erf" {
            r = ox_erf(v)
        } else if op == "Gelu" {
            if approx_tanh {
                r = 0.5 * v * (1.0 + ox_tanh(0.7978845608028654 * (v + 0.044715 * v * v * v)))
            } else {
                r = 0.5 * v * (1.0 + ox_erf(v * 0.7071067811865476))
            }
        } else if op == "Reciprocal" {
            r = 1.0 / v
        } else if op == "Floor" {
            r = std::math::floor(v)
        } else if op == "Ceil" {
            r = std::math::ceil(v)
        } else if op == "Sin" {
            r = std::math::sin(v)
        } else if op == "Cos" {
            r = std::math::cos(v)
        }
        out = std::array::push(out, r)
        i += 1
    }
    Result::Ok(ox_round(OxT { dt: 1, shape: x.shape, data: out }))
}

fn ox_layernorm(n: OxN, x: OxT, scale: OxT, bias: any) -> Result {
    if x.dt != 1 || scale.dt != 1 {
        return Result::Err("LayerNormalization: only float tensors are supported")
    }
    if len(n.outs) > 1 && n.outs[1] != "" {
        return Result::Err("LayerNormalization: the mean and inverse standard deviation outputs are not supported")
    }
    let rank = len(x.shape)
    let axis = ox_axis(ox_a_int(n, "axis", -1), rank)
    if axis < 0 || axis >= rank {
        return Result::Err("LayerNormalization: axis out of range")
    }
    let eps = ox_a_float(n, "epsilon", 0.00001)
    let inner = ox_numel(std::array::slice(x.shape, axis, rank))
    let outer = ox_numel(std::array::slice(x.shape, 0, axis))
    if len(scale.data) != inner && len(scale.data) != 1 {
        return Result::Err("LayerNormalization: the scale does not match the normalized shape")
    }
    let mut bd: any = nil
    if bias != nil {
        if bias.dt != 1 || (len(bias.data) != inner && len(bias.data) != 1) {
            return Result::Err("LayerNormalization: the bias does not match the normalized shape")
        }
        bd = bias.data
    }
    let xd = x.data
    let sd = scale.data
    let fi = std::math::to_float(inner)
    let mut out = []
    let mut o = 0
    while o < outer {
        let base = o * inner
        let mut sum = 0.0
        let mut j = 0
        while j < inner {
            sum = sum + xd[base + j]
            j += 1
        }
        let mean = sum / fi
        let mut vs = 0.0
        j = 0
        while j < inner {
            let d = xd[base + j] - mean
            vs = vs + d * d
            j += 1
        }
        let inv = 1.0 / std::math::sqrt(vs / fi + eps)
        j = 0
        while j < inner {
            let mut s = sd[0]
            if len(sd) != 1 {
                s = sd[j]
            }
            let mut r = (xd[base + j] - mean) * inv * s
            if bd != nil {
                if len(bd) == 1 {
                    r = r + bd[0]
                } else {
                    r = r + bd[j]
                }
            }
            out = std::array::push(out, r)
            j += 1
        }
        o += 1
    }
    Result::Ok(ox_round(OxT { dt: 1, shape: x.shape, data: out }))
}

// Reducciones adicionales (ReduceMin, ReduceProd, ReduceSumSquare, ReduceL2) sobre float.
fn ox_reduce2(op: string, x: OxT, axes: any, keep: int) -> Result {
    if x.dt != 1 {
        return Result::Err(op + ": only float tensors are supported")
    }
    let rank = len(x.shape)
    let mut flags = std::array::filled(rank, false)
    if axes == nil {
        flags = std::array::filled(rank, true)
    } else {
        for a in axes {
            let ax = ox_axis(a, rank)
            if ax < 0 || ax >= rank {
                return Result::Err(op + ": axis out of range")
            }
            flags = std::array::set(flags, ax, true)
        }
    }
    let mut oshape = []
    let mut kshape = []
    let mut i = 0
    while i < rank {
        if flags[i] {
            kshape = std::array::push(kshape, 1)
        } else {
            kshape = std::array::push(kshape, x.shape[i])
            oshape = std::array::push(oshape, x.shape[i])
        }
        i += 1
    }
    let kstr = ox_strides(kshape)
    let outn = ox_numel(kshape)
    let mut init = 0.0
    if op == "ReduceProd" {
        init = 1.0
    }
    let mut acc = std::array::filled(outn, init)
    let mut seen = std::array::filled(outn, 0)
    let xs = ox_strides(x.shape)
    let xd = x.data
    let total = len(xd)
    let mut k = 0
    while k < total {
        let mut off = 0
        let mut d = 0
        while d < rank {
            if !flags[d] {
                off = off + ((k / xs[d]) % x.shape[d]) * kstr[d]
            }
            d += 1
        }
        let v = xd[k]
        if op == "ReduceMin" {
            if seen[off] == 0 || v < acc[off] {
                acc = std::array::set(acc, off, v)
            }
        } else if op == "ReduceProd" {
            acc = std::array::set(acc, off, acc[off] * v)
        } else {
            acc = std::array::set(acc, off, acc[off] + v * v)
        }
        seen = std::array::set(seen, off, seen[off] + 1)
        k += 1
    }
    if op == "ReduceL2" {
        let mut j = 0
        while j < outn {
            acc = std::array::set(acc, j, std::math::sqrt(acc[j]))
            j += 1
        }
    }
    let mut shape = oshape
    if keep == 1 {
        shape = kshape
    }
    Result::Ok(ox_round(OxT { dt: 1, shape: shape, data: acc }))
}

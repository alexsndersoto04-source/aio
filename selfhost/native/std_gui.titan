}

fn gui_glyph_last_row(ch: int) -> int {
    match ch {
        44 => 48,
        59 => 48,
        95 => 255,
        _ => 0,
    }
}

fn gui_glyph_row(ch: int, row: int) -> int {
    if row == 7 { return gui_glyph_last_row(ch) }
    let packed = gui_glyph_data(ch)
    std::raw::shr(packed, 8 * row) & 255
}

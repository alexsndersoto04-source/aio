        32 => 0,
        33 => 6755502926871576,
        34 => 2368548,
        35 => 10271792851877412,
        37 => 37794750401111138,
        38 => 33439294500129848,
        40 => 3404294966482956,
        41 => 13537238902904880,
        42 => 39687613326336,
        43 => 26493473789952,
        44 => 6781787720122368,
        45 => 2113929216,
        46 => 6781787720122368,
        47 => 27127357442360838,
        48 => 17001088862283324,
        49 => 35492338828064792,
        50 => 35571606541985340,
        51 => 17000675028657724,
        52 => 8457986422610956,
        53 => 17000674667290750,
        54 => 17001088962027580,
        55 => 13563782002116222,
        56 => 17001087888680508,
        57 => 16895122489108028,
        58 => 6781788124348416,
        59 => 6781788124348416,
        60 => 3404295771789324,
        61 => 541174136832,
        62 => 13537238802241584,
        63 => 6755502722016828,
        64 => 17557475904349756,
        65 => 28823140694375448,
        66 => 35015487471904380,
        67 => 17001062722463292,
        68 => 33896184265731192,
        69 => 35571814518251646,
        70 => 27127565216931966,
        71 => 17564038680569404,
        72 => 28823038017824358,
        73 => 16914990365153340,
        74 => 15881397693320222,
        75 => 28829712163302502,
        76 => 35571814115598432,
        77 => 27975301350782819,
        78 => 28823072379139686,
        79 => 17001088593323580,
        80 => 27127565284435580,
        81 => 15318870162564668,
        82 => 28829712363447932,
        83 => 17000675571426876,
        84 => 6781891203569790,
        85 => 17001088593323622,

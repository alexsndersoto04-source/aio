fn std__kv__compare_and_swap(handle: int, key: any, expected: any, replacement: any) -> any {
    let function = "std::kv::compare_and_swap"
    kv_key_check(key, function)
    kv_value_check(expected, function)
    kv_value_check(replacement, function)
    let (path, tree_hex) = kv_default_context(handle, function)
    let lock = kv_lock(path, function)
    let attempted = std::try::catch(|| kv_cas_locked(path, tree_hex, key, expected, replacement, function))
    kv_finish_locked(lock, function, attempted)
}

fn std__kv__open_tree(db_handle: int, name: string) -> any {
    let function = "std::kv::open_tree"
    kv_tree_name_check(name, function)
    if kv_free_tree_slot() == 0 {
        kv_fail(function, "key-value tree handles exceeds limit 32")
    }
    let (path, _default_tree) = kv_default_context(db_handle, function)
    let tree_hex = if name == "__sled__default" { "" } else { std::encoding::hex_encode(std::encoding::utf8_encode(name)) }
    let lock = kv_lock(path, function)
    let attempted = std::try::catch(|| kv_ensure_tree_locked(path, tree_hex, function))
    let _result = kv_finish_locked(lock, function, attempted)
    kv_register_tree(db_handle, name, function)
}


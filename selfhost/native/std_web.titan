// std::web y std::wasm en el runtime nativo. Son importaciones del módulo WebAssembly (host JS del
// navegador, `examples/browser/host.js`) y funciones del montón del backend Wasm: un ejecutable nativo
// no tiene ni navegador ni montón Wasm. Igual que la VM de Rust, fallan en tiempo de ejecución con un
// error que se puede capturar (`std::try::catch`) en lugar de no compilar. La implementación de verdad de
// estas funciones es el backend Wasm de Titan (selfhost/wasm.titan), verificado en tests/wasm_diff.

fn wb_host_fail(name: string) {
    rt_native_fail(name, "std::web functions require the WebAssembly browser host")
}

fn wb_heap_fail(name: string) {
    rt_native_fail(name, "std::wasm heap functions require the WebAssembly backend")
}

fn std__wasm__heap_used() -> any {
    wb_heap_fail("std::wasm::heap_used")
    nil
}


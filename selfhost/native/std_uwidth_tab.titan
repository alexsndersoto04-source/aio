// starts_emoji_presentation_seq: cp >> 10 -> número de hoja (o -1).
fn uw_emo_leaf(top: int) -> int {
    if top == 0 {
        return 0
    }
    if top == 8 {
        return 1
    }
    if top == 9 {
        return 2
    }
    if top == 10 {
        return 3
    }
    if top == 12 {
        return 4
    }
    if top == 124 {
        return 5
    }
    if top == 125 {
        return 6
    }
    -1
}

// cp >> 8 -> (desplazamiento, cantidad de rangos) de la hoja, o (-1, 0).

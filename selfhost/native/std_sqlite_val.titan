// std::sqlite en Titan, parte 1: valores, enteros de longitud variable, flotantes IEEE,
// registros (formato de archivo de SQLite) y comparación de valores.
// Prefijo `sq` en todas las funciones (único entre los módulos std_*).

enum Sv {
    SNull,
    SInt(int),
    SReal(float),
    SText(string),
    SBlob(any),
    SErr(string),
}

fn sq_arr_cat(a: array, b: array) -> array {
    std::array::concat(a, b)
}

fn sq_u16(a: array, o: int) -> int {
    a[o] * 256 + a[o + 1]
}

fn sq_u32(a: array, o: int) -> int {
    return ((a[o] * 256 + a[o + 1]) * 256 + a[o + 2]) * 256 + a[o + 3]
}

fn sq_set16(a: array, o: int, v: int) -> array {
    let b = std::array::set(a, o, (v / 256) % 256)
    std::array::set(b, o + 1, v % 256)
}

fn sq_set32(a: array, o: int, v: int) -> array {
    let mut b = std::array::set(a, o, (v / 16777216) % 256)
    b = std::array::set(b, o + 1, (v / 65536) % 256)
    b = std::array::set(b, o + 2, (v / 256) % 256)
    std::array::set(b, o + 3, v % 256)
}

fn sq_be16(v: int) -> array {
    [(v / 256) % 256, v % 256]
}

fn sq_be32(v: int) -> array {
    [(v / 16777216) % 256, (v / 65536) % 256, (v / 256) % 256, v % 256]
}

fn sq_zeros(n: int) -> array {
    std::array::filled(n, 0)
}

// ------------------------------------------------------------ varint

// Devuelve (valor, longitud). El valor es el entero de 64 bits con signo.
fn sq_varint(a: array, o: int) -> (int, int) {
    let mut v = 0
    let mut i = 0
    while i < 8 {
        let b = a[o + i]
        v = v * 128 + b % 128
        if b < 128 {
            return (v, i + 1)
        }
        i += 1
    }
    let b = a[o + 8]
    if v >= 36028797018963968 {
        return ((v - 72057594037927936) * 256 + b, 9)
    }
    return (v * 256 + b, 9)
}

fn sq_varint_len(v: int) -> int {
    if v < 0 || v >= 72057594037927936 {
        return 9
    }
    let mut n = 1
    let mut x = v / 128
    while x > 0 {
        n += 1
        x = x / 128
    }
    n
}

fn sq_varint_enc(v: int) -> array {
    if v >= 0 && v < 128 {
        return [v]
    }
    if v >= 0 && v < 72057594037927936 {
        let mut g = []
        let mut x = v
        while x > 0 {
            g = std::array::push(g, x % 128)
            x = x / 128
        }
        let mut out = []
        let mut i = len(g) - 1
        while i >= 0 {
            if i > 0 {
                out = std::array::push(out, g[i] + 128)
            } else {
                out = std::array::push(out, g[i])
            }
            i -= 1
        }
        return out
    }
    let low = ((v % 256) + 256) % 256
    let q = (v - low) / 256
    let mut hi = q + 72057594037927936
    let mut g = []
    let mut k = 0
    while k < 8 {
        g = std::array::push(g, hi % 128)
        hi = hi / 128
        k += 1
    }
    let mut out = []
    let mut i = 7
    while i >= 0 {
        out = std::array::push(out, g[i] + 128)
        i -= 1
    }
    std::array::push(out, low)
}

// ------------------------------------------------------------ flotantes IEEE-754

// 8 bytes big-endian de un f64 (NaN no se guarda nunca: SQLite lo convierte en NULL).
fn sq_f2b(x: float) -> array {
    let mut neg = 0
    let mut ax = x
    if x < 0.0 {
        neg = 128
        ax = 0.0 - x
    }
    if ax == 0.0 {
        return [neg, 0, 0, 0, 0, 0, 0, 0]
    }
    if ax > 1.7976931348623157e308 {
        return [neg + 127, 240, 0, 0, 0, 0, 0, 0]
    }
    let mut e = 0
    let mut t = ax
    while t >= 2.0 {
        t = t / 2.0
        e += 1
    }
    while t < 1.0 {
        t = t * 2.0
        e -= 1
        if e < -1030 {
            break
        }
    }
    let mut ef = 0
    let mut mant = 0
    if e < -1022 {
        let s = ax * std::math::pow(2.0, 537.0) * std::math::pow(2.0, 537.0)
        mant = std::math::to_int(std::math::floor(s))
    } else {
        ef = e + 1023
        mant = std::math::to_int(std::math::floor((t - 1.0) * 4503599627370496.0))
    }
    let m6 = mant / 281474976710656
    let r1 = mant % 281474976710656
    let mut out = [neg + ef / 16, (ef % 16) * 16 + m6]
    let mut k = 5
    let mut div = 1099511627776
    let mut r = r1
    while k >= 0 {
        out = std::array::push(out, r / div)
        r = r % div
        if k > 0 {
            div = div / 256
        }
        k -= 1
    }
    out
}

fn sq_b2f(a: array, o: int) -> float {
    let neg = a[o] >= 128
    let ef = (a[o] % 128) * 16 + a[o + 1] / 16
    let mut mant = a[o + 1] % 16
    let mut k = 2
    while k < 8 {
        mant = mant * 256 + a[o + k]
        k += 1
    }
    let mut f = 0.0
    if ef == 0 {
        f = std::math::to_float(mant) * std::math::pow(2.0, -1074.0)
    } else if ef == 2047 {
        f = std::math::pow(2.0, 1024.0)
    } else {
        f = std::math::to_float(mant + 4503599627370496) * std::math::pow(2.0, std::math::to_float(ef - 1075))
    }
    if neg {
        return 0.0 - f
    }
    f
}

// ------------------------------------------------------------ registros

fn sq_utf8(s: string) -> array {
    std::bytes::to_array(std::encoding::utf8_encode(s))
}

fn sq_ser_type(v: Sv) -> int {
    match v {
        Sv::SNull => 0,
        Sv::SInt(i) => {
            if i == 0 {
                8
            } else if i == 1 {
                9
            } else if i >= -128 && i <= 127 {
                1
            } else if i >= -32768 && i <= 32767 {
                2
            } else if i >= -8388608 && i <= 8388607 {
                3
            } else if i >= -2147483648 && i <= 2147483647 {
                4
            } else if i >= -140737488355328 && i <= 140737488355327 {
                5
            } else {
                6
            }
        },
        Sv::SReal(_) => 7,
        Sv::SText(s) => 13 + 2 * len(sq_utf8(s)),
        Sv::SBlob(b) => 12 + 2 * std::bytes::length(b),
        Sv::SErr(_) => 0,
    }
}

fn sq_ser_size(t: int) -> int {
    if t == 0 || t == 8 || t == 9 {
        return 0
    }
    if t == 1 {
        return 1
    }
    if t == 2 {
        return 2
    }
    if t == 3 {
        return 3
    }
    if t == 4 {
        return 4
    }
    if t == 5 {
        return 6
    }
    if t == 6 || t == 7 {
        return 8
    }
    if t >= 12 {
        return (t - 12) / 2
    }
    0
}

fn sq_int_be(v: int, n: int) -> array {
    let mut x = v
    let mut r = std::array::filled(n, 0)
    let mut k = n - 1
    while k >= 0 {
        let b = ((x % 256) + 256) % 256
        r = std::array::set(r, k, b)
        x = (x - b) / 256
        k -= 1
    }
    r
}

// Cuerpo (bytes) de un valor ya con su tipo serial.
fn sq_ser_body(v: Sv, t: int) -> array {
    match v {
        Sv::SNull => [],
        Sv::SInt(i) => sq_int_be(i, sq_ser_size(t)),
        Sv::SReal(f) => sq_f2b(f),
        Sv::SText(s) => sq_utf8(s),
        Sv::SBlob(b) => std::bytes::to_array(b),
        Sv::SErr(_) => [],
    }
}

// Registro completo: cabecera (varint de longitud + tipos) y cuerpos.
fn sq_rec_enc(vals: array) -> array {
    let mut types = []
    let mut hl = 0
    for v in vals {
        let t = sq_ser_type(v)
        types = std::array::push(types, t)
        hl += sq_varint_len(t)
    }
    let mut k = 1
    while sq_varint_len(hl + k) != k {
        k += 1
    }
    let total = hl + k
    let mut out = sq_varint_enc(total)
    for t in types {
        out = sq_arr_cat(out, sq_varint_enc(t))
    }
    let mut i = 0
    let n = len(vals)
    while i < n {
        out = sq_arr_cat(out, sq_ser_body(vals[i], types[i]))
        i += 1
    }
    out
}

fn sq_dec_text(a: array, o: int, n: int) -> string {
    let bs = std::bytes::from_array(std::array::slice(a, o, o + n))
    let r = std::try::catch(|| { std::encoding::utf8_decode(bs) })
    match r {
        Result::Ok(s) => s,
        _ => sq_lossy(a, o, n),
    }
}

// Reemplaza bytes inválidos por U+FFFD (poco frecuente).
fn sq_lossy(a: array, o: int, n: int) -> string {
    let mut ok = []
    let mut i = o
    let end = o + n
    while i < end {
        let b = a[i]
        let mut need = 0
        if b < 128 {
            need = 1
        } else if b >= 194 && b <= 223 {
            need = 2
        } else if b >= 224 && b <= 239 {
            need = 3
        } else if b >= 240 && b <= 244 {
            need = 4
        }
        let mut good = need > 0 && i + need <= end
        if good && need > 1 {
            let mut j = 1
            while j < need {
                if a[i + j] < 128 || a[i + j] > 191 {
                    good = false
                }
                j += 1
            }
        }
        if good {
            let chunk = std::bytes::from_array(std::array::slice(a, i, i + need))
            let r = std::try::catch(|| { std::encoding::utf8_decode(chunk) })
            match r {
                Result::Ok(s) => {
                    ok = std::array::push(ok, s)
                    i += need
                },
                _ => {
                    ok = std::array::push(ok, std::text::from_char_code(65533))
                    i += 1
                },
            }
        } else {
            ok = std::array::push(ok, std::text::from_char_code(65533))
            i += 1
        }
    }
    std::collections::join(ok, "")
}

fn sq_dec_val(a: array, o: int, t: int) -> Sv {
    if t == 0 {
        return Sv::SNull
    }
    if t == 8 {
        return Sv::SInt(0)
    }
    if t == 9 {
        return Sv::SInt(1)
    }
    if t >= 1 && t <= 6 {
        let n = sq_ser_size(t)
        let mut v = a[o]
        if v >= 128 {
            v = v - 256
        }
        let mut k = 1
        while k < n {
            v = v * 256 + a[o + k]
            k += 1
        }
        return Sv::SInt(v)
    }
    if t == 7 {
        return Sv::SReal(sq_b2f(a, o))
    }
    let n = sq_ser_size(t)
    if t >= 13 && t % 2 == 1 {
        return Sv::SText(sq_dec_text(a, o, n))
    }
    if t >= 12 && t % 2 == 0 {
        return Sv::SBlob(std::bytes::from_array(std::array::slice(a, o, o + n)))
    }
    Sv::SNull
}

// Decodifica `lim` valores como máximo (lim < 0: todos).
fn sq_rec_dec(a: array, lim: int) -> array {
    let (hl, n0) = sq_varint(a, 0)
    let mut types = []
    let mut p = n0
    while p < hl {
        if lim >= 0 && len(types) >= lim {
            break
        }
        let (t, n) = sq_varint(a, p)
        types = std::array::push(types, t)
        p += n
    }
    let mut vals = []
    let mut o = hl
    for t in types {
        vals = std::array::push(vals, sq_dec_val(a, o, t))
        o += sq_ser_size(t)
    }
    vals
}

// ------------------------------------------------------------ comparación

fn sq_cls(v: Sv) -> int {
    match v {
        Sv::SNull => 0,
        Sv::SInt(_) => 1,
        Sv::SReal(_) => 1,
        Sv::SText(_) => 3,
        Sv::SBlob(_) => 4,
        Sv::SErr(_) => 0,
    }
}

fn sq_cmp_f(a: float, b: float) -> int {
    if a < b {
        return -1
    }
    if a > b {
        return 1
    }
    0
}

fn sq_cmp_i(a: int, b: int) -> int {
    if a < b {
        return -1
    }
    if a > b {
        return 1
    }
    0
}

// Entero contra flotante, exacto (como sqlite3IntFloatCompare).
fn sq_cmp_if(i: int, r: float) -> int {
    if r >= 9223372036854775808.0 {
        return -1
    }
    if r < -9223372036854775808.0 {
        return 1
    }
    let y = std::math::to_int(r)
    if i < y {
        return -1
    }
    if i > y {
        return 1
    }
    sq_cmp_f(std::math::to_float(i), r)
}

fn sq_fold(s: string) -> string {
    // minúsculas solo ASCII, como NOCASE
    let cs = std::text::chars(s)
    let mut out = []
    for c in cs {
        let k = std::text::char_code(c)
        if k >= 65 && k <= 90 {
            out = std::array::push(out, std::text::from_char_code(k + 32))
        } else {
            out = std::array::push(out, c)
        }
    }
    std::collections::join(out, "")
}

fn sq_rtrim(s: string) -> string {
    let cs = std::text::chars(s)
    let mut n = len(cs)
    while n > 0 && std::text::char_code(cs[n - 1]) == 32 {
        n -= 1
    }
    std::collections::join(std::array::slice(cs, 0, n), "")
}

// Orden de bytes de dos cadenas (UTF-8, igual que memcmp).
fn sq_cmp_str(a: string, b: string) -> int {
    if a == b {
        return 0
    }
    if a < b {
        return -1
    }
    1
}

// coll: 0 BINARY, 1 NOCASE, 2 RTRIM
fn sq_cmp_text(a: string, b: string, coll: int) -> int {
    if coll == 1 {
        return sq_cmp_str(sq_fold(a), sq_fold(b))
    }
    if coll == 2 {
        return sq_cmp_str(sq_rtrim(a), sq_rtrim(b))
    }
    sq_cmp_str(a, b)
}

fn sq_cmp_blob(a: any, b: any) -> int {
    let x = std::bytes::to_array(a)
    let y = std::bytes::to_array(b)
    let nx = len(x)
    let ny = len(y)
    let mut i = 0
    while i < nx && i < ny {
        if x[i] != y[i] {
            if x[i] < y[i] {
                return -1
            }
            return 1
        }
        i += 1
    }
    sq_cmp_i(nx, ny)
}

fn sq_cmp(a: Sv, b: Sv, coll: int) -> int {
    let ca = sq_cls(a)
    let cb = sq_cls(b)
    if ca != cb {
        return sq_cmp_i(ca, cb)
    }
    match a {
        Sv::SNull => 0,
        Sv::SInt(x) => {
            match b {
                Sv::SInt(y) => sq_cmp_i(x, y),
                Sv::SReal(y) => sq_cmp_if(x, y),
                _ => 0,
            }
        },
        Sv::SReal(x) => {
            match b {
                Sv::SInt(y) => 0 - sq_cmp_if(y, x),
                Sv::SReal(y) => sq_cmp_f(x, y),
                _ => 0,
            }
        },
        Sv::SText(x) => {
            match b {
                Sv::SText(y) => sq_cmp_text(x, y, coll),
                _ => 0,
            }
        },
        Sv::SBlob(x) => {
            match b {
                Sv::SBlob(y) => sq_cmp_blob(x, y),
                _ => 0,
            }
        },
        _ => 0,
    }
}

// std::tokenize del runtime nativo: capa de nativas sobre el motor de tokenizers en Titan
// (std_tokenize_*.titan). Mismos límites y mismos textos de error que la versión de Rust
// (crates/titan_stdlib/src/tokenize_mod.rs). Prefijo `tz_`.
//
// Registro de tokenizers en el bloque rtm_state():
//   +40  mapa "t<handle>" -> [tokenizer, bytes del JSON]   (0 = todavía vacío)
//   +48  siguiente handle (0 = 1). Empiezan en 1 y no se reutilizan.
//
// Diferencias con Rust, documentadas:
//   - Rechaza al cargar (error "unsupported ..."): normalizador Precompiled (T5/ALBERT/XLM-R),
//     pre-tokenizador UnicodeScripts y BPE con dropout > 0.
//   - Un JSON mal formado da un mensaje propio, no el de serde.
//   - No hay límite de 2 operaciones concurrentes (las nativas no se interrumpen entre sí).

fn tz_models_slot() -> int { rtm_state() + 40 }
fn tz_next_slot() -> int { rtm_state() + 48 }

fn tz_reg() -> any {
    let bits = std::raw::load(tz_models_slot())
    if bits == 0 {
        return std__map__new()
    }
    std::raw::value(9, bits)
}

fn tz_reg_take() -> any {
    let bits = std::raw::load(tz_models_slot())
    if bits == 0 {
        return std__map__new()
    }
    std::raw::store(tz_models_slot(), 0)
    std::raw::adopt(9, bits)
}

fn tz_reg_put(m: any) {
    std::raw::store(tz_models_slot(), std::raw::keep(m))
}

fn tz_next_id() -> int {
    let v = std::raw::load(tz_next_slot())
    let mut id = v
    if v == 0 {
        id = 1
    }
    std::raw::store(tz_next_slot(), id + 1)
    id
}

fn tz_fail(f: string, msg: string) {
    rt_native_fail(f, msg)
}

fn tz_limit(f: string, what: string, limit: int) {
    rt_native_fail(f, what + " exceeds limit " + "{limit}")
}

fn tz_entry(h: int) -> any {
    let key = "t" + "{h}"
    let reg = tz_reg()
    if !std::map::contains(reg, key) {
        return nil
    }
    std::map::get(reg, key)
}

fn tz_need(f: string, h: int) -> any {
    let e = tz_entry(h)
    if e == nil {
        tz_fail(f, "unknown tokenizer handle " + "{h}")
    }
    e
}

fn tz_bool(v: any, f: string) {
    if std::raw::tag(v) != 3 {
        tz_fail(f, "expected bool")
    }
}

fn tz_u32(v: int, what: string, f: string) {
    if v < 0 || v > 4294967295 {
        tz_fail(f, what + " out of u32 range")
    }
}

fn tz_validate_text(f: string, text: any) {
    if rt_slen(text) > 65536 {
        tz_limit(f, "tokenizer input text bytes", 65536)
    }
}

// Capacidad antes de cargar: handles (16), bytes de un JSON (16 MiB) y suma por runtime (64 MiB).
fn tz_preflight(f: string, source_bytes: int) {
    let reg = tz_reg()
    let n = std::map::length(reg)
    if n >= 16 {
        tz_limit(f, "tokenizer handles", 16)
    }
    if source_bytes > 16777216 {
        tz_limit(f, "tokenizer source bytes", 16777216)
    }
    let mut total = 0
    for k in std::map::keys(reg) {
        total += std::map::get(reg, k)[1]
    }
    if total + source_bytes > 67108864 {
        tz_limit(f, "runtime tokenizer source bytes", 67108864)
    }
}

// Interpreta el JSON y registra el tokenizer.
fn tz_register(f: string, src: string, size: int) -> int {
    let (t, err) = tk_load(tk_ctx(), src)
    if err != "" {
        tz_fail(f, "tokenizer error: " + err)
    }
    if tk_vocab_size(t, true) > 262144 {
        tz_limit(f, "tokenizer vocabulary entries", 262144)
    }
    for k in std::map::keys(t.vocab) {
        if rt_slen(k) > 256 {
            tz_limit(f, "vocabulary token bytes", 256)
        }
    }
    for k in std::map::keys(t.am) {
        if rt_slen(k) > 256 {
            tz_limit(f, "vocabulary token bytes", 256)
        }
    }
    tz_preflight(f, size)
    let id = tz_next_id()
    let mut reg = tz_reg_take()
    reg = std::map::insert(reg, "t" + "{id}", [t, size])
    tz_reg_put(reg)
    id
}

fn std__tokenize__load(path: any) -> any {
    let f = "std::tokenize::load"
    rt_expect_str(path, f)
    if rt_slen(path) > 16384 {
        tz_limit(f, "tokenizer path bytes", 16384)
    }
    if !std__fs__exists(path) {
        tz_fail(f, "tokenizer I/O error: " + rt_os_error(2))
    }
    if std__fs__is_dir(path) {
        tz_fail(f, "tokenizer I/O error: " + rt_os_error(21))
    }
    let got = std::try::catch(|| {
        std__fs__read_bytes(path)
    })
    let mut bytes: any = nil
    match got {
        Result::Ok(b) => {
            bytes = b
        },
        _ => {
            tz_fail(f, "tokenizer I/O error: " + rt_os_error(13))
        },
    }
    let size = rt_slen(bytes)
    if size > 16777216 {
        tz_limit(f, "tokenizer source bytes", 16777216)
    }
    tz_preflight(f, size)
    if rt_slen(rt_utf8_error(rt_bdata(bytes), size)) > 0 {
        tz_fail(f, "invalid tokenizer argument: tokenizer JSON is not UTF-8")
    }
    let src = std__encoding__utf8_decode(bytes)
    tz_register(f, src, size)
}

fn std__tokenize__from_json(json: any) -> any {
    let f = "std::tokenize::from_json"
    rt_expect_str(json, f)
    let size = rt_slen(json)
    tz_preflight(f, size)
    tz_register(f, json, size)
}

fn std__tokenize__close(h: any) -> any {
    rt_expect_int(h, "std::tokenize::close")
    let key = "t" + "{h}"
    let reg = tz_reg()
    if std::map::contains(reg, key) {
        let mut taken = tz_reg_take()
        taken = std::map::remove(taken, key)
        tz_reg_put(taken)
    }
    nil
}

fn std__tokenize__vocab_size(h: any) -> any {
    let f = "std::tokenize::vocab_size"
    rt_expect_int(h, f)
    let e = tz_need(f, h)
    tk_vocab_size(e[0], true)
}

// Una codificación -> mapa de Titan, con los límites de convert_encoding.
fn tz_enc_bytes(e: Enc) -> int {
    let mut n = 0
    for s in e.toks {
        n += rt_slen(s)
    }
    n
}

fn tz_check_enc(f: string, e: Enc) {
    if len(e.ids) > 131072 {
        tz_limit(f, "tokens per encoding", 131072)
    }
    if tz_enc_bytes(e) > 8388608 {
        tz_limit(f, "encoded token bytes", 8388608)
    }
}

fn tz_map(e: Enc) -> any {
    let mut m = std__map__new()
    m = std::map::insert(m, "ids", e.ids)
    m = std::map::insert(m, "tokens", e.toks)
    m = std::map::insert(m, "type_ids", e.tys)
    m = std::map::insert(m, "attention_mask", e.at)
    m = std::map::insert(m, "special_tokens_mask", e.sp)
    m
}

fn std__tokenize__encode(h: any, text: any, special: any) -> any {
    let f = "std::tokenize::encode"
    rt_expect_int(h, f)
    rt_expect_str(text, f)
    tz_bool(special, f)
    tz_validate_text(f, text)
    let e = tz_need(f, h)
    let (enc, err) = tk_encode(e[0], text, special)
    if err != "" {
        tz_fail(f, "tokenizer error: " + err)
    }
    tz_check_enc(f, enc)
    tz_map(enc)
}

fn std__tokenize__encode_padded(h: any, text: any, max_length: any, pad_id: any, special: any) -> any {
    let f = "std::tokenize::encode_padded"
    rt_expect_int(h, f)
    rt_expect_str(text, f)
    rt_expect_int(max_length, f)
    if max_length < 0 {
        tz_fail(f, "expected nonnegative integer")
    }
    rt_expect_int(pad_id, f)
    tz_u32(pad_id, "pad_id", f)
    tz_bool(special, f)
    tz_validate_text(f, text)
    if max_length == 0 {
        tz_fail(f, "invalid tokenizer argument: padded token length must be positive")
    }
    if max_length > 65536 {
        tz_limit(f, "padded token length", 65536)
    }
    let ent = tz_need(f, h)
    let (enc, err) = tk_encode(ent[0], text, special)
    if err != "" {
        tz_fail(f, "tokenizer error: " + err)
    }
    if len(enc.ids) > 131072 {
        tz_limit(f, "raw tokens before padding", 131072)
    }
    let n = len(enc.ids)
    let mut out = enc
    if n > max_length {
        let last = n - 1
        let mut ids = std::array::slice(enc.ids, 0, max_length)
        let mut toks = std::array::slice(enc.toks, 0, max_length)
        let mut tys = std::array::slice(enc.tys, 0, max_length)
        let mut at = std::array::slice(enc.at, 0, max_length)
        let mut sp = std::array::slice(enc.sp, 0, max_length)
        if special {
            ids = std::array::set(ids, max_length - 1, enc.ids[last])
            toks = std::array::set(toks, max_length - 1, enc.toks[last])
            tys = std::array::set(tys, max_length - 1, enc.tys[last])
            at = std::array::set(at, max_length - 1, enc.at[last])
            sp = std::array::set(sp, max_length - 1, enc.sp[last])
        }
        out = Enc { ids: ids, toks: toks, tys: tys, sp: sp, at: at }
    } else {
        let k = max_length - n
        out = Enc {
            ids: tk_cat(enc.ids, std::array::filled(k, pad_id)),
            toks: tk_cat(enc.toks, std::array::filled(k, "[PAD]")),
            tys: tk_cat(enc.tys, std::array::filled(k, 0)),
            sp: tk_cat(enc.sp, std::array::filled(k, 1)),
            at: tk_cat(enc.at, std::array::filled(k, 0)),
        }
    }
    if tz_enc_bytes(out) > 8388608 {
        tz_limit(f, "encoded token bytes", 8388608)
    }
    tz_map(out)
}

fn std__tokenize__encode_batch(h: any, texts: any, special: any) -> any {
    let f = "std::tokenize::encode_batch"
    rt_expect_int(h, f)
    rt_expect_array(texts, f)
    let n = len(texts)
    let mut i = 0
    while i < n {
        rt_expect_str(texts[i], f)
        i += 1
    }
    tz_bool(special, f)
    if n > 64 {
        tz_limit(f, "tokenizer batch items", 64)
    }
    let mut total = 0
    i = 0
    while i < n {
        tz_validate_text(f, texts[i])
        total += rt_slen(texts[i])
        i += 1
    }
    if total > 262144 {
        tz_limit(f, "tokenizer batch input bytes", 262144)
    }
    let ent = tz_need(f, h)
    let (encs, err) = tk_encode_batch(ent[0], texts, special)
    if err != "" {
        tz_fail(f, "tokenizer error: " + err)
    }
    let mut tokens = 0
    let mut bytes = 0
    for e in encs {
        tokens += len(e.ids)
        bytes += tz_enc_bytes(e)
    }
    if tokens > 262144 {
        tz_limit(f, "tokens per batch", 262144)
    }
    if bytes > 16777216 {
        tz_limit(f, "encoded batch token bytes", 16777216)
    }
    let mut out = []
    for e in encs {
        tz_check_enc(f, e)
        out = std::array::push(out, tz_map(e))
    }
    out
}

fn std__tokenize__decode(h: any, ids: any, skip: any) -> any {
    let f = "std::tokenize::decode"
    rt_expect_int(h, f)
    rt_expect_array(ids, f)
    let n = len(ids)
    let mut i = 0
    while i < n {
        rt_expect_int(ids[i], f)
        tz_u32(ids[i], "token id", f)
        i += 1
    }
    tz_bool(skip, f)
    if n > 131072 {
        tz_limit(f, "token ids to decode", 131072)
    }
    let ent = tz_need(f, h)
    let mut list = []
    i = 0
    while i < n {
        list = std::array::push(list, ids[i])
        i += 1
    }
    let text = tk_decode(ent[0], list, skip)
    if rt_slen(text) > 1048576 {
        tz_limit(f, "decoded tokenizer text bytes", 1048576)
    }
    text
}

fn std__tokenize__token_to_id(h: any, token: any) -> any {
    let f = "std::tokenize::token_to_id"
    rt_expect_int(h, f)
    rt_expect_str(token, f)
    if rt_slen(token) > 256 {
        tz_limit(f, "token bytes", 256)
    }
    let ent = tz_need(f, h)
    let id = tk_token_to_id(ent[0], token)
    if id < 0 {
        return nil
    }
    id
}

fn std__tokenize__id_to_token(h: any, id: any) -> any {
    let f = "std::tokenize::id_to_token"
    rt_expect_int(h, f)
    rt_expect_int(id, f)
    tz_u32(id, "token id", f)
    let ent = tz_need(f, h)
    let tok = tk_id_to_token(ent[0], id)
    if tok == nil {
        return nil
    }
    if rt_slen(tok) > 256 {
        tz_limit(f, "token bytes", 256)
    }
    tok
}

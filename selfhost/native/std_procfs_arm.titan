fn pf_arm_impl(x: int) -> any {
    if x == 65 {
        return "ARM"
    }
    if x == 66 {
        return "Broadcom"
    }
    if x == 67 {
        return "Cavium"
    }
    if x == 68 {
        return "DEC"
    }
    if x == 70 {
        return "FUJITSU"
    }
    if x == 72 {
        return "HiSilicon"
    }
    if x == 73 {
        return "Infineon"
    }
    if x == 77 {
        return "Motorola/Freescale"
    }
    if x == 78 {
        return "NVIDIA"
    }
    if x == 80 {
        return "APM"
    }
    if x == 81 {
        return "Qualcomm"
    }
    if x == 83 {
        return "Samsung"
    }
    if x == 86 {
        return "Marvell"
    }
    if x == 97 {
        return "Apple"
    }
    if x == 102 {
        return "Faraday"
    }
    if x == 105 {
        return "Intel"
    }
    if x == 112 {
        return "Phytium"
    }
    if x == 192 {
        return "Ampere"
    }
    nil
}


// std::postgres nativo: cliente del protocolo PostgreSQL v3 (consulta extendida, autenticación
// cleartext/md5/SCRAM-SHA-256, SSLRequest + TLS de std_tls.titan) con la semántica de
// crates/titan_postgres (que usa el crate `postgres`): siempre sentencias preparadas con
// parámetros tipados, filas como mapas, transacciones, migraciones y pool.
// Prefijo pq_ (las funciones rt_pg_* son las instrucciones Postgres* y Db*).
//
// Conexión (PQ_SIZE bytes): PQ_FD socket, PQ_TLS estado TLS (0 si va en claro), PQ_IN búfer de
// entrada (tb_ de std_tls), PQ_TX transacción abierta, PQ_PID/PQ_SECRET clave de cancelación,
// PQ_CLOSED, PQ_ID id del handle, PQ_POOL pool al que vuelve al soltarla (0 si es directa),
// PQ_BODY/PQ_BLEN cuerpo del último mensaje, PQ_ADDR "host:port" propio, PQ_QUIET modo sin errores.
// Pool: PL_URL (string propio), PL_MAX, PL_TLS, PL_TOTAL, PL_CLOSED, PL_NIDLE y PL_IDLE (64 conexiones).
// Registro de handles: tabla de 256 entradas de 24 bytes {id, clase 4 conexión / 5 pool, puntero}
// colgada de tcp_st()+24; los ids salen del mismo contador que los sockets, como en la VM.

const PQ_FD: int = 0
const PQ_TLS: int = 8
const PQ_IN: int = 16
const PQ_TX: int = 24
const PQ_PID: int = 32
const PQ_SECRET: int = 40
const PQ_CLOSED: int = 48
const PQ_ID: int = 56
const PQ_POOL: int = 64
const PQ_BODY: int = 72
const PQ_BLEN: int = 80
const PQ_ADDR: int = 88
const PQ_QUIET: int = 96
const PQ_UNIX: int = 104
const PQ_PORT: int = 112
const PQ_SIZE: int = 128

const PL_URL: int = 0
const PL_MAX: int = 8
const PL_TLS: int = 16
const PL_TOTAL: int = 24
const PL_CLOSED: int = 32
const PL_NIDLE: int = 40
const PL_IDLE: int = 48
const PL_SIZE: int = 576

const PQ_MAX_HANDLES: int = 256

fn pq_gs(p: int, off: int) -> int {
    std::raw::load(p + off)
}

fn pq_ss(p: int, off: int, v: int) {
    std::raw::store(p + off, v)
}

fn pq_str(p: int, n: int) -> any {
    let sp = rt_str_alloc(n)
    rt_copy(sp + 16, p, n)
    rt_sval(sp)
}

// Copia propia (nunca se libera) de un string, devuelta como puntero al objeto.
fn pq_own(s: any) -> int {
    let n = rt_slen(s)
    let sp = rt_str_alloc(n)
    rt_copy(sp + 16, rt_bdata(s), n)
    sp
}

fn pq_be16(p: int) -> int {
    std::raw::shl(std::raw::load8(p), 8) | std::raw::load8(p + 1)
}

fn pq_be32(p: int) -> int {
    std::raw::shl(std::raw::load8(p), 24) | std::raw::shl(std::raw::load8(p + 1), 16) | std::raw::shl(std::raw::load8(p + 2), 8) | std::raw::load8(p + 3)
}

fn pq_be64(p: int) -> int {
    std::raw::shl(pq_be32(p), 32) | pq_be32(p + 4)
}

fn pq_type_error(message: any) {
    rt_fatal(rt_concat("type error: ", message))
}

fn pq_fail(message: any) {
    rt_native_fail("std::postgres", message)
}


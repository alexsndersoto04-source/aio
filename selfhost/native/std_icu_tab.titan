// Número total de enteros.
fn icu_tab_count() -> int { 48819 }

// Tablas: (primer entero, cantidad, cifras hexadecimales por número).
fn icu_tab_parts() -> int { 13 }
fn icu_tab_part(k: int) -> (int, int, int) {
    if k == 0 {
        return (0, 3230, 4)
    }
    if k == 1 {
        return (3230, 12503, 8)
    }
    if k == 2 {
        return (15733, 772, 4)
    }
    if k == 3 {
        return (16505, 195, 6)
    }
    if k == 4 {
        return (16700, 2439, 4)
    }
    if k == 5 {
        return (19139, 313, 6)
    }
    if k == 6 {
        return (19452, 2654, 4)
    }
    if k == 7 {
        return (22106, 2578, 4)
    }
    if k == 8 {
        return (24684, 4656, 2)
    }
    if k == 9 {
        return (29340, 1719, 4)
    }
    if k == 10 {
        return (31059, 3626, 2)
    }
    if k == 11 {
        return (34685, 3506, 4)
    }
    if k == 12 {
        return (38191, 10628, 2)
    }
    return (0, 0, 0)
}


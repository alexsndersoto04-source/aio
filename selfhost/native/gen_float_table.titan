// Genera selfhost/native/float_table.titan: las potencias de diez 10^k
// (k = -348, -340, ..., 340) como f * 2^e con f de 62 bits (2^61 <= f < 2^62),
// redondeadas al más cercano, calculadas con enteros exactos (float.titan).
// Las usa el algoritmo Grisu de float.titan. Se regenera con:
//   zett run selfhost/native/gen_float_table.titan > selfhost/native/float_table.titan
import float

// floor(a / 2^n) y si el resto es >= la mitad (para redondear).
fn gen_shr_round(a: array, n: int) -> array {
    let mut x = a
    let mut k = n
    let mut half = false
    while k > 0 {
        // dividir por 2
        let mut out = []
        let mut rem = 0
        let mut i = len(x) - 1
        while i >= 0 {
            let cur = rem * 4294967296 + x[i]
            out = std::array::concat([cur / 2], out)
            rem = cur % 2
            i -= 1
        }
        half = rem == 1
        x = bn_trim(out)
        k -= 1
    }
    if half {
        x = bn_add_small(x, 1)
    }
    x
}

// (f, e) de 10^k.
fn gen_power(k: int) -> (int, int) {
    let two62 = bn_shl([1], 62)
    let two61 = bn_shl([1], 61)
    if k >= 0 {
        let n = bn_mul_pow10([1], k)
        let mut e = bn_bits(n) - 62
        let mut f = n
        if e > 0 {
            f = gen_shr_round(n, e)
        } else {
            f = bn_shl(n, 0 - e)
        }
        if bn_cmp(f, two62) >= 0 {
            f = gen_shr_round(f, 1)
            e += 1
        }
        return (bn_int(f), e)
    }
    // 10^k = 2^-s / 10^-k * 2^s: f = round(2^s / 10^-k)
    let d = bn_mul_pow10([1], 0 - k)
    let s = 61 + bn_bits(d)
    let mut num = bn_shl([1], s)
    // cociente y resto por división larga bit a bit
    let mut q = []
    let mut r = []
    let mut bit = s
    while bit >= 0 {
        r = bn_shl(r, 1)
        if bit == s {
            r = bn_add_small(r, 1)
        }
        q = bn_shl(q, 1)
        if bn_cmp(r, d) >= 0 {
            r = bn_sub(r, d)
            q = bn_add_small(q, 1)
        }
        bit -= 1
    }
    let mut e = 0 - s
    if bn_cmp(bn_shl(r, 1), d) >= 0 {
        q = bn_add_small(q, 1)
    }
    while bn_cmp(q, two62) >= 0 {
        q = gen_shr_round(q, 1)
        e += 1
    }
    while bn_cmp(q, two61) < 0 {
        q = bn_shl(q, 1)
        e -= 1
    }
    return (bn_int(q), e)
}

fn gen_tree(lo: int, hi: int, indent: string) -> string {
    if lo == hi {
        let (f, e) = gen_power(-348 + 8 * lo)
        return indent + "return ({f}, {e})\n"
    }
    let mid = (lo + hi) / 2
    let inner = indent + "    "
    let open = std::text::from_char_code(123) + ""
    let close = std::text::from_char_code(125) + ""
    let mut out = indent + "if i <= " + "{mid}" + " " + open + "\n"
    out += gen_tree(lo, mid, inner)
    out += indent + close + "\n"
    out += gen_tree(mid + 1, hi, indent)
    out
}

fn main() {
    print("// GENERADO por selfhost/native/gen_float_table.titan; no editar a mano.")
    print("// fl_cached(i) = (f, e) con 10^(-348 + 8i) ~= f * 2^e, 2^61 <= f < 2^62, i = 0..86.")
    let open = std::text::from_char_code(123) + ""
    let close = std::text::from_char_code(125) + ""
    print("fn fl_cached(i: int) -> (int, int) " + open)
    print(gen_tree(0, 86, "    ") + close)
}

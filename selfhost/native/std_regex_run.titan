// Búsqueda con expresiones regulares y las nativas de std::regex, escritas
// en Titan. Semántica de regex 1.13.0 / regex-automata 0.4.15:
//   * PikeVM leftmost-first (nfa/thompson/pikevm.rs): mismo orden de hilos,
//     mismo cierre épsilon con conjunto disperso y capturas restauradas.
//   * utf8_empty: una coincidencia que termina dentro de un carácter se
//     descarta y se vuelve a buscar (util/empty.rs, skip_splits_fwd).
//   * Iteración (util/iter.rs Searcher): tras una coincidencia vacía en el
//     mismo final que la anterior se avanza un byte.
//   * Aserciones de util/look.rs (LookMatcher) con fin de línea '\n'.
//   * Sustitución con $n, $nombre, ${...} y $$ (util/interpolate.rs).
// El NFA es el de std_regex_nfa.titan (el mismo que compila Core::new).

// ------------------------------------------------------------ máquina
//
// V: +0 NFA, +8 datos del texto, +16 longitud, +24 cantidad de ranuras,
// +32 conjunto actual, +40 conjunto siguiente, +48 pila (tríos: 0 explorar
// estado / 1 restaurar ranura, valor), +56 ranuras de trabajo, +64 ranuras
// del resultado, +72 datos de los estados, +80 datos de las transiciones
// dispersas, +88 registro, +96 clase \w Unicode (0 = sin decodificar),
// +104 cantidad de estados, +112 estado inicial (anclado).
//
// Conjunto: +0 tamaño, +8 denso, +16 disperso, +24 ranuras (por estado).

fn rv_set_new(ns: int, nslots: int) -> int {
    let s = rt_alloc(32)
    std::raw::store(s, 0)
    std::raw::store(s + 8, rt_alloc(8 * ns + 8))
    std::raw::store(s + 16, rt_alloc(8 * ns + 8))
    std::raw::store(s + 24, rt_alloc(8 * ns * nslots + 8))
    s
}

fn rv_set_free(s: int) {
    rt_free_block(std::raw::load(s + 8))
    rt_free_block(std::raw::load(s + 16))
    rt_free_block(std::raw::load(s + 24))
    rt_free_block(s)
}

// Sigue los estados Empty (que builder.rs quita al construir el NFA final).
fn rv_resolve(sd: int, s0: int) -> int {
    let mut s = s0
    while std::raw::load(sd + 32 * s) == 1 {
        s = std::raw::load(sd + 32 * s + 8)
    }
    s
}

// Reescribe los punteros para saltar los estados Empty.
fn rv_skip_empties(n: int) {
    let sd = std::raw::load(std::raw::load(n + 8) + 16)
    let ns = rn_count(n)
    let mut s = 0
    while s < ns {
        let k = std::raw::load(sd + 32 * s)
        if k == 2 {
            std::raw::store(sd + 32 * s + 24, rv_resolve(sd, std::raw::load(sd + 32 * s + 24)))
        } else if k == 4 || k == 5 || k == 6 {
            std::raw::store(sd + 32 * s + 16, rv_resolve(sd, std::raw::load(sd + 32 * s + 16)))
        } else if k == 7 || k == 8 {
            let v = std::raw::load(sd + 32 * s + 8)
            let mut i = 0
            while i < iv_len(v) {
                iv_set(v, i, rv_resolve(sd, iv_get(v, i)))
                i += 1
            }
        }
        s += 1
    }
    let pool = std::raw::load(n + 40)
    let mut i = 2
    while i < iv_len(pool) {
        iv_set(pool, i, rv_resolve(sd, iv_get(pool, i)))
        i += 3
    }
}

fn rv_new(p: int, n: int, text: any, nslots: int) -> int {
    let v = rt_alloc(120)
    let ns = rn_count(n)
    let sd = std::raw::load(std::raw::load(n + 8) + 16)
    std::raw::store(v, n)
    std::raw::store(v + 8, std::raw::bits(text) + 16)
    std::raw::store(v + 16, rt_slen(text))
    std::raw::store(v + 24, nslots)
    std::raw::store(v + 32, rv_set_new(ns, nslots))
    std::raw::store(v + 40, rv_set_new(ns, nslots))
    std::raw::store(v + 48, iv_new(64))
    std::raw::store(v + 56, rt_alloc(8 * nslots + 8))
    std::raw::store(v + 64, rt_alloc(8 * nslots + 8))
    std::raw::store(v + 72, sd)
    std::raw::store(v + 80, std::raw::load(std::raw::load(n + 40) + 16))
    std::raw::store(v + 88, p)
    std::raw::store(v + 96, 0)
    std::raw::store(v + 104, ns)
    std::raw::store(v + 112, rv_resolve(sd, std::raw::load(n + 96)))
    v
}

fn rv_free(v: int) {
    rv_set_free(std::raw::load(v + 32))
    rv_set_free(std::raw::load(v + 40))
    iv_free(std::raw::load(v + 48))
    rt_free_block(std::raw::load(v + 56))
    rt_free_block(std::raw::load(v + 64))
    rt_free_block(v)
}

fn rv_byte(v: int, i: int) -> int {
    std::raw::load8(std::raw::load(v + 8) + i)
}

// ------------------------------------------------------------ aserciones

fn rv_is_word_byte(b: int) -> bool {
    (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95
}

// Longitud de la secuencia UTF-8 por su primer byte (0 = inválido).
fn rv_utf8_len(b: int) -> int {
    if b < 128 {
        return 1
    }
    if b >= 194 && b <= 223 {
        return 2
    }
    if b >= 224 && b <= 239 {
        return 3
    }
    if b >= 240 && b <= 244 {
        return 4
    }
    0
}

// utf8::decode(&haystack[a..fin]): el carácter o -1 (inválido o vacío).
fn rv_decode(v: int, a: int, fin: int) -> int {
    if a >= fin {
        return -1
    }
    let b0 = rv_byte(v, a)
    let len = rv_utf8_len(b0)
    if len == 0 || a + len > fin {
        return -1
    }
    if len == 1 {
        return b0
    }
    let mut c = 0
    if len == 2 {
        c = b0 - 192
    } else if len == 3 {
        c = b0 - 224
    } else {
        c = b0 - 240
    }
    let mut i = 1
    while i < len {
        let b = rv_byte(v, a + i)
        if b < 128 || b > 191 {
            return -1
        }
        c = c * 64 + (b - 128)
        i += 1
    }
    if (len == 3 && c < 2048) || (len == 4 && c < 65536) || c > 1114111 || (c >= 55296 && c <= 57343) {
        return -1
    }
    c
}

// utf8::decode_last(&haystack[..at]).
fn rv_decode_last(v: int, at: int) -> int {
    if at == 0 {
        return -1
    }
    let mut start = at - 1
    let mut limit = 0
    if at > 4 {
        limit = at - 4
    }
    while start > limit {
        let b = rv_byte(v, start)
        if b < 128 || b >= 192 {
            break
        }
        start -= 1
    }
    rv_decode(v, start, at)
}

fn rv_word_char(v: int, c: int) -> bool {
    if c < 0 {
        return false
    }
    if c < 128 {
        return rv_is_word_byte(c)
    }
    let mut w = std::raw::load(v + 96)
    if w == 0 {
        let p = std::raw::load(v + 88)
        w = std::raw::load(p + 168)
        if w == 0 {
            w = ru_single(p, rxt_perl_word())
            std::raw::store(p + 168, w)
        }
        std::raw::store(v + 96, w)
    }
    let mut lo = 0
    let mut hi = rc_n(w)
    while lo < hi {
        let mid = (lo + hi) / 2
        if c < rc_lo(w, mid) {
            hi = mid
        } else if c > rc_hi(w, mid) {
            lo = mid + 1
        } else {
            return true
        }
    }
    false
}

fn rv_wb_before(v: int, at: int) -> bool {
    at > 0 && rv_is_word_byte(rv_byte(v, at - 1))
}

fn rv_wb_after(v: int, at: int) -> bool {
    at < std::raw::load(v + 16) && rv_is_word_byte(rv_byte(v, at))
}

fn rv_wu_before(v: int, at: int) -> bool {
    rv_word_char(v, rv_decode_last(v, at))
}

fn rv_wu_after(v: int, at: int) -> bool {
    rv_word_char(v, rv_decode(v, at, std::raw::load(v + 16)))
}

fn rv_look(v: int, bit: int, at: int) -> bool {
    let len = std::raw::load(v + 16)
    if bit == 1 {
        return at == 0
    }
    if bit == 2 {
        return at == len
    }
    if bit == 4 {
        return at == 0 || rv_byte(v, at - 1) == 10
    }
    if bit == 8 {
        return at == len || rv_byte(v, at) == 10
    }
    if bit == 16 {
        if at == 0 {
            return true
        }
        let b = rv_byte(v, at - 1)
        return b == 10 || (b == 13 && (at >= len || rv_byte(v, at) != 10))
    }
    if bit == 32 {
        if at == len {
            return true
        }
        let b = rv_byte(v, at)
        return b == 13 || (b == 10 && (at == 0 || rv_byte(v, at - 1) != 13))
    }
    if bit == 64 {
        return rv_wb_before(v, at) != rv_wb_after(v, at)
    }
    if bit == 128 {
        return rv_wb_before(v, at) == rv_wb_after(v, at)
    }
    if bit == 256 {
        return rv_wu_before(v, at) != rv_wu_after(v, at)
    }
    if bit == 512 {
        let mut before = false
        if at > 0 {
            if rv_decode_last(v, at) < 0 {
                return false
            }
            before = rv_wu_before(v, at)
        }
        let mut after = false
        if at < len {
            if rv_decode(v, at, len) < 0 {
                return false
            }
            after = rv_wu_after(v, at)
        }
        return before == after
    }
    if bit == 1024 {
        return !rv_wb_before(v, at) && rv_wb_after(v, at)
    }
    if bit == 2048 {
        return rv_wb_before(v, at) && !rv_wb_after(v, at)
    }
    if bit == 4096 {
        return !rv_wu_before(v, at) && rv_wu_after(v, at)
    }
    if bit == 8192 {
        return rv_wu_before(v, at) && !rv_wu_after(v, at)
    }
    if bit == 16384 {
        return !rv_wb_before(v, at)
    }
    if bit == 32768 {
        return !rv_wb_after(v, at)
    }
    if bit == 65536 {
        if at > 0 {
            if rv_decode_last(v, at) < 0 {
                return false
            }
            return !rv_wu_before(v, at)
        }
        return true
    }
    if at < len {
        if rv_decode(v, at, len) < 0 {
            return false
        }
        return !rv_wu_after(v, at)
    }
    true
}

// ------------------------------------------------------------ PikeVM

fn rv_contains(set: int, s: int) -> bool {
    let i = std::raw::load(std::raw::load(set + 16) + 8 * s)
    i >= 0 && i < std::raw::load(set) && std::raw::load(std::raw::load(set + 8) + 8 * i) == s
}

fn rv_insert(set: int, s: int) {
    let len = std::raw::load(set)
    std::raw::store(std::raw::load(set + 8) + 8 * len, s)
    std::raw::store(std::raw::load(set + 16) + 8 * s, len)
    std::raw::store(set, len + 1)
}

// epsilon_closure: añade a set lo alcanzable desde sid en la posición at,
// con las ranuras slots (se modifican y se restauran).
fn rv_closure(v: int, set: int, slots: int, at: int, sid: int) {
    let sd = std::raw::load(v + 72)
    let nslots = std::raw::load(v + 24)
    let stack = std::raw::load(v + 48)
    let base = iv_len(stack)
    iv_push(stack, 0)
    iv_push(stack, sid)
    iv_push(stack, 0)
    while iv_len(stack) > base {
        let top = iv_len(stack)
        let tag = iv_get(stack, top - 3)
        let a = iv_get(stack, top - 2)
        let b = iv_get(stack, top - 1)
        iv_trunc(stack, top - 3)
        if tag == 1 {
            std::raw::store(slots + 8 * a, b)
            continue
        }
        let mut s = a
        let mut seguir = 1
        while seguir == 1 {
            if rv_contains(set, s) {
                seguir = 0
                continue
            }
            rv_insert(set, s)
            let st = sd + 32 * s
            let k = std::raw::load(st)
            if k == 2 || k == 3 || k == 9 || k == 10 {
                let dst = std::raw::load(set + 24) + 8 * nslots * s
                let mut i = 0
                while i < nslots {
                    std::raw::store(dst + 8 * i, std::raw::load(slots + 8 * i))
                    i += 1
                }
                seguir = 0
            } else if k == 1 {
                s = std::raw::load(st + 8)
            } else if k == 4 {
                if rv_look(v, std::raw::load(st + 8), at) {
                    s = std::raw::load(st + 16)
                } else {
                    seguir = 0
                }
            } else if k == 7 {
                let alts = std::raw::load(st + 8)
                let cnt = iv_len(alts)
                if cnt == 0 {
                    seguir = 0
                } else {
                    let mut j = cnt - 1
                    while j >= 1 {
                        iv_push(stack, 0)
                        iv_push(stack, iv_get(alts, j))
                        iv_push(stack, 0)
                        j -= 1
                    }
                    s = iv_get(alts, 0)
                }
            } else if k == 8 {
                let alts = std::raw::load(st + 8)
                let cnt = iv_len(alts)
                if cnt == 0 {
                    seguir = 0
                } else {
                    let mut j = 0
                    while j < cnt - 1 {
                        iv_push(stack, 0)
                        iv_push(stack, iv_get(alts, j))
                        iv_push(stack, 0)
                        j += 1
                    }
                    s = iv_get(alts, cnt - 1)
                }
            } else {
                let mut slot = 2 * std::raw::load(st + 8)
                if k == 6 {
                    slot += 1
                }
                if slot < nslots {
                    iv_push(stack, 1)
                    iv_push(stack, slot)
                    iv_push(stack, std::raw::load(slots + 8 * slot))
                    std::raw::store(slots + 8 * slot, at)
                }
                s = std::raw::load(st + 16)
            }
        }
    }
}

// Siguiente estado para el byte b desde un estado ByteRange/Sparse (-1 si no).
fn rv_step(v: int, s: int, b: int) -> int {
    let st = std::raw::load(v + 72) + 32 * s
    let k = std::raw::load(st)
    if k == 2 {
        if b >= std::raw::load(st + 8) && b <= std::raw::load(st + 16) {
            return std::raw::load(st + 24)
        }
        return -1
    }
    if k == 3 {
        let pool = std::raw::load(v + 80)
        let mut t = pool + 24 * std::raw::load(st + 8)
        let fin = t + 24 * std::raw::load(st + 16)
        while t < fin {
            let lo = std::raw::load(t)
            if lo > b {
                return -1
            }
            if b <= std::raw::load(t + 8) {
                return std::raw::load(t + 16)
            }
            t += 24
        }
    }
    -1
}

// search_imp desde start. Devuelve el final de la coincidencia (-1 si no
// hay) y deja las ranuras en V+64.
fn rv_search_imp(v: int, start: int) -> int {
    let len = std::raw::load(v + 16)
    if start > len {
        return -1
    }
    let nslots = std::raw::load(v + 24)
    let mut curr = std::raw::load(v + 32)
    let mut next = std::raw::load(v + 40)
    std::raw::store(curr, 0)
    std::raw::store(next, 0)
    let scratch = std::raw::load(v + 56)
    let out = std::raw::load(v + 64)
    let start_sid = std::raw::load(v + 112)
    let sd = std::raw::load(v + 72)
    let mut hm = -1
    let mut at = start
    while at <= len {
        if std::raw::load(curr) == 0 && hm >= 0 {
            break
        }
        if hm < 0 {
            let mut i = 0
            while i < nslots {
                std::raw::store(scratch + 8 * i, -1)
                i += 1
            }
            rv_closure(v, curr, scratch, at, start_sid)
        }
        let dense = std::raw::load(curr + 8)
        let cslots = std::raw::load(curr + 24)
        let cnt = std::raw::load(curr)
        let mut b = -1
        if at < len {
            b = rv_byte(v, at)
        }
        let mut i = 0
        while i < cnt {
            let s = std::raw::load(dense + 8 * i)
            let k = std::raw::load(sd + 32 * s)
            if k == 10 {
                let src = cslots + 8 * nslots * s
                let mut j = 0
                while j < nslots {
                    std::raw::store(out + 8 * j, std::raw::load(src + 8 * j))
                    j += 1
                }
                hm = at
                break
            }
            if b >= 0 && (k == 2 || k == 3) {
                let nx = rv_step(v, s, b)
                if nx >= 0 {
                    rv_closure(v, next, cslots + 8 * nslots * s, at + 1, nx)
                }
            }
            i += 1
        }
        let t = curr
        curr = next
        next = t
        std::raw::store(next, 0)
        at += 1
    }
    std::raw::store(v + 32, curr)
    std::raw::store(v + 40, next)
    hm
}

fn rv_is_boundary(v: int, i: int) -> bool {
    let len = std::raw::load(v + 16)
    if i >= len {
        return i == len
    }
    let b = rv_byte(v, i)
    b < 128 || b >= 192
}

// search_slots_imp con skip_splits_fwd: final de la coincidencia o -1.
fn rv_search(v: int, start: int) -> int {
    let mut e = rv_search_imp(v, start)
    if e < 0 {
        return -1
    }
    let mut s = start
    while !rv_is_boundary(v, e) {
        s += 1
        e = rv_search_imp(v, s)
        if e < 0 {
            return -1
        }
    }
    e
}

fn rv_slot(v: int, i: int) -> int {
    std::raw::load(std::raw::load(v + 64) + 8 * i)
}

// Searcher::advance. It: +0 inicio de la búsqueda, +8 último final (-1).
// Devuelve 1 si hay otra coincidencia (ranuras en V+64), 0 si no.
fn rv_iter_next(v: int, it: int) -> int {
    let st = std::raw::load(it)
    let mut e = rv_search(v, st)
    if e < 0 {
        return 0
    }
    if rv_slot(v, 0) == e && e == std::raw::load(it + 8) {
        std::raw::store(it, st + 1)
        e = rv_search(v, st + 1)
        if e < 0 {
            return 0
        }
    }
    std::raw::store(it, e)
    std::raw::store(it + 8, e)
    1
}

// ------------------------------------------------------------ preparación
//
// Caché de las 8 últimas expresiones compiladas (globals + 2816: bloque con
// 8 entradas de patrón (string retenido) y registro P, y +128 la próxima
// entrada a reemplazar). Regex::new compila cada vez; guardar el resultado
// no cambia nada de lo que se observa (los errores no se guardan: se vuelven
// a calcular) y evita repetir la compilación en bucles. El runtime nativo no
// tiene hilos.

fn rx_cache() -> int {
    let g = std::raw::globals() + 2816
    let c = std::raw::load(g)
    if c != 0 {
        return c
    }
    let b = rt_alloc(136)
    let mut i = 0
    while i < 17 {
        std::raw::store(b + 8 * i, 0)
        i += 1
    }
    std::raw::store(g, b)
    b
}

fn rx_same_str(a: int, b: int) -> bool {
    let n = std::raw::load(a + 8)
    if std::raw::load(b + 8) != n {
        return false
    }
    let mut i = 0
    while i < n {
        if std::raw::load8(a + 16 + i) != std::raw::load8(b + 16 + i) {
            return false
        }
        i += 1
    }
    true
}

fn rx_cache_find(pat: any) -> int {
    let c = rx_cache()
    let pb = std::raw::bits(pat)
    let mut i = 0
    while i < 8 {
        let e = std::raw::load(c + 16 * i)
        if e != 0 && rx_same_str(e, pb) {
            return std::raw::load(c + 16 * i + 8)
        }
        i += 1
    }
    0
}

fn rx_cache_put(pat: any, p: int) {
    let c = rx_cache()
    let k = std::raw::load(c + 128)
    let old = std::raw::load(c + 16 * k)
    if old != 0 {
        let op = std::raw::load(c + 16 * k + 8)
        rn_free(std::raw::load(op + 160))
        rp_free(op)
        std::raw::release(5, old)
    }
    std::raw::retain(5, std::raw::bits(pat))
    std::raw::store(c + 16 * k, std::raw::bits(pat))
    std::raw::store(c + 16 * k + 8, p)
    std::raw::store(c + 128, (k + 1) % 8)
}

// Analiza, traduce y compila (o toma de la caché); si hay error termina la
// nativa con el mensaje de la VM. Devuelve el registro P con el NFA en
// P+160 (P+168: clase \w Unicode decodificada). P es de la caché: no se
// libera.
fn rx_compile_or_fail(function: string, pat: any) -> int {
    rt_expect_str(pat, function)
    let hit = rx_cache_find(pat)
    if hit != 0 {
        return hit
    }
    let p = rp_new(pat)
    let ast = rp_parse(p)
    let mut h = 0
    if ast != 0 {
        h = tr_ast(p, ast)
    }
    if h == 0 {
        let msg = rx_format_error(pat, tr_error_text(std::raw::load(p + 72)), std::raw::load(p + 80), std::raw::load(p + 88), std::raw::load(p + 96) != 0, std::raw::load(p + 104), std::raw::load(p + 112))
        rp_free(p)
        rt_native_fail(function, rt_concat(rt_concat(rt_concat("invalid regular expression '", pat), "': "), msg))
    }
    let n = rx_prepare(p, h)
    if n == 0 {
        rp_free(p)
        rt_native_fail(function, rt_concat(rt_concat("invalid regular expression '", pat), "': Compiled regex exceeds size limit of 10485760 bytes."))
    }
    rv_skip_empties(n)
    std::raw::store(p + 160, n)
    rx_cache_put(pat, p)
    p
}

fn rx_done(p: int, v: int) {
    rv_free(v)
}

fn rx_groups(p: int) -> int {
    std::raw::load(std::raw::load(p + 160) + 128)
}

// ------------------------------------------------------------ nativas

fn std__regex__is_valid(pat: any) -> any {
    rt_expect_str(pat, "std::regex::is_valid")
    if rx_cache_find(pat) != 0 {
        return true
    }
    let e = rx_check_hir(pat)
    rt_slen(e) == 0
}

fn std__regex__is_match(pat: any, text: any) -> any {
    let p = rx_compile_or_fail("std::regex::is_match", pat)
    rt_expect_str(text, "std::regex::is_match")
    let v = rv_new(p, std::raw::load(p + 160), text, 2)
    let found = rv_search(v, 0) >= 0
    rx_done(p, v)
    found
}

fn std__regex__find(pat: any, text: any) -> any {
    let p = rx_compile_or_fail("std::regex::find", pat)
    rt_expect_str(text, "std::regex::find")
    let v = rv_new(p, std::raw::load(p + 160), text, 2)
    let e = rv_search(v, 0)
    let mut out = ""
    if e >= 0 {
        out = rt_substr_bytes(text, rv_slot(v, 0), e)
    }
    rx_done(p, v)
    out
}

fn std__regex__find_all(pat: any, text: any) -> any {
    let p = rx_compile_or_fail("std::regex::find_all", pat)
    rt_expect_str(text, "std::regex::find_all")
    let v = rv_new(p, std::raw::load(p + 160), text, 2)
    let it = rt_alloc(16)
    std::raw::store(it, 0)
    std::raw::store(it + 8, -1)
    let mut out = []
    while rv_iter_next(v, it) == 1 {
        out = std::array::push(out, rt_substr_bytes(text, rv_slot(v, 0), rv_slot(v, 1)))
    }
    rt_free_block(it)
    rx_done(p, v)
    out
}

fn std__regex__captures(pat: any, text: any) -> any {
    let p = rx_compile_or_fail("std::regex::captures", pat)
    rt_expect_str(text, "std::regex::captures")
    let g = rx_groups(p)
    let v = rv_new(p, std::raw::load(p + 160), text, 2 * g)
    let mut out = []
    if rv_search(v, 0) >= 0 {
        let mut i = 0
        while i < g {
            let a = rv_slot(v, 2 * i)
            let b = rv_slot(v, 2 * i + 1)
            if a >= 0 && b >= 0 {
                out = std::array::push(out, rt_substr_bytes(text, a, b))
            } else {
                out = std::array::push(out, "")
            }
            i += 1
        }
    }
    rx_done(p, v)
    out
}

fn std__regex__split(pat: any, text: any) -> any {
    let p = rx_compile_or_fail("std::regex::split", pat)
    rt_expect_str(text, "std::regex::split")
    let v = rv_new(p, std::raw::load(p + 160), text, 2)
    let it = rt_alloc(16)
    std::raw::store(it, 0)
    std::raw::store(it + 8, -1)
    let mut out = []
    let mut last = 0
    while rv_iter_next(v, it) == 1 {
        out = std::array::push(out, rt_substr_bytes(text, last, rv_slot(v, 0)))
        last = rv_slot(v, 1)
    }
    out = std::array::push(out, rt_substr_bytes(text, last, rt_slen(text)))
    rt_free_block(it)
    rx_done(p, v)
    out
}

// ¿El byte es válido en una referencia $nombre sin llaves?
fn rx_cap_letter(b: int) -> bool {
    (b >= 48 && b <= 57) || (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || b == 95
}

// cap.parse::<usize>() sobre rep[a..b): el número o -1 (acepta un '+'
// inicial como Rust; -1 también si desborda).
fn rx_parse_usize(rp: int, a: int, b: int) -> int {
    let mut i = a
    if i < b && std::raw::load8(rp + i) == 43 {
        i += 1
    }
    if i >= b {
        return -1
    }
    let mut x = 0
    while i < b {
        let d = std::raw::load8(rp + i) - 48
        if d < 0 || d > 9 {
            return -1
        }
        if x > (9223372036854775807 - d) / 10 {
            return -1
        }
        x = x * 10 + d
        i += 1
    }
    x
}

// Índice del grupo con nombre rep[a..b) (-1 si no existe).
fn rx_name_index(p: int, rp: int, a: int, b: int) -> int {
    let names = std::raw::load(std::raw::load(p + 160) + 120)
    let pat = std::raw::load(p)
    let mut i = 0
    while i < iv_len(names) {
        let n0 = iv_get(names, i + 1)
        let n1 = iv_get(names, i + 2)
        if n1 - n0 == b - a {
            let mut k = 0
            while k < b - a && std::raw::load8(pat + n0 + k) == std::raw::load8(rp + a + k) {
                k += 1
            }
            if k == b - a {
                return iv_get(names, i)
            }
        }
        i += 3
    }
    -1
}

fn rx_append_group(v: int, sb: int, text: any, g: int, groups: int) {
    if g < 0 || g >= groups {
        return
    }
    let a = rv_slot(v, 2 * g)
    let b = rv_slot(v, 2 * g + 1)
    if a >= 0 && b >= 0 {
        sb_raw(sb, std::raw::bits(text) + 16 + a, b - a)
    }
}

// interpolate::string.
fn rx_expand(p: int, v: int, sb: int, text: any, rep: any, groups: int) {
    let rp = std::raw::bits(rep) + 16
    let n = rt_slen(rep)
    let mut i = 0
    while i < n {
        let mut j = i
        while j < n && std::raw::load8(rp + j) != 36 {
            j += 1
        }
        sb_raw(sb, rp + i, j - i)
        i = j
        if i >= n {
            break
        }
        if i + 1 < n && std::raw::load8(rp + i + 1) == 36 {
            sb_byte(sb, 36)
            i += 2
            continue
        }
        if i + 1 >= n {
            sb_byte(sb, 36)
            i += 1
            continue
        }
        if std::raw::load8(rp + i + 1) == 123 {
            let a = i + 2
            let mut e = a
            while e < n && std::raw::load8(rp + e) != 125 {
                e += 1
            }
            if e >= n {
                sb_byte(sb, 36)
                i += 1
                continue
            }
            let num = rx_parse_usize(rp, a, e)
            if num >= 0 {
                rx_append_group(v, sb, text, num, groups)
            } else {
                rx_append_group(v, sb, text, rx_name_index(p, rp, a, e), groups)
            }
            i = e + 1
            continue
        }
        let a = i + 1
        let mut e = a
        while e < n && rx_cap_letter(std::raw::load8(rp + e)) {
            e += 1
        }
        if e == a {
            sb_byte(sb, 36)
            i += 1
            continue
        }
        let num = rx_parse_usize(rp, a, e)
        if num >= 0 {
            rx_append_group(v, sb, text, num, groups)
        } else {
            rx_append_group(v, sb, text, rx_name_index(p, rp, a, e), groups)
        }
        i = e
    }
}

fn std__regex__replace_all(pat: any, text: any, rep: any) -> any {
    let p = rx_compile_or_fail("std::regex::replace_all", pat)
    rt_expect_str(text, "std::regex::replace_all")
    rt_expect_str(rep, "std::regex::replace_all")
    let rp = std::raw::bits(rep) + 16
    let rn = rt_slen(rep)
    let mut expand = false
    let mut i = 0
    while i < rn {
        if std::raw::load8(rp + i) == 36 {
            expand = true
        }
        i += 1
    }
    let mut groups = 1
    if expand {
        groups = rx_groups(p)
    }
    let v = rv_new(p, std::raw::load(p + 160), text, 2 * groups)
    let it = rt_alloc(16)
    std::raw::store(it, 0)
    std::raw::store(it + 8, -1)
    let sb = sb_new(rt_slen(text) + 16)
    let tp = std::raw::bits(text) + 16
    let mut last = 0
    while rv_iter_next(v, it) == 1 {
        sb_raw(sb, tp + last, rv_slot(v, 0) - last)
        if expand {
            rx_expand(p, v, sb, text, rep, groups)
        } else {
            sb_raw(sb, rp, rn)
        }
        last = rv_slot(v, 1)
    }
    sb_raw(sb, tp + last, rt_slen(text) - last)
    rt_free_block(it)
    rx_done(p, v)
    sb_finish(sb)
}

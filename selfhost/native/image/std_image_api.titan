fn std__image__crop(handle: any, x0: any, y0: any, w0: any, h0: any) -> any {
    let f = "std::image::crop"
    let id = im_int(handle, f)
    let x = im_u32(f, im_int(x0, f), "x")
    let y = im_u32(f, im_int(y0, f), "y")
    let w = im_u32(f, im_int(w0, f), "width")
    let h = im_u32(f, im_int(h0, f), "height")
    im_dims(f, w, h)
    let e = im_need(f, id)
    let right = x + w
    let bottom = y + h
    if right > 4294967295 || bottom > 4294967295 {
        im_param(f, "crop coordinates overflow")
    }
    if right > std::raw::load(e + 8) || bottom > std::raw::load(e + 16) {
        im_param(f, "crop is outside the source image")
    }
    im_crop_do(f, e, x, y, w, h)
}

fn std__image__brighten(handle: any, value: any) -> any {
    let f = "std::image::brighten"
    let id = im_int(handle, f)
    let v = im_int(value, f)
    if v < 0 - 2147483648 || v > 2147483647 {
        im_fail(f, "brightness out of range")
    }
    im_bright(f, im_need(f, id), v)
}

fn std__image__resize(handle: any, width: any, height: any, filter: any) -> any {
    let f = "std::image::resize"
    let id = im_int(handle, f)
    let w = im_u32(f, im_int(width, f), "width")
    let h = im_u32(f, im_int(height, f), "height")
    rt_expect_str(filter, f)
    im_dims(f, w, h)
    let kind = imop_filter_name(f, filter)
    let e = im_need(f, id)
    let (nw, nh) = imop_resize_dimensions(std::raw::load(e + 8), std::raw::load(e + 16), w, h)
    imop_resize_exact_do(f, e, nw, nh, kind)
}

fn std__image__resize_exact(handle: any, width: any, height: any, filter: any) -> any {
    let f = "std::image::resize_exact"
    let id = im_int(handle, f)
    let w = im_u32(f, im_int(width, f), "width")
    let h = im_u32(f, im_int(height, f), "height")
    rt_expect_str(filter, f)
    im_dims(f, w, h)
    let kind = imop_filter_name(f, filter)
    imop_resize_exact_do(f, im_need(f, id), w, h, kind)
}

fn std__image__thumbnail(handle: any, width: any, height: any) -> any {
    let f = "std::image::thumbnail"
    let id = im_int(handle, f)
    let w = im_u32(f, im_int(width, f), "width")
    let h = im_u32(f, im_int(height, f), "height")
    im_dims(f, w, h)
    let e = im_need(f, id)
    let (nw, nh) = imop_resize_dimensions(std::raw::load(e + 8), std::raw::load(e + 16), w, h)
    imop_thumbnail_exact_do(f, e, nw, nh)
}

fn std__image__blur(handle: any, sigma0: any) -> any {
    let f = "std::image::blur"
    let id = im_int(handle, f)
    let raw = rt_expect_number(sigma0, f)
    if !rt_is_finite(raw) {
        im_fail(f, "blur sigma out of range")
    }
    let sigma = vec_f32(raw)
    if !rt_is_finite(sigma) {
        im_fail(f, "blur sigma out of range")
    }
    if std::raw::fcmp(sigma, 0) < 0 || std::raw::fcmp(sigma, imop_c(100.0)) > 0 {
        im_param(f, "blur sigma is outside the supported range")
    }
    if std::raw::fcmp(sigma, 0) > 0 && std::raw::fcmp(sigma, 4039728865751334912) < 0 {
        im_param(f, "blur sigma is outside the supported range")
    }
    imop_blur_do(f, im_need(f, id), sigma)
}


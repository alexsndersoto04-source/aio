// std::csv, std::uuid y std::stats escritos en Titan, con el comportamiento
// de la VM (csv.rs, crate uuid 1.x, stats.rs).

// ---------------------------------------------------------------- csv

fn cv_fail(message: any) {
    rt_native_fail("std::csv::parse", message)
}

fn std__csv__parse(text: any) -> any {
    rt_expect_str(text, "std::csv::parse")
    let p = std::raw::bits(text) + 16
    let n = rt_slen(text)
    let rows = js_vec_new()
    let mut row = js_vec_new()
    let mut field = sb_new(16)
    let mut quoted = false
    let mut closed = false
    let mut i = 0
    while i < n {
        let c = std::raw::load8(p + i)
        if quoted {
            if c == 34 {
                if i + 1 < n && std::raw::load8(p + i + 1) == 34 {
                    sb_byte(field, 34)
                    i += 2
                    continue
                }
                quoted = false
                closed = true
                i += 1
                continue
            }
            sb_byte(field, c)
            i += 1
            continue
        }
        if closed && c != 44 && c != 13 && c != 10 {
            cv_fail(rt_concat("unexpected character after closing quote at byte ", rt_int_to_str(i)))
        }
        if c == 34 {
            if sb_len(field) == 0 && !closed {
                quoted = true
                i += 1
            } else {
                cv_fail(rt_concat("unexpected quote in unquoted field at byte ", rt_int_to_str(i)))
            }
        } else if c == 44 {
            js_vec_push(row, sb_finish(field))
            field = sb_new(16)
            closed = false
            i += 1
        } else if c == 13 || c == 10 {
            if c == 13 && i + 1 < n && std::raw::load8(p + i + 1) == 10 {
                i += 1
            }
            js_vec_push(row, sb_finish(field))
            field = sb_new(16)
            js_vec_push(rows, js_vec_finish(row))
            row = js_vec_new()
            closed = false
            i += 1
        } else {
            sb_byte(field, c)
            i += 1
        }
    }
    if quoted {
        cv_fail(rt_concat("unterminated quoted field at record ", rt_int_to_str(std::raw::load(rows) + 1)))
    }
    if sb_len(field) > 0 || std::raw::load(row) > 0 || closed {
        js_vec_push(row, sb_finish(field))
        js_vec_push(rows, js_vec_finish(row))
    } else {
        sb_finish(field)
        js_vec_finish(row)
    }
    js_vec_finish(rows)
}

fn cv_needs_quotes(s: any) -> bool {
    let p = std::raw::bits(s) + 16
    let n = rt_slen(s)
    let mut i = 0
    while i < n {
        let c = std::raw::load8(p + i)
        if c == 44 || c == 34 || c == 13 || c == 10 {
            return true
        }
        i += 1
    }
    false
}

fn std__csv__serialize(rows: any) -> any {
    let f = "std::csv::serialize"
    rt_expect_array(rows, f)
    let n = rt_seq_len(rows)
    // Primero se valida todo (como Rust, que convierte antes de escribir).
    let mut r = 0
    while r < n {
        let row = rt_seq_get(rows, r)
        rt_expect_array(row, f)
        let m = rt_seq_len(row)
        let mut k = 0
        while k < m {
            rt_expect_str(rt_seq_get(row, k), f)
            k += 1
        }
        r += 1
    }
    let b = sb_new(64)
    r = 0
    while r < n {
        if r > 0 {
            sb_byte(b, 13)
            sb_byte(b, 10)
        }
        let row = rt_seq_get(rows, r)
        let m = rt_seq_len(row)
        let mut k = 0
        while k < m {
            if k > 0 {
                sb_byte(b, 44)
            }
            let s = rt_seq_get(row, k)
            if cv_needs_quotes(s) {
                let p = std::raw::bits(s) + 16
                let len = rt_slen(s)
                sb_byte(b, 34)
                let mut i = 0
                while i < len {
                    let c = std::raw::load8(p + i)
                    sb_byte(b, c)
                    if c == 34 {
                        sb_byte(b, 34)
                    }
                    i += 1
                }
                sb_byte(b, 34)
            } else {
                sb_str(b, s)
            }
            k += 1
        }
        r += 1
    }
    sb_finish(b)
}

// ---------------------------------------------------------------- uuid

// Escribe 16 bytes como "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx".
fn uu_format(bytes: int) -> any {
    let s = rt_str_alloc(36)
    let mut o = s + 16
    let mut i = 0
    while i < 16 {
        if i == 4 || i == 6 || i == 8 || i == 10 {
            std::raw::store8(o, 45)
            o += 1
        }
        let x = std::raw::load8(bytes + i)
        std::raw::store8(o, js_hexd(x / 16))
        std::raw::store8(o + 1, js_hexd(x & 15))
        o += 2
        i += 1
    }
    rt_sval(s)
}

// Uuid::parse_str: simple (32), con guiones (36), entre llaves (38) o URN
// "urn:uuid:" (45). Deja los 16 bytes en `out`; false si no es válido.
fn uu_parse(text: any, out: int) -> bool {
    let mut p = std::raw::bits(text) + 16
    let n = rt_slen(text)
    let mut hyphens = true
    if n == 32 {
        hyphens = false
    } else if n == 38 {
        if std::raw::load8(p) != 123 || std::raw::load8(p + 37) != 125 {
            return false
        }
        p += 1
    } else if n == 45 {
        let prefix = "urn:uuid:"
        let q = std::raw::bits(prefix) + 16
        let mut k = 0
        while k < 9 {
            if std::raw::load8(p + k) != std::raw::load8(q + k) {
                return false
            }
            k += 1
        }
        p += 9
    } else if n != 36 {
        return false
    }
    let mut pos = 0
    let mut i = 0
    while i < 16 {
        if hyphens && (i == 4 || i == 6 || i == 8 || i == 10) {
            if std::raw::load8(p + pos) != 45 {
                return false
            }
            pos += 1
        }
        let hi = js_hex_val(std::raw::load8(p + pos))
        let lo = js_hex_val(std::raw::load8(p + pos + 1))
        if hi < 0 || lo < 0 {
            return false
        }
        std::raw::store8(out + i, hi * 16 + lo)
        pos += 2
        i += 1
    }
    true
}

fn std__uuid__is_valid(text: any) -> any {
    rt_expect_str(text, "std::uuid::is_valid")
    let b = rt_alloc(16)
    let ok = uu_parse(text, b)
    rt_free_block(b)
    ok
}

fn std__uuid__normalize(text: any) -> any {
    rt_expect_str(text, "std::uuid::normalize")
    let b = rt_alloc(16)
    let mut out: any = ""
    if uu_parse(text, b) {
        out = uu_format(b)
    }
    rt_free_block(b)
    out
}

fn std__uuid__nil() -> any {
    "00000000-0000-0000-0000-000000000000"
}

// Versión 4: 122 bits al azar del sistema.
fn std__uuid__v4() -> any {
    let b = rt_alloc(16)
    rn_os_fill(b, 16)
    std::raw::store8(b + 6, (std::raw::load8(b + 6) & 15) | 64)
    std::raw::store8(b + 8, (std::raw::load8(b + 8) & 63) | 128)
    let s = uu_format(b)
    rt_free_block(b)
    s
}

// Versión 7: 48 bits de milisegundos Unix, 12 bits de contador (empieza al
// azar en cada milisegundo nuevo y sube dentro del mismo, para que los UUID
// del proceso salgan ordenados) y 62 bits al azar.
fn std__uuid__v7() -> any {
    let g = std::raw::globals()
    let b = rt_alloc(16)
    rn_os_fill(b, 16)
    let (secs, ns) = rt_clock(0)
    let mut ms = secs * 1000 + ns / 1000000
    let last = std::raw::load(g + 2408)
    let mut counter = 0
    if ms <= last {
        ms = last
        counter = std::raw::load(g + 2416) + 1
        if counter > 4095 {
            ms = last + 1
            counter = (std::raw::load8(b + 6) * 256 + std::raw::load8(b + 7)) & 2047
        }
    } else {
        counter = (std::raw::load8(b + 6) * 256 + std::raw::load8(b + 7)) & 2047
    }
    std::raw::store(g + 2408, ms)
    std::raw::store(g + 2416, counter)
    let mut k = 0
    while k < 6 {
        std::raw::store8(b + k, std::raw::shr(ms, 40 - 8 * k) & 255)
        k += 1
    }
    std::raw::store8(b + 6, 112 | std::raw::shr(counter, 8))
    std::raw::store8(b + 7, counter & 255)
    std::raw::store8(b + 8, (std::raw::load8(b + 8) & 63) | 128)
    let s = uu_format(b)
    rt_free_block(b)
    s
}

// ---------------------------------------------------------------- stats

// Los números del array como bits de f64 en un búfer crudo (enteros
// convertidos); "expected number" si hay otra cosa.
fn st_numbers(v: any, function: string) -> int {
    rt_expect_array(v, function)
    let n = rt_seq_len(v)
    let buf = rt_alloc(8 * n + 8)
    let mut i = 0
    while i < n {
        let x = rt_seq_get(v, i)
        let t = std::raw::tag(x)
        if t == 2 {
            std::raw::store(buf + 8 * i, std::raw::bits(x))
        } else if t == 1 {
            std::raw::store(buf + 8 * i, std::raw::ffromint(std::raw::bits(x)))
        } else {
            rt_native_fail(function, "expected number")
        }
        i += 1
    }
    buf
}

fn st_finite(bits: int) -> bool {
    (bits & 9218868437227405312) != 9218868437227405312
}

fn std__stats__mean(v: any) -> any {
    let buf = st_numbers(v, "std::stats::mean")
    let n = rt_seq_len(v)
    if n == 0 {
        rt_native_fail("std::stats::mean", "mean requires at least one number")
    }
    // Sum de f64 en Rust empieza en -0.0.
    let mut s = -9223372036854775807 - 1
    let mut i = 0
    while i < n {
        s = std::raw::fadd(s, std::raw::load(buf + 8 * i))
        i += 1
    }
    rt_free_block(buf)
    rt_float(std::raw::fdiv(s, std::raw::ffromint(n)))
}

// Clave de f64::total_cmp como entero con signo.
fn st_key(bits: int) -> int {
    bits ^ std::raw::shr(std::raw::sar(bits, 63), 1)
}

// Ordena n floats (bits) en `buf` con total_cmp (mezcla ascendente).
fn st_sort(buf: int, n: int) {
    let tmp = rt_alloc(8 * n + 8)
    let mut width = 1
    while width < n {
        let mut lo = 0
        while lo < n {
            let mut mid = lo + width
            if mid > n {
                mid = n
            }
            let mut hi = lo + 2 * width
            if hi > n {
                hi = n
            }
            let mut a = lo
            let mut b = mid
            let mut o = lo
            while o < hi {
                if a < mid && (b >= hi || st_key(std::raw::load(buf + 8 * a)) <= st_key(std::raw::load(buf + 8 * b))) {
                    std::raw::store(tmp + 8 * o, std::raw::load(buf + 8 * a))
                    a += 1
                } else {
                    std::raw::store(tmp + 8 * o, std::raw::load(buf + 8 * b))
                    b += 1
                }
                o += 1
            }
            lo += 2 * width
        }
        rt_copy(buf, tmp, 8 * n)
        width *= 2
    }
    rt_free_block(tmp)
}

// quantile de stats.rs; -1 (bits imposibles aquí) si no es válido.
fn st_quantile(buf: int, n: int, q: int) -> any {
    // 0.0 <= q <= 1.0 (falso con NaN)
    if n == 0 || !(std::raw::fcmp(q, 0) >= 0 && std::raw::fcmp(q, 4607182418800017408) <= 0) || rt_is_nan(q) {
        return nil
    }
    let mut i = 0
    while i < n {
        if !st_finite(std::raw::load(buf + 8 * i)) {
            return nil
        }
        i += 1
    }
    st_sort(buf, n)
    let position = std::raw::fmul(q, std::raw::ffromint(n - 1))
    // position >= 0: el suelo es truncar y el techo suma 1 si hay fracción.
    let lower = std::raw::ftoint(rt_trunc(position))
    let mut upper = lower
    if rt_has_fraction(position) {
        upper = lower + 1
    }
    let fraction = std::raw::fsub(position, std::raw::ffromint(lower))
    let a = std::raw::fmul(std::raw::load(buf + 8 * lower), std::raw::fsub(4607182418800017408, fraction))
    let b = std::raw::fmul(std::raw::load(buf + 8 * upper), fraction)
    rt_float(std::raw::fadd(a, b))
}

fn std__stats__median(v: any) -> any {
    let buf = st_numbers(v, "std::stats::median")
    let r = st_quantile(buf, rt_seq_len(v), 4602678819172646912)
    rt_free_block(buf)
    if r == nil {
        rt_native_fail("std::stats::median", "median requires finite numbers")
    }
    r
}

fn std__stats__quantile(v: any, q: any) -> any {
    let buf = st_numbers(v, "std::stats::quantile")
    let t = std::raw::tag(q)
    let mut qb = 0
    if t == 2 {
        qb = std::raw::bits(q)
    } else if t == 1 {
        qb = std::raw::ffromint(std::raw::bits(q))
    } else {
        rt_native_fail("std::stats::quantile", "expected number")
    }
    let r = st_quantile(buf, rt_seq_len(v), qb)
    rt_free_block(buf)
    if r == nil {
        rt_native_fail("std::stats::quantile", "invalid quantile or input")
    }
    r
}

// Welford (Summary de stats.rs): se saltan los no finitos. Devuelve la
// varianza poblacional en bits, o nil si no hubo ningún número.
fn st_variance(buf: int, n: int) -> any {
    let mut count = 0
    let mut mean = 0
    let mut m2 = 0
    let mut i = 0
    while i < n {
        let x = std::raw::load(buf + 8 * i)
        if st_finite(x) {
            count += 1
            let delta = std::raw::fsub(x, mean)
            mean = std::raw::fadd(mean, std::raw::fdiv(delta, std::raw::ffromint(count)))
            m2 = std::raw::fadd(m2, std::raw::fmul(delta, std::raw::fsub(x, mean)))
        }
        i += 1
    }
    if count == 0 {
        return nil
    }
    std::raw::fdiv(m2, std::raw::ffromint(count))
}

fn std__stats__variance(v: any) -> any {
    let buf = st_numbers(v, "std::stats::variance")
    let r = st_variance(buf, rt_seq_len(v))
    rt_free_block(buf)
    if r == nil {
        rt_native_fail("std::stats::variance", "variance requires numbers")
    }
    rt_float(r)
}

fn std__stats__stddev(v: any) -> any {
    let buf = st_numbers(v, "std::stats::stddev")
    let r = st_variance(buf, rt_seq_len(v))
    rt_free_block(buf)
    if r == nil {
        rt_native_fail("std::stats::stddev", "standard deviation requires numbers")
    }
    rt_float(std::raw::fsqrt(r))
}

// ------------------------------------------------------------ importaciones y capas

struct WaStr {
    handles: array,
    data: array,
    pages: int,
    heap_start: int,
}

// definiciones: [nativa, campo, parámetros, ¿devuelve valor?]; print: índice o -1.
struct WaHi {
    defs: array,
    print: int,
    natives: map,
    web: map,
}

struct WaEc {
    g: G,
    f: Func,
    lay: WaLay,
    st: WaStr,
    hi: WaHi,
    concat: int,
    alloc: int,
    seq: int,
    shash: int,
    scratch1: int,
    scratch2: int,
    pc: int,
}

fn wa_map_arity(name: string) -> int {
    if name == "std::map::new" {
        return 0
    }
    if name == "std::map::length" || name == "std::map::keys" || name == "std::map::values" {
        return 1
    }
    if name == "std::map::insert_new" || name == "std::map::insert" {
        return 3
    }
    if name == "std::map::contains" || name == "std::map::get" || name == "std::map::remove" {
        return 2
    }
    -1
}

fn wa_string_arity(name: string) -> int {
    if name == "std::text::equals" {
        return 2
    }
    if name == "std::text::hash64" {
        return 1
    }
    -1
}

fn wa_array_arity(name: string) -> int {
    if name == "std::array::set" || name == "std::array::slice" {
        return 3
    }
    if name == "std::array::push" || name == "std::array::concat" {
        return 2
    }
    if name == "std::array::pop" {
        return 1
    }
    -1
}

fn wa_heap_arity(name: string) -> int {
    if name == "std::wasm::heap_used" || name == "std::wasm::heap_capacity" || name == "std::wasm::heap_limit" || name == "std::wasm::heap_checkpoint" || name == "std::wasm::heap_allocations" || name == "std::wasm::heap_allocated_bytes" || name == "std::wasm::heap_restores" || name == "std::wasm::heap_reclaimed_bytes" || name == "std::wasm::heap_peak_used" || name == "std::wasm::heap_reset_counters" || name == "std::wasm::heap_scope_begin" {
        return 0
    }
    if name == "std::wasm::heap_set_limit" || name == "std::wasm::heap_restore" || name == "std::wasm::heap_scope_end" {
        return 1
    }
    -1
}

fn wa_web_map() -> map {
    let mut m = std::map::new()
    for d in wa_web_table() {
        m = std::map::insert(m, d[0], d)
    }
    m
}

fn wa_target(op: Op) -> int {
    if op.flag {
        return 9223372036854775807
    }
    op.n
}

// ------------------------------------------------------------ validación

fn wa_validate(g: G, f: Func, op: Op, web: map) -> Result {
    let k = op.k
    if (k == "PushLocal" || k == "StoreLocal") && op.n >= f.locals {
        return Result::Err("function '" + f.name + "' accesses invalid local " + wa_i(op.n) + "")
    }
    if k == "PushStr" && op.n >= len(g.table) {
        return Result::Err("function '" + f.name + "' references invalid string-table entry " + wa_i(op.n) + "")
    }
    if (k == "NewArray" || k == "NewTuple") && op.n > 536870911 {
        return wa_unsupported(f, "collection with " + wa_i(op.n) + " elements exceeds Wasm memory32")
    }
    if k == "NewStruct" && len(op.list) > 536870911 {
        return wa_unsupported(f, "struct exceeds Wasm memory32")
    }
    if k == "Print" && op.n != 1 {
        return wa_unsupported(f, "Print(" + wa_i(op.n) + ") requires exactly one browser-host argument")
    }
    if k == "CallNative" {
        let name = op.s
        let mut expected = wa_map_arity(name)
        if expected < 0 {
            expected = wa_string_arity(name)
        }
        if expected < 0 {
            expected = wa_array_arity(name)
        }
        if expected < 0 {
            expected = wa_heap_arity(name)
        }
        if expected < 0 && std::map::contains(web, name) {
            expected = std::map::get(web, name)[2]
        }
        if expected < 0 {
            return wa_unsupported(f, "CallNative(" + name + ")")
        }
        if op.n != expected {
            return Result::Err("function '" + f.name + "' calls '" + name + "' with " + wa_i(op.n) + " arguments, but it expects {expected}")
        }
        return Result::Ok(nil)
    }
    if k == "Call" {
        if op.flag {
            return wa_unsupported(f, "range expressions (start..end / start..=end) are not yet supported when compiling to WebAssembly")
        }
        if op.n >= len(g.funcs) {
            return Result::Err("function '" + f.name + "' calls invalid function " + wa_i(op.n) + "")
        }
        let target = g.funcs[op.n]
        if op.m != target.arity {
            return Result::Err("function '" + f.name + "' calls '" + target.name + "' with " + wa_i(op.m) + " arguments, but it expects " + wa_i(target.arity) + "")
        }
        return Result::Ok(nil)
    }
    if k == "PushInt" || k == "PushBool" || k == "PushChar" || k == "PushNil" || k == "PushStr" || k == "PushLocal" || k == "StoreLocal" || k == "Pop" || k == "Dup" || k == "Add" || k == "Sub" || k == "Mul" || k == "Div" || k == "Mod" || k == "Neg" || k == "Not" || k == "BitNot" || k == "Eq" || k == "Neq" || k == "Lt" || k == "Gt" || k == "Lte" || k == "Gte" || k == "BitAnd" || k == "BitOr" || k == "BitXor" || k == "Jump" || k == "JumpIfFalse" || k == "Ret" || k == "Print" || k == "Len" || k == "NewArray" || k == "NewTuple" || k == "Index" || k == "NewStruct" || k == "GetField" || k == "NewEnum" || k == "EnumIs" || k == "EnumPayload" || k == "Nop" || k == "Halt" {
        return Result::Ok(nil)
    }
    wa_unsupported(f, cg_op_text(op))
}

// (consumidos, producidos)
fn wa_stack_effect(op: Op) -> (int, int) {
    let k = op.k
    if k == "PushInt" || k == "PushBool" || k == "PushChar" || k == "PushNil" || k == "PushStr" || k == "PushLocal" {
        return (0, 1)
    }
    if k == "StoreLocal" || k == "Pop" || k == "JumpIfFalse" {
        return (1, 0)
    }
    if k == "Dup" {
        return (1, 2)
    }
    if k == "Add" || k == "Sub" || k == "Mul" || k == "Div" || k == "Mod" || k == "Eq" || k == "Neq" || k == "Lt" || k == "Gt" || k == "Lte" || k == "Gte" || k == "BitAnd" || k == "BitOr" || k == "BitXor" {
        return (2, 1)
    }
    if k == "Neg" || k == "Not" || k == "BitNot" || k == "Len" {
        return (1, 1)
    }
    if k == "NewArray" || k == "NewTuple" {
        return (op.n, 1)
    }
    if k == "NewStruct" {
        return (len(op.list), 1)
    }
    if k == "Index" {
        return (2, 1)
    }
    if k == "GetField" {
        return (1, 1)
    }
    if k == "NewEnum" {
        if op.flag {
            return (1, 1)
        }
        return (0, 1)
    }
    if k == "EnumIs" || k == "EnumPayload" {
        return (1, 1)
    }
    if k == "Call" {
        return (op.m, 1)
    }
    if k == "CallNative" || k == "Print" {
        return (op.n, 1)
    }
    return (0, 0)
}

// ------------------------------------------------------------ análisis de pila

// Anota la altura de `target`; devuelve Err(mensaje) o Ok(¿hay que encolarlo?).
fn wa_enqueue(f: Func, heights: array, target: int, height: int) -> Result {
    if target >= len(heights) || target < 0 {
        let mut shown = "{target}"
        if target == 9223372036854775807 {
            shown = "18446744073709551615"
        }
        return Result::Err("function '" + f.name + "' jumps to invalid instruction " + shown)
    }
    let first = heights[target]
    if first >= 0 && first != height {
        return Result::Err("inconsistent operand stack in function '" + f.name + "' at instruction {target}: {first} versus {height} values")
    }
    if first >= 0 {
        return Result::Ok(false)
    }
    Result::Ok(true)
}

fn wa_analyze(g: G, f: Func, web: map) -> Result {
    if len(f.code) == 0 {
        return Result::Ok(WaLay { heights: [], stack_base: f.locals, stack_slots: 0, pc_local: f.locals, adds: std::map::new(), fields: std::map::new() })
    }
    let n = len(f.code)
    let mut heights = []
    let mut i = 0
    while i < n {
        heights = std::array::push(heights, -1)
        i += 1
    }
    heights = std::array::set(heights, 0, 0)
    let mut pending = [0]
    let mut head = 0
    let mut maximum = 0
    while head < len(pending) {
        let instruction = pending[head]
        head += 1
        let height = heights[instruction]
        let op = f.code[instruction]
        wa_validate(g, f, op, web)?
        let (consumed, produced) = wa_stack_effect(op)
        if height < consumed {
            return Result::Err("operand stack underflow in function '" + f.name + "' at instruction {instruction}")
        }
        let next_height = height - consumed + produced
        if next_height > maximum {
            maximum = next_height
        }
        if maximum > f.max_stack {
            return Result::Err("operand stack in function '" + f.name + "' requires {maximum} values, exceeding declared maximum " + wa_i(f.max_stack) + "")
        }
        let mut targets = []
        if op.k == "Jump" {
            targets = [wa_target(op)]
        } else if op.k == "JumpIfFalse" {
            targets = [wa_target(op), instruction + 1]
        } else if op.k == "Ret" || op.k == "Halt" {
            targets = []
        } else {
            targets = [instruction + 1]
        }
        let mut ti = 0
        for target in targets {
            let is_fallthrough = target == instruction + 1 && op.k != "Jump"
            if is_fallthrough && target >= n {
                return Result::Err("function '" + f.name + "' jumps to invalid instruction {target}")
            }
            let push = wa_enqueue(f, heights, target, next_height)?
            if push {
                heights = std::array::set(heights, target, next_height)
                pending = std::array::push(pending, target)
            }
            ti += 1
        }
    }
    let (adds, fields) = wa_infer(g, f, heights)?
    Result::Ok(WaLay { heights: heights, stack_base: f.locals, stack_slots: maximum, pc_local: f.locals + maximum, adds: adds, fields: fields })
}

// ------------------------------------------------------------ regiones estructuradas

fn wa_has_jumps(f: Func) -> bool {
    for op in f.code {
        if op.k == "Jump" || op.k == "JumpIfFalse" {
            return true
        }
    }
    false
}

fn wa_is_linear(f: Func, lay: WaLay) -> bool {
    for h in lay.heights {
        if h < 0 {
            return false
        }
    }
    !wa_has_jumps(f)
}

// (then_jump, else_start, end) o nil.
fn wa_if_region(f: Func, conditional: int, limit: int) -> any {
    if conditional >= len(f.code) {
        return nil
    }
    let op = f.code[conditional]
    if op.k != "JumpIfFalse" {
        return nil
    }
    let else_start = wa_target(op)
    if else_start < 1 {
        return nil
    }
    let then_jump = else_start - 1
    if then_jump >= len(f.code) || f.code[then_jump].k != "Jump" {
        return nil
    }
    let end = wa_target(f.code[then_jump])
    if conditional >= then_jump || end <= else_start || end > limit {
        return nil
    }
    return (then_jump, else_start, end)
}

// (condición, salto atrás, fin) o nil.
fn wa_loop_region(f: Func, start: int, limit: int) -> any {
    let mut condition = start
    while condition < limit {
        let op = f.code[condition]
        if op.k == "JumpIfFalse" {
            let end = wa_target(op)
            if end > condition + 1 && end <= limit {
                let back_jump = end - 1
                if back_jump < len(f.code) && f.code[back_jump].k == "Jump" && wa_target(f.code[back_jump]) == start {
                    return (condition, back_jump, end)
                }
            }
        }
        condition += 1
    }
    nil
}

// loop_targets: has_loop, continue_target, break_target
fn wa_reducible(f: Func, lay: WaLay, start: int, end: int, has_loop: bool, cont: int, brk: int) -> bool {
    let mut instruction = start
    while instruction < end {
        if lay.heights[instruction] < 0 {
            instruction += 1
            continue
        }
        let region = wa_loop_region(f, instruction, end)
        if region != nil {
            let (condition, back_jump, rend) = region
            if !wa_reducible(f, lay, instruction, condition, has_loop, cont, brk) || !wa_reducible(f, lay, condition + 1, back_jump, true, instruction, rend) {
                return false
            }
            instruction = rend
            continue
        }
        let op = f.code[instruction]
        if op.k == "JumpIfFalse" {
            let r = wa_if_region(f, instruction, end)
            if r == nil {
                return false
            }
            let (then_jump, else_start, rend) = r
            if !wa_reducible(f, lay, instruction + 1, then_jump, has_loop, cont, brk) || !wa_reducible(f, lay, else_start, rend, has_loop, cont, brk) {
                return false
            }
            instruction = rend
        } else if op.k == "Jump" && has_loop && (wa_target(op) == cont || wa_target(op) == brk) {
            instruction += 1
        } else if op.k == "Jump" {
            return false
        } else {
            instruction += 1
        }
    }
    true
}

fn wa_has_reducible(f: Func, lay: WaLay) -> bool {
    wa_has_jumps(f) && wa_reducible(f, lay, 0, len(f.code), false, 0, 0)
}

// ------------------------------------------------------------ emisión de operaciones

fn wa_store_const(b: array, local: int, value: int) -> array {
    wa_local_set(wa_i64_const(b, value), local)
}

fn wa_binary(b: array, lay: WaLay, height: int, opcode: array) -> array {
    let output = lay.stack_base + height - 2
    let mut out = wa_local_get(b, output)
    out = wa_local_get(out, output + 1)
    out = std::array::concat(out, opcode)
    wa_local_set(out, output)
}

fn wa_comparison(b: array, lay: WaLay, height: int, opcode: array) -> array {
    let output = lay.stack_base + height - 2
    let mut out = wa_local_get(b, output)
    out = wa_local_get(out, output + 1)
    out = std::array::concat(out, opcode)
    out = wa_i64_extend_i32_u(out)
    wa_local_set(out, output)
}

fn wa_set_pc(b: array, local: int, instruction: int) -> array {
    wa_local_set(wa_i32_const(b, instruction), local)
}

fn wa_collection_count(b: array, handle_local: int) -> array {
    let mut out = wa_local_get(b, handle_local)
    out = wa_i32_wrap_i64(out)
    out = wa_i32_const(out, 4)
    out = wa_i32_sub(out)
    wa_i32_load(out, 2, 0)
}

fn wa_allocation_counters(b: array, previous_heap: int) -> array {
    let mut b2 = b
    b2 = wa_global_get(b2, 3)
    b2 = wa_i64_const(b2, 1)
    b2 = wa_i64_add(b2)
    b2 = wa_global_set(b2, 3)
    b2 = wa_global_get(b2, 4)
    b2 = wa_global_get(b2, 0)
    b2 = wa_local_get(b2, previous_heap)
    b2 = wa_i32_sub(b2)
    b2 = wa_i64_extend_i32_u(b2)
    b2 = wa_i64_add(b2)
    b2 = wa_global_set(b2, 4)
    b2 = wa_global_get(b2, 0)
    b2 = wa_i64_extend_i32_u(b2)
    b2 = wa_global_get(b2, 7)
    b2 = wa_i64_gt_u(b2)
    b2 = wa_if(b2)
    b2 = wa_global_get(b2, 0)
    b2 = wa_i64_extend_i32_u(b2)
    b2 = wa_global_set(b2, 7)
    b2 = wa_end(b2)
    b2
}

fn wa_emit_heap_rewind(b: array, checkpoint_local: int) -> array {
    let mut b2 = b
    b2 = wa_local_get(b2, checkpoint_local)
    b2 = wa_i32_wrap_i64(b2)
    b2 = wa_i32_const(b2, 0)
    b2 = wa_global_get(b2, 0)
    b2 = wa_local_get(b2, checkpoint_local)
    b2 = wa_i32_wrap_i64(b2)
    b2 = wa_i32_sub(b2)
    b2 = wa_memory_fill(b2, 0)
    b2 = wa_global_get(b2, 5)
    b2 = wa_i64_const(b2, 1)
    b2 = wa_i64_add(b2)
    b2 = wa_global_set(b2, 5)
    b2 = wa_global_get(b2, 6)
    b2 = wa_global_get(b2, 0)
    b2 = wa_local_get(b2, checkpoint_local)
    b2 = wa_i32_wrap_i64(b2)
    b2 = wa_i32_sub(b2)
    b2 = wa_i64_extend_i32_u(b2)
    b2 = wa_i64_add(b2)
    b2 = wa_global_set(b2, 6)
    b2 = wa_local_get(b2, checkpoint_local)
    b2 = wa_i32_wrap_i64(b2)
    b2 = wa_global_set(b2, 0)
    b2
}

fn wa_emit_map_entry_address(b: array, map: int, index: int, offset: int) -> array {
    let mut b2 = b
    b2 = wa_local_get(b2, map)
    b2 = wa_i32_wrap_i64(b2)
    b2 = wa_local_get(b2, index)
    b2 = wa_i32_wrap_i64(b2)
    b2 = wa_i32_const(b2, 24)
    b2 = wa_i32_mul(b2)
    b2 = wa_i32_add(b2)
    if offset != 0 {
        b2 = wa_i32_const(b2, offset)
        b2 = wa_i32_add(b2)
    }
    b2
}

// Una instrucción de un solo byte para las operaciones aritméticas/comparaciones.
fn wa_emit_operation(c: WaEc, instruction: int, height: int, dispatch: int, b: array) -> array {
    let f = c.f
    let lay = c.lay
    let bias = len(c.hi.defs)
    let op = f.code[instruction]
    let k = op.k
    let mut b2 = b
    let sb = lay.stack_base
    if k == "PushInt" {
        b2 = wa_store_const(b2, sb + height, op.n)
    } else if k == "PushBool" {
        if op.flag {
            b2 = wa_store_const(b2, sb + height, 1)
        } else {
            b2 = wa_store_const(b2, sb + height, 0)
        }
    } else if k == "PushChar" {
        b2 = wa_store_const(b2, sb + height, std::text::char_code(std::text::chars(op.s)[0]))
    } else if k == "PushNil" {
        b2 = wa_store_const(b2, sb + height, 0)
    } else if k == "PushStr" {
        b2 = wa_store_const(b2, sb + height, c.st.handles[op.n])
    } else if k == "PushLocal" {
        b2 = wa_local_get(b2, op.n)
        b2 = wa_local_set(b2, sb + height)
    } else if k == "StoreLocal" {
        b2 = wa_local_get(b2, sb + height - 1)
        b2 = wa_local_set(b2, op.n)
    } else if k == "Pop" {
    } else if k == "Dup" {
        b2 = wa_local_get(b2, sb + height - 1)
        b2 = wa_local_set(b2, sb + height)
    } else if k == "Add" && std::map::contains(lay.adds, "{instruction}") {
        let output = sb + height - 2
        b2 = wa_local_get(b2, output)
        b2 = wa_local_get(b2, output + 1)
        b2 = wa_call(b2, c.concat)
        b2 = wa_local_set(b2, output)
    } else if k == "Add" {
        b2 = wa_binary(b2, lay, height, [124])
    } else if k == "Sub" {
        b2 = wa_binary(b2, lay, height, [125])
    } else if k == "Mul" {
        b2 = wa_binary(b2, lay, height, [126])
    } else if k == "Div" {
        b2 = wa_binary(b2, lay, height, [127])
    } else if k == "Mod" {
        b2 = wa_binary(b2, lay, height, [129])
    } else if k == "BitAnd" {
        b2 = wa_binary(b2, lay, height, [131])
    } else if k == "BitOr" {
        b2 = wa_binary(b2, lay, height, [132])
    } else if k == "BitXor" {
        b2 = wa_binary(b2, lay, height, [133])
    } else if k == "Eq" {
        b2 = wa_comparison(b2, lay, height, [81])
    } else if k == "Neq" {
        b2 = wa_comparison(b2, lay, height, [82])
    } else if k == "Lt" {
        b2 = wa_comparison(b2, lay, height, [83])
    } else if k == "Gt" {
        b2 = wa_comparison(b2, lay, height, [85])
    } else if k == "Lte" {
        b2 = wa_comparison(b2, lay, height, [87])
    } else if k == "Gte" {
        b2 = wa_comparison(b2, lay, height, [89])
    } else if k == "Neg" {
        let slot = sb + height - 1
        b2 = wa_i64_const(b2, 0)
        b2 = wa_local_get(b2, slot)
        b2 = wa_i64_sub(b2)
        b2 = wa_local_set(b2, slot)
    } else if k == "Not" {
        let slot = sb + height - 1
        b2 = wa_local_get(b2, slot)
        b2 = wa_i64_eqz(b2)
        b2 = wa_i64_extend_i32_u(b2)
        b2 = wa_local_set(b2, slot)
    } else if k == "BitNot" {
        let slot = sb + height - 1
        b2 = wa_local_get(b2, slot)
        b2 = wa_i64_const(b2, -1)
        b2 = wa_i64_xor(b2)
        b2 = wa_local_set(b2, slot)
    } else if k == "Call" {
        let first = height - op.m
        let mut argument = first
        while argument < height {
            b2 = wa_local_get(b2, sb + argument)
            argument += 1
        }
        b2 = wa_call(b2, op.n + bias)
        b2 = wa_local_set(b2, sb + first)
    } else if k == "CallNative" && op.s == "std::map::new" {
        let output = sb + height
        b2 = wa_i32_const(b2, 0)
        b2 = wa_i32_const(b2, 0)
        b2 = wa_call(b2, c.alloc)
        b2 = wa_local_set(b2, output)
    } else if k == "CallNative" && op.s == "std::map::length" {
        let output = sb + height - 1
        b2 = wa_collection_count(b2, output)
        b2 = wa_i64_extend_i32_u(b2)
        b2 = wa_local_set(b2, output)
    } else if k == "CallNative" && (op.s == "std::map::keys" || op.s == "std::map::values") {
        b2 = wa_emit_map_keys_or_values(c, height, op.s == "std::map::keys", b2)
    } else if k == "CallNative" && op.s == "std::map::insert_new" {
        b2 = wa_emit_map_insert_new(c, height, b2)
    } else if k == "CallNative" && op.s == "std::map::insert" {
        b2 = wa_emit_map_insert(c, height, b2)
    } else if k == "CallNative" && op.s == "std::map::remove" {
        b2 = wa_emit_map_remove(c, height, b2)
    } else if k == "CallNative" && (op.s == "std::map::contains" || op.s == "std::map::get") {
        b2 = wa_emit_map_lookup(c, height, op.s == "std::map::contains", b2)
    } else if k == "CallNative" && op.s == "std::text::equals" {
        let output = sb + height - 2
        b2 = wa_local_get(b2, output)
        b2 = wa_local_get(b2, output + 1)
        b2 = wa_call(b2, c.seq)
        b2 = wa_local_set(b2, output)
    } else if k == "CallNative" && op.s == "std::text::hash64" {
        let output = sb + height - 1
        b2 = wa_local_get(b2, output)
        b2 = wa_call(b2, c.shash)
        b2 = wa_local_set(b2, output)
    } else if k == "CallNative" && wa_heap_arity(op.s) >= 0 {
        b2 = wa_emit_wasm_heap_native(op.s, c, height, b2)
    } else if k == "CallNative" && op.s == "std::array::set" {
        b2 = wa_emit_array_set(c, height, b2)
    } else if k == "CallNative" && op.s == "std::array::push" {
        b2 = wa_emit_array_push(c, height, b2)
    } else if k == "CallNative" && op.s == "std::array::pop" {
        b2 = wa_emit_array_pop(c, height, b2)
    } else if k == "CallNative" && op.s == "std::array::slice" {
        b2 = wa_emit_array_slice(c, height, b2)
    } else if k == "CallNative" && op.s == "std::array::concat" {
        b2 = wa_emit_array_concat(c, height, b2)
    } else if k == "CallNative" {
        let first = height - op.n
        let mut argument = first
        while argument < height {
            b2 = wa_local_get(b2, sb + argument)
            argument += 1
        }
        b2 = wa_call(b2, std::map::get(c.hi.natives, op.s))
        let imp = std::map::get(c.hi.web, op.s)
        if imp[3] {
            b2 = wa_local_set(b2, sb + first)
        } else {
            b2 = wa_store_const(b2, sb + first, 0)
        }
    } else if k == "Print" {
        b2 = wa_local_get(b2, sb + height - 1)
        b2 = wa_call(b2, c.hi.print)
        b2 = wa_store_const(b2, sb + height - 1, 0)
    } else if k == "Jump" {
        b2 = wa_set_pc(b2, c.pc, wa_target(op))
        b2 = wa_br(b2, dispatch)
        return b2
    } else if k == "JumpIfFalse" {
        b2 = wa_local_get(b2, sb + height - 1)
        b2 = wa_i64_eqz(b2)
        b2 = wa_if(b2)
        b2 = wa_set_pc(b2, c.pc, wa_target(op))
        b2 = wa_else(b2)
        b2 = wa_set_pc(b2, c.pc, instruction + 1)
        b2 = wa_end(b2)
        b2 = wa_br(b2, dispatch)
        return b2
    } else if k == "Ret" || k == "Halt" {
        if height == 0 {
            b2 = wa_i64_const(b2, 0)
        } else {
            b2 = wa_local_get(b2, sb + height - 1)
        }
        b2 = wa_return(b2)
        return b2
    } else if k == "NewArray" || k == "NewTuple" || k == "NewStruct" {
        let mut count = op.n
        if k == "NewStruct" {
            count = len(op.list)
        }
        let first = height - count
        b2 = wa_i32_const(b2, count * 8)
        b2 = wa_i32_const(b2, count)
        b2 = wa_call(b2, c.alloc)
        b2 = wa_local_set(b2, c.scratch1)
        let mut element = 0
        while element < count {
            b2 = wa_local_get(b2, c.scratch1)
            b2 = wa_i32_wrap_i64(b2)
            b2 = wa_i32_const(b2, element * 8)
            b2 = wa_i32_add(b2)
            b2 = wa_local_get(b2, sb + first + element)
            b2 = wa_i64_store(b2, 3, 0)
            element += 1
        }
        b2 = wa_local_get(b2, c.scratch1)
        b2 = wa_local_set(b2, sb + first)
    } else if k == "NewEnum" {
        let mut output_slot = height
        if op.flag {
            output_slot = height - 1
        }
        let output = sb + output_slot
        b2 = wa_i32_const(b2, 16)
        b2 = wa_i32_const(b2, 2)
        b2 = wa_call(b2, c.alloc)
        b2 = wa_local_set(b2, c.scratch1)
        let mut slot = 0
        while slot < 2 {
            b2 = wa_local_get(b2, c.scratch1)
            b2 = wa_i32_wrap_i64(b2)
            if slot != 0 {
                b2 = wa_i32_const(b2, 8)
                b2 = wa_i32_add(b2)
            }
            if slot == 0 {
                b2 = wa_i64_const(b2, wa_enum_tag(op.s, op.s2))
            } else if op.flag {
                b2 = wa_local_get(b2, output)
            } else {
                b2 = wa_i64_const(b2, 0)
            }
            b2 = wa_i64_store(b2, 3, 0)
            slot += 1
        }
        b2 = wa_local_get(b2, c.scratch1)
        b2 = wa_local_set(b2, output)
    } else if k == "EnumIs" {
        let output = sb + height - 1
        b2 = wa_local_get(b2, output)
        b2 = wa_i32_wrap_i64(b2)
        b2 = wa_i64_load(b2, 3, 0)
        b2 = wa_i64_const(b2, wa_enum_tag(op.s, op.s2))
        b2 = wa_i64_eq(b2)
        b2 = wa_i64_extend_i32_u(b2)
        b2 = wa_local_set(b2, output)
    } else if k == "EnumPayload" {
        let output = sb + height - 1
        b2 = wa_local_get(b2, output)
        b2 = wa_i32_wrap_i64(b2)
        b2 = wa_i32_const(b2, 8)
        b2 = wa_i32_add(b2)
        b2 = wa_i64_load(b2, 3, 0)
        b2 = wa_local_set(b2, output)
    } else if k == "GetField" {
        let output = sb + height - 1
        let field = std::map::get(lay.fields, "{instruction}")
        b2 = wa_local_get(b2, output)
        b2 = wa_i32_wrap_i64(b2)
        b2 = wa_i32_const(b2, field * 8)
        b2 = wa_i32_add(b2)
        b2 = wa_i64_load(b2, 3, 0)
        b2 = wa_local_set(b2, output)
    } else if k == "Index" {
        let output = sb + height - 2
        let index = output + 1
        b2 = wa_local_get(b2, index)
        b2 = wa_i64_const(b2, 0)
        b2 = wa_i64_lt_s(b2)
        b2 = wa_if(b2)
        b2 = wa_unreachable(b2)
        b2 = wa_end(b2)
        b2 = wa_local_get(b2, index)
        b2 = wa_local_get(b2, output)
        b2 = wa_i32_wrap_i64(b2)
        b2 = wa_i32_const(b2, 4)
        b2 = wa_i32_sub(b2)
        b2 = wa_i32_load(b2, 2, 0)
        b2 = wa_i64_extend_i32_u(b2)
        b2 = wa_i64_ge_u(b2)
        b2 = wa_if(b2)
        b2 = wa_unreachable(b2)
        b2 = wa_end(b2)
        b2 = wa_local_get(b2, output)
        b2 = wa_i32_wrap_i64(b2)
        b2 = wa_local_get(b2, index)
        b2 = wa_i32_wrap_i64(b2)
        b2 = wa_i32_const(b2, 3)
        b2 = wa_i32_shl(b2)
        b2 = wa_i32_add(b2)
        b2 = wa_i64_load(b2, 3, 0)
        b2 = wa_local_set(b2, output)
    } else if k == "Len" {
        let slot = sb + height - 1
        b2 = wa_local_get(b2, slot)
        b2 = wa_i32_wrap_i64(b2)
        b2 = wa_i32_const(b2, 4)
        b2 = wa_i32_sub(b2)
        b2 = wa_i32_load(b2, 2, 0)
        b2 = wa_i64_extend_i32_u(b2)
        b2 = wa_local_set(b2, slot)
    }
    if dispatch >= 0 {
        b2 = wa_set_pc(b2, c.pc, instruction + 1)
        b2 = wa_br(b2, dispatch)
    }
    b2
}

// ------------------------------------------------------------ cuerpo de una función

// Rama activa de un bucle directo: has, continue_target, break_target, profundidades.
fn wa_direct_region(c: WaEc, start: int, end: int, has: bool, ct: int, bt: int, cd: int, bd: int, b: array) -> array {
    let f = c.f
    let lay = c.lay
    let sb = lay.stack_base
    let mut b2 = b
    let mut instruction = start
    while instruction < end {
        if lay.heights[instruction] < 0 {
            instruction += 1
            continue
        }
        let lr = wa_loop_region(f, instruction, end)
        if lr != nil {
            let (condition, back_jump, rend) = lr
            b2 = wa_block(b2)
            b2 = wa_loop(b2)
            b2 = wa_direct_region(c, instruction, condition, has, ct, bt, cd + 2, bd + 2, b2)
            b2 = wa_marker(b2)
            let condition_height = lay.heights[condition]
            b2 = wa_local_get(b2, sb + condition_height - 1)
            b2 = wa_i64_eqz(b2)
            b2 = wa_br_if(b2, 1)
            b2 = wa_direct_region(c, condition + 1, back_jump, true, instruction, rend, 0, 1, b2)
            if lay.heights[back_jump] >= 0 {
                b2 = wa_marker(b2)
            }
            b2 = wa_br(b2, 0)
            b2 = wa_end(b2)
            b2 = wa_end(b2)
            instruction = rend
        } else if f.code[instruction].k == "JumpIfFalse" {
            let (then_jump, else_start, rend) = wa_if_region(f, instruction, end)
            b2 = wa_marker(b2)
            let condition_height = lay.heights[instruction]
            b2 = wa_local_get(b2, sb + condition_height - 1)
            b2 = wa_i64_eqz(b2)
            b2 = wa_i32_eqz(b2)
            b2 = wa_if(b2)
            b2 = wa_direct_region(c, instruction + 1, then_jump, has, ct, bt, cd + 1, bd + 1, b2)
            if lay.heights[then_jump] >= 0 {
                b2 = wa_marker(b2)
            }
            b2 = wa_else(b2)
            b2 = wa_direct_region(c, else_start, rend, has, ct, bt, cd + 1, bd + 1, b2)
            b2 = wa_end(b2)
            instruction = rend
        } else if f.code[instruction].k == "Jump" {
            b2 = wa_marker(b2)
            if wa_target(f.code[instruction]) == ct {
                b2 = wa_br(b2, cd)
            } else {
                b2 = wa_br(b2, bd)
            }
            instruction += 1
        } else {
            b2 = wa_marker(b2)
            let height = lay.heights[instruction]
            b2 = wa_emit_operation(c, instruction, height, -1, b2)
            instruction += 1
        }
    }
    b2
}

// Cuerpo de la función (locales + instrucciones + end). Los marcadores son -1.
fn wa_compile_function(g: G, f: Func, lay: WaLay, st: WaStr, hi: WaHi, concat: int, alloc: int, seq: int, shash: int) -> Result {
    if f.locals < f.arity {
        return Result::Err("local count underflow in function '" + f.name + "'")
    }
    let extra = f.locals - f.arity
    let linear = wa_is_linear(f, lay)
    let direct_control = wa_has_reducible(f, lay)
    let direct = linear || direct_control
    let numeric_locals = extra + lay.stack_slots + 2
    let mut groups = []
    if numeric_locals > 0 {
        groups = std::array::push(groups, std::array::concat(wa_uleb(numeric_locals), [126]))
    }
    if !direct {
        groups = std::array::push(groups, [1, 127])
    }
    let mut b = wa_vec(groups)
    let c = WaEc { g: g, f: f, lay: lay, st: st, hi: hi, concat: concat, alloc: alloc, seq: seq, shash: shash, scratch1: lay.pc_local, scratch2: lay.pc_local + 1, pc: lay.pc_local + 2 }
    let mut reachable = []
    let mut ri = 0
    for h in lay.heights {
        if h >= 0 {
            reachable = std::array::push(reachable, ri)
        }
        ri += 1
    }
    if len(reachable) == 0 {
        b = wa_i64_const(b, 0)
        b = wa_end(b)
        return Result::Ok(b)
    }
    if linear {
        for instruction in reachable {
            b = wa_marker(b)
            b = wa_emit_operation(c, instruction, lay.heights[instruction], -1, b)
        }
        b = wa_end(b)
        return Result::Ok(b)
    }
    if direct_control {
        b = wa_direct_region(c, 0, len(f.code), false, 0, 0, 0, 0, b)
        b = wa_end(b)
        return Result::Ok(b)
    }
    // Saltos arbitrarios: despacho O(1) con br_table.
    b = wa_block(b)
    b = wa_loop(b)
    for x in reachable {
        b = wa_block(b)
    }
    let default_depth = len(reachable) + 1
    let mut targets = []
    let mut ti = 0
    while ti < len(f.code) {
        targets = std::array::push(targets, default_depth)
        ti += 1
    }
    let mut depth = 0
    for instruction in reachable {
        targets = std::array::set(targets, instruction, depth)
        depth += 1
    }
    b = wa_local_get(b, c.pc)
    b = wa_br_table(b, targets, default_depth)
    let mut position = 0
    for instruction in reachable {
        b = wa_end(b)
        b = wa_nop_marker(b)
        let dispatch_depth = len(reachable) - position - 1
        b = wa_emit_operation(c, instruction, lay.heights[instruction], dispatch_depth, b)
        position += 1
    }
    b = wa_unreachable(b)
    b = wa_end(b)
    b = wa_end(b)
    b = wa_unreachable(b)
    b = wa_i64_const(b, 0)
    b = wa_end(b)
    Result::Ok(b)
}
fn wa_emit_wasm_heap_native(name: string, c: WaEc, height: int, b0: array) -> array {
    let mut b = b0
    let mut output_slot = height
    if name == "std::wasm::heap_set_limit" || name == "std::wasm::heap_restore" || name == "std::wasm::heap_scope_end" {
        output_slot = height - 1
    }
    let output = c.lay.stack_base + output_slot 
    if name == "std::wasm::heap_used" || name == "std::wasm::heap_checkpoint" {
        b = wa_global_get(b, 0)
        b = wa_i64_extend_i32_u(b)
    } else if name == "std::wasm::heap_capacity" {
        b = wa_memory_size(b, 0)
        b = wa_i64_extend_i32_u(b)
        b = wa_i64_const(b, 65536)
        b = wa_i64_mul(b)
    } else if name == "std::wasm::heap_limit" {
        b = wa_global_get(b, 1)
        b = wa_i64_extend_i32_u(b)
    } else if name == "std::wasm::heap_allocations" {
        b = wa_global_get(b, 3)
    } else if name == "std::wasm::heap_allocated_bytes" {
        b = wa_global_get(b, 4)
    } else if name == "std::wasm::heap_restores" {
        b = wa_global_get(b, 5)
    } else if name == "std::wasm::heap_reclaimed_bytes" {
        b = wa_global_get(b, 6)
    } else if name == "std::wasm::heap_peak_used" {
        b = wa_global_get(b, 7)
    } else if name == "std::wasm::heap_reset_counters" {
        for counter in 3..=6 {
            b = wa_i64_const(b, 0)
            b = wa_global_set(b, counter)
        }
        b = wa_global_get(b, 0)
        b = wa_i64_extend_i32_u(b)
        b = wa_global_set(b, 7)
        b = wa_i64_const(b, 1)
    } else if name == "std::wasm::heap_scope_begin" {
        b = wa_global_get(b, 0)
        b = wa_i64_extend_i32_u(b)
        b = wa_local_set(b, output)
        b = wa_i32_const(b, 8)
        b = wa_i32_const(b, 2)
 b = wa_call(b, c.alloc)
        b = wa_local_set(b, c.scratch1)
        b = wa_local_get(b, c.scratch1)
        b = wa_i32_wrap_i64(b)
        b = wa_global_get(b, 8)
 b = wa_i32_store(b, 2, 0)
        b = wa_local_get(b, c.scratch1)
        b = wa_i32_wrap_i64(b)
        b = wa_local_get(b, output)
        b = wa_i32_wrap_i64(b)
 b = wa_i32_store(b, 2, 4)
        b = wa_local_get(b, c.scratch1)
        b = wa_i32_wrap_i64(b)
        b = wa_global_set(b, 8)
        return b
    } else if name == "std::wasm::heap_set_limit" {
        b = wa_local_get(b, output)
        b = wa_i64_const(b, 0)
        b = wa_i64_lt_s(b)
        b = wa_if(b)
        b = wa_i64_const(b, 0)
        b = wa_local_set(b, output)
        b = wa_else(b)
        b = wa_local_get(b, output)
        b = wa_i64_const(b, 4294967295)
        b = wa_i64_gt_u(b)
        b = wa_local_get(b, output)
        b = wa_global_get(b, 0)
        b = wa_i64_extend_i32_u(b)
        b = wa_i64_lt_u(b)
        b = wa_i32_or(b)
        b = wa_if(b)
        b = wa_i64_const(b, 0)
        b = wa_local_set(b, output)
        b = wa_else(b)
        b = wa_local_get(b, output)
        b = wa_i32_wrap_i64(b)
        b = wa_global_set(b, 1)
        b = wa_i64_const(b, 1)
        b = wa_local_set(b, output)
        b = wa_end(b)
        b = wa_end(b)
        return b
    } else if name == "std::wasm::heap_scope_end" {
        b = wa_global_get(b, 8)
        b = wa_i32_eqz(b)
        b = wa_if(b)
        b = wa_i64_const(b, 0)
        b = wa_local_set(b, output)
        b = wa_else(b)
        b = wa_global_get(b, 8)
 b = wa_i32_load(b, 2, 4)
        b = wa_i64_extend_i32_u(b)
        b = wa_local_get(b, output)
        b = wa_i64_ne(b)
        b = wa_if(b)
        b = wa_i64_const(b, 0)
        b = wa_local_set(b, output)
        b = wa_else(b)
        b = wa_global_get(b, 8)
 b = wa_i32_load(b, 2, 0)
        b = wa_i64_extend_i32_u(b)
        b = wa_local_set(b, c.scratch1)
        b = wa_emit_heap_rewind(b, output)
        b = wa_local_get(b, c.scratch1)
        b = wa_i32_wrap_i64(b)
        b = wa_global_set(b, 8)
        b = wa_i64_const(b, 1)
        b = wa_local_set(b, output)
        b = wa_end(b)
        b = wa_end(b)
        return b
    } else if name == "std::wasm::heap_restore" {
        b = wa_local_get(b, output)
        b = wa_i64_const(b, 0)
        b = wa_i64_lt_s(b)
        b = wa_local_get(b, output)
        b = wa_global_get(b, 0)
        b = wa_i64_extend_i32_u(b)
        b = wa_i64_gt_u(b)
        b = wa_i32_or(b)
        b = wa_local_get(b, output)
        b = wa_global_get(b, 2)
        b = wa_i64_extend_i32_u(b)
        b = wa_i64_lt_u(b)
        b = wa_i32_or(b)
        b = wa_if(b)
        b = wa_i64_const(b, 0)
        b = wa_local_set(b, output)
        b = wa_else(b)
        b = wa_local_get(b, output)
        b = wa_i32_wrap_i64(b)
        b = wa_i32_const(b, 0)
        b = wa_global_get(b, 0)
        b = wa_local_get(b, output)
        b = wa_i32_wrap_i64(b)
        b = wa_i32_sub(b)
        b = wa_memory_fill(b, 0)
        b = wa_global_get(b, 5)
        b = wa_i64_const(b, 1)
        b = wa_i64_add(b)
        b = wa_global_set(b, 5)
        b = wa_global_get(b, 6)
        b = wa_global_get(b, 0)
        b = wa_local_get(b, output)
        b = wa_i32_wrap_i64(b)
        b = wa_i32_sub(b)
        b = wa_i64_extend_i32_u(b)
        b = wa_i64_add(b)
        b = wa_global_set(b, 6)
        b = wa_local_get(b, output)
        b = wa_i32_wrap_i64(b)
        b = wa_global_set(b, 0)
        b = wa_i32_const(b, 0)
        b = wa_global_set(b, 8)
        b = wa_i64_const(b, 1)
        b = wa_local_set(b, output)
        b = wa_end(b)
        return b
    }
    b = wa_local_set(b, output)
    b
}
fn wa_emit_map_lookup(c: WaEc, height: int, contains: bool, b0: array) -> array {
    let mut b = b0
    let map = c.lay.stack_base + (height - 2) 
    let key = map + 1
            b = wa_i64_const(b, 0)
    b = wa_local_set(b, c.scratch1)
    b = wa_block(b)
    b = wa_loop(b)
    b = wa_local_get(b, c.scratch1)
    b = wa_collection_count(b, map)
    b = wa_i64_extend_i32_u(b)
    b = wa_i64_ge_u(b)
    b = wa_if(b)
    b = wa_i64_const(b, 0)
    b = wa_local_set(b, map)
    b = wa_br(b, 2)
    b = wa_end(b)
    b = wa_emit_map_entry_address(b, map, c.scratch1, 0)
    b = wa_i64_load(b, 3, 0)
    b = wa_local_get(b, key)
 b = wa_call(b, c.shash)
    b = wa_i64_eq(b)
    b = wa_if(b)
    b = wa_emit_map_entry_address(b, map, c.scratch1, 8)
    b = wa_i64_load(b, 3, 0)
    b = wa_local_get(b, key)
 b = wa_call(b, c.seq)
    b = wa_i64_eqz(b)
    b = wa_i32_eqz(b)
    b = wa_if(b)
    if contains {
        b = wa_i64_const(b, 1)
    } else {
        b = wa_emit_map_entry_address(b, map, c.scratch1, 16)
        b = wa_i64_load(b, 3, 0)
    }
    b = wa_local_set(b, map)
    b = wa_br(b, 3)
    b = wa_end(b)
    b = wa_end(b)
    b = wa_local_get(b, c.scratch1)
    b = wa_i64_const(b, 1)
    b = wa_i64_add(b)
    b = wa_local_set(b, c.scratch1)
    b = wa_br(b, 0)
    b = wa_end(b)
    b = wa_end(b)
    b
}

fn wa_emit_map_remove(c: WaEc, height: int, b0: array) -> array {
    let mut b = b0
    let map = c.lay.stack_base + (height - 2) 
    let key = map + 1
            b = wa_i64_const(b, 0)
    b = wa_local_set(b, c.scratch1)
    b = wa_block(b)
    b = wa_loop(b)
    b = wa_local_get(b, c.scratch1)
    b = wa_collection_count(b, map)
    b = wa_i64_extend_i32_u(b)
    b = wa_i64_ge_u(b)
    b = wa_if(b)
    b = wa_i64_const(b, -1)
    b = wa_local_set(b, c.scratch1)
    b = wa_br(b, 2)
    b = wa_end(b)
    b = wa_emit_map_entry_address(b, map, c.scratch1, 0)
    b = wa_i64_load(b, 3, 0)
    b = wa_local_get(b, key)
 b = wa_call(b, c.shash)
    b = wa_i64_eq(b)
    b = wa_if(b)
    b = wa_emit_map_entry_address(b, map, c.scratch1, 8)
    b = wa_i64_load(b, 3, 0)
    b = wa_local_get(b, key)
 b = wa_call(b, c.seq)
    b = wa_i64_eqz(b)
    b = wa_i32_eqz(b)
    b = wa_if(b)
    b = wa_br(b, 3)
    b = wa_end(b)
    b = wa_end(b)
    b = wa_local_get(b, c.scratch1)
    b = wa_i64_const(b, 1)
    b = wa_i64_add(b)
    b = wa_local_set(b, c.scratch1)
    b = wa_br(b, 0)
    b = wa_end(b)
    b = wa_end(b)
    b = wa_local_get(b, c.scratch1)
    b = wa_i64_const(b, -1)
    b = wa_i64_eq(b)
    b = wa_if(b)
    b = wa_else(b)
    b = wa_local_get(b, c.scratch1)
    b = wa_local_set(b, key)
    b = wa_collection_count(b, map)
    b = wa_i32_const(b, 1)
    b = wa_i32_sub(b)
    b = wa_i32_const(b, 24)
    b = wa_i32_mul(b)
    b = wa_collection_count(b, map)
    b = wa_i32_const(b, 1)
    b = wa_i32_sub(b)
 b = wa_call(b, c.alloc)
    b = wa_local_set(b, c.scratch1)
    b = wa_local_get(b, c.scratch1)
    b = wa_i32_wrap_i64(b)
    b = wa_local_get(b, map)
    b = wa_i32_wrap_i64(b)
    b = wa_local_get(b, key)
    b = wa_i32_wrap_i64(b)
    b = wa_i32_const(b, 24)
    b = wa_i32_mul(b)
 b = wa_memory_copy(b)
    b = wa_local_get(b, c.scratch1)
    b = wa_i32_wrap_i64(b)
    b = wa_local_get(b, key)
    b = wa_i32_wrap_i64(b)
    b = wa_i32_const(b, 24)
    b = wa_i32_mul(b)
    b = wa_i32_add(b)
    b = wa_local_get(b, map)
    b = wa_i32_wrap_i64(b)
    b = wa_local_get(b, key)
    b = wa_i32_wrap_i64(b)
    b = wa_i32_const(b, 1)
    b = wa_i32_add(b)
    b = wa_i32_const(b, 24)
    b = wa_i32_mul(b)
    b = wa_i32_add(b)
    b = wa_collection_count(b, map)
    b = wa_i64_extend_i32_u(b)
    b = wa_local_get(b, key)
    b = wa_i64_sub(b)
    b = wa_i64_const(b, 1)
    b = wa_i64_sub(b)
    b = wa_i32_wrap_i64(b)
    b = wa_i32_const(b, 24)
    b = wa_i32_mul(b)
 b = wa_memory_copy(b)
    b = wa_local_get(b, c.scratch1)
    b = wa_local_set(b, map)
    b = wa_end(b)
    b
}

fn wa_emit_map_keys_or_values(c: WaEc, height: int, is_keys: bool, b0: array) -> array {
    let mut b = b0
    let map = c.lay.stack_base + (height - 1) 
            b = wa_collection_count(b, map)
    b = wa_i32_const(b, 536870911)
    b = wa_i32_gt_u(b)
    b = wa_if(b)
    b = wa_unreachable(b)
    b = wa_end(b)

    b = wa_collection_count(b, map)
    b = wa_i32_const(b, 3)
    b = wa_i32_shl(b)
    b = wa_collection_count(b, map)
 b = wa_call(b, c.alloc)
    b = wa_local_set(b, c.scratch1)

    b = wa_i64_const(b, 0)
    b = wa_local_set(b, c.scratch2)
    b = wa_block(b)
    b = wa_loop(b)
    b = wa_local_get(b, c.scratch2)
    b = wa_collection_count(b, map)
    b = wa_i64_extend_i32_u(b)
    b = wa_i64_ge_u(b)
    b = wa_br_if(b, 1)

    b = wa_local_get(b, c.scratch1)
    b = wa_i32_wrap_i64(b)
    b = wa_local_get(b, c.scratch2)
    b = wa_i32_wrap_i64(b)
    b = wa_i32_const(b, 3)
    b = wa_i32_shl(b)
    b = wa_i32_add(b)
 b = wa_emit_map_entry_address(b, map, c.scratch2, if is_keys { 8 } else { 16 })
    b = wa_i64_load(b, 3, 0)
    b = wa_i64_store(b, 3, 0)

    b = wa_local_get(b, c.scratch2)
    b = wa_i64_const(b, 1)
    b = wa_i64_add(b)
    b = wa_local_set(b, c.scratch2)
    b = wa_br(b, 0)
    b = wa_end(b)
    b = wa_end(b)

    b = wa_local_get(b, c.scratch1)
    b = wa_local_set(b, map)
    b
}

fn wa_emit_map_insert(c: WaEc, height: int, b0: array) -> array {
    let mut b = b0
    let map = c.lay.stack_base + (height - 3) 
    let key = map + 1
    let value = map + 2
            b = wa_collection_count(b, map)
    b = wa_i32_const(b, 178956970)
    b = wa_i32_ge_u(b)
    b = wa_if(b)
    b = wa_unreachable(b)
    b = wa_end(b)
    b = wa_collection_count(b, map)
    b = wa_i32_const(b, 1)
    b = wa_i32_add(b)
    b = wa_i32_const(b, 24)
    b = wa_i32_mul(b)
    b = wa_collection_count(b, map)
    b = wa_i32_const(b, 1)
    b = wa_i32_add(b)
 b = wa_call(b, c.alloc)
    b = wa_local_set(b, c.scratch1)
    b = wa_local_get(b, c.scratch1)
    b = wa_i32_wrap_i64(b)
    b = wa_local_get(b, map)
    b = wa_i32_wrap_i64(b)
    b = wa_collection_count(b, map)
    b = wa_i32_const(b, 24)
    b = wa_i32_mul(b)
 b = wa_memory_copy(b)
    b = wa_local_get(b, c.scratch1)
    b = wa_local_set(b, map)
    b = wa_i64_const(b, 0)
    b = wa_local_set(b, c.scratch1)
    b = wa_block(b)
    b = wa_block(b)
    b = wa_loop(b)
    b = wa_local_get(b, c.scratch1)
    b = wa_collection_count(b, map)
    b = wa_i32_const(b, 1)
    b = wa_i32_sub(b)
    b = wa_i64_extend_i32_u(b)
    b = wa_i64_ge_u(b)
    b = wa_br_if(b, 1)
    b = wa_emit_map_entry_address(b, map, c.scratch1, 0)
    b = wa_i64_load(b, 3, 0)
    b = wa_local_get(b, key)
 b = wa_call(b, c.shash)
    b = wa_i64_eq(b)
    b = wa_if(b)
    b = wa_emit_map_entry_address(b, map, c.scratch1, 8)
    b = wa_i64_load(b, 3, 0)
    b = wa_local_get(b, key)
 b = wa_call(b, c.seq)
    b = wa_i64_eqz(b)
    b = wa_i32_eqz(b)
    b = wa_if(b)
    b = wa_emit_map_entry_address(b, map, c.scratch1, 16)
    b = wa_local_get(b, value)
    b = wa_i64_store(b, 3, 0)
    b = wa_local_get(b, map)
    b = wa_i32_wrap_i64(b)
    b = wa_i32_const(b, 4)
    b = wa_i32_sub(b)
    b = wa_collection_count(b, map)
    b = wa_i32_const(b, 1)
    b = wa_i32_sub(b)
    b = wa_i32_store(b, 2, 0)
    b = wa_br(b, 4)

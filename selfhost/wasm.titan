    b = wa_i32_gt_u(b)
    b = wa_if(b)
    b = wa_unreachable(b)
    b = wa_end(b)

    b = wa_memory_size(b, 0)
    b = wa_local_set(b, 5)
    b = wa_local_get(b, 4)
    b = wa_i32_const(b, 16)
    b = wa_i32_shr_u(b)
    b = wa_local_get(b, 4)
    b = wa_i32_const(b, 65_535)
    b = wa_i32_and(b)
    b = wa_i32_eqz(b)
    b = wa_i32_eqz(b)
    b = wa_i32_add(b)
    b = wa_local_tee(b, 6)
    b = wa_local_get(b, 5)
    b = wa_i32_gt_u(b)
    b = wa_if(b)
    b = wa_local_get(b, 6)
    b = wa_local_get(b, 5)
    b = wa_i32_sub(b)
    b = wa_memory_grow(b, 0)
    b = wa_i32_const(b, -1)
    b = wa_i32_eq(b)
    b = wa_if(b)
    b = wa_unreachable(b)
    b = wa_end(b)
    b = wa_end(b)

    b = wa_local_get(b, 2)
    b = wa_local_get(b, 1)
 b = wa_i32_store(b, 2, 0)

    b = wa_local_get(b, 4)
    b = wa_i32_const(b, -4)
    b = wa_i32_gt_u(b)
    b = wa_if(b)
    b = wa_unreachable(b)
    b = wa_end(b)
    b = wa_local_get(b, 4)
    b = wa_i32_const(b, 3)
    b = wa_i32_add(b)
    b = wa_i32_const(b, -4)
    b = wa_i32_and(b)
    b = wa_global_set(b, 0)
    b = wa_allocation_counters(b, 2)

    b = wa_local_get(b, 0)
    b = wa_i64_extend_i32_u(b)
    b = wa_i64_const(b, 32)
    b = wa_i64_shl(b)
    b = wa_local_get(b, 3)
    b = wa_i64_extend_i32_u(b)
    b = wa_i64_or(b)
    b = wa_end(b)
    b
}

// ------------------------------------------------------------ JSON (como serde_json)

// t: null | num | u64 | str | arr | obj.   obj: keys + items en paralelo.
struct WaJ {
    t: string,
    s: string,
    n: int,
    items: array,
    keys: array,
}

fn wa_jnull() -> WaJ {
    WaJ { t: "null", s: "", n: 0, items: [], keys: [] }
}

fn wa_jnum(n: int) -> WaJ {
    WaJ { t: "num", s: "", n: n, items: [], keys: [] }
}

fn wa_ju64(n: int) -> WaJ {
    WaJ { t: "u64", s: "", n: n, items: [], keys: [] }
}

fn wa_jstr(s: string) -> WaJ {
    WaJ { t: "str", s: s, n: 0, items: [], keys: [] }
}

fn wa_jarr(items: array) -> WaJ {
    WaJ { t: "arr", s: "", n: 0, items: items, keys: [] }
}

fn wa_jobj(keys: array, items: array) -> WaJ {
    WaJ { t: "obj", s: "", n: 0, items: items, keys: keys }
}

fn wa_json_string(s: string) -> string {
    let mut out = "\""
    for c in std::text::chars(s) {
        let code = std::text::char_code(c)
        if code == 34 {
            out += "\\\""
        } else if code == 92 {
            out += "\\\\"
        } else if code == 8 {
            out += "\\b"
        } else if code == 12 {
            out += "\\f"
        } else if code == 10 {
            out += "\\n"
        } else if code == 13 {
            out += "\\r"
        } else if code == 9 {
            out += "\\t"
        } else if code < 32 {
            out += "\\u" + wa_hex(code, 4)
        } else {
            out += std::text::from_char_code(code)
        }
    }
    out + "\""
}

fn wa_json_scalar(j: WaJ) -> string {
    if j.t == "null" {
        return "null"
    }
    if j.t == "num" {
        let n = j.n
        return "{n}"
    }
    if j.t == "u64" {
        return wa_u64_text(j.n)
    }
    wa_json_string(j.s)
}

fn wa_json_compact(j: WaJ) -> string {
    if j.t == "arr" {
        let mut parts = []
        for item in j.items {
            parts = std::array::push(parts, wa_json_compact(item))
        }
        return "[" + cg_join(parts, ",") + "]"
    }
    if j.t == "obj" {
        let mut parts = []
        let mut i = 0
        for item in j.items {
            parts = std::array::push(parts, wa_json_string(j.keys[i]) + ":" + wa_json_compact(item))
            i += 1
        }
        return "{" + cg_join(parts, ",") + "}"
    }
    wa_json_scalar(j)
}

fn wa_indent(n: int) -> string {
    let mut out = ""
    let mut i = 0
    while i < n {
        out += "  "
        i += 1
    }
    out
}

fn wa_json_pretty(j: WaJ, depth: int) -> string {
    let pad = wa_indent(depth + 1)
    let end_pad = wa_indent(depth)
    if j.t == "arr" {
        if len(j.items) == 0 {
            return "[]"
        }
        let mut parts = []
        for item in j.items {
            parts = std::array::push(parts, pad + wa_json_pretty(item, depth + 1))
        }
        return "[\n" + cg_join(parts, ",\n") + "\n" + end_pad + "]"
    }
    if j.t == "obj" {
        if len(j.items) == 0 {
            return "{}"
        }
        let mut parts = []
        let mut i = 0
        for item in j.items {
            parts = std::array::push(parts, pad + wa_json_string(j.keys[i]) + ": " + wa_json_pretty(item, depth + 1))
            i += 1
        }
        return "{\n" + cg_join(parts, ",\n") + "\n" + end_pad + "}"
    }
    wa_json_scalar(j)
}

// ------------------------------------------------------------ mapas de fuente

fn wa_normalize_source(source: any, root: string) -> any {
    if source == nil {
        return nil
    }
    let prefix = root + "/"
    if std::text::starts_with(source, prefix) {
        return std::text::substring(source, len(prefix), len(source))
    }
    if source == root {
        return ""
    }
    source
}

fn wa_vlq(value: int) -> string {
    let alphabet = std::text::chars("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/")
    let mut v = value * 2
    if value < 0 {
        v = (0 - value) * 2 + 1
    }
    let mut out = ""
    loop {
        let mut digit = v % 32
        v = v / 32
        if v != 0 {
            digit += 32
        }
        out += std::text::from_char_code(std::text::char_code(alphabet[digit]))
        if v == 0 {
            break
        }
    }
    out
}

fn wa_sort_entries(items: array) -> array {
    if len(items) <= 1 {
        return items
    }
    let mid = len(items) / 2
    let left = wa_sort_entries(std::array::slice(items, 0, mid))
    let right = wa_sort_entries(std::array::slice(items, mid, len(items)))
    let mut out = []
    let mut i = 0
    let mut j = 0
    while i < len(left) && j < len(right) {
        if right[j][0] < left[i][0] {
            out = std::array::push(out, right[j])
            j += 1
        } else {
            out = std::array::push(out, left[i])
            i += 1
        }
    }
    while i < len(left) {
        out = std::array::push(out, left[i])
        i += 1
    }
    while j < len(right) {
        out = std::array::push(out, right[j])
        j += 1
    }
    out
}

// Mapa estándar (source map v3) con sourcesContent leído desde `root`.
fn wa_standard_map(g: G, root: string, bias: int, offsets: map) -> WaJ {
    let mut source_set = std::map::new()
    let mut name_set = std::map::new()
    for f in g.funcs {
        let file = wa_normalize_source(f.file, root)
        if file != nil {
            source_set = std::map::insert(source_set, file, 0)
        }
        name_set = std::map::insert(name_set, f.name, 0)
    }
    let sources = std::map::keys(source_set)
    let names = std::map::keys(name_set)
    let mut source_index = std::map::new()
    let mut i = 0
    for s in sources {
        source_index = std::map::insert(source_index, s, i)
        i += 1
    }
    let mut name_index = std::map::new()
    i = 0
    for n in names {
        name_index = std::map::insert(name_index, n, i)
        i += 1
    }
    let mut entries = []
    let mut fi = 0
    for f in g.funcs {
        let file = wa_normalize_source(f.file, root)
        if file != nil {
            let mut pc = 0
            for loc in f.locs {
                if loc != nil && std::map::contains(offsets, "{fi}:{pc}") {
                    let mut line = loc.line - 1
                    if line < 0 {
                        line = 0
                    }
                    let mut column = loc.col - 1
                    if column < 0 {
                        column = 0
                    }
                    entries = std::array::push(entries, [std::map::get(offsets, "{fi}:{pc}"), std::map::get(source_index, file), line, column, std::map::get(name_index, f.name)])
                }
                pc += 1
            }
        }
        fi += 1
    }
    entries = wa_sort_entries(entries)
    let mut mappings = ""
    let mut prev = [0, 0, 0, 0, 0]
    let mut first = true
    for e in entries {
        if !first {
            mappings += ","
        }
        first = false
        let mut k = 0
        while k < 5 {
            mappings += wa_vlq(e[k] - prev[k])
            k += 1
        }
        prev = e
    }
    let mut src_json = []
    let mut content = []
    for s in sources {
        src_json = std::array::push(src_json, wa_jstr(s))
        let mut path = s
        if !std::text::starts_with(s, "/") {
            path = std::path::join(root, s)
        }
        if std::fs::is_file(path) {
            content = std::array::push(content, wa_jstr(std::fs::read_text(path)))
        } else {
            content = std::array::push(content, wa_jnull())
        }
    }
    let mut name_json = []
    for n in names {
        name_json = std::array::push(name_json, wa_jstr(n))
    }
    wa_jobj(["version", "sources", "sourcesContent", "names", "mappings"], [wa_jnum(3), wa_jarr(src_json), wa_jarr(content), wa_jarr(name_json), wa_jstr(mappings)])
}

// Mapa lógico de Titan -> Wasm.
fn wa_logical_map(g: G, root: string, bias: int, offsets: map, tags: map) -> WaJ {
    let mut funcs = []
    let mut fi = 0
    for f in g.funcs {
        let mut instrs = []
        let mut pc = 0
        for loc in f.locs {
            if loc != nil {
                let mut off = wa_jnull()
                if std::map::contains(offsets, "{fi}:{pc}") {
                    off = wa_jnum(std::map::get(offsets, "{fi}:{pc}"))
                }
                let mut operation = "<missing>"
                if pc < len(f.code) {
                    operation = cg_op_text(f.code[pc])
                }
                instrs = std::array::push(instrs, wa_jobj(["titan_instruction", "wasm_offset", "operation", "start", "end", "line", "column"], [wa_jnum(pc), off, wa_jstr(operation), wa_jnum(loc.start), wa_jnum(loc.end), wa_jnum(loc.line), wa_jnum(loc.col)]))
            }
            pc += 1
        }
        let file = wa_normalize_source(f.file, root)
        let mut file_json = wa_jnull()
        if file != nil {
            file_json = wa_jstr(file)
        }
        funcs = std::array::push(funcs, wa_jobj(["titan_function_index", "wasm_function_index", "name", "source_file", "instructions"], [wa_jnum(fi), wa_jnum(bias + fi), wa_jstr(f.name), file_json, wa_jarr(instrs)]))
        fi += 1
    }
    let mut tag_keys = []
    let mut tag_vals = []
    for label in std::map::keys(tags) {
        tag_keys = std::array::push(tag_keys, label)
        tag_vals = std::array::push(tag_vals, wa_ju64(std::map::get(tags, label)))
    }
    wa_jobj(["format", "version", "imported_function_count", "enum_tags", "functions"], [wa_jstr("titan-wasm-source-map"), wa_jnum(1), wa_jnum(bias), wa_jobj(tag_keys, tag_vals), wa_jarr(funcs)])
}

// ------------------------------------------------------------ ensamblado del módulo

fn wa_custom_section(name: string, data: array) -> array {
    wa_section(0, std::array::concat(wa_name(name), data))
}

fn wa_string_layout(strings: array) -> Result {
    let too_big = "WebAssembly string data exceeds the 32-bit linear-memory ABI"
    let mut handles = []
    let mut data = []
    for s in strings {
        while (8 + len(data)) % 4 != 0 {
            data = std::array::push(data, 0)
        }
        let bytes = wa_utf8(s)
        let blen = len(bytes)
        let slen = std::text::length(s)
        if blen > 4294967295 {
            return Result::Err(too_big)
        }
        let pointer = 8 + len(data) + 4
        if pointer > 4294967295 {
            return Result::Err(too_big)
        }
        handles = std::array::push(handles, blen * 4294967296 + pointer)
        data = std::array::concat(data, wa_le32(slen))
        data = std::array::concat(data, bytes)
    }
    let end = 8 + len(data)
    let aligned = (end + 3) / 4 * 4
    if aligned > 4294967295 {
        return Result::Err(too_big)
    }
    let mut pages = (aligned + 65535) / 65536
    if pages < 1 {
        pages = 1
    }
    Result::Ok(WaStr { handles: handles, data: data, pages: pages, heap_start: aligned })
}

fn wa_hex64(v: int) -> string {
    let lo = ((v % 4294967296) + 4294967296) % 4294967296
    let mut hi = (v - lo) / 4294967296
    if hi < 0 {
        hi += 4294967296
    }
    wa_hex(hi, 8) + wa_hex(lo, 8)
}

fn wa_enum_tags(g: G) -> Result {
    let mut tags = std::map::new()
    let mut owners = std::map::new()
    for f in g.funcs {
        for op in f.code {
            if op.k == "NewEnum" || op.k == "EnumIs" {
                let label = op.s + "::" + op.s2
                let tag = wa_enum_tag(op.s, op.s2)
                let key = "{tag}"
                if std::map::contains(owners, key) {
                    let first = std::map::get(owners, key)
                    if first != label {
                        return Result::Err("enum discriminant collision between '" + first + "' and '" + label + "' at tag 0x" + wa_hex64(tag))
                    }
                }
                owners = std::map::insert(owners, key, label)
                tags = std::map::insert(tags, label, tag)
            }
        }
    }
    Result::Ok(tags)
}

fn wa_uses_native(natives: map, names: array) -> bool {
    for n in names {
        if std::map::contains(natives, n) {
            return true
        }
    }
    false
}

// Cuerpo con marcadores (-1) -> (bytes con 1, posiciones relativas de los marcadores).
fn wa_resolve_markers(body: array) -> (array, array) {
    let mut bytes = []
    let mut marks = []
    for v in body {
        if v < 0 {
            marks = std::array::push(marks, len(bytes))
            bytes = std::array::push(bytes, 1)
        } else {
            bytes = std::array::push(bytes, v)
        }
    }
    return (bytes, marks)
}

fn wa_val_types(n: int, t: int) -> array {
    let mut out = []
    let mut i = 0
    while i < n {
        out = std::array::push(out, t)
        i += 1
    }
    out
}

fn wa_func_type(params: array, results: array) -> array {
    std::array::concat(std::array::concat(std::array::concat([96], wa_uleb(len(params))), params), std::array::concat(wa_uleb(len(results)), results))
}

// Resultado: Ok((wasm, mapa lógico JSON, mapa estándar JSON, sources para el CLI)).
// El generador de Titan emite `TakeLocal` (mueve el valor) donde Rust emite
// `PushLocal`; para los enteros de Wasm son lo mismo. Se normaliza para el análisis
// y la emisión; los mapas conservan el texto original de la operación.
fn wa_normalize(g: G) -> G {
    let mut funcs = []
    for f in g.funcs {
        let mut code = []
        for op in f.code {
            if op.k == "TakeLocal" {
                code = std::array::push(code, Op { k: "PushLocal", n: op.n, m: op.m, s: op.s, s2: op.s2, flag: op.flag, list: op.list })
            } else {
                code = std::array::push(code, op)
            }
        }
        funcs = std::array::push(funcs, Func { name: f.name, file: f.file, arity: f.arity, params: f.params, ret: f.ret, captures: f.captures, locals: f.locals, max_stack: f.max_stack, code: code, locs: f.locs })
    }
    gs_funcs(g, funcs)
}

fn wa_compile(g0: G, root: string) -> Result {
    let g = wa_normalize(g0)
    if g.entry >= len(g.funcs) {
        return Result::Err("invalid module entry point")
    }
    let st = wa_string_layout(g.table)?
    let tags = wa_enum_tags(g)?
    let web = wa_web_map()
    let mut layouts = []
    for f in g.funcs {
        layouts = std::array::push(layouts, wa_analyze(g, f, web)?)
    }
    // nativas y operaciones usadas
    let mut used = std::map::new()
    let mut needs_print = false
    let mut needs_collections = false
    for f in g.funcs {
        for op in f.code {
            if op.k == "Print" {
                needs_print = true
            }
            if op.k == "NewArray" || op.k == "NewTuple" || op.k == "NewStruct" || op.k == "NewEnum" {
                needs_collections = true
            }
            if op.k == "CallNative" {
                used = std::map::insert(used, op.s, true)
            }
        }
    }
    let mut needs_concat = false
    for lay in layouts {
        if len(std::map::keys(lay.adds)) > 0 {
            needs_concat = true
        }
    }
    let needs_equals = wa_uses_native(used, ["std::text::equals", "std::map::contains", "std::map::get", "std::map::insert", "std::map::remove"])
    let needs_hash = wa_uses_native(used, ["std::text::hash64", "std::map::insert_new", "std::map::insert", "std::map::contains", "std::map::get", "std::map::remove"])
    let mut needs_arrays = needs_collections
    let mut needs_maps = false
    let mut needs_heap_api = false
    for name in std::map::keys(used) {
        if wa_array_arity(name) >= 0 {
            needs_arrays = true
        }
        if wa_map_arity(name) >= 0 {
            needs_maps = true
        }
        if wa_heap_arity(name) >= 0 {
            needs_heap_api = true
        }
    }
    // importaciones del navegador
    let mut defs = []
    let mut print_index = -1
    if needs_print {
        print_index = 0
        defs = std::array::push(defs, ["", "print", 1, false])
    }
    let mut natives = std::map::new()
    for d in wa_web_table() {
        if std::map::contains(used, d[0]) {
            natives = std::map::insert(natives, d[0], len(defs))
            defs = std::array::push(defs, d)
        }
    }
    let hi = WaHi { defs: defs, print: print_index, natives: natives, web: web }
    let needs_host_strings = wa_uses_native(natives, ["std::web::event_type", "std::web::event_value", "std::web::event_key", "std::web::event_target_id", "std::web::fetch_body", "std::web::fetch_url", "std::web::fetch_error", "std::web::fetch_headers", "std::web::ws_message", "std::web::ws_protocol", "std::web::ws_close_reason", "std::web::ws_error"])
    if needs_host_strings {
        for f in g.funcs {
            if f.name == "__titan_alloc_string" {
                return Result::Err("function name '__titan_alloc_string' is reserved by the WebAssembly runtime ABI")
            }
        }
    }
    let needs_scopes = wa_uses_native(used, ["std::wasm::heap_scope_begin", "std::wasm::heap_scope_end"])
    let needs_allocator = needs_host_strings || needs_arrays || needs_maps || needs_scopes
    let needs_heap = needs_concat || needs_allocator || needs_heap_api
    let bias = len(defs)
    let count = len(g.funcs)
    let mut next_fn = bias + count
    let mut concat_fn = -1
    if needs_concat {
        concat_fn = next_fn
        next_fn += 1
    }
    let mut alloc_fn = -1
    if needs_allocator {
        alloc_fn = next_fn
        next_fn += 1
    }
    let mut equals_fn = -1
    if needs_equals {
        equals_fn = next_fn
        next_fn += 1
    }
    let mut hash_fn = -1
    if needs_hash {
        hash_fn = next_fn
        next_fn += 1
    }
    // tipos
    let mut types = []
    for f in g.funcs {
        types = std::array::push(types, wa_func_type(wa_val_types(f.arity, 126), [126]))
    }
    let first_import_type = len(types)
    for d in defs {
        let mut results = []
        if d[3] {
            results = [126]
        }
        types = std::array::push(types, wa_func_type(wa_val_types(d[2], 126), results))
    }
    let concat_type = len(types)
    if needs_concat {
        types = std::array::push(types, wa_func_type([126, 126], [126]))
    }
    let alloc_type = len(types)
    if needs_allocator {
        types = std::array::push(types, wa_func_type([127, 127], [126]))
    }
    let equals_type = len(types)
    if needs_equals {
        types = std::array::push(types, wa_func_type([126, 126], [126]))
    }
    let hash_type = len(types)
    if needs_hash {
        types = std::array::push(types, wa_func_type([126], [126]))
    }
    let mut module = [0, 97, 115, 109, 1, 0, 0, 0]
    module = std::array::concat(module, wa_section(1, wa_vec(types)))
    if len(defs) > 0 {
        let mut imports = []
        let mut offset = 0
        for d in defs {
            imports = std::array::push(imports, std::array::concat(std::array::concat(wa_name("titan"), wa_name(d[1])), std::array::concat([0], wa_uleb(first_import_type + offset))))
            offset += 1
        }
        module = std::array::concat(module, wa_section(2, wa_vec(imports)))
    }
    let mut fsec = []
    let mut index = 0
    while index < count {
        fsec = std::array::push(fsec, wa_uleb(index))
        index += 1
    }
    if needs_concat {
        fsec = std::array::push(fsec, wa_uleb(concat_type))
    }
    if needs_allocator {
        fsec = std::array::push(fsec, wa_uleb(alloc_type))
    }
    if needs_equals {
        fsec = std::array::push(fsec, wa_uleb(equals_type))
    }
    if needs_hash {
        fsec = std::array::push(fsec, wa_uleb(hash_type))
    }
    module = std::array::concat(module, wa_section(3, wa_vec(fsec)))
    module = std::array::concat(module, wa_section(5, wa_vec([std::array::concat([0], wa_uleb(st.pages))])))
    if needs_heap {
        let mut globals = []
        let heap_expr = std::array::concat(std::array::concat([127, 1, 65], wa_sleb(st.heap_start)), [11])
        globals = std::array::push(globals, heap_expr)
        globals = std::array::push(globals, [127, 1, 65, 127, 11])
        globals = std::array::push(globals, std::array::concat(std::array::concat([127, 0, 65], wa_sleb(st.heap_start)), [11]))
        let mut ci = 0
        while ci < 4 {
            globals = std::array::push(globals, [126, 1, 66, 0, 11])
            ci += 1
        }
        globals = std::array::push(globals, std::array::concat(std::array::concat([126, 1, 66], wa_sleb(st.heap_start)), [11]))
        globals = std::array::push(globals, [127, 1, 65, 0, 11])
        module = std::array::concat(module, wa_section(6, wa_vec(globals)))
    }
    let mut exports = []
    exports = std::array::push(exports, std::array::concat(wa_name("main"), std::array::concat([0], wa_uleb(g.entry + bias))))
    exports = std::array::push(exports, std::array::concat(wa_name("memory"), [2, 0]))
    if needs_host_strings {
        exports = std::array::push(exports, std::array::concat(wa_name("__titan_alloc_string"), std::array::concat([0], wa_uleb(alloc_fn))))
    }
    index = 0
    for f in g.funcs {
        if f.name != "main" && !std::text::starts_with(f.name, "<") {
            exports = std::array::push(exports, std::array::concat(wa_name(f.name), std::array::concat([0], wa_uleb(index + bias))))
        }
        index += 1
    }
    module = std::array::concat(module, wa_section(7, wa_vec(exports)))
    // código
    let mut bodies = []
    index = 0
    for f in g.funcs {
        let body = wa_compile_function(g, f, layouts[index], st, hi, concat_fn, alloc_fn, equals_fn, hash_fn)?
        bodies = std::array::push(bodies, body)
        index += 1
    }
    if needs_concat {
        bodies = std::array::push(bodies, wa_compile_string_concat())
    }
    if needs_allocator {
        bodies = std::array::push(bodies, wa_compile_host_string_allocator())
    }
    if needs_equals {
        bodies = std::array::push(bodies, wa_compile_string_equals())
    }
    if needs_hash {
        bodies = std::array::push(bodies, wa_compile_string_hash())
    }
    let mut entries = []
    let mut marks_per_fn = []
    let mut total = len(wa_uleb(len(bodies)))
    let mut starts = []
    for body in bodies {
        let (bytes, marks) = wa_resolve_markers(body)
        let head = wa_uleb(len(bytes))
        starts = std::array::push(starts, total + len(head))
        total += len(head) + len(bytes)
        entries = std::array::push(entries, std::array::concat(head, bytes))
        marks_per_fn = std::array::push(marks_per_fn, marks)
    }
    let code_content_start = len(module) + 1 + len(wa_uleb(total))
    // posiciones absolutas de los marcadores
    let mut offsets = std::map::new()
    index = 0
    while index < count {
        let lay = layouts[index]
        let marks = marks_per_fn[index]
        let mut expected = []
        let mut ei = 0
        for h in lay.heights {
            if h >= 0 {
                expected = std::array::push(expected, ei)
            }
            ei += 1
        }
        if len(marks) != len(expected) {
            let got = len(marks)
            let want = len(expected)
            return Result::Err("could not encode WebAssembly source metadata: function {index} emitted {got} source markers, expected {want}")
        }
        let mut m = 0
        while m < len(marks) {
            offsets = std::map::insert(offsets, "{index}:" + wa_i(expected[m]) + "", code_content_start + starts[index] + marks[m])
            m += 1
        }
        index += 1
    }
    let mut code_sec = wa_uleb(len(bodies))
    for e in entries {
        code_sec = std::array::concat(code_sec, e)
    }
    module = std::array::concat(module, wa_section(10, code_sec))
    if len(st.data) > 0 {
        let seg = std::array::concat(std::array::concat([0, 65], wa_sleb(8)), std::array::concat([11], std::array::concat(wa_uleb(len(st.data)), st.data)))
        module = std::array::concat(module, wa_section(11, std::array::concat([1], seg)))
    }
    let logical = wa_logical_map(g0, root, bias, offsets, tags)
    let standard = wa_standard_map(g0, root, bias, offsets)
    module = std::array::concat(module, wa_custom_section("titan.source_map", wa_utf8(wa_json_compact(logical))))
    Result::Ok((module, wa_json_pretty(logical, 0), wa_json_compact(standard)))
}

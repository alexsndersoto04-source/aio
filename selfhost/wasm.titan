// ============================================================================
// Backend WebAssembly de Titan escrito en Titan (self-hosting, paso `std::web`).
//
// Traducción fiel de crates/titan_wasm/src/lib.rs: recibe el módulo de bytecode
// de selfhost/codegen.titan y produce el mismo binario .wasm, el mismo mapa
// lógico (JSON) y el mismo mapa estándar (source map v3) que `zett wasm`.
// Verificación diferencial: selfhost/tests/wasm_diff/run.sh compara byte a byte.
//
// Representación:
//   - Los cuerpos de función son `array` de enteros (bytes). Las funciones
//     `wa_<instrucción>(b, ...)` añaden una instrucción y devuelven el array.
//   - Un marcador de mapa de fuente es el valor -1 dentro del cuerpo (en Rust,
//     un `nop` tras un `end`); al ensamblar se cambia por el byte 1 y se
//     anota su posición absoluta (lo que Rust obtiene releyendo con wasmparser).
//   - Los errores viajan como Result::Err(mensaje), con el texto de WasmError.
// Todo lleva el prefijo wa_ / Wa porque `import` junta los nombres en un solo
// espacio.
// ============================================================================
import codegen

// ------------------------------------------------------------ codificación

fn wa_i(x: int) -> string {
    "{x}"
}

fn wa_uleb(n: int) -> array {
    let mut out = []
    let mut v = n
    loop {
        let byte = v % 128
        v = v / 128
        if v == 0 {
            out = std::array::push(out, byte)
            break
        }
        out = std::array::push(out, byte + 128)
    }
    out
}

// LEB128 con signo de un entero de 64 bits en complemento a dos.
fn wa_sleb(n: int) -> array {
    let mut out = []
    let mut v = n
    loop {
        let mut byte = v % 128
        if byte < 0 {
            byte += 128
        }
        v = (v - byte) / 128
        if (v == 0 && byte < 64) || (v == -1 && byte >= 64) {
            out = std::array::push(out, byte)
            break
        }
        out = std::array::push(out, byte + 128)
    }
    out
}

fn wa_utf8(s: string) -> array {
    std::bytes::to_array(std::encoding::utf8_encode(s))
}

fn wa_name(s: string) -> array {
    let bytes = wa_utf8(s)
    std::array::concat(wa_uleb(len(bytes)), bytes)
}

fn wa_le32(v: int) -> array {
    [v % 256, (v / 256) % 256, (v / 65536) % 256, (v / 16777216) % 256]
}

fn wa_i32_const(b: array, v: int) -> array {
    std::array::concat(std::array::push(b, 65), wa_sleb(v))
}

fn wa_i64_const(b: array, v: int) -> array {
    std::array::concat(std::array::push(b, 66), wa_sleb(v))
}

fn wa_memarg(b: array, align: int, offset: int) -> array {
    std::array::concat(std::array::concat(b, wa_uleb(align)), wa_uleb(offset))
}

fn wa_block(b: array) -> array {
    std::array::push(std::array::push(b, 2), 64)
}

fn wa_loop(b: array) -> array {
    std::array::push(std::array::push(b, 3), 64)
}

fn wa_if(b: array) -> array {
    std::array::push(std::array::push(b, 4), 64)
}

fn wa_br_table(b: array, targets: array, default: int) -> array {
    let mut out = std::array::concat(std::array::push(b, 14), wa_uleb(len(targets)))
    for t in targets {
        out = std::array::concat(out, wa_uleb(t))
    }
    std::array::concat(out, wa_uleb(default))
}

fn wa_memory_copy(b: array) -> array {
    std::array::concat(b, [252, 10, 0, 0])
}

fn wa_memory_fill(b: array, mem: int) -> array {
    std::array::concat(b, [252, 11, mem])
}

fn wa_memory_size(b: array, mem: int) -> array {
    std::array::concat(b, [63, mem])
}

fn wa_memory_grow(b: array, mem: int) -> array {
    std::array::concat(b, [64, mem])
}

// Marcador de mapa de fuente: `block end nop` (el nop es el centinela -1).
fn wa_marker(b: array) -> array {
    std::array::concat(b, [2, 64, 11, -1])
}

// Solo el `nop` del marcador (tras un `end` ya emitido).
fn wa_nop_marker(b: array) -> array {
    std::array::push(b, -1)
}

fn wa_section(id: int, content: array) -> array {
    std::array::concat(std::array::concat([id], wa_uleb(len(content))), content)
}

fn wa_vec(items: array) -> array {
    let mut out = wa_uleb(len(items))
    for item in items {
        out = std::array::concat(out, item)
    }
    out
}

fn wa_hex(v: int, digits: int) -> string {
    let chars = "0123456789abcdef"
    let cs = std::text::chars(chars)
    let mut out = ""
    let mut x = v
    let mut i = 0
    while i < digits {
        out = std::text::from_char_code(std::text::char_code(cs[x % 16])) + out
        x = x / 16
        i += 1
    }
    out
}

// Número de 64 bits sin signo, en decimal (los tags de enum usan el rango completo).
fn wa_u64_text(v: int) -> string {
    if v >= 0 {
        return "{v}"
    }
    // v + 2^64 = hi * 2^32 + lo con hi, lo sin signo de 32 bits.
    let mut hi = (v - ((v % 4294967296) + 4294967296) % 4294967296) / 4294967296 + 4294967296
    let lo = ((v % 4294967296) + 4294967296) % 4294967296
    let mut digits = ""
    let mut lo2 = lo
    while hi > 0 || lo2 > 0 {
        let rem_hi = hi % 10
        hi = hi / 10
        let cur = rem_hi * 4294967296 + lo2
        let d = cur % 10
        lo2 = cur / 10
        digits = "{d}" + digits
    }
    digits
}

// Multiplicación módulo 2^64 (en dos límbos de 32 bits en cuatro de 16).
fn wa_mul64(a: int, b: int) -> int {
    let au = a
    let bu = b
    let mut al = []
    let mut bl = []
    let mut x = au
    let mut y = bu
    let mut i = 0
    while i < 4 {
        let mut ra = x % 65536
        if ra < 0 {
            ra += 65536
        }
        x = (x - ra) / 65536
        let mut rb = y % 65536
        if rb < 0 {
            rb += 65536
        }
        y = (y - rb) / 65536
        al = std::array::push(al, ra)
        bl = std::array::push(bl, rb)
        i += 1
    }
    // columnas de 16 bits con acarreo
    let mut limbs = []
    let mut carry = 0
    let mut k = 0
    while k < 4 {
        let mut sum = carry
        let mut j = 0
        while j <= k {
            sum += al[j] * bl[k - j]
            j += 1
        }
        limbs = std::array::push(limbs, sum % 65536)
        carry = sum / 65536
        k += 1
    }
    // reconstruir como entero con signo: el límbo alto manda el signo
    let hi = limbs[3]
    let mut top = hi
    if top >= 32768 {
        top = top - 65536
    }
    top * 281474976710656 + limbs[2] * 4294967296 + limbs[1] * 65536 + limbs[0]
}

fn wa_xor64(a: int, b: int) -> int {
    a ^ b
}

// Hash FNV-1a de 64 bits del tag de enum: Nombre::Variante.
fn wa_enum_tag(name: string, variant: string) -> int {
    let mut hash = -3750763034362895579
    for byte in std::array::concat(std::array::concat(wa_utf8(name), [58, 58]), wa_utf8(variant)) {
        hash = wa_xor64(hash, byte)
        hash = wa_mul64(hash, 1099511628211)
    }
    hash
}

// ------------------------------------------------------------ tipos de bytecode

struct WaTy {
    k: string,
    name: string,
    kids: array,
}

fn wa_ty(k: string) -> WaTy {
    WaTy { k: k, name: "", kids: [] }
}

fn wa_is_ident(c: char) -> bool {
    std::text::is_alphanumeric(c) || c == '_'
}

// Analiza el texto Debug de un BytecodeType desde `pos`; devuelve (tipo, siguiente posición).
fn wa_parse_ty(cs: array, pos: int) -> (WaTy, int) {
    let mut i = pos
    let mut ident = ""
    while i < len(cs) && wa_is_ident(cs[i]) {
        ident += std::text::from_char_code(std::text::char_code(cs[i]))
        i += 1
    }
    if i >= len(cs) || cs[i] != '(' {
        return (wa_ty(ident), i)
    }
    i += 1
    let mut t = wa_ty(ident)
    if ident == "Struct" || ident == "Enum" || ident == "EnumOf" {
        // "nombre"
        i += 1
        let mut name = ""
        while cs[i] != '"' {
            name += std::text::from_char_code(std::text::char_code(cs[i]))
            i += 1
        }
        i += 1
        t = WaTy { k: ident, name: name, kids: [] }
        if ident == "EnumOf" {
            // , [T, T]
            i += 3
            let mut kids = []
            while cs[i] != ']' {
                let (kid, next) = wa_parse_ty(cs, i)
                kids = std::array::push(kids, kid)
                i = next
                if cs[i] == ',' {
                    i += 2
                }
            }
            i += 1
            t = WaTy { k: ident, name: name, kids: kids }
        }
    } else if ident == "TupleOf" {
        i += 1
        let mut kids = []
        while cs[i] != ']' {
            let (kid, next) = wa_parse_ty(cs, i)
            kids = std::array::push(kids, kid)
            i = next
            if cs[i] == ',' {
                i += 2
            }
        }
        i += 1
        t = WaTy { k: ident, name: "", kids: kids }
    } else {
        // ArrayOf(T) o MapOf(K, V)
        let mut kids = []
        while cs[i] != ')' {
            let (kid, next) = wa_parse_ty(cs, i)
            kids = std::array::push(kids, kid)
            i = next
            if cs[i] == ',' {
                i += 2
            }
        }
        t = WaTy { k: ident, name: "", kids: kids }
    }
    // cierra el paréntesis
    i += 1
    return (t, i)
}

fn wa_type_of(text: any) -> any {
    if text == nil {
        return nil
    }
    let (t, end) = wa_parse_ty(std::text::chars(text), 0)
    t
}

// ------------------------------------------------------------ clases de valor

// ValueKind de Rust. k: Numeric | String | Array | Tuple | Map | Struct | Enum | Unknown.
//   Array/Map: `inner` es el tipo del elemento (nil = None).
//   Tuple: `inner` es true cuando hay lista (Some) y `list` son los elementos.
//   Struct: `list` son los nombres de campo. Enum: `name` y `payloads` (variante -> clase).
struct WaVk {
    k: string,
    inner: any,
    list: array,
    name: string,
    payloads: map,
}

fn wa_vk(k: string) -> WaVk {
    WaVk { k: k, inner: nil, list: [], name: "", payloads: std::map::new() }
}

fn wa_vk_with(k: string, inner: any) -> WaVk {
    WaVk { k: k, inner: inner, list: [], name: "", payloads: std::map::new() }
}

fn wa_metadata_kind(g: G, ty: any) -> WaVk {
    if ty == nil {
        return wa_vk("Unknown")
    }
    let k = ty.k
    if k == "Int" || k == "Bool" {
        return wa_vk("Numeric")
    }
    if k == "String" {
        return wa_vk("String")
    }
    if k == "Array" {
        return wa_vk("Array")
    }
    if k == "Tuple" {
        return wa_vk("Tuple")
    }
    if k == "Map" {
        return wa_vk("Map")
    }
    if k == "ArrayOf" {
        return wa_vk_with("Array", wa_metadata_kind(g, ty.kids[0]))
    }
    if k == "MapOf" {
        return wa_vk_with("Map", wa_metadata_kind(g, ty.kids[1]))
    }
    if k == "TupleOf" {
        let mut els = []
        for e in ty.kids {
            els = std::array::push(els, wa_metadata_kind(g, e))
        }
        return WaVk { k: "Tuple", inner: true, list: els, name: "", payloads: std::map::new() }
    }
    if k == "Enum" {
        return WaVk { k: "Enum", inner: nil, list: [], name: ty.name, payloads: std::map::new() }
    }
    if k == "EnumOf" {
        let mut kinds = []
        for e in ty.kids {
            kinds = std::array::push(kinds, wa_metadata_kind(g, e))
        }
        let mut payloads = std::map::new()
        if ty.name == "Option" && len(kinds) == 1 {
            payloads = std::map::insert(payloads, "Some", kinds[0])
        } else if ty.name == "Result" && len(kinds) == 2 {
            payloads = std::map::insert(payloads, "Ok", kinds[0])
            payloads = std::map::insert(payloads, "Err", kinds[1])
        } else if len(kinds) == 1 {
            payloads = std::map::insert(payloads, "*", kinds[0])
        }
        return WaVk { k: "Enum", inner: nil, list: [], name: ty.name, payloads: payloads }
    }
    if k == "Struct" {
        if std::map::contains(g.structs, ty.name) {
            return WaVk { k: "Struct", inner: nil, list: std::map::get(g.structs, ty.name), name: "", payloads: std::map::new() }
        }
        return wa_vk("Unknown")
    }
    wa_vk("Unknown")
}

struct WaTs {
    stack: array,
    locals: array,
}

// Diseño de una función tras el análisis de pila.
//   heights: altura de pila antes de cada instrucción (-1 = inalcanzable).
struct WaLay {
    heights: array,
    stack_base: int,
    stack_slots: int,
    pc_local: int,
    adds: map,
    fields: map,
}

fn wa_drop_n(st: array, n: int) -> array {
    std::array::slice(st, 0, len(st) - n)
}

fn wa_last(st: array) -> WaVk {
    st[len(st) - 1]
}

fn wa_apply_effect(op: Op, state: WaTs, g: G, f: Func, instruction: int) -> WaTs {
    let k = op.k
    let mut stack = state.stack
    let mut locals = state.locals
    if k == "PushStr" {
        stack = std::array::push(stack, wa_vk("String"))
    } else if k == "PushInt" || k == "PushBool" || k == "PushChar" {
        stack = std::array::push(stack, wa_vk("Numeric"))
    } else if k == "PushNil" {
        stack = std::array::push(stack, wa_vk("Unknown"))
    } else if k == "PushLocal" {
        stack = std::array::push(stack, locals[op.n])
    } else if k == "StoreLocal" {
        locals = std::array::set(locals, op.n, wa_last(stack))
        stack = wa_drop_n(stack, 1)
    } else if k == "Pop" || k == "JumpIfFalse" {
        if len(stack) > 0 {
            stack = wa_drop_n(stack, 1)
        }
    } else if k == "Dup" {
        stack = std::array::push(stack, wa_last(stack))
    } else if k == "Add" {
        let right = stack[len(stack) - 1]
        let left = stack[len(stack) - 2]
        stack = wa_drop_n(stack, 2)
        let mut result = wa_vk("Unknown")
        if left == wa_vk("String") && right == wa_vk("String") {
            result = wa_vk("String")
        } else if left == wa_vk("Numeric") && right == wa_vk("Numeric") {
            result = wa_vk("Numeric")
        }
        stack = std::array::push(stack, result)
    } else if k == "Sub" || k == "Mul" || k == "Div" || k == "Mod" || k == "Eq" || k == "Neq" || k == "Lt" || k == "Gt" || k == "Lte" || k == "Gte" || k == "BitAnd" || k == "BitOr" || k == "BitXor" {
        stack = wa_drop_n(stack, 2)
        stack = std::array::push(stack, wa_vk("Numeric"))
    } else if k == "Neg" || k == "Not" || k == "BitNot" || k == "Len" {
        stack = wa_drop_n(stack, 1)
        stack = std::array::push(stack, wa_vk("Numeric"))
    } else if k == "NewArray" {
        let count = op.n
        let elements = std::array::slice(stack, len(stack) - count, len(stack))
        stack = wa_drop_n(stack, count)
        let mut element: any = nil
        if count > 0 {
            let first = elements[0]
            let mut all = true
            for e in elements {
                if e != first {
                    all = false
                }
            }
            if all {
                element = first
            }
        }
        stack = std::array::push(stack, wa_vk_with("Array", element))
    } else if k == "NewTuple" {
        let count = op.n
        let elements = std::array::slice(stack, len(stack) - count, len(stack))
        stack = wa_drop_n(stack, count)
        stack = std::array::push(stack, WaVk { k: "Tuple", inner: true, list: elements, name: "", payloads: std::map::new() })
    } else if k == "NewStruct" {
        stack = wa_drop_n(stack, len(op.list))
        stack = std::array::push(stack, WaVk { k: "Struct", inner: nil, list: op.list, name: "", payloads: std::map::new() })
    } else if k == "GetField" {
        stack = wa_drop_n(stack, 1)
        stack = std::array::push(stack, wa_vk("Unknown"))
    } else if k == "NewEnum" {
        let mut payloads = std::map::new()
        if op.flag {
            if len(stack) > 0 {
                payloads = std::map::insert(payloads, op.s2, wa_last(stack))
                stack = wa_drop_n(stack, 1)
            }
        }
        stack = std::array::push(stack, WaVk { k: "Enum", inner: nil, list: [], name: op.s, payloads: payloads })
    } else if k == "EnumIs" {
        stack = wa_drop_n(stack, 1)
        stack = std::array::push(stack, wa_vk("Numeric"))
    } else if k == "EnumPayload" {
        let value = wa_last(stack)
        stack = wa_drop_n(stack, 1)
        // variante de la última comprobación EnumIs anterior
        let mut variant: any = nil
        let mut j = instruction - 1
        while j >= 0 && variant == nil {
            if f.code[j].k == "EnumIs" {
                variant = f.code[j].s2
            }
            j -= 1
        }
        let mut payload = wa_vk("Unknown")
        if value.k == "Enum" {
            let mut found: any = nil
            if variant != nil {
                if std::map::contains(value.payloads, variant) {
                    found = std::map::get(value.payloads, variant)
                } else if std::map::contains(value.payloads, "*") {
                    found = std::map::get(value.payloads, "*")
                }
            }
            if found == nil {
                let keys = std::map::keys(value.payloads)
                if len(keys) == 1 {
                    found = std::map::get(value.payloads, keys[0])
                }
            }
            if found != nil {
                payload = found
            }
        }
        stack = std::array::push(stack, payload)
    } else if k == "Index" {
        stack = wa_drop_n(stack, 1)
        let target = wa_last(stack)
        stack = wa_drop_n(stack, 1)
        let mut result = wa_vk("Unknown")
        if target.k == "Array" && target.inner != nil {
            result = target.inner
        } else if target.k == "Tuple" && target.inner != nil {
            let els = target.list
            if len(els) > 0 {
                let first = els[0]
                let mut all = true
                for e in els {
                    if e != first {
                        all = false
                    }
                }
                if all {
                    result = first
                }
            }
        }
        stack = std::array::push(stack, result)
    } else if k == "Call" {
        stack = wa_drop_n(stack, op.m)
        let mut rk = wa_vk("Unknown")
        if !op.flag && op.n < len(g.funcs) {
            rk = wa_metadata_kind(g, wa_type_of(g.funcs[op.n].ret))
        }
        stack = std::array::push(stack, rk)
    } else if k == "CallNative" {
        let name = op.s
        let argc = op.n
        let mut rk = wa_vk("Unknown")
        if name == "std::map::new" {
            rk = wa_vk("Map")
        } else if (name == "std::map::insert_new" || name == "std::map::insert") && argc >= 3 && len(stack) >= argc {
            let map_kind = stack[len(stack) - argc]
            let value_kind = stack[len(stack) - 1]
            if map_kind.k == "Map" && map_kind.inner != nil {
                rk = wa_vk_with("Map", map_kind.inner)
            } else if value_kind != wa_vk("Unknown") {
                rk = wa_vk_with("Map", value_kind)
            } else {
                rk = wa_vk("Map")
            }
        } else if name == "std::map::remove" && argc >= 2 && len(stack) >= argc {
            let mk = stack[len(stack) - argc]
            if mk.k == "Map" {
                rk = wa_vk_with("Map", mk.inner)
            } else {
                rk = wa_vk("Map")
            }
        } else if name == "std::map::get" && argc >= 2 && len(stack) >= argc {
            let mk = stack[len(stack) - argc]
            if mk.k == "Map" && mk.inner != nil {
                rk = mk.inner
            }
        } else if name == "std::map::values" && argc >= 1 && len(stack) >= argc {
            let mk = stack[len(stack) - argc]
            if mk.k == "Map" && mk.inner != nil {
                rk = wa_vk_with("Array", mk.inner)
            } else {
                rk = wa_vk("Array")
            }
        } else if name == "std::map::keys" {
            rk = wa_vk_with("Array", wa_vk("String"))
        } else if name == "std::map::length" {
            rk = wa_vk("Numeric")
        }
        stack = wa_drop_n(stack, argc)
        stack = std::array::push(stack, rk)
    } else if k == "Print" {
        stack = wa_drop_n(stack, op.n)
        stack = std::array::push(stack, wa_vk("Unknown"))
    }
    WaTs { stack: stack, locals: locals }
}

// Mezcla `incoming` en el estado de destino; devuelve (estado, cambió).
fn wa_merge_state(dest: any, incoming: WaTs) -> (any, bool) {
    if dest == nil {
        return (incoming, true)
    }
    let mut changed = false
    let mut stack = dest.stack
    let mut locals = dest.locals
    let mut i = 0
    while i < len(stack) && i < len(incoming.stack) {
        if stack[i] != incoming.stack[i] && stack[i].k != "Unknown" {
            stack = std::array::set(stack, i, wa_vk("Unknown"))
            changed = true
        }
        i += 1
    }
    i = 0
    while i < len(locals) && i < len(incoming.locals) {
        if locals[i] != incoming.locals[i] && locals[i].k != "Unknown" {
            locals = std::array::set(locals, i, wa_vk("Unknown"))
            changed = true
        }
        i += 1
    }
    return (WaTs { stack: stack, locals: locals }, changed)
}

fn wa_unsupported(f: Func, operation: string) -> Result {
    Result::Err("function '" + f.name + "' uses unsupported WebAssembly operation: " + operation)
}

// Devuelve Result::Ok((sumas de strings, índices de campo)) o el error.
fn wa_infer(g: G, f: Func, heights: array) -> Result {
    if len(f.code) == 0 {
        return Result::Ok((std::map::new(), std::map::new()))
    }
    let mut initial = []
    let mut li = 0
    while li < f.locals {
        initial = std::array::push(initial, wa_vk("Unknown"))
        li += 1
    }
    li = 0
    for p in f.params {
        if li < len(initial) {
            initial = std::array::set(initial, li, wa_metadata_kind(g, wa_type_of(p)))
        }
        li += 1
    }
    let n = len(f.code)
    let mut states = []
    let mut si = 0
    while si < n {
        states = std::array::push(states, nil)
        si += 1
    }
    states = std::array::set(states, 0, WaTs { stack: [], locals: initial })
    let mut pending = [0]
    let mut head = 0
    while head < len(pending) {
        let instruction = pending[head]
        head += 1
        let op = f.code[instruction]
        let state = wa_apply_effect(op, states[instruction], g, f, instruction)
        let mut succ = []
        if op.k == "Jump" {
            succ = [op.n]
        } else if op.k == "JumpIfFalse" {
            succ = [op.n]
            if instruction + 1 < n {
                succ = std::array::push(succ, instruction + 1)
            }
        } else if op.k == "Ret" || op.k == "Halt" {
            succ = []
        } else if instruction + 1 < n {
            succ = [instruction + 1]
        }
        for s in succ {
            let (merged, changed) = wa_merge_state(states[s], state)
            states = std::array::set(states, s, merged)
            if changed {
                pending = std::array::push(pending, s)
            }
        }
    }
    let mut adds = std::map::new()
    let mut fields = std::map::new()
    let mut instruction = 0
    while instruction < n {
        let op = f.code[instruction]
        if heights[instruction] < 0 {
            instruction += 1
            continue
        }
        let state = states[instruction]
        if op.k == "EnumIs" {
            let top = wa_last(state.stack)
            if top.k == "Enum" {
                if top.name != op.s {
                    return wa_unsupported(f, "enum test expects '" + op.s + "', found '" + top.name + "'")
                }
            } else if top.k != "Unknown" {
                return wa_unsupported(f, "value is not enum '" + op.s + "' at instruction {instruction}")
            }
        }
        if op.k == "GetField" {
            let top = wa_last(state.stack)
            if top.k != "Struct" {
                return wa_unsupported(f, "unresolved struct field '" + op.s + "' at instruction {instruction}")
            }
            let mut index = -1
            let mut fi = 0
            for candidate in top.list {
                if index < 0 && candidate == op.s {
                    index = fi
                }
                fi += 1
            }
            if index < 0 {
                return wa_unsupported(f, "unknown struct field '" + op.s + "' at instruction {instruction}")
            }
            fields = std::map::insert(fields, "{instruction}", index)
        }
        if op.k == "Index" && state.stack[len(state.stack) - 2] == wa_vk("String") {
            return wa_unsupported(f, "string Index at instruction {instruction}")
        }
        if op.k == "Add" {
            let left = state.stack[len(state.stack) - 2]
            let right = state.stack[len(state.stack) - 1]
            if left == wa_vk("String") && right == wa_vk("String") {
                adds = std::map::insert(adds, "{instruction}", true)
            } else if left == wa_vk("String") || right == wa_vk("String") {
                return Result::Err("function '" + f.name + "' has an ambiguous '+' at instruction {instruction}; string and numeric operands cannot be distinguished from erased bytecode")
            }
        }
        instruction += 1
    }
    return Result::Ok((adds, fields))
}

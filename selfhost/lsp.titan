// Servidor LSP (Language Server Protocol) de Titan, escrito en Titan.
// Port de `crates/titan_lsp` (lib.rs + server.rs): JSON-RPC 2.0 con cabecera `Content-Length`
// por la entrada/salida estándar, mensajes de hasta 16 MiB, nada de registros por stdout.
// Prefijo ls_ (servicio de lenguaje) y lj_ (JSON). Se lanza con `titan lsp`.
//
// Detalles que se mantienen igual que en Rust:
//   - posiciones LSP en unidades UTF-16; los textos se manejan como arreglos de caracteres y los
//     spans del lexer (bytes) se convierten con una tabla de desplazamientos;
//   - las claves de los objetos JSON salen ordenadas (serde_json sin `preserve_order`);
//   - un error en una notificación (didOpen/didChange/didClose mal formados) termina el servidor
//     con `titan-lsp: <error>` y código 1, igual que el `?` de Rust;
//   - un método desconocido responde con el código -32602 y «method not found».
// Diferencias deliberadas (ver ESTADO.md): la edición de `rename` usa la clave `newText` del
// protocolo (Rust serializaba `new_text`, que ningún cliente entiende).
import lexer
import parser
import typechecker
import natives

struct LsInfo {
    cs: array,
    n: int,
    boff: array,
    lines: array,
    cols: array,
    starts: array,
}

struct LsState {
    docs: map,
    order: array,
}

// ------------------------------------------------------------------ JSON

// Tipo de un valor devuelto por std::json::parse: s m a i f b n.
fn lj_kind(v: any) -> string {
    let s = std::json::stringify(v)
    let c = std::text::substring(s, 0, 1)
    if c == "\"" {
        return "s"
    }
    if c == "{" {
        return "m"
    }
    if c == "[" {
        return "a"
    }
    if c == "t" || c == "f" {
        return "b"
    }
    if c == "n" {
        return "n"
    }
    if std::text::contains(s, ".") || std::text::contains(s, "e") || std::text::contains(s, "E") {
        return "f"
    }
    "i"
}

fn lj_get(m: any, key: string) -> any {
    if lj_kind(m) != "m" {
        return nil
    }
    if !std::map::contains(m, key) {
        return nil
    }
    m[key]
}

fn lj_has(m: any, key: string) -> bool {
    lj_kind(m) == "m" && std::map::contains(m, key)
}

fn lj_str(v: any) -> any {
    if v != nil && lj_kind(v) == "s" {
        return v
    }
    nil
}

// as_u64 truncado a u32 (como `as u32`); nil si no es un entero no negativo.
fn lj_u32(v: any) -> any {
    if v != nil && lj_kind(v) == "i" && v >= 0 {
        return v & 4294967295
    }
    nil
}

fn ls_i(n: any) -> string {
    "{n}"
}

fn lj_q(s: string) -> string {
    std::json::stringify(s)
}

fn lj_pos(line: int, ch: int) -> string {
    "{\"character\":" + ls_i(ch) + ",\"line\":" + ls_i(line) + "}"
}

fn lj_range(sl: int, sc: int, el: int, ec: int) -> string {
    "{\"end\":" + lj_pos(el, ec) + ",\"start\":" + lj_pos(sl, sc) + "}"
}

fn lj_join(parts: array) -> string {
    let mut out = ""
    let mut i = 0
    while i < len(parts) {
        if i > 0 {
            out += ","
        }
        out += parts[i]
        i += 1
    }
    out
}

fn lj_list(parts: array) -> string {
    "[" + lj_join(parts) + "]"
}

// ------------------------------------------------------------------ texto

fn ls_u16len(c: any) -> int {
    if std::text::char_code(c) >= 65536 {
        return 2
    }
    1
}

fn ls_u8len(code: int) -> int {
    if code < 128 {
        return 1
    }
    if code < 2048 {
        return 2
    }
    if code < 65536 {
        return 3
    }
    4
}

fn ls_info(text: string) -> LsInfo {
    let cs = std::text::chars(text)
    let n = len(cs)
    let mut boff = []
    let mut lines = []
    let mut cols = []
    let mut starts = [0]
    let mut b = 0
    let mut line = 0
    let mut col = 0
    let mut i = 0
    while i < n {
        boff = std::array::push(boff, b)
        lines = std::array::push(lines, line)
        cols = std::array::push(cols, col)
        let code = std::text::char_code(cs[i])
        b += ls_u8len(code)
        if code == 10 {
            line += 1
            col = 0
            starts = std::array::push(starts, i + 1)
        } else if code >= 65536 {
            col += 2
        } else {
            col += 1
        }
        i += 1
    }
    boff = std::array::push(boff, b)
    lines = std::array::push(lines, line)
    cols = std::array::push(cols, col)
    LsInfo { cs: cs, n: n, boff: boff, lines: lines, cols: cols, starts: starts }
}

// Primer índice de carácter cuyo desplazamiento en bytes es >= off (off se recorta al final).
fn ls_idx_of_byte(info: LsInfo, off: int) -> int {
    let mut lo = 0
    let mut hi = info.n
    while lo < hi {
        let mid = (lo + hi) / 2
        if info.boff[mid] < off {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    lo
}

// offset_to_position (bytes -> línea, carácter UTF-16).
fn ls_pos_of_byte(info: LsInfo, off: int) -> (int, int) {
    let i = ls_idx_of_byte(info, off)
    return (info.lines[i], info.cols[i])
}

// position_to_offset, pero devolviendo el índice de carácter; -1 si no existe.
fn ls_idx_of_pos(info: LsInfo, line: int, character: int) -> int {
    if line >= len(info.starts) {
        return -1
    }
    let ls = info.starts[line]
    let mut le = info.n
    if line + 1 < len(info.starts) {
        le = info.starts[line + 1] - 1
    }
    let mut u = 0
    let mut i = ls
    while i < le {
        if u == character {
            return i
        }
        u += ls_u16len(info.cs[i])
        if u > character {
            return -1
        }
        i += 1
    }
    if u == character {
        return le
    }
    return -1
}

fn ls_is_ident_start(c: any) -> bool {
    c == '_' || std::text::is_alphabetic(c)
}

fn ls_valid_identifier(value: string) -> bool {
    let cs = std::text::chars(value)
    if len(cs) == 0 || !ls_is_ident_start(cs[0]) {
        return false
    }
    let mut i = 1
    while i < len(cs) {
        if !(cs[i] == '_' || std::text::is_alphanumeric(cs[i])) {
            return false
        }
        i += 1
    }
    true
}

// Comparación por bytes UTF-8 (= por punto de código). Las cadenas de Titan ya se comparan así.
fn ls_less(a: array, b: array) -> bool {
    if a[0] != b[0] {
        return a[0] < b[0]
    }
    a[1] < b[1]
}

// Ordenación estable por (clave 0, clave 1).
fn ls_sort(items: array) -> array {
    let n = len(items)
    if n <= 1 {
        return items
    }
    let mid = n / 2
    let left = ls_sort(std::array::slice(items, 0, mid))
    let right = ls_sort(std::array::slice(items, mid, n))
    let mut out = []
    let mut i = 0
    let mut j = 0
    while i < len(left) && j < len(right) {
        if ls_less(right[j], left[i]) {
            out = std::array::push(out, right[j])
            j += 1
        } else {
            out = std::array::push(out, left[i])
            i += 1
        }
    }
    while i < len(left) {
        out = std::array::push(out, left[i])
        i += 1
    }
    while j < len(right) {
        out = std::array::push(out, right[j])
        j += 1
    }
    out
}

// ------------------------------------------------------------------ símbolos y tokens

// Símbolo = [nombre, uri, tipo, detalle, línea_ini, car_ini, línea_fin, car_fin]
fn ls_symbols(uri: string, text: string) -> array {
    let (tokens, _errors) = tokenize(text)
    let info = ls_info(text)
    let mut out = []
    let mut i = 0
    while i + 1 < len(tokens) {
        let k = tokens[i].kind
        let mut sk = 0
        let mut detail = ""
        if k == "Fn" {
            sk = 12
            detail = "function"
        } else if k == "Struct" {
            sk = 23
            detail = "struct"
        } else if k == "Enum" {
            sk = 10
            detail = "enum"
        } else if k == "Trait" {
            sk = 11
            detail = "trait"
        } else if k == "Module" {
            sk = 2
            detail = "module"
        } else if k == "Const" {
            sk = 14
            detail = "constant"
        } else if k == "Let" {
            sk = 13
            detail = "variable"
        }
        if sk != 0 && tokens[i + 1].kind == "Ident" {
            let t = tokens[i + 1]
            let (sl, sc) = ls_pos_of_byte(info, t.start)
            let (el, ec) = ls_pos_of_byte(info, t.end)
            out = std::array::push(out, [t.text, uri, sk, detail, sl, sc, el, ec])
        }
        i += 1
    }
    out
}

fn ls_identifier_ranges(text: string, name: string) -> array {
    let (tokens, _errors) = tokenize(text)
    let info = ls_info(text)
    let mut out = []
    for t in tokens {
        if t.kind == "Ident" && t.text == name {
            let (sl, sc) = ls_pos_of_byte(info, t.start)
            let (el, ec) = ls_pos_of_byte(info, t.end)
            out = std::array::push(out, [sl, sc, el, ec])
        }
    }
    out
}

// token_at: el identificador cuyo span contiene el desplazamiento en bytes (extremos incluidos).
fn ls_token_at(text: string, off: int) -> any {
    let (tokens, _errors) = tokenize(text)
    for t in tokens {
        if t.start <= off && off <= t.end {
            if t.kind == "Ident" {
                return t.text
            }
            return nil
        }
    }
    nil
}

fn ls_semantic_kind(kind: string, previous: string) -> int {
    if kind == "Fn" || kind == "Let" || kind == "Mut" || kind == "Return" || kind == "If" || kind == "Else" || kind == "Match" || kind == "For" || kind == "While" || kind == "Loop" || kind == "Break" || kind == "Continue" || kind == "In" || kind == "Struct" || kind == "Enum" || kind == "Trait" || kind == "Impl" || kind == "Module" || kind == "Import" || kind == "Pub" || kind == "Const" || kind == "Unsafe" || kind == "Spawn" || kind == "Go" || kind == "As" {
        return 0
    }
    if kind == "Ident" && previous == "Fn" {
        return 1
    }
    if kind == "Ident" && (previous == "Struct" || previous == "Enum" || previous == "Trait") {
        return 2
    }
    if kind == "Ident" || kind == "Self_" {
        return 3
    }
    if kind == "StringLit" || kind == "CharLit" {
        return 4
    }
    if kind == "IntLit" || kind == "FloatLit" {
        return 5
    }
    if kind == "Plus" || kind == "Minus" || kind == "Star" || kind == "Slash" || kind == "Percent" || kind == "Eq" || kind == "EqEq" || kind == "NotEq" || kind == "Lt" || kind == "Gt" || kind == "LtEq" || kind == "GtEq" || kind == "LazyAnd" || kind == "LazyOr" || kind == "Ampersand" || kind == "Pipe" || kind == "Caret" || kind == "Bang" || kind == "Tilde" || kind == "Question" || kind == "Range" || kind == "RangeInclusive" || kind == "ThinArrow" || kind == "FatArrow" {
        return 6
    }
    return -1
}

fn ls_semantic_tokens(text: string) -> array {
    let (tokens, _errors) = tokenize(text)
    let info = ls_info(text)
    let mut data = []
    let mut prev_line = 0
    let mut prev_start = 0
    let mut i = 0
    while i < len(tokens) {
        let t = tokens[i]
        let mut previous = ""
        if i > 0 {
            previous = tokens[i - 1].kind
        }
        let tt = ls_semantic_kind(t.kind, previous)
        i += 1
        if tt < 0 {
            continue
        }
        let (sl, sc) = ls_pos_of_byte(info, t.start)
        let (el, ec) = ls_pos_of_byte(info, t.end)
        if sl != el {
            continue
        }
        let dl = sl - prev_line
        let mut ds = sc
        if dl == 0 {
            ds = sc - prev_start
        }
        let mut length = 0
        if ec > sc {
            length = ec - sc
        }
        if length == 0 {
            continue
        }
        data = std::array::push(data, "{dl}")
        data = std::array::push(data, "{ds}")
        data = std::array::push(data, "{length}")
        data = std::array::push(data, "{tt}")
        data = std::array::push(data, "0")
        prev_line = sl
        prev_start = sc
    }
    data
}

// ------------------------------------------------------------------ nativas (para completion/signatureHelp)

// Línea de la tabla: "nombre P1,P2 -> R" (sin parámetros: "nombre  -> R").
// -> [nombre, "[P1, P2]", R]
fn ls_native_parts(line: string) -> array {
    let sp = ls_index_of(line, " ")
    let name = std::text::substring(line, 0, sp)
    let rest = std::text::substring(line, sp + 1, std::text::length(line))
    let arrow = ls_index_of(rest, " -> ")
    let params = std::text::substring(rest, 0, arrow)
    let result = std::text::substring(rest, arrow + 4, std::text::length(rest))
    let mut shown = "["
    if params != "" {
        let items = ls_split_commas(params)
        shown += ls_join(items, ", ")
    }
    shown += "]"
    return [name, shown, result, params]
}

fn ls_index_of(s: string, needle: string) -> int {
    let n = std::text::length(s)
    let m = std::text::length(needle)
    let mut i = 0
    while i + m <= n {
        if std::text::substring(s, i, i + m) == needle {
            return i
        }
        i += 1
    }
    return -1
}

fn ls_join(parts: array, sep: string) -> string {
    let mut out = ""
    let mut i = 0
    while i < len(parts) {
        if i > 0 {
            out += sep
        }
        out += parts[i]
        i += 1
    }
    out
}

// native::lookup(name): [nombre, "[P1, P2]", R, "P1,P2"] o nil.
fn ls_native_lookup(name: string) -> any {
    let prefix = name + " "
    for line in native_table() {
        if std::text::starts_with(line, prefix) {
            return ls_native_parts(line)
        }
    }
    nil
}

// ------------------------------------------------------------------ servicio

fn ls_new() -> LsState {
    LsState { docs: std::map::new(), order: [] }
}

fn ls_text(st: LsState, uri: string) -> any {
    if !std::map::contains(st.docs, uri) {
        return nil
    }
    std::map::get(st.docs, uri)[0]
}

fn ls_open(st: LsState, uri: string, text: string, version: int) -> LsState {
    let mut order = st.order
    if !std::map::contains(st.docs, uri) {
        order = std::array::push(order, uri)
    }
    LsState { docs: std::map::insert(st.docs, uri, [text, version]), order: order }
}

fn ls_close(st: LsState, uri: string) -> LsState {
    if !std::map::contains(st.docs, uri) {
        return st
    }
    let mut order = []
    for u in st.order {
        if u != uri {
            order = std::array::push(order, u)
        }
    }
    LsState { docs: std::map::remove(st.docs, uri), order: order }
}

// apply_change: Ok(nuevo estado) o Err(mensaje). `range` = nil o [sl, sc, el, ec].
fn ls_apply_change(st: LsState, uri: string, range: any, replacement: string, version: int) -> Result {
    if !std::map::contains(st.docs, uri) {
        return Result::Err("document is not open")
    }
    let doc = std::map::get(st.docs, uri)
    if version < doc[1] {
        return Result::Err("stale document version")
    }
    if range == nil {
        return Result::Ok(ls_open(st, uri, replacement, version))
    }
    let text = doc[0]
    let info = ls_info(text)
    let a = ls_idx_of_pos(info, range[0], range[1])
    if a < 0 {
        return Result::Err("invalid change start")
    }
    let b = ls_idx_of_pos(info, range[2], range[3])
    if b < 0 {
        return Result::Err("invalid change end")
    }
    if a > b {
        return Result::Err("change range is reversed")
    }
    let updated = std::text::substring(text, 0, a) + replacement + std::text::substring(text, b, info.n)
    Result::Ok(ls_open(st, uri, updated, version))
}

// Diagnóstico = JSON ya serializado.
fn ls_diag_json(sl: int, sc: int, el: int, ec: int, message: string) -> string {
    "{\"message\":" + lj_q(message) + ",\"range\":" + lj_range(sl, sc, el, ec) + ",\"severity\":1,\"source\":\"titan\"}"
}

// "... at L:C" -> [L, C] (1-based como en el mensaje).
fn ls_message_pos(message: string) -> array {
    let mut at = -1
    let mut i = 0
    let n = std::text::length(message)
    while i + 4 <= n {
        if std::text::substring(message, i, i + 4) == " at " {
            at = i
        }
        i += 1
    }
    if at < 0 {
        return [0, 0]
    }
    let tail = std::text::substring(message, at + 4, n)
    let colon = ls_index_of(tail, ":")
    if colon < 0 {
        return [0, 0]
    }
    let mut line = 0
    let mut col = 0
    match std::text::parse_int(std::text::substring(tail, 0, colon)) {
        Option::Some(v) => {
            line = v
        },
        _ => {},
    }
    match std::text::parse_int(std::text::substring(tail, colon + 1, std::text::length(tail))) {
        Option::Some(v) => {
            col = v
        },
        _ => {},
    }
    return [line, col]
}

fn ls_point_diag(message: string) -> string {
    let lc = ls_message_pos(message)
    let mut line = 0
    if lc[0] > 0 {
        line = lc[0] - 1
    }
    let mut col = 0
    if lc[1] > 0 {
        col = lc[1] - 1
    }
    ls_diag_json(line, col, line, col + 1, message)
}

fn ls_diagnostics(st: LsState, uri: string) -> array {
    let source = ls_text(st, uri)
    if source == nil {
        return []
    }
    let (tokens, lex_errors) = tokenize(source)
    let mut out = []
    for e in lex_errors {
        out = std::array::push(out, ls_point_diag(e))
    }
    if len(lex_errors) > 0 {
        return out
    }
    let (items, parse_errors) = parse_program(tokens)
    if len(parse_errors) > 0 {
        for e in parse_errors {
            out = std::array::push(out, ls_point_diag(e))
        }
        return out
    }
    let diags = check_program(items)
    if len(diags) > 0 {
        let info = ls_info(source)
        for d in diags {
            let sp = d.span
            if sp != nil {
                let (sl, sc) = ls_pos_of_byte(info, sp.start)
                let (el, ec) = ls_pos_of_byte(info, sp.end)
                out = std::array::push(out, ls_diag_json(sl, sc, el, ec, d.msg))
            } else {
                out = std::array::push(out, ls_diag_json(0, 0, 0, 0, d.msg))
            }
        }
    }
    out
}

fn ls_document_symbols(st: LsState, uri: string) -> array {
    let text = ls_text(st, uri)
    if text == nil {
        return []
    }
    ls_symbols(uri, text)
}

// workspace_symbols: filtrado por subcadena (minúsculas) y ordenado por (nombre, uri).
fn ls_workspace_symbols(st: LsState, query: string) -> array {
    let q = std::text::lowercase(query)
    let mut all = []
    for uri in st.order {
        let text = std::map::get(st.docs, uri)[0]
        for s in ls_symbols(uri, text) {
            if std::text::contains(std::text::lowercase(s[0]), q) {
                all = std::array::push(all, s)
            }
        }
    }
    ls_sort(all)
}

fn ls_symbol_named(st: LsState, name: string) -> any {
    for s in ls_workspace_symbols(st, name) {
        if s[0] == name {
            return s
        }
    }
    nil
}

// Palabra (identificador) en la posición; nil si no hay.
fn ls_word_at(st: LsState, uri: string, line: int, character: int) -> any {
    let text = ls_text(st, uri)
    if text == nil {
        return nil
    }
    let info = ls_info(text)
    let idx = ls_idx_of_pos(info, line, character)
    if idx < 0 {
        return nil
    }
    ls_token_at(text, info.boff[idx])
}

// completions: [nombre, "", tipo, detalle] ordenados por nombre; los símbolos pisan a las
// palabras clave y las nativas a ambos (BTreeMap::insert).
fn ls_completions(st: LsState) -> array {
    let mut values = std::map::new()
    let mut names = []
    for k in ["fn", "let", "if", "else", "match", "for", "while", "loop", "return", "break", "continue", "struct", "enum", "trait", "impl", "import", "const", "true", "false", "nil"] {
        if !std::map::contains(values, k) {
            names = std::array::push(names, k)
        }
        values = std::map::insert(values, k, [14, "Titan keyword"])
    }
    for s in ls_workspace_symbols(st, "") {
        if !std::map::contains(values, s[0]) {
            names = std::array::push(names, s[0])
        }
        values = std::map::insert(values, s[0], [s[2], s[3]])
    }
    for line in native_table() {
        let p = ls_native_parts(line)
        if !std::map::contains(values, p[0]) {
            names = std::array::push(names, p[0])
        }
        values = std::map::insert(values, p[0], [3, "native " + p[1] + " -> " + p[2]])
    }
    let mut keyed = []
    for n in names {
        keyed = std::array::push(keyed, [n, ""])
    }
    let mut out = []
    for k in ls_sort(keyed) {
        let v = std::map::get(values, k[0])
        out = std::array::push(out, "{\"detail\":" + lj_q(v[1]) + ",\"kind\":" + ls_i(v[0]) + ",\"label\":" + lj_q(k[0]) + "}")
    }
    out
}

fn ls_hover(st: LsState, uri: string, line: int, character: int) -> any {
    let name = ls_word_at(st, uri, line, character)
    if name == nil {
        return nil
    }
    // En Rust se busca primero `native::lookup(name)`, pero `name` es un identificador suelto y
    // todas las nativas se llaman `std::...::...`, así que esa rama no puede cumplirse nunca.
    let s = ls_symbol_named(st, name)
    if s == nil {
        return nil
    }
    "`" + s[0] + "`\n\n" + s[3]
}

// signature_help -> nil o [etiqueta, [parámetros], activo]
fn ls_signature_help(st: LsState, uri: string, line: int, character: int) -> any {
    let text = ls_text(st, uri)
    if text == nil {
        return nil
    }
    let info = ls_info(text)
    let idx = ls_idx_of_pos(info, line, character)
    if idx < 0 {
        return nil
    }
    let cs = info.cs
    let mut open = -1
    let mut i = idx - 1
    while i >= 0 {
        if cs[i] == '(' {
            open = i
            break
        }
        i -= 1
    }
    if open < 0 {
        return nil
    }
    let mut end = open
    while end > 0 && std::text::is_whitespace(cs[end - 1]) {
        end -= 1
    }
    let mut start = end
    while start > 0 && (std::text::is_alphanumeric(cs[start - 1]) || cs[start - 1] == '_' || cs[start - 1] == ':') {
        start -= 1
    }
    if start == end {
        return nil
    }
    let mut name = ""
    let mut j = start
    while j < end {
        name += cs[j]
        j += 1
    }
    let mut active = 0
    let mut k = open + 1
    while k < idx {
        if cs[k] == ',' {
            active += 1
        }
        k += 1
    }
    let native = ls_native_lookup(name)
    if native != nil {
        let mut params = []
        if native[3] != "" {
            let mut n = 0
            let mut count = 1
            for c in std::text::chars(native[3]) {
                if c == ',' {
                    count += 1
                }
            }
            let types = ls_split_commas(native[3])
            while n < count {
                params = std::array::push(params, "arg{n}: " + types[n])
                n += 1
            }
        }
        return [name + "(" + ls_join(params, ", ") + ") -> " + native[2], params, active]
    }
    let s = ls_symbol_named(st, name)
    if s == nil {
        return nil
    }
    return [s[0] + "(…)", [], active]
}

fn ls_split_commas(s: string) -> array {
    let mut items = []
    let mut cur = ""
    for c in std::text::chars(s) {
        if c == ',' {
            items = std::array::push(items, cur)
            cur = ""
        } else {
            cur += c
        }
    }
    std::array::push(items, cur)
}

fn ls_references(st: LsState, uri: string, line: int, character: int) -> array {
    let name = ls_word_at(st, uri, line, character)
    if name == nil {
        return []
    }
    let mut out = []
    for u in st.order {
        let text = std::map::get(st.docs, u)[0]
        for r in ls_identifier_ranges(text, name) {
            out = std::array::push(out, "{\"range\":" + lj_range(r[0], r[1], r[2], r[3]) + ",\"uri\":" + lj_q(u) + "}")
        }
    }
    out
}

// rename -> Ok(JSON de `changes`) o Err(mensaje)
fn ls_rename(st: LsState, uri: string, line: int, character: int, new_name: string) -> Result {
    if !ls_valid_identifier(new_name) {
        return Result::Err("invalid Titan identifier")
    }
    let name = ls_word_at(st, uri, line, character)
    if name == nil {
        return Result::Err("no identifier at position")
    }
    let mut keyed = []
    for u in st.order {
        keyed = std::array::push(keyed, [u, ""])
    }
    let mut entries = []
    for k in ls_sort(keyed) {
        let text = std::map::get(st.docs, k[0])[0]
        let mut edits = []
        for r in ls_identifier_ranges(text, name) {
            edits = std::array::push(edits, "{\"newText\":" + lj_q(new_name) + ",\"range\":" + lj_range(r[0], r[1], r[2], r[3]) + "}")
        }
        if len(edits) > 0 {
            entries = std::array::push(entries, lj_q(k[0]) + ":" + lj_list(edits))
        }
    }
    Result::Ok("{" + lj_join(entries) + "}")
}

// ------------------------------------------------------------------ transporte

// Lee hasta un salto de línea (inclusive) o hasta el final del flujo; devuelve bytes (vacío = fin).
fn ls_read_line() -> Result {
    let mut line = std::encoding::utf8_encode("")
    loop {
        let r = std::try::catch(|| { std::io::read_stdin(1) })
        let mut b: any = nil
        match r {
            Result::Ok(v) => {
                b = v
            },
            Result::Err(e) => {
                return Result::Err("LSP I/O error: " + ls_clean(e))
            },
        }
        if std::bytes::length(b) == 0 {
            break
        }
        line = std::bytes::concat(line, b)
        if std::bytes::to_array(b)[0] == 10 {
            break
        }
    }
    Result::Ok(line)
}

fn ls_clean(e: any) -> string {
    let s = "{e}"
    let mark = "' failed: "
    let at = ls_index_of(s, mark)
    if at < 0 {
        return s
    }
    std::text::substring(s, at + std::text::length(mark), std::text::length(s))
}

// Número de Content-Length: Ok(n) / Err(mensaje) como `trim().parse::<usize>()` + límite de 16 MiB.
fn ls_parse_length(value: string) -> Result {
    let mut digits = std::text::trim(value)
    if std::text::starts_with(digits, "+") {
        digits = std::text::substring(digits, 1, std::text::length(digits))
    }
    let cs = std::text::chars(digits)
    if len(cs) == 0 {
        return Result::Err("invalid LSP frame: invalid Content-Length")
    }
    for c in cs {
        let code = std::text::char_code(c)
        if code < 48 || code > 57 {
            return Result::Err("invalid LSP frame: invalid Content-Length")
        }
    }
    let mut i = 0
    while i + 1 < len(cs) && cs[i] == '0' {
        i += 1
    }
    let sig = std::text::substring(digits, i, std::text::length(digits))
    let n = std::text::length(sig)
    if n > 20 || (n == 20 && sig > "18446744073709551615") {
        return Result::Err("invalid LSP frame: invalid Content-Length")
    }
    if n > 9 {
        return Result::Err("invalid LSP frame: message exceeds 16 MiB")
    }
    let mut v = 0
    match std::text::parse_int(sig) {
        Option::Some(x) => {
            v = x
        },
        _ => {},
    }
    if v > 16777216 {
        return Result::Err("invalid LSP frame: message exceeds 16 MiB")
    }
    Result::Ok(v)
}

// Ok([]) = fin limpio; Ok([mensaje]) = mensaje JSON; Err(texto del error).
fn ls_read_message() -> Result {
    let mut length: any = nil
    loop {
        let raw = ls_read_line()?
        if std::bytes::length(raw) == 0 {
            if length == nil {
                return Result::Ok([])
            }
            return Result::Err("invalid LSP frame: unexpected EOF in headers")
        }
        let decoded = std::try::catch(|| { std::encoding::utf8_decode(raw) })
        let mut line = ""
        match decoded {
            Result::Ok(t) => {
                line = t
            },
            Result::Err(_) => {
                return Result::Err("LSP I/O error: stream did not contain valid UTF-8")
            },
        }
        if line == "\r\n" || line == "\n" {
            break
        }
        let mut value: any = nil
        if std::text::starts_with(line, "Content-Length:") {
            value = std::text::substring(line, 15, std::text::length(line))
        } else if std::text::starts_with(line, "content-length:") {
            value = std::text::substring(line, 15, std::text::length(line))
        }
        if value != nil {
            length = ls_parse_length(value)?
        }
    }
    if length == nil {
        return Result::Err("invalid LSP frame: missing Content-Length")
    }
    let mut body = std::encoding::utf8_encode("")
    while std::bytes::length(body) < length {
        let want = length - std::bytes::length(body)
        let r = std::try::catch(|| { std::io::read_stdin(want) })
        let mut chunk: any = nil
        match r {
            Result::Ok(v) => {
                chunk = v
            },
            Result::Err(e) => {
                return Result::Err("LSP I/O error: " + ls_clean(e))
            },
        }
        if std::bytes::length(chunk) == 0 {
            return Result::Err("LSP I/O error: failed to fill whole buffer")
        }
        body = std::bytes::concat(body, chunk)
    }
    let text_r = std::try::catch(|| { std::encoding::utf8_decode(body) })
    let mut text = ""
    match text_r {
        Result::Ok(t) => {
            text = t
        },
        Result::Err(_) => {
            return Result::Err("invalid JSON-RPC message: invalid unicode code point at line 1 column 1")
        },
    }
    let parsed = std::try::catch(|| { std::json::parse(text) })
    match parsed {
        Result::Ok(v) => {
            return Result::Ok([v])
        },
        Result::Err(e) => {
            return Result::Err("invalid JSON-RPC message: " + ls_clean(e))
        },
    }
    Result::Ok([])
}

fn ls_write_message(body: string) -> Result {
    let bytes = std::encoding::utf8_encode(body)
    let head = std::encoding::utf8_encode("Content-Length: " + ls_i(std::bytes::length(bytes)) + "\r\n\r\n")
    let r = std::try::catch(|| { std::io::write_stdout(std::bytes::concat(head, bytes)) })
    match r {
        Result::Ok(_) => {
            return Result::Ok(nil)
        },
        Result::Err(e) => {
            return Result::Err("LSP I/O error: " + ls_clean(e))
        },
    }
    Result::Ok(nil)
}

fn ls_reply(id_json: string, result: string) -> Result {
    ls_write_message("{\"id\":" + id_json + ",\"jsonrpc\":\"2.0\",\"result\":" + result + "}")
}

fn ls_reply_error(id_json: string, message: string) -> Result {
    ls_write_message("{\"error\":{\"code\":-32602,\"message\":" + lj_q(message) + "},\"id\":" + id_json + ",\"jsonrpc\":\"2.0\"}")
}

fn ls_publish(st: LsState, uri: string) -> Result {
    ls_write_message("{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"diagnostics\":" + lj_list(ls_diagnostics(st, uri)) + ",\"uri\":" + lj_q(uri) + "}}")
}

fn ls_capabilities() -> string {
    "{\"capabilities\":{\"completionProvider\":{\"triggerCharacters\":[\".\",\":\"]},\"definitionProvider\":true,\"documentSymbolProvider\":true,\"hoverProvider\":true,\"referencesProvider\":true,\"renameProvider\":{\"prepareProvider\":false},\"semanticTokensProvider\":{\"full\":true,\"legend\":{\"tokenModifiers\":[],\"tokenTypes\":[\"keyword\",\"function\",\"type\",\"variable\",\"string\",\"number\",\"operator\"]}},\"signatureHelpProvider\":{\"triggerCharacters\":[\"(\",\",\"]},\"textDocumentSync\":{\"change\":2,\"openClose\":true},\"workspaceSymbolProvider\":true},\"serverInfo\":{\"name\":\"titan-lsp\",\"version\":\"1.0.0\"}}"
}

// params.textDocument.uri -> Ok(uri) / Err(mensaje)
fn ls_document_uri(params: any) -> Result {
    let doc = lj_get(params, "textDocument")
    let uri = lj_str(lj_get(doc, "uri"))
    if uri == nil {
        return Result::Err("missing textDocument.uri")
    }
    Result::Ok(uri)
}

fn ls_parse_position(v: any) -> Result {
    let line = lj_u32(lj_get(v, "line"))
    if line == nil {
        return Result::Err("missing line")
    }
    let character = lj_u32(lj_get(v, "character"))
    if character == nil {
        return Result::Err("missing character")
    }
    Result::Ok([line, character])
}

// Ok([uri, línea, carácter])
fn ls_document_position(params: any) -> Result {
    let uri = ls_document_uri(params)?
    if !lj_has(params, "position") {
        return Result::Err("missing position")
    }
    let p = ls_parse_position(params["position"])?
    Result::Ok([uri, p[0], p[1]])
}

fn ls_parse_range(v: any) -> Result {
    if !lj_has(v, "start") {
        return Result::Err("missing range.start")
    }
    let a = ls_parse_position(v["start"])?
    if !lj_has(v, "end") {
        return Result::Err("missing range.end")
    }
    let b = ls_parse_position(v["end"])?
    Result::Ok([a[0], a[1], b[0], b[1]])
}

fn ls_frame_err(message: string) -> string {
    "invalid LSP frame: " + message
}

// Resultado de una petición: Ok(JSON) o Err(mensaje del error -32602).
fn ls_request(st: LsState, method: string, params: any) -> Result {
    if method == "initialize" {
        return Result::Ok(ls_capabilities())
    }
    if method == "textDocument/completion" {
        ls_document_position(params)?
        return Result::Ok(lj_list(ls_completions(st)))
    }
    if method == "textDocument/signatureHelp" {
        let dp = ls_document_position(params)?
        let h = ls_signature_help(st, dp[0], dp[1], dp[2])
        if h == nil {
            return Result::Ok("null")
        }
        let mut plist = []
        for p in h[1] {
            plist = std::array::push(plist, "{\"label\":" + lj_q(p) + "}")
        }
        let active = h[2]
        return Result::Ok("{\"activeParameter\":" + ls_i(active) + ",\"activeSignature\":0,\"signatures\":[{\"label\":" + lj_q(h[0]) + ",\"parameters\":" + lj_list(plist) + "}]}")
    }
    if method == "textDocument/semanticTokens/full" {
        let uri = ls_document_uri(params)?
        let text = ls_text(st, uri)
        let mut data = []
        if text != nil {
            data = ls_semantic_tokens(text)
        }
        return Result::Ok("{\"data\":" + lj_list(data) + "}")
    }
    if method == "textDocument/hover" {
        let dp = ls_document_position(params)?
        let h = ls_hover(st, dp[0], dp[1], dp[2])
        if h == nil {
            return Result::Ok("null")
        }
        return Result::Ok("{\"contents\":{\"kind\":\"markdown\",\"value\":" + lj_q(h) + "}}")
    }
    if method == "textDocument/definition" {
        let dp = ls_document_position(params)?
        let name = ls_word_at(st, dp[0], dp[1], dp[2])
        if name == nil {
            return Result::Ok("null")
        }
        let s = ls_symbol_named(st, name)
        if s == nil {
            return Result::Ok("null")
        }
        return Result::Ok("{\"range\":" + lj_range(s[4], s[5], s[6], s[7]) + ",\"uri\":" + lj_q(s[1]) + "}")
    }
    if method == "textDocument/references" {
        let dp = ls_document_position(params)?
        return Result::Ok(lj_list(ls_references(st, dp[0], dp[1], dp[2])))
    }
    if method == "textDocument/rename" {
        let dp = ls_document_position(params)?
        let nn = lj_str(lj_get(params, "newName"))
        if nn == nil {
            return Result::Err("missing newName")
        }
        let changes = ls_rename(st, dp[0], dp[1], dp[2], nn)?
        return Result::Ok("{\"changes\":" + changes + "}")
    }
    if method == "textDocument/documentSymbol" {
        let uri = ls_document_uri(params)?
        let mut out = []
        for s in ls_document_symbols(st, uri) {
            out = std::array::push(out, "{\"detail\":" + lj_q(s[3]) + ",\"kind\":" + ls_i(s[2]) + ",\"name\":" + lj_q(s[0]) + ",\"range\":" + lj_range(s[4], s[5], s[6], s[7]) + ",\"selectionRange\":" + lj_range(s[4], s[5], s[6], s[7]) + "}")
        }
        return Result::Ok(lj_list(out))
    }
    if method == "workspace/symbol" {
        let mut query = ""
        let q = lj_str(lj_get(params, "query"))
        if q != nil {
            query = q
        }
        let mut out = []
        for s in ls_workspace_symbols(st, query) {
            out = std::array::push(out, "{\"kind\":" + ls_i(s[2]) + ",\"location\":{\"range\":" + lj_range(s[4], s[5], s[6], s[7]) + ",\"uri\":" + lj_q(s[1]) + "},\"name\":" + lj_q(s[0]) + "}")
        }
        return Result::Ok(lj_list(out))
    }
    Result::Err("method not found")
}

fn ls_id_json(id: any) -> string {
    std::json::stringify(id)
}

// Bucle principal. Ok(nil) al terminar bien; Err("texto") con el error que Rust imprimiría tras
// `titan-lsp: `.
fn lsp_serve() -> Result {
    let mut st = ls_new()
    let mut shutdown = false
    loop {
        let got = ls_read_message()?
        if len(got) == 0 {
            break
        }
        let message = got[0]
        let is_obj = lj_kind(message) == "m"
        let mut method = ""
        let mut params: any = nil
        if is_obj {
            let m = lj_str(lj_get(message, "method"))
            if m != nil {
                method = m
            }
            params = lj_get(message, "params")
        }
        if is_obj && std::map::contains(message, "id") {
            let id_json = ls_id_json(message["id"])
            if method == "shutdown" {
                shutdown = true
                ls_reply(id_json, "null")?
            } else {
                match ls_request(st, method, params) {
                    Result::Ok(text) => {
                        ls_reply(id_json, text)?
                    },
                    Result::Err(msg) => {
                        ls_reply_error(id_json, msg)?
                    },
                }
            }
        } else {
            if method == "exit" {
                break
            }
            if method == "textDocument/didOpen" {
                if lj_has(params, "textDocument") {
                    let doc = params["textDocument"]
                    let uri = lj_str(lj_get(doc, "uri"))
                    if uri == nil {
                        return Result::Err(ls_frame_err("missing uri"))
                    }
                    let text = lj_str(lj_get(doc, "text"))
                    if text == nil {
                        return Result::Err(ls_frame_err("missing text"))
                    }
                    let mut version = 0
                    let v = lj_get(doc, "version")
                    if v != nil && lj_kind(v) == "i" {
                        version = v
                    }
                    st = ls_open(st, uri, text, version)
                    ls_publish(st, uri)?
                }
            } else if method == "textDocument/didChange" {
                if !lj_has(params, "textDocument") {
                    return Result::Err(ls_frame_err("missing textDocument"))
                }
                let doc = params["textDocument"]
                let uri = lj_str(lj_get(doc, "uri"))
                if uri == nil {
                    return Result::Err(ls_frame_err("missing uri"))
                }
                let mut version = 0
                let v = lj_get(doc, "version")
                if v != nil && lj_kind(v) == "i" {
                    version = v
                }
                let changes = lj_get(params, "contentChanges")
                if changes != nil && lj_kind(changes) == "a" {
                    for change in changes {
                        let mut range: any = nil
                        if lj_has(change, "range") {
                            match ls_parse_range(change["range"]) {
                                Result::Ok(r) => {
                                    range = r
                                },
                                Result::Err(msg) => {
                                    return Result::Err(ls_frame_err(msg))
                                },
                            }
                        }
                        let text = lj_str(lj_get(change, "text"))
                        if text == nil {
                            return Result::Err(ls_frame_err("missing text"))
                        }
                        match ls_apply_change(st, uri, range, text, version) {
                            Result::Ok(next) => {
                                st = next
                            },
                            Result::Err(msg) => {
                                return Result::Err(ls_frame_err(msg))
                            },
                        }
                    }
                }
                ls_publish(st, uri)?
            } else if method == "textDocument/didClose" {
                match ls_document_uri(params) {
                    Result::Ok(uri) => {
                        st = ls_close(st, uri)
                        ls_write_message("{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"diagnostics\":[],\"uri\":" + lj_q(uri) + "}}")?
                    },
                    Result::Err(msg) => {
                        return Result::Err(ls_frame_err(msg))
                    },
                }
            }
        }
        if shutdown && method == "exit" {
            break
        }
    }
    Result::Ok(nil)
}

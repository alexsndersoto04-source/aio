// ============================================================================
// Typechecker de Titan escrito en Titan (self-hosting, fase 3).
//
// Traducción fiel de crates/titan_typechecker/src/lib.rs: mismas reglas, mismos
// mensajes y el mismo orden de diagnósticos. Verificación diferencial:
// `typecheck_dump(texto)` produce el mismo texto que `titan typecheck <archivo>`
// (typechecker de Rust) byte por byte.
//
// Entrada: el AST de selfhost/parser.titan (struct Node, ver su tabla).
// Tipos: struct Ty (unión etiquetada, igual que el enum `Type` de Rust):
//   k = "Int" "Float" "Bool" "String" "Char" "Nil" "Unit" "Never" "Unknown"
//       "Array"(items=[elem]) "Tuple"(items) "Named"(name)
//       "Function"(items=params, ret=resultado)
// `==` entre structs de Titan compara por contenido, igual que el PartialEq
// derivado de Rust.
//
// Las ramas de Rust para `Pattern::Struct`, `Pattern::Tuple`, `Stmt::Assign` y
// `Expr::Let` no se traducen: el parser nunca produce esos nodos (solo existen
// para ASTs sintéticos), así que no pueden afectar a ningún programa fuente.
// ============================================================================

import parser
import natives

struct Ty {
    k: string,
    name: string,
    items: array,
    ret: any,
}

struct Sig {
    params: array,
    result: Ty,
}

// Un diagnóstico: el mensaje (Display del TypeError) y su span (o nil).
struct Diag {
    msg: string,
    span: any,
}

// ------------------------------------------------------------------- tipos

fn mkt(k: string) -> Ty {
    Ty { k: k, name: "", items: [], ret: nil }
}

fn tarr(elem: Ty) -> Ty {
    Ty { k: "Array", name: "", items: [elem], ret: nil }
}

fn ttup(items: array) -> Ty {
    Ty { k: "Tuple", name: "", items: items, ret: nil }
}

fn tnamed(name: string) -> Ty {
    Ty { k: "Named", name: name, items: [], ret: nil }
}

fn tfn(params: array, result: Ty) -> Ty {
    Ty { k: "Function", name: "", items: params, ret: result }
}

fn mixed_name() -> string {
    "$titan::mixed-element"
}

fn is_k(t: Ty, k: string) -> bool {
    t.k == k
}

fn is_named(t: Ty, name: string) -> bool {
    t.k == "Named" && t.name == name
}

// Escapado de `{:?}` de Rust para un String (entre comillas).
fn debug_str(s: string) -> string {
    let mut out = "\""
    for c in s {
        if c == '"' {
            out += "\\\""
        } else if c == '\\' {
            out += "\\\\"
        } else if c == '\n' {
            out += "\\n"
        } else if c == '\r' {
            out += "\\r"
        } else if c == '\t' {
            out += "\\t"
        } else if c == '\0' {
            out += "\\0"
        } else {
            let code = std::text::char_code(c)
            if code < 32 || code == 127 {
                out += "\\u{" + hex_lower(code) + "}"
            } else {
                out += c
            }
        }
    }
    out + "\""
}

fn hex_lower(n: int) -> string {
    let digits = "0123456789abcdef"
    if n == 0 {
        return "0"
    }
    let mut out = ""
    let mut v = n
    while v > 0 {
        out = std::text::substring(digits, v % 16, v % 16 + 1) + out
        v = v / 16
    }
    out
}

// `{:?}` del enum Type de Rust.
fn tdebug(t: Ty) -> string {
    let k = t.k
    if k == "Array" {
        return "Array(" + tdebug(t.items[0]) + ")"
    }
    if k == "Tuple" {
        return "Tuple([" + tdebug_list(t.items) + "])"
    }
    if k == "Named" {
        return "Named(" + debug_str(t.name) + ")"
    }
    if k == "Function" {
        return "Function([" + tdebug_list(t.items) + "], " + tdebug(t.ret) + ")"
    }
    k
}

fn tdebug_list(items: array) -> string {
    let mut out = ""
    let mut i = 0
    while i < len(items) {
        if i > 0 {
            out += ", "
        }
        out += tdebug(items[i])
        i += 1
    }
    out
}

// Display de Type: el tipo "mixto" interno se imprime como `mixed`.
fn tdisp(t: Ty) -> string {
    if is_named(t, mixed_name()) {
        return "mixed"
    }
    tdebug(t)
}

// ------------------------------------------------- mensajes (Display de TypeError)

fn m_mismatch(expected: Ty, found: Ty) -> string {
    "type mismatch: expected " + tdisp(expected) + ", found " + tdisp(found)
}

fn m_unknown_var(name: string) -> string {
    "unknown variable or function '" + name + "'"
}

fn m_not_callable(name: string) -> string {
    "'" + name + "' is not callable"
}

fn m_arity(expected: int, found: int) -> string {
    "function expected {expected} arguments, found {found}"
}

fn m_invalid_unary(op: string, operand: Ty) -> string {
    "invalid operand for " + op + ": " + tdisp(operand)
}

fn m_invalid_operands(op: string, left: Ty, right: Ty) -> string {
    "invalid operands for " + op + ": " + tdisp(left) + " and " + tdisp(right)
}

fn m_not_indexable(target: Ty) -> string {
    "value of type " + tdisp(target) + " cannot be indexed"
}

fn m_index_oob(index: int, length: int) -> string {
    "index {index} is out of bounds for a tuple of length {length}"
}

fn m_not_iterable(target: Ty) -> string {
    "value of type " + tdisp(target) + " is not iterable"
}

fn m_unknown_method(receiver: Ty, method: string) -> string {
    "type " + tdisp(receiver) + " has no method '" + method + "'"
}

fn m_invalid_assign_target() -> string {
    "assignment target must be a mutable local variable in the current function"
}

fn m_outside_function() -> string {
    "return used outside a function or closure"
}

fn m_missing_return(name: string, expected: Ty) -> string {
    "function '" + name + "' can finish without returning " + tdisp(expected)
}

fn m_inconsistent_returns(name: string, first: Ty, second: Ty) -> string {
    "function '" + name + "' returns incompatible types " + tdisp(first) + " and " + tdisp(second)
}

fn m_duplicate(kind: string, name: string) -> string {
    "duplicate " + kind + " declaration '" + name + "'"
}

fn m_unknown_type(name: string) -> string {
    "unknown type '" + name + "'"
}

fn m_invalid_type_args(name: string, expected: int, found: int) -> string {
    "type '" + name + "' expects {expected} type arguments, found {found}"
}

fn m_recursive_constant(cycle: string) -> string {
    "recursive constant dependency: " + cycle
}

fn m_recursive_alias(name: string) -> string {
    "type alias '" + name + "' is recursive"
}

fn m_invalid_impl_target(name: string) -> string {
    "impl target '" + name + "' is not a declared struct"
}

fn m_trait_method_mismatch(trait_name: string, target: string, method: string) -> string {
    "method '" + method + "' in impl " + trait_name + " for " + target + " has an incompatible signature"
}

fn m_missing_trait_method(trait_name: string, target: string, method: string) -> string {
    "impl " + trait_name + " for " + target + " is missing required method '" + method + "'"
}

fn m_unknown_trait_method(trait_name: string, method: string) -> string {
    "method '" + method + "' is not declared by trait '" + trait_name + "'"
}

fn m_missing_field(structure: string, field: string) -> string {
    "missing field '" + field + "' in struct '" + structure + "'"
}

fn m_unknown_field(structure: string, field: string) -> string {
    "unknown field '" + field + "' in struct '" + structure + "'"
}

fn m_duplicate_field(structure: string, field: string) -> string {
    "field '" + field + "' appears more than once in struct literal '" + structure + "'"
}

fn m_invalid_argument(function: string, expected: string, found: Ty) -> string {
    "invalid argument to '" + function + "': expected " + expected + ", found " + tdisp(found)
}

fn m_invalid_interpolation(expression: string) -> string {
    "invalid string interpolation expression '" + expression + "'"
}

fn m_no_fields(target: Ty) -> string {
    "value of type " + tdisp(target) + " has no fields"
}

fn m_invalid_pattern(message: string) -> string {
    "invalid pattern: " + message
}

fn m_unknown_variant(enumeration: string, variant: string) -> string {
    "unknown variant '" + enumeration + "::" + variant + "'"
}

fn m_non_exhaustive() -> string {
    "non-exhaustive match; add a catch-all arm"
}

fn m_non_exhaustive_enum(enumeration: string, missing: array) -> string {
    let mut list = "["
    let mut i = 0
    while i < len(missing) {
        if i > 0 {
            list += ", "
        }
        list += debug_str(missing[i])
        i += 1
    }
    "non-exhaustive match for enum '" + enumeration + "'; missing " + list + "]"
}

fn m_unreachable_pattern(arm: int) -> string {
    "match arm {arm} has an unreachable pattern"
}

fn m_outside_loop() -> string {
    "break/continue used outside a loop"
}

fn m_invalid_try() -> string {
    "operator ? requires an Option or Result value"
}

fn m_unsupported(feature: string) -> string {
    "unsupported language feature: " + feature
}

fn m_entry_params(found: int) -> string {
    "entry point 'main' must take no parameters, but {found} were declared"
}

// Estado del typechecker (equivale a los campos de `TypeEnv` en Rust).
// Titan no permite asignar campos de struct, así que cada cambio construye un
// Env nuevo con `set_<campo>` (generado por un script: es solo repetición).
struct Env {
    scopes: array,
    bindings: array,
    functions: map,
    base: map,
    structs: map,
    variants: map,
    base_variants: map,
    constants: map,
    ctypes: map,
    cdecls: map,
    cstack: array,
    checked: map,
    traits: map,
    aliases: map,
    errors: array,
    ret: Ty,
    cands: array,
    loop_depth: int,
    breaks: array,
    fdepth: int,
    natives: map,
}

fn set_scopes(e: Env, v) -> Env {
    Env { scopes: v, bindings: e.bindings, functions: e.functions, base: e.base, structs: e.structs, variants: e.variants, base_variants: e.base_variants, constants: e.constants, ctypes: e.ctypes, cdecls: e.cdecls, cstack: e.cstack, checked: e.checked, traits: e.traits, aliases: e.aliases, errors: e.errors, ret: e.ret, cands: e.cands, loop_depth: e.loop_depth, breaks: e.breaks, fdepth: e.fdepth, natives: e.natives }
}

fn set_bindings(e: Env, v) -> Env {
    Env { scopes: e.scopes, bindings: v, functions: e.functions, base: e.base, structs: e.structs, variants: e.variants, base_variants: e.base_variants, constants: e.constants, ctypes: e.ctypes, cdecls: e.cdecls, cstack: e.cstack, checked: e.checked, traits: e.traits, aliases: e.aliases, errors: e.errors, ret: e.ret, cands: e.cands, loop_depth: e.loop_depth, breaks: e.breaks, fdepth: e.fdepth, natives: e.natives }
}


// ------------------------------------------------------- errores y spans

fn err(e: Env, msg: string) -> Env {
    set_errors(e, std::array::push(e.errors, Diag { msg: msg, span: nil }))
}

fn err_at(e: Env, msg: string, span: Span) -> Env {
    set_errors(e, std::array::push(e.errors, Diag { msg: msg, span: span }))
}

// assign_error_span: los errores emitidos desde `start` que aún no tienen
// ubicación reciben `span`.
fn assign_span(e: Env, start: int, span: Span) -> Env {
    let errs = e.errors
    if len(errs) <= start {
        return e
    }
    let mut out = std::array::slice(errs, 0, start)
    let mut i = start
    while i < len(errs) {
        let d = errs[i]
        if d.span == nil {
            out = std::array::push(out, Diag { msg: d.msg, span: span })
        } else {
            out = std::array::push(out, d)
        }
        i += 1
    }
    set_errors(e, out)
}

// ------------------------------------------------------ AST -> tipo

fn type_from_ast(t) -> Ty {
    let k = t.kind
    if k == "t_named" {
        let name = t.text
        if name == "int" || name == "i32" || name == "i64" || name == "u64" || name == "usize" {
            return mkt("Int")
        }
        if name == "float" || name == "f32" || name == "f64" {
            return mkt("Float")
        }
        if name == "bool" {
            return mkt("Bool")
        }
        if name == "string" || name == "str" {
            return mkt("String")
        }
        if name == "char" {
            return mkt("Char")
        }
        if (name == "Array" || name == "Vec") && len(t.list) > 0 {
            return tarr(type_from_ast(t.list[0]))
        }
        if name == "array" {
            return tarr(mkt("Unknown"))
        }
        if name == "map" {
            return tnamed("map")
        }
        if name == "any" {
            return mkt("Unknown")
        }
        return tnamed(name)
    }
    if k == "t_slice" || k == "t_array" {
        return tarr(type_from_ast(t.a))
    }
    if k == "t_tuple" {
        return ttup(types_from_ast(t.list))
    }
    if k == "t_fn" {
        return tfn(types_from_ast(t.list), type_from_ast(t.a))
    }
    if k == "t_unit" {
        return mkt("Unit")
    }
    if k == "t_never" {
        return mkt("Never")
    }
    // t_ref
    type_from_ast(t.a)
}

fn types_from_ast(list: array) -> array {
    let mut out = []
    for t in list {
        out = std::array::push(out, type_from_ast(t))
    }
    out
}

// Anotación opcional (nil = sin anotar) con el tipo por defecto indicado.
fn ann_or(t, default: Ty) -> Ty {
    if t == nil {
        return default
    }
    type_from_ast(t)
}

fn direct_named_type(t) -> string {
    if t.kind == "t_named" && len(t.list) == 0 {
        return t.text
    }
    ""
}

// --------------------------------------------------------- compatibilidad

fn compatible(a: Ty, b: Ty) -> bool {
    if a == b {
        return true
    }
    if a.k == "Never" {
        return false
    }
    if a.k == "Unknown" {
        return true
    }
    if b.k == "Unknown" || b.k == "Never" {
        return true
    }
    if (a.k == "Unit" && b.k == "Nil") || (a.k == "Nil" && b.k == "Unit") {
        return true
    }
    if a.k == "Array" && b.k == "Array" {
        return compatible(a.items[0], b.items[0])
    }
    if a.k == "Tuple" && b.k == "Tuple" {
        if len(a.items) != len(b.items) {
            return false
        }
        let mut i = 0
        while i < len(a.items) {
            if !compatible(a.items[i], b.items[i]) {
                return false
            }
            i += 1
        }
        return true
    }
    if a.k == "Function" && b.k == "Function" {
        return function_type_compatible(a.items, a.ret, b.items, b.ret)
    }
    false
}

fn function_parameter_accepts(parameter: Ty, argument: Ty) -> bool {
    if parameter == argument || argument.k == "Never" || parameter.k == "Unknown" {
        return true
    }
    if argument.k == "Unknown" || parameter.k == "Never" {
        return false
    }
    if (parameter.k == "Unit" && argument.k == "Nil") || (parameter.k == "Nil" && argument.k == "Unit") {
        return true
    }
    if parameter.k == "Array" && argument.k == "Array" {
        return function_parameter_accepts(parameter.items[0], argument.items[0])
    }
    if parameter.k == "Tuple" && argument.k == "Tuple" {
        if len(parameter.items) != len(argument.items) {
            return false
        }
        let mut i = 0
        while i < len(parameter.items) {
            if !function_parameter_accepts(parameter.items[i], argument.items[i]) {
                return false
            }
            i += 1
        }
        return true
    }
    if parameter.k == "Function" && argument.k == "Function" {
        return function_type_compatible(parameter.items, parameter.ret, argument.items, argument.ret)
    }
    false
}

fn function_result_compatible(expected: Ty, found: Ty) -> bool {
    if expected == found || found.k == "Never" || expected.k == "Unknown" {
        return true
    }
    if found.k == "Unknown" || expected.k == "Never" {
        return false
    }
    if (expected.k == "Unit" && found.k == "Nil") || (expected.k == "Nil" && found.k == "Unit") {
        return true
    }
    if expected.k == "Array" && found.k == "Array" {
        return function_result_compatible(expected.items[0], found.items[0])
    }
    if expected.k == "Tuple" && found.k == "Tuple" {
        if len(expected.items) != len(found.items) {
            return false
        }
        let mut i = 0
        while i < len(expected.items) {
            if !function_result_compatible(expected.items[i], found.items[i]) {
                return false
            }
            i += 1
        }
        return true
    }
    if expected.k == "Function" && found.k == "Function" {
        return function_type_compatible(expected.items, expected.ret, found.items, found.ret)
    }
    false
}

fn function_type_compatible(expected_params: array, expected_result: Ty, found_params: array, found_result: Ty) -> bool {
    if len(expected_params) != len(found_params) {
        return false
    }
    let mut i = 0
    while i < len(found_params) {
        if !function_parameter_accepts(found_params[i], expected_params[i]) {
            return false
        }
        i += 1
    }
    function_result_compatible(expected_result, found_result)
}

fn native_compatible(expected: Ty, found: Ty) -> bool {
    if compatible(expected, found) || (expected.k == "Float" && found.k == "Int") {
        return true
    }
    if is_named(expected, "bytes") && found.k == "String" {
        return true
    }
    if expected.k == "Array" && found.k == "Array" {
        return native_compatible(expected.items[0], found.items[0])
    }
    if expected.k == "Array" && found.k == "Tuple" {
        for item in found.items {
            if !native_compatible(expected.items[0], item) {
                return false
            }
        }
        return true
    }
    false
}

fn is_numeric(t: Ty) -> bool {
    t.k == "Int" || t.k == "Float" || t.k == "Unknown"
}

// Option<Ty>: nil = None.
fn common_type(types: array) -> any {
    if len(types) == 0 {
        return nil
    }
    let first = types[0]
    let mut i = 1
    while i < len(types) {
        if !compatible(first, types[i]) {
            return nil
        }
        i += 1
    }
    first
}

fn common_or_unknown(types: array) -> Ty {
    let c = common_type(types)
    if c == nil {
        return mkt("Unknown")
    }
    c
}

fn sequence_item_type(t: Ty) -> any {
    if t.k == "Array" {
        return t.items[0]
    }
    if t.k == "Tuple" {
        return common_or_unknown(t.items)
    }
    if t.k == "Unknown" {
        return mkt("Unknown")
    }
    nil
}

fn sequence_matches(expected_item: Ty, found: Ty) -> bool {
    if found.k == "Array" {
        return compatible(expected_item, found.items[0])
    }
    if found.k == "Tuple" {
        for item in found.items {
            if !compatible(expected_item, item) {
                return false
            }
        }
        return true
    }
    found.k == "Unknown" || found.k == "Never"
}

fn is_length_supported(t: Ty) -> bool {
    t.k == "Array" || t.k == "Tuple" || t.k == "String" || t.k == "Unknown" || is_named(t, "bytes") || is_named(t, "map")
}

// Option<usize>: -1 = None.
fn builtin_method_arity(receiver: Ty, method: string) -> int {
    if receiver.k == "Array" || receiver.k == "Tuple" {
        if method == "len" {
            return 0
        }
        if method == "map" || method == "filter" || method == "sort_by" || method == "find" || method == "any" || method == "all" {
            return 1
        }
        if method == "fold" {
            return 2
        }
        return -1
    }
    if receiver.k == "String" || is_named(receiver, "bytes") || is_named(receiver, "map") {
        if method == "len" {
            return 0
        }
    }
    -1
}

fn function_signature(function, self_type: string) -> Sig {
    let mut params = []
    let mut i = 0
    while i < len(function.list) {
        let p = function.list[i]
        if i == 0 && p.text == "self" && p.a == nil && self_type != "" {
            params = std::array::push(params, tnamed(self_type))
        } else {
            params = std::array::push(params, ann_or(p.a, mkt("Unknown")))
        }
        i += 1
    }
    Sig { params: params, result: ann_or(function.b, mkt("Unit")) }
}

// ------------------------------------------------ nativas de la stdlib

fn native_type(name: string) -> Ty {
    if name == "Any" {
        return mkt("Unknown")
    }
    if name == "Bytes" {
        return tnamed("bytes")
    }
    if name == "Array" {
        return tarr(mkt("Unknown"))
    }
    if name == "Map" {
        return tnamed("map")
    }
    if name == "Option" {
        return tnamed("Option")
    }
    // Int Float Bool String Nil Never: mismo nombre que en Type.
    mkt(name)
}

// Divide `s` por el carácter `sep` (conserva los trozos vacíos).
fn split_on(s: string, sep: char) -> array {
    let mut parts = []
    let mut cur = ""
    for c in s {
        if c == sep {
            parts = std::array::push(parts, cur)
            cur = ""
        } else {
            cur += c
        }
    }
    std::array::push(parts, cur)
}

// "nombre P1,P2 -> R" (natives.titan) -> mapa nombre -> Sig. Sin parámetros la
// lista queda vacía: "nombre  -> R".
fn load_natives() -> map {
    let mut m = std::map::new()
    for line in native_table() {
        let parts = split_on(line, ' ')
        let name = parts[0]
        let plist = parts[1]
        let result = parts[3]
        let mut params = []
        if plist != "" {
            for p in split_on(plist, ',') {
                params = std::array::push(params, native_type(p))
            }
        }
        m = std::map::insert(m, name, Sig { params: params, result: native_type(result) })
    }
    m
}


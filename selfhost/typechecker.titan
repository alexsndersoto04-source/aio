    m = std::map::insert(m, "std::mysql::pool_health", Sig { params: [tnamed("MysqlPool"), mkt("Int")], result: mkt("Bool") })
    m = std::map::insert(m, "std::mysql::pool_close", Sig { params: [tnamed("MysqlPool")], result: mkt("Nil") })
    m = std::map::insert(m, "std::db::execute", Sig { params: [mkt("Unknown"), mkt("String"), mkt("Unknown")], result: mkt("Int") })
    m = std::map::insert(m, "std::db::query", Sig { params: [mkt("Unknown"), mkt("String"), mkt("Unknown")], result: tarr(tnamed("map")) })
    m = std::map::insert(m, "std::db::begin", Sig { params: [mkt("Unknown")], result: mkt("Nil") })
    m = std::map::insert(m, "std::db::commit", Sig { params: [mkt("Unknown")], result: mkt("Nil") })
    m = std::map::insert(m, "std::db::rollback", Sig { params: [mkt("Unknown")], result: mkt("Nil") })
    m = std::map::insert(m, "std::db::migrate", Sig { params: [mkt("Unknown"), mkt("Unknown")], result: mkt("Int") })
    m = std::map::insert(m, "std::db::close", Sig { params: [mkt("Unknown")], result: mkt("Bool") })
    m = std::map::insert(m, "std::db::ping", Sig { params: [mkt("Unknown")], result: mkt("Bool") })
    m = std::map::insert(m, "std::runtime::memory_limit", Sig { params: [], result: mkt("Int") })
    m = std::map::insert(m, "std::runtime::allocated_bytes", Sig { params: [], result: mkt("Int") })
    m = std::map::insert(m, "std::runtime::gc_live_count", Sig { params: [], result: mkt("Int") })
    m = std::map::insert(m, "std::runtime::gc_collect", Sig { params: [], result: mkt("Int") })
    m = std::map::insert(m, "std::runtime::gc_threshold", Sig { params: [], result: mkt("Int") })
    m = std::map::insert(m, "std::runtime::gc_set_threshold", Sig { params: [mkt("Int")], result: mkt("Nil") })
    m = std::map::insert(m, "std::runtime::active_tasks", Sig { params: [], result: mkt("Int") })
    m = std::map::insert(m, "std::runtime::heap_dump", Sig { params: [mkt("String")], result: mkt("Bool") })
    m = std::map::insert(m, "std::runtime::optimize_level", Sig { params: [], result: mkt("Int") })
    m = std::map::insert(m, "std::runtime::fast_path_enabled", Sig { params: [], result: mkt("Bool") })
    m = std::map::insert(m, "std::runtime::benchmark", Sig { params: [mkt("Int"), tfn([], mkt("Unknown"))], result: tnamed("map") })
    m = std::map::insert(m, "std::runtime::spawn_quota", Sig { params: [mkt("Int"), tfn([], mkt("Unknown"))], result: tnamed("Task") })
    m
}

// enum_variants iniciales: nombre cualificado -> [] (sin payload) o [Ty].
fn builtin_variants() -> map {
    let mut m = std::map::new()
    m = std::map::insert(m, "Option::None", [])
    m = std::map::insert(m, "Option::Some", [mkt("Unknown")])
    m = std::map::insert(m, "Result::Ok", [mkt("Unknown")])
    m = std::map::insert(m, "Result::Err", [mkt("Unknown")])
    m
}

// Sintaxis Titan de una anotación de tipo (Display de TypeExpr).
fn type_expr_text(t) -> string {
    let k = t.kind
    if k == "t_named" {
        if len(t.list) == 0 {
            return t.text
        }
        return t.text + "<" + type_expr_list(t.list) + ">"
    }
    if k == "t_ref" {
        if t.flag {
            return "&mut " + type_expr_text(t.a)
        }
        return "&" + type_expr_text(t.a)
    }
    if k == "t_slice" {
        return "[" + type_expr_text(t.a) + "]"
    }
    if k == "t_array" {
        if t.b.kind == "int" {
            let n = t.b.a
            return "[" + type_expr_text(t.a) + "; {n}]"
        }
        return "[" + type_expr_text(t.a) + "; _]"
    }
    if k == "t_tuple" {
        if len(t.list) == 1 {
            return "(" + type_expr_list(t.list) + ",)"
        }
        return "(" + type_expr_list(t.list) + ")"
    }
    if k == "t_fn" {
        return "fn(" + type_expr_list(t.list) + ") -> " + type_expr_text(t.a)
    }
    if k == "t_unit" {
        return "()"
    }
    "!"
}

fn type_expr_list(list: array) -> string {
    let mut out = ""
    let mut i = 0
    while i < len(list) {
        if i > 0 {
            out += ", "
        }
        out += type_expr_text(list[i])
        i += 1
    }
    out
}

// ------------------------------------------ validación de declaraciones

// Estado de declaration_errors: conjuntos (mapas nombre -> true) y la lista
// de (mensaje, span).
struct DeclSt {
    values: map,
    types: map,
    impls: map,
    errs: array,
}

fn decl_err(st: DeclSt, msg: string, span: Span) -> DeclSt {
    DeclSt { values: st.values, types: st.types, impls: st.impls, errs: std::array::push(st.errs, (msg, span)) }
}

fn decl_insert(st: DeclSt, namespace: string, kind: string, name: string, span: Span) -> DeclSt {
    if namespace == "value" {
        if std::map::contains(st.values, name) {
            return decl_err(st, m_duplicate(kind, name), span)
        }
        return DeclSt { values: std::map::insert(st.values, name, true), types: st.types, impls: st.impls, errs: st.errs }
    }
    if std::map::contains(st.types, name) {
        return decl_err(st, m_duplicate(kind, name), span)
    }
    DeclSt { values: st.values, types: std::map::insert(st.types, name, true), impls: st.impls, errs: st.errs }
}

fn decl_parameters(st0: DeclSt, owner: string, params: array) -> DeclSt {
    let mut st = st0
    let mut names = std::map::new()
    for p in params {
        if std::map::contains(names, p.text) {
            st = decl_err(st, m_duplicate("parameter", owner + "::" + p.text), p.span)
        } else {
            names = std::map::insert(names, p.text, true)
        }
        if p.b != nil {
            st = decl_err(st, m_unsupported("default parameter '" + owner + "::" + p.text + "'"), p.span)
        }
    }
    st
}

fn decl_unimplemented(st: DeclSt, owner: string, function) -> DeclSt {
    if function.flag {
        return decl_err(st, m_unsupported("extern function '" + owner + "' without runtime linkage"), function.span)
    }
    if function.c == nil {
        return decl_err(st, m_unsupported("bodyless function '" + owner + "' outside a trait declaration"), function.span)
    }
    st
}

// Nombres ya vistos de una lista de nodos: devuelve los spans duplicados
// como errores con el `kind` dado.
fn decl_members(st0: DeclSt, owner: string, members: array, kind: string) -> DeclSt {
    let mut st = st0
    let mut seen = std::map::new()
    for m in members {
        if !std::map::contains(seen, m.text) {
            seen = std::map::insert(seen, m.text, true)
            continue
        }
        st = decl_err(st, m_duplicate(kind, owner + "::" + m.text), m.span)
    }
    st
}

fn decl_visit(st0: DeclSt, items: array) -> DeclSt {
    let mut st = st0
    for item in items {
        let k = item.kind
        if k == "fn" {
            st = decl_insert(st, "value", "function", item.text, item.span)
            st = decl_parameters(st, item.text, item.list)
            st = decl_unimplemented(st, item.text, item)
            if item.text == "main" && len(item.list) > 0 {
                st = decl_err(st, m_entry_params(len(item.list)), item.span)
            }
        } else if k == "const" {
            st = decl_insert(st, "value", "constant", item.text, item.span)
        } else if k == "struct" {
            st = decl_insert(st, "type", "type", item.text, item.span)
            st = decl_members(st, item.text, item.list, "field")
        } else if k == "enum" {
            st = decl_insert(st, "type", "type", item.text, item.span)
            st = decl_members(st, item.text, item.list, "enum variant")
        } else if k == "trait" {
            st = decl_insert(st, "type", "trait", item.text, item.span)
            let mut seen = std::map::new()
            for method in item.list {
                let qualified = item.text + "::" + method.text
                if std::map::contains(seen, method.text) {
                    st = decl_err(st, m_duplicate("trait method", qualified), method.span)
                } else {
                    seen = std::map::insert(seen, method.text, true)
                }
                st = decl_parameters(st, qualified, method.list)
                if method.c != nil && method.b == nil {
                    st = decl_err(st, m_unsupported("trait default method '" + qualified + "' without an explicit return type"), method.span)
                }
            }
        } else if k == "typealias" {
            st = decl_insert(st, "type", "type", item.text, item.span)
        } else if k == "impl" {
            let mut target = direct_named_type(item.b)
            if target == "" {
                target = "<invalid>"
            }
            if item.a != nil {
                let implementation = item.a + " for " + target
                if std::map::contains(st.impls, implementation) {
                    st = decl_err(st, m_duplicate("impl", implementation), item.span)
                } else {
                    st = DeclSt { values: st.values, types: st.types, impls: std::map::insert(st.impls, implementation, true), errs: st.errs }
                }
            }
            let mut seen = std::map::new()
            for method in item.list {
                let qualified = target + "::" + method.text
                if std::map::contains(seen, method.text) {
                    st = decl_err(st, m_duplicate("method", qualified), method.span)
                } else {
                    seen = std::map::insert(seen, method.text, true)
                }
                st = decl_parameters(st, qualified, method.list)
                st = decl_unimplemented(st, qualified, method)
            }
        } else if k == "module" {
            st = decl_visit(st, item.list)
        }
    }
    st
}

fn declaration_errors(base: map, items: array) -> array {
    let mut values = std::map::new()
    for name in std::map::keys(base) {
        if !std::text::contains(name, "::") {
            values = std::map::insert(values, name, true)
        }
    }
    let st = DeclSt { values: values, types: builtin_type_names(base), impls: std::map::new(), errs: [] }
    decl_visit(st, items).errs
}

fn collect_type_names(t: Ty, names0: map) -> map {
    let mut names = names0
    if t.k == "Named" {
        return std::map::insert(names, t.name, true)
    }
    if t.k == "Array" {
        return collect_type_names(t.items[0], names)
    }
    if t.k == "Tuple" {
        for item in t.items {
            names = collect_type_names(item, names)
        }
        return names
    }
    if t.k == "Function" {
        for p in t.items {
            names = collect_type_names(p, names)
        }
        return collect_type_names(t.ret, names)
    }
    names
}

fn builtin_type_names(base: map) -> map {
    let mut names = std::map::new()
    for n in ["int", "i32", "i64", "u64", "usize", "float", "f32", "f64", "bool", "string", "str", "char", "Array", "Vec", "array", "map", "any", "Option", "Result"] {
        names = std::map::insert(names, n, true)
    }
    for sig in std::map::values(base) {
        for p in sig.params {
            names = collect_type_names(p, names)
        }
        names = collect_type_names(sig.result, names)
    }
    names
}

fn collect_declared_type_names(items: array, names0: map) -> map {
    let mut names = names0
    for item in items {
        if item.kind == "struct" || item.kind == "enum" || item.kind == "typealias" {
            names = std::map::insert(names, item.text, true)
        } else if item.kind == "module" {
            names = collect_declared_type_names(item.list, names)
        }
    }
    names
}

// ---------------------------------------- declared_type_errors (tipos usados)

// unknown: nombre -> span; invalid: clave -> (nombre, esperado, hallado, span);
// unsupported: rasgo -> span. En los tres gana el primer span visto.
struct Issues {
    unknown: map,
    invalid: map,
    unsupported: map,
}

fn iss_unknown(is: Issues, name: string, span: Span) -> Issues {
    if std::map::contains(is.unknown, name) {
        return is
    }
    Issues { unknown: std::map::insert(is.unknown, name, span), invalid: is.invalid, unsupported: is.unsupported }
}

fn iss_invalid(is: Issues, name: string, expected: int, found: int, span: Span) -> Issues {
    let key = name + "\n{expected}\n{found}"
    if std::map::contains(is.invalid, key) {
        return is
    }
    Issues { unknown: is.unknown, invalid: std::map::insert(is.invalid, key, (name, expected, found, span)), unsupported: is.unsupported }
}

fn iss_unsupported(is: Issues, feature: string, span: Span) -> Issues {
    if std::map::contains(is.unsupported, feature) {
        return is
    }
    Issues { unknown: is.unknown, invalid: is.invalid, unsupported: std::map::insert(is.unsupported, feature, span) }
}

fn dt_type(t, known: map, is0: Issues, span: Span) -> Issues {
    let mut is = is0
    let k = t.kind
    if k == "t_named" {
        if std::map::contains(known, t.text) {
            let mut expected = 0
            if t.text == "Array" || t.text == "Vec" {
                expected = 1
            }
            if len(t.list) != expected {
                is = iss_invalid(is, t.text, expected, len(t.list), span)
            }
        } else {
            is = iss_unknown(is, t.text, span)
        }
        for g in t.list {
            is = dt_type(g, known, is, span)
        }
        return is
    }
    if k == "t_ref" {
        is = iss_unsupported(is, "reference types", span)
        return dt_type(t.a, known, is, span)
    }
    if k == "t_slice" {
        return dt_type(t.a, known, is, span)
    }
    if k == "t_array" {
        is = iss_unsupported(is, "fixed-size array types", span)
        is = dt_type(t.a, known, is, span)
        return dt_expr(t.b, known, is)
    }
    if k == "t_tuple" {
        for el in t.list {
            is = dt_type(el, known, is, span)
        }
        return is
    }
    if k == "t_fn" {
        for p in t.list {
            is = dt_type(p, known, is, span)
        }
        return dt_type(t.a, known, is, span)
    }
    is
}

fn dt_params(params: array, known: map, is0: Issues) -> Issues {
    let mut is = is0
    for p in params {
        if p.a != nil {
            is = dt_type(p.a, known, is, p.span)
        }
        if p.b != nil {
            is = dt_expr(p.b, known, is)
        }
    }
    is
}

fn dt_pattern(p, known: map, is: Issues) -> Issues {
    let k = p.kind
    if k == "p_lit" {
        return dt_expr(p.a, known, is)
    }
    if k == "p_enum" && p.a != nil {
        return dt_pattern(p.a, known, is)
    }
    if k == "p_or" {
        return dt_pattern(p.b, known, dt_pattern(p.a, known, is))
    }
    is
}

fn dt_block(b, known: map, is0: Issues) -> Issues {
    let mut is = is0
    for s in b.list {
        if s.kind == "sexpr" {
            is = dt_expr(s.a, known, is)
        } else if s.kind == "slet" {
            if s.a != nil {
                is = dt_type(s.a, known, is, s.span)
            }
            is = dt_expr(s.b, known, is)
        } else if s.kind == "sitem" {
            is = dt_item(s.a, known, is)
        }
    }
    if b.a != nil {
        is = dt_expr(b.a, known, is)
    }
    is
}

fn dt_exprs(list: array, known: map, is0: Issues) -> Issues {
    let mut is = is0
    for x in list {
        is = dt_expr(x, known, is)
    }
    is
}

fn dt_expr(x, known: map, is: Issues) -> Issues {
    let k = x.kind
    if k == "array" || k == "tuple" {
        return dt_exprs(x.list, known, is)
    }
    if k == "structlit" {
        return dt_exprs(x.list2, known, is)
    }
    if k == "binary" || k == "range" || k == "index" || k == "assign" {
        return dt_expr(x.b, known, dt_expr(x.a, known, is))
    }
    if k == "unary" || k == "field" || k == "spawn" || k == "try" {
        return dt_expr(x.a, known, is)
    }
    if k == "call" || k == "methodcall" {
        return dt_exprs(x.list, known, dt_expr(x.a, known, is))
    }
    if k == "if" {
        let mut r = dt_block(x.b, known, dt_expr(x.a, known, is))
        if x.c != nil {
            r = dt_block(x.c, known, r)
        }
        return r
    }
    if k == "match" {
        let mut r = dt_expr(x.a, known, is)
        for arm in x.list {
            r = dt_pattern(arm.a, known, r)
            if arm.b != nil {
                r = dt_expr(arm.b, known, r)
            }
            r = dt_block(arm.c, known, r)
        }
        return r
    }
    if k == "for" {
        return dt_block(x.c, known, dt_expr(x.b, known, dt_pattern(x.a, known, is)))
    }
    if k == "while" {
        return dt_block(x.b, known, dt_expr(x.a, known, is))
    }
    if k == "loop" {
        return dt_block(x.a, known, is)
    }
    if k == "block" {
        return dt_block(x, known, is)
    }
    if k == "break" || k == "return" {
        if x.a != nil {
            return dt_expr(x.a, known, is)
        }
        return is
    }
    if k == "closure" {
        let mut r = dt_params(x.list, known, is)
        if x.a != nil {
            r = dt_type(x.a, known, r, x.span)
        }
        return dt_expr(x.b, known, r)
    }
    is
}

fn dt_methods(methods: array, known: map, is0: Issues) -> Issues {
    let mut is = is0
    for m in methods {
        is = dt_params(m.list, known, is)
        if m.b != nil {
            is = dt_type(m.b, known, is, m.span)
        }
        if m.c != nil {
            is = dt_block(m.c, known, is)
        }
    }
    is
}

fn dt_item(item, known: map, is0: Issues) -> Issues {
    let mut is = is0
    let k = item.kind
    if k == "fn" {
        return dt_methods([item], known, is)
    }
    if k == "struct" {
        for f in item.list {
            is = dt_type(f.a, known, is, f.span)
        }
        return is
    }
    if k == "enum" {
        for v in item.list {
            if v.a != nil {
                is = dt_type(v.a, known, is, v.span)
            }
        }
        return is
    }
    if k == "trait" {
        return dt_methods(item.list, known, is)
    }
    if k == "impl" {
        is = dt_type(item.b, known, is, item.span)
        return dt_methods(item.list, known, is)
    }
    if k == "const" {
        if item.a != nil {
            is = dt_type(item.a, known, is, item.span)
        }
        return dt_expr(item.b, known, is)
    }
    if k == "typealias" {
        return dt_type(item.a, known, is, item.span)
    }
    if k == "module" {
        for it in item.list {
            is = dt_item(it, known, is)
        }
    }
    is
}

// Orden: desconocidos por nombre, luego argumentos inválidos por
// (nombre, esperado, hallado), luego rasgos no soportados por nombre. Las
// claves de los mapas de Titan ya salen ordenadas (BTreeMap).
fn declared_type_errors(items: array, known: map) -> array {
    let mut is = Issues { unknown: std::map::new(), invalid: std::map::new(), unsupported: std::map::new() }
    for item in items {
        is = dt_item(item, known, is)
    }
    let mut out = []
    for name in std::map::keys(is.unknown) {
        out = std::array::push(out, (m_unknown_type(name), std::map::get(is.unknown, name)))
    }
    let invalid = sort_by(std::map::values(is.invalid), |l, r| cmp_invalid(l, r))
    for entry in invalid {
        out = std::array::push(out, (m_invalid_type_args(entry.0, entry.1, entry.2), entry.3))
    }
    for feature in std::map::keys(is.unsupported) {
        out = std::array::push(out, (m_unsupported(feature), std::map::get(is.unsupported, feature)))
    }
    out
}

fn cmp_invalid(l, r) -> int {
    if l.0 < r.0 {
        return -1
    }
    if l.0 > r.0 {
        return 1
    }
    if l.1 != r.1 {
        return l.1 - r.1
    }
    l.2 - r.2
}

fn alias_reaches(origin: string, t: Ty, aliases: map, visited: map) -> bool {
    if t.k == "Named" {
        if t.name == origin {
            return true
        }
        if !std::map::contains(aliases, t.name) {
            return false
        }
        if std::map::contains(visited, t.name) {
            return false
        }
        return alias_reaches(origin, std::map::get(aliases, t.name), aliases, std::map::insert(visited, t.name, true))
    }
    if t.k == "Array" {
        return alias_reaches(origin, t.items[0], aliases, visited)
    }
    if t.k == "Tuple" {
        for item in t.items {
            if alias_reaches(origin, item, aliases, visited) {
                return true
            }
        }
        return false
    }
    if t.k == "Function" {
        for p in t.items {
            if alias_reaches(origin, p, aliases, visited) {
                return true
            }
        }
        return alias_reaches(origin, t.ret, aliases, visited)
    }
    false
}

// ------------------------------------------------ ámbitos y flujo de control

fn push_scope(e: Env) -> Env {
    set_bindings(set_scopes(e, std::array::push(e.scopes, std::map::new())), std::array::push(e.bindings, std::map::new()))
}

fn pop_scope(e: Env) -> Env {
    let mut r = e
    if len(r.scopes) > 0 {
        r = set_scopes(r, std::array::slice(r.scopes, 0, len(r.scopes) - 1))
    }
    if len(r.bindings) > 0 {
        r = set_bindings(r, std::array::slice(r.bindings, 0, len(r.bindings) - 1))
    }
    r
}

fn define_at_depth(e: Env, name: string, t: Ty, mutable: bool, depth: int) -> Env {
    let mut r = e
    let ns = len(r.scopes)
    if ns > 0 {
        r = set_scopes(r, std::array::set(r.scopes, ns - 1, std::map::insert(r.scopes[ns - 1], name, t)))
    }
    let nb = len(r.bindings)
    if nb > 0 {
        r = set_bindings(r, std::array::set(r.bindings, nb - 1, std::map::insert(r.bindings[nb - 1], name, (mutable, depth))))
    }
    r
}

fn define_mutable(e: Env, name: string, t: Ty, mutable: bool) -> Env {
    define_at_depth(e, name, t, mutable, e.fdepth)
}

fn define(e: Env, name: string, t: Ty) -> Env {
    define_mutable(e, name, t, false)
}

// Option<Type>: nil = None.
fn lookup(e: Env, name: string) -> any {
    let mut i = len(e.scopes) - 1
    while i >= 0 {
        if std::map::contains(e.scopes[i], name) {
            return std::map::get(e.scopes[i], name)
        }
        i -= 1
    }
    nil
}

// Option<(bool, usize)>: nil = None.
fn binding(e: Env, name: string) -> any {
    let mut i = len(e.bindings) - 1
    while i >= 0 {
        if std::map::contains(e.bindings[i], name) {
            return std::map::get(e.bindings[i], name)
        }
        i -= 1
    }
    nil
}

// return_candidates.last().map(Vec::len): -1 = None.
fn cand_count(e: Env) -> int {
    if len(e.cands) == 0 {
        return -1
    }
    len(e.cands[len(e.cands) - 1])
}

// loop_breaks.last().copied(): nil = None.
fn loop_broke(e: Env) -> any {
    if len(e.breaks) == 0 {
        return nil
    }
    e.breaks[len(e.breaks) - 1]
}

fn restore_control_flow(e: Env, count: int, broke) -> Env {
    let mut r = e
    let nc = len(r.cands)
    if nc > 0 && count >= 0 {
        let last = r.cands[nc - 1]
        if count < len(last) {
            r = set_cands(r, std::array::set(r.cands, nc - 1, std::array::slice(last, 0, count)))
        }
    }
    let nb = len(r.breaks)
    if nb > 0 && broke != nil {
        r = set_breaks(r, std::array::set(r.breaks, nb - 1, broke))
    }
    r
}

fn push_candidate(e: Env, t: Ty) -> Env {
    let nc = len(e.cands)
    if nc == 0 {
        return e
    }
    set_cands(e, std::array::set(e.cands, nc - 1, std::array::push(e.cands[nc - 1], t)))
}

fn set_last_break(e: Env, v: bool) -> Env {
    let nb = len(e.breaks)
    if nb == 0 {
        return e
    }
    set_breaks(e, std::array::set(e.breaks, nb - 1, v))
}

fn pop_break(e: Env) -> (bool, Env) {
    let nb = len(e.breaks)
    if nb == 0 {
        return (false, e)
    }
    let v = e.breaks[nb - 1]
    return (v, set_breaks(e, std::array::slice(e.breaks, 0, nb - 1)))
}

// ------------------------------------------------------------- alias

fn resolve_alias(e: Env, t: Ty) -> Ty {
    if std::map::length(e.aliases) == 0 {
        return t
    }
    resolve_alias_inner(e, t, std::map::new())
}

fn resolve_alias_inner(e: Env, t: Ty, visited: map) -> Ty {
    if t.k == "Named" {
        if !std::map::contains(e.aliases, t.name) {
            return t
        }
        if std::map::contains(visited, t.name) {
            return mkt("Unknown")
        }
        return resolve_alias_inner(e, std::map::get(e.aliases, t.name), std::map::insert(visited, t.name, true))
    }
    if t.k == "Array" {
        return tarr(resolve_alias_inner(e, t.items[0], visited))
    }
    if t.k == "Tuple" {
        let mut items = []
        for item in t.items {
            items = std::array::push(items, resolve_alias_inner(e, item, visited))
        }
        return ttup(items)
    }
    if t.k == "Function" {
        let mut params = []
        for p in t.items {
            params = std::array::push(params, resolve_alias_inner(e, p, visited))
        }
        return tfn(params, resolve_alias_inner(e, t.ret, visited))
    }
    t
}

fn require_compatible(e: Env, expected: Ty, found: Ty) -> Env {
    if !compatible(resolve_alias(e, expected), resolve_alias(e, found)) {
        return err(e, m_mismatch(expected, found))
    }
    e
}

// expected: Option<Type> (nil = None).
fn branch_types_may_differ(e: Env, first: Ty, second: Ty, expected) -> bool {
    if expected != nil {
        return resolve_alias(e, expected).k == "Unknown"
    }
    resolve_alias(e, first).k == "Unit" || resolve_alias(e, second).k == "Unit"
}

fn join_branch_types(e: Env, first: Ty, second: Ty) -> Ty {
    if resolve_alias(e, first).k == "Unit" || resolve_alias(e, second).k == "Unit" {
        return mkt("Unit")
    }
    mkt("Unknown")
}

fn signatures_equal(e: Env, expected: Sig, found: Sig) -> bool {
    if len(expected.params) != len(found.params) {
        return false
    }
    let mut i = 0
    while i < len(expected.params) {
        if resolve_alias(e, expected.params[i]) != resolve_alias(e, found.params[i]) {
            return false
        }
        i += 1
    }
    resolve_alias(e, expected.result) == resolve_alias(e, found.result)
}

// --------------------------------------------------- estado inicial / reset

fn new_env() -> Env {
    new_env_with(native_table())
}

fn new_env_with(native_lines: array) -> Env {
    let base = builtin_functions()
    let variants = builtin_variants()
    Env { scopes: [std::map::new()], bindings: [std::map::new()], functions: base, base: base, structs: std::map::new(), variants: variants, base_variants: variants, constants: std::map::new(), ctypes: std::map::new(), cdecls: std::map::new(), cstack: [], checked: std::map::new(), traits: std::map::new(), aliases: std::map::new(), errors: [], ret: mkt("Unknown"), cands: [], loop_depth: 0, breaks: [], fdepth: 0, natives: load_natives_from(native_lines), cur_file: nil }
}

fn reset_analysis_state(e: Env) -> Env {
    let mut bindings = std::map::new()
    let mut constants = std::map::new()
    for name in std::map::keys(e.ctypes) {
        bindings = std::map::insert(bindings, name, (false, 0))
        constants = std::map::insert(constants, name, true)
    }
    Env { scopes: [e.ctypes], bindings: [bindings], functions: e.functions, base: e.base, structs: e.structs, variants: e.variants, base_variants: e.base_variants, constants: constants, ctypes: e.ctypes, cdecls: e.cdecls, cstack: [], checked: std::map::new(), traits: e.traits, aliases: e.aliases, errors: [], ret: mkt("Unknown"), cands: [], loop_depth: 0, breaks: [], fdepth: 0, natives: e.natives, cur_file: e.cur_file }
}

fn count_inference_targets(items: array) -> int {
    let mut n = 0
    for item in items {
        if item.kind == "fn" || item.kind == "const" {
            n += 1
        } else if item.kind == "impl" || item.kind == "trait" {
            n += len(item.list)
        } else if item.kind == "module" {
            n += count_inference_targets(item.list)
        }
    }
    n
}

// --------------------------------------------------------- recolección

fn collect_type_aliases(e: Env, items: array) -> Env {
    let mut r = e
    for item in items {
        if item.kind == "typealias" {
            r = set_aliases(r, std::map::insert(r.aliases, item.text, type_from_ast(item.a)))
        } else if item.kind == "module" {
            r = collect_type_aliases(r, item.list)
        }
    }
    r
}

fn collect_traits(e: Env, items: array) -> Env {
    let mut r = e
    for item in items {
        if item.kind == "trait" {
            r = set_traits(r, std::map::insert(r.traits, item.text, item))
        } else if item.kind == "module" {
            r = collect_traits(r, item.list)
        }
    }
    r
}

// `TypeExpr::Named { name, .. }` (con o sin genéricos) -> nombre; si no, "".
fn impl_type_name(t) -> string {
    if t.kind == "t_named" {
        return t.text
    }
    ""
}

// Parámetros con `self` sin anotar convertido en Named(tipo) (si hay tipo).
fn self_params(params: array, type_name: string) -> array {
    let mut out = []
    let mut i = 0
    while i < len(params) {
        let p = params[i]
        if i == 0 && p.text == "self" && p.a == nil && type_name != "" {
            out = std::array::push(out, tnamed(type_name))
        } else {
            out = std::array::push(out, ann_or(p.a, mkt("Unknown")))
        }
        i += 1
    }
    out
}

fn collect_declarations(e0: Env, items: array) -> Env {
    let mut e = collect_traits(collect_type_aliases(e0, items), items)
    e = collect_items(e, items)
    e
}

fn collect_items(e0: Env, items: array) -> Env {
    let mut e = e0
    for item in items {
        let k = item.kind
        if k == "fn" {
            let mut params = []
            for p in item.list {
                params = std::array::push(params, ann_or(p.a, mkt("Unknown")))
            }
            e = set_functions(e, std::map::insert(e.functions, item.text, Sig { params: params, result: ann_or(item.b, mkt("Unknown")) }))
        } else if k == "struct" {
            let mut fields = std::map::new()
            for f in item.list {
                fields = std::map::insert(fields, f.text, type_from_ast(f.a))
            }
            e = set_structs(e, std::map::insert(e.structs, item.text, fields))
        } else if k == "enum" {
            for v in item.list {
                let mut payload = []
                if v.a != nil {
                    payload = [type_from_ast(v.a)]
                }
                e = set_variants(e, std::map::insert(e.variants, item.text + "::" + v.text, payload))
            }
        } else if k == "const" {
            e = set_ctypes(e, std::map::insert(e.ctypes, item.text, ann_or(item.a, mkt("Unknown"))))
            e = set_cdecls(e, std::map::insert(e.cdecls, item.text, item))
        } else if k == "module" {
            e = collect_items(e, item.list)
        } else if k == "impl" {
            e = collect_impl(e, item)
        } else if k == "trait" {
            e = set_traits(e, std::map::insert(e.traits, item.text, item))
        }
    }
    e
}

fn collect_impl(e0: Env, block) -> Env {
    let mut e = e0
    let type_name = impl_type_name(block.b)
    let mut provided = std::map::new()
    for method in block.list {
        provided = std::map::insert(provided, method.text, true)
        let mut qualified = method.text
        if type_name != "" {
            qualified = type_name + "::" + method.text
        }
        let sig = Sig { params: self_params(method.list, type_name), result: ann_or(method.b, mkt("Unit")) }
        e = set_functions(e, std::map::insert(e.functions, qualified, sig))
    }
    if block.a == nil || type_name == "" {
        return e
    }
    let trait_name = block.a
    if !std::map::contains(e.traits, trait_name) {
        return err_at(e, m_unknown_trait(trait_name), block.span)
    }
    let trait_decl = std::map::get(e.traits, trait_name)
    for tm in trait_decl.list {
        if std::map::contains(provided, tm.text) {
            continue
        }
        let qualified = type_name + "::" + tm.text
        if tm.c != nil {
            let sig = Sig { params: self_params(tm.list, type_name), result: ann_or(tm.b, mkt("Unit")) }
            e = set_functions(e, std::map::insert(e.functions, qualified, sig))
        } else {
            e = err_at(e, m_missing_trait_method(trait_name, type_name, tm.text), block.span)
        }
    }
    e
}

// ------------------------------------------------------------ validación

// Como en Rust, los errores de declaración reciben el archivo de la ÚLTIMA
// función de nivel superior (defecto anotado en selfhost/ESTADO.md).
fn validate_declarations(e0: Env, items: array) -> Env {
    let previous = e0.cur_file
    let mut e = set_cur_file(e0, nil)
    for item in items {
        if item.kind == "fn" {
            e = set_cur_file(e, source_file_of(item))
        }
    }
    for d in declaration_errors(e.base, items) {
        e = err_at(e, d.0, d.1)
    }
    set_cur_file(e, previous)
}

// FunctionDecl::source_file: el parser deja `text2` vacío; el cargador de
// proyectos lo rellena con la ruta del archivo.
fn source_file_of(function) -> any {
    if function.text2 == "" {
        return nil
    }
    function.text2
}

// assign_error_file: solo el archivo, sin tocar las ubicaciones.
fn assign_file(e: Env, start: int) -> Env {
    let errs = e.errors
    if len(errs) <= start {
        return e
    }
    let mut out = std::array::slice(errs, 0, start)
    let mut i = start
    while i < len(errs) {
        let d = errs[i]
        if d.file == nil {
            out = std::array::push(out, Diag { msg: d.msg, span: d.span, file: e.cur_file })
        } else {
            out = std::array::push(out, d)
        }
        i += 1
    }
    set_errors(e, out)
}

fn collect_type_alias_spans(items: array, spans0: map) -> map {
    let mut spans = spans0
    for item in items {
        if item.kind == "typealias" {
            spans = std::map::insert(spans, item.text, item.span)
        } else if item.kind == "module" {
            spans = collect_type_alias_spans(item.list, spans)
        }
    }
    spans
}

// Orden de fuente (línea, columna) y luego nombre, como el Rust corregido.
fn validate_type_aliases(e0: Env, items: array) -> Env {
    let mut e = e0
    let spans = collect_type_alias_spans(items, std::map::new())
    let mut recursive = []
    for name in std::map::keys(e.aliases) {
        if alias_reaches(name, std::map::get(e.aliases, name), e.aliases, std::map::new()) {
            recursive = std::array::push(recursive, (name, std::map::get(spans, name)))
        }
    }
    let sorted = sort_by(recursive, |l, r| cmp_alias(l, r))
    for entry in sorted {
        if entry.1 != nil {
            e = err_at(e, m_recursive_alias(entry.0), entry.1)
        } else {
            e = err(e, m_recursive_alias(entry.0))
        }
    }
    e
}

// Option<(line, column)> ordena None antes que Some, como en Rust.
fn cmp_alias(l, r) -> int {
    let ls = l.1
    let rs = r.1
    if ls == nil && rs != nil {
        return -1
    }
    if ls != nil && rs == nil {
        return 1
    }
    if ls != nil && rs != nil {
        if ls.line != rs.line {
            return ls.line - rs.line
        }
        if ls.col != rs.col {
            return ls.col - rs.col
        }
    }
    if l.0 < r.0 {
        return -1
    }
    if l.0 > r.0 {
        return 1
    }
    0
}

fn validate_declared_types(e0: Env, items: array) -> Env {
    let mut e = e0
    let known = collect_declared_type_names(items, builtin_type_names(e.base))
    for d in declared_type_errors(items, known) {
        e = err_at(e, d.0, d.1)
    }
    e
}

fn validate_impl_contracts(e: Env, items: array) -> Env {
    validate_impl_contracts_in(e, items, std::map::new()).0
}

fn validate_impl_contracts_in(e0: Env, items: array, methods0: map) -> (Env, map) {
    let mut e = e0
    let mut methods = methods0
    for item in items {
        if item.kind == "module" {
            let (e2, m2) = validate_impl_contracts_in(e, item.list, methods)
            e = e2
            methods = m2
            continue
        }
        if item.kind != "impl" {
            continue
        }
        let target = direct_named_type(item.b)
        if target == "" {
            e = err_at(e, m_invalid_impl_target(type_expr_text(item.b)), item.span)
            continue
        }
        if !std::map::contains(e.structs, target) {
            e = err_at(e, m_invalid_impl_target(target), item.span)
        }
        let mut provided = std::map::new()
        for method in item.list {
            provided = std::map::insert(provided, method.text, true)
        }
        for method in item.list {
            let qualified = target + "::" + method.text
            if std::map::contains(methods, qualified) {
                e = err_at(e, m_duplicate("method", qualified), method.span)
                continue
            }
            methods = std::map::insert(methods, qualified, true)
        }
        if item.a == nil {
            continue
        }
        let trait_name = item.a
        if !std::map::contains(e.traits, trait_name) {
            continue
        }
        let trait_decl = std::map::get(e.traits, trait_name)
        let mut contracts = std::map::new()
        for tm in trait_decl.list {
            // HashMap::collect: si hay nombres repetidos gana el último.
            contracts = std::map::insert(contracts, tm.text, tm)
        }
        for method in item.list {
            if !std::map::contains(contracts, method.text) {
                e = err_at(e, m_unknown_trait_method(trait_name, method.text), method.span)
                continue
            }
            let expected = function_signature(std::map::get(contracts, method.text), target)
            let qualified = target + "::" + method.text
            let mut found = function_signature(method, target)
            if std::map::contains(e.functions, qualified) {
                found = std::map::get(e.functions, qualified)
            }
            if !signatures_equal(e, expected, found) {
                e = err_at(e, m_trait_method_mismatch(trait_name, target, method.text), method.span)
            }
        }
        for tm in trait_decl.list {
            if std::map::contains(provided, tm.text) || tm.c == nil {
                continue
            }
            let qualified = target + "::" + tm.text
            if std::map::contains(methods, qualified) {
                e = err_at(e, m_duplicate("method", qualified), item.span)
                continue
            }
            methods = std::map::insert(methods, qualified, true)
        }
    }
    return (e, methods)
}

// ------------------------------------------------------ programa completo

fn function_results(functions: map) -> map {
    let mut out = std::map::new()
    for name in std::map::keys(functions) {
        let sig = std::map::get(functions, name)
        out = std::map::insert(out, name, sig.result)
    }
    out
}

// check_program: devuelve la lista de Diag (vacía = ok).
fn check_program(items: array) -> array {
    check_program_with(items, native_table())
}

// Igual que check_program, con otra lista de nativas. El compilador nativo la
// usa para el runtime, que además tiene las operaciones `std::raw::`.
fn check_program_with(items: array, native_lines: array) -> array {
    let mut e = new_env_with(native_lines)
    e = validate_declarations(e, items)
    e = collect_declarations(e, items)
    e = validate_type_aliases(e, items)
    e = validate_declared_types(e, items)
    let mut validation = e.errors
    e = set_errors(e, [])
    let rounds = count_inference_targets(items)
    let mut round = 0
    while round <= rounds {
        let previous_functions = function_results(e.functions)
        let previous_constants = e.ctypes
        e = reset_analysis_state(e)
        e = check_constants_in(e, items)
        for item in items {
            e = check_item(e, item)
        }
        if function_results(e.functions) == previous_functions && previous_constants == e.ctypes {
            break
        }
        round += 1
    }
    e = set_errors(e, [])
    e = validate_impl_contracts(e, items)
    validation = std::array::concat(validation, e.errors)
    e = reset_analysis_state(e)
    e = set_errors(e, validation)
    e = check_constants_in(e, items)
    for item in items {
        e = check_item(e, item)
    }
    e.errors
}

// ---------------------------------------------------------------- ítems

fn fn_node(name: string, params: array, ret, body, span: Span) -> Node {
    Node { kind: "fn", text: name, text2: "", flag: false, a: nil, b: ret, c: body, list: params, list2: [], span: span }
}

// Copia de los parámetros con `self` sin anotar anotado como el tipo.
fn annotate_self(params: array, type_name: string) -> array {
    if len(params) == 0 || type_name == "" {
        return params
    }
    let first = params[0]
    if first.text != "self" || first.a != nil {
        return params
    }
    let t = Node { kind: "t_named", text: type_name, text2: "", flag: false, a: nil, b: nil, c: nil, list: [], list2: [], span: zero_span() }
    let fixed = Node { kind: first.kind, text: first.text, text2: first.text2, flag: first.flag, a: t, b: first.b, c: first.c, list: first.list, list2: first.list2, span: first.span }
    std::array::set(params, 0, fixed)
}

fn check_item(e0: Env, item) -> Env {
    let mut e = e0
    let k = item.kind
    if k == "fn" {
        return check_function(e, item)
    }
    if k == "impl" {
        let type_name = impl_type_name(item.b)
        let mut provided = std::map::new()
        for method in item.list {
            provided = std::map::insert(provided, method.text, true)
        }
        for method in item.list {
            let mut name = method.text
            if type_name != "" {
                name = type_name + "::" + method.text
            }
            let annotated = Node { kind: method.kind, text: name, text2: method.text2, flag: method.flag, a: method.a, b: method.b, c: method.c, list: annotate_self(method.list, type_name), list2: method.list2, span: method.span }
            e = check_function(e, annotated)
        }
        if item.a != nil && type_name != "" && std::map::contains(e.traits, item.a) {
            let trait_decl = std::map::get(e.traits, item.a)
            for tm in trait_decl.list {
                if std::map::contains(provided, tm.text) || tm.c == nil {
                    continue
                }
                e = check_function(e, fn_node(type_name + "::" + tm.text, annotate_self(tm.list, type_name), tm.b, tm.c, tm.span))
            }
        }
        return e
    }
    if k == "module" {
        for it in item.list {
            e = check_item(e, it)
        }
        return e
    }
    if k == "const" {
        return check_constant(e, item.text).1
    }
    e
}

fn check_constants_in(e0: Env, items: array) -> Env {
    let mut e = e0
    for item in items {
        if item.kind == "const" {
            let start = len(e.errors)
            e = check_constant(e, item.text).1
            e = assign_file(e, start)
        } else if item.kind == "module" {
            e = check_constants_in(e, item.list)
        }
    }
    e
}

fn check_constant(e0: Env, name: string) -> (Ty, Env) {
    let mut e = e0
    if std::map::contains(e.checked, name) {
        if std::map::contains(e.ctypes, name) {
            return (std::map::get(e.ctypes, name), e)
        }
        return (mkt("Unknown"), e)
    }
    let mut start = -1
    let mut i = 0
    while i < len(e.cstack) {
        if e.cstack[i] == name {
            start = i
            break
        }
        i += 1
    }
    if start >= 0 {
        let mut cycle = ""
        let mut j = start
        while j < len(e.cstack) {
            cycle += e.cstack[j] + " -> "
            j += 1
        }
        cycle += name
        return (mkt("Unknown"), err(e, m_recursive_constant(cycle)))
    }
    if !std::map::contains(e.cdecls, name) {
        return (mkt("Unknown"), e)
    }
    let constant = std::map::get(e.cdecls, name)
    e = set_cstack(e, std::array::push(e.cstack, name))
    let mut inferred = mkt("Unknown")
    if constant.a != nil {
        let declared = type_from_ast(constant.a)
        let (found, e2) = check_expr_expected(e, constant.b, declared)
        e = e2
        inferred = declared
    } else {
        let (found, e2) = check_expr(e, constant.b)
        e = e2
        inferred = found
    }
    e = set_cstack(e, std::array::slice(e.cstack, 0, len(e.cstack) - 1))
    e = set_ctypes(e, std::map::insert(e.ctypes, name, inferred))
    e = set_scopes(e, std::array::set(e.scopes, 0, std::map::insert(e.scopes[0], name, inferred)))
    e = set_bindings(e, std::array::set(e.bindings, 0, std::map::insert(e.bindings[0], name, (false, 0))))
    e = set_checked(e, std::map::insert(e.checked, name, true))
    return (inferred, e)
}

fn check_identifier(e: Env, name: string) -> (Ty, Env) {
    let mut locally_bound = false
    let mut i = 1
    while i < len(e.scopes) {
        if std::map::contains(e.scopes[i], name) {
            locally_bound = true
        }
        i += 1
    }
    if !locally_bound && std::map::contains(e.cdecls, name) {
        return check_constant(e, name)
    }
    let found = lookup(e, name)
    if found != nil {
        return (found, e)
    }
    if std::map::contains(e.base, name) {
        return (mkt("Unknown"), err(e, m_unsupported("built-in function values ('" + name + "')")))
    }
    if std::map::contains(e.functions, name) {
        let sig = std::map::get(e.functions, name)
        return (tfn(sig.params, sig.result), e)
    }
    if std::map::contains(e.variants, name) {
        let payload = std::map::get(e.variants, name)
        let sep = find_sub(name, "::")
        if len(payload) == 0 && sep >= 0 {
            return (tnamed(std::text::substring(name, 0, sep)), e)
        }
    }
    return (mkt("Unknown"), err(e, m_unknown_var(name)))
}

// Primera posición (en caracteres) de `needle` en `s`, o -1.
fn find_sub(s: string, needle: string) -> int {
    let n = len(needle)
    let mut i = 0
    while i + n <= len(s) {
        if std::text::substring(s, i, i + n) == needle {
            return i
        }
        i += 1
    }
    -1
}

fn check_function(e0: Env, function) -> Env {
    let start = len(e0.errors)
    let previous = e0.cur_file
    let e = check_function_inner(set_cur_file(e0, source_file_of(function)), function)
    // El archivo de ESTA función sigue vigente al asignar la ubicación.
    set_cur_file(assign_span(e, start, function.span), previous)
}

fn check_function_inner(e0: Env, function) -> Env {
    let mut e = push_scope(e0)
    for p in function.list {
        let param_type = ann_or(p.a, mkt("Unknown"))
        if p.b != nil {
            let (found, e2) = check_expr(e, p.b)
            e = require_compatible(e2, param_type, found)
        }
        e = define_at_depth(e, p.text, param_type, p.flag, e.fdepth + 1)
    }
    let old_return = e.ret
    let old_loop_depth = e.loop_depth
    let old_breaks = e.breaks
    e = set_ret(e, ann_or(function.b, mkt("Unknown")))
    e = set_loop_depth(e, 0)
    e = set_breaks(e, [])
    e = set_fdepth(e, e.fdepth + 1)
    e = set_cands(e, std::array::push(e.cands, []))
    let body = function.c
    if body != nil {
        let mut body_type = mkt("Unit")
        if function.b != nil {
            let (t, e2) = check_block_expected(e, body, e.ret)
            e = e2
            body_type = t
        } else {
            let (t, e2) = check_block_expected(e, body, nil)
            e = e2
            body_type = t
        }
        if function.b == nil {
            if body.a != nil {
                if body_type.k != "Never" {
                    e = push_candidate(e, body_type)
                }
            } else if body_type.k != "Never" && !block_definitely_returns(body) {
                e = push_candidate(e, mkt("Unit"))
            }
            if body_type.k == "Never" && cand_count(e) == 0 {
                e = push_candidate(e, mkt("Never"))
            }
        }
        if function.b != nil && !compatible(e.ret, mkt("Unit")) && body.a == nil && body_type.k != "Never" && !block_definitely_returns(body) {
            e = err(e, m_missing_return(function.text, e.ret))
        }
    }
    let mut candidates = []
    if len(e.cands) > 0 {
        candidates = e.cands[len(e.cands) - 1]
        e = set_cands(e, std::array::slice(e.cands, 0, len(e.cands) - 1))
    }
    if function.b == nil && body != nil {
        let (inferred, e2) = infer_return_type(e, function.text, candidates)
        e = e2
        if std::map::contains(e.functions, function.text) {
            let sig = std::map::get(e.functions, function.text)
            e = set_functions(e, std::map::insert(e.functions, function.text, Sig { params: sig.params, result: inferred }))
        }
    }
    e = set_fdepth(e, e.fdepth - 1)
    e = set_loop_depth(e, old_loop_depth)
    e = set_breaks(e, old_breaks)
    e = set_ret(e, old_return)
    pop_scope(e)
}

fn infer_return_type(e: Env, name: string, candidates: array) -> (Ty, Env) {
    if len(candidates) == 0 {
        return (mkt("Unit"), e)
    }
    let first = candidates[0]
    let first_resolved = resolve_alias(e, first)
    let mut i = 1
    while i < len(candidates) {
        let candidate = candidates[i]
        let resolved = resolve_alias(e, candidate)
        if !compatible(first_resolved, resolved) && !compatible(resolved, first_resolved) {
            if first_resolved.k == "Unit" || resolved.k == "Unit" || first_resolved.k == "Unknown" || resolved.k == "Unknown" {
                return (mkt("Unit"), e)
            }
            return (mkt("Unknown"), err(e, m_inconsistent_returns(name, first, candidate)))
        }
        i += 1
    }
    return (first, e)
}

// ---------------------------------------------------------------- bloques

// expected: Option<Type> (nil = None).
fn check_block_expected(e0: Env, block, expected) -> (Ty, Env) {
    let start = len(e0.errors)
    let (t, e) = check_block_inner(e0, block, expected)
    return (t, assign_span(e, start, block.span))
}

fn check_block(e: Env, block) -> (Ty, Env) {
    check_block_expected(e, block, nil)
}

fn check_block_inner(e0: Env, block, expected) -> (Ty, Env) {
    let mut e = push_scope(e0)
    let mut diverges = false
    for stmt in block.list {
        let was_diverged = diverges
        let count = cand_count(e)
        let broke = loop_broke(e)
        let mut st = mkt("Unit")
        let k = stmt.kind
        if k == "slet" {
            if stmt.a != nil {
                let binding_type = type_from_ast(stmt.a)
                let (vt, e2) = check_expr_expected(e, stmt.b, binding_type)
                e = define_mutable(e2, stmt.text, binding_type, stmt.flag)
                st = vt
            } else {
                let (vt, e2) = check_expr(e, stmt.b)
                e = define_mutable(e2, stmt.text, vt, stmt.flag)
                st = vt
            }
        } else if k == "sexpr" {
            let x = stmt.a
            if x.kind == "if" || x.kind == "match" {
                let (t, e2) = check_expr_expected(e, x, mkt("Unknown"))
                e = e2
                st = t
            } else {
                let (t, e2) = check_expr(e, x)
                e = e2
                st = t
            }
        } else {
            e = err(e, m_unsupported("nested declarations"))
        }
        if was_diverged {
            e = restore_control_flow(e, count, broke)
        }
        if st.k == "Never" {
            diverges = true
        }
    }
    let count = cand_count(e)
    let broke = loop_broke(e)
    let mut result = mkt("Unit")
    if block.a != nil {
        if expected != nil {
            let (t, e2) = check_expr_expected(e, block.a, expected)
            e = e2
            result = t
        } else {
            let (t, e2) = check_expr(e, block.a)
            e = e2
            result = t
        }
    }
    if diverges {
        e = restore_control_flow(e, count, broke)
    }
    e = pop_scope(e)
    if diverges {
        return (mkt("Never"), e)
    }
    return (result, e)
}

// ------------------------------------------------------------ expresiones

fn check_expr(e0: Env, x) -> (Ty, Env) {
    let start = len(e0.errors)
    let (t, e) = check_expr_inner(e0, x)
    return (t, assign_span(e, start, x.span))
}

// expected: Option<Type>; reachable: el `&mut bool` de Rust (se devuelve).
fn check_evaluated_expr(e0: Env, x, expected, reachable: bool) -> (Ty, Env, bool) {
    let count = cand_count(e0)
    let broke = loop_broke(e0)
    let mut e = e0
    let mut found = mkt("Unknown")
    if expected != nil {
        let (t, e2) = check_expr_expected(e, x, expected)
        e = e2
        found = t
    } else {
        let (t, e2) = check_expr(e, x)
        e = e2
        found = t
    }
    let mut r = reachable
    if !reachable {
        e = restore_control_flow(e, count, broke)
    } else if resolve_alias(e, found).k == "Never" {
        r = false
    }
    return (found, e, r)
}

fn check_expr_expected(e0: Env, x, expected: Ty) -> (Ty, Env) {
    let mut e = e0
    let er = resolve_alias(e, expected)
    let k = x.kind
    let mut found = mkt("Unknown")
    if k == "match" {
        let (t, e2) = check_match_expr(e, x.a, x.list, er)
        e = e2
        found = t
    } else if k == "if" {
        let (t, e2) = check_if_expr(e, x.a, x.b, x.c, er)
        e = e2
        found = t
    } else if k == "block" {
        let (t, e2) = check_block_expected(e, x, er)
        e = e2
        found = t
    } else if k == "closure" && er.k == "Function" {
        let (t, e2) = check_closure(e, x.list, x.a, x.b, er.items, er.ret)
        e = e2
        found = t
    } else if k == "array" && er.k == "Array" {
        let item = er.items[0]
        let mut reachable = true
        for el in x.list {
            let (t, e2, r2) = check_evaluated_expr(e, el, item, reachable)
            e = e2
            reachable = r2
        }
        if !reachable {
            found = mkt("Never")
        } else {
            found = tarr(item)
        }
    } else if k == "tuple" && er.k == "Tuple" && len(x.list) == len(er.items) {
        let mut reachable = true
        let mut types = []
        let mut i = 0
        while i < len(x.list) {
            let (t, e2, r2) = check_evaluated_expr(e, x.list[i], er.items[i], reachable)
            e = e2
            reachable = r2
            types = std::array::push(types, t)
            i += 1
        }
        if !reachable {
            found = mkt("Never")
        } else {
            found = ttup(types)
        }
    } else if k == "assign" && (er.k == "Unknown" || er.k == "Unit" || er.k == "Nil") {
        // Una asignación en posición de sentencia (se espera (), Nil, o el
        // resultado se descarta) vale (). En posición de valor conserva el
        // valor asignado: `let y = (x = 5)` sigue dando y == 5.
        let (t, e2) = check_assignment(e, x.a, x.text, x.b)
        e = e2
        if t.k == "Never" {
            found = mkt("Never")
        } else {
            found = mkt("Unit")
        }
    } else {
        let (t, e2) = check_expr(e, x)
        e = e2
        found = t
    }
    e = require_compatible(e, expected, found)
    return (found, e)
}

fn never_or(reachable: bool, t: Ty) -> Ty {
    if reachable {
        return t
    }
    mkt("Never")
}

fn check_expr_inner(e0: Env, x) -> (Ty, Env) {
    let mut e = e0
    let k = x.kind
    if k == "int" {
        return (mkt("Int"), e)
    }
    if k == "float" {
        return (mkt("Float"), e)
    }
    if k == "string" {
        return (mkt("String"), e)
    }
    if k == "template" {
        return check_string_template(e, x)
    }
    if k == "char" {
        return (mkt("Char"), e)
    }
    if k == "bool" {
        return (mkt("Bool"), e)
    }
    if k == "nil" {
        return (mkt("Nil"), e)
    }
    if k == "ident" {
        let (t, e2) = check_identifier(e, x.text)
        if resolve_alias(e2, t).k == "Never" {
            return (mkt("Never"), e2)
        }
        return (t, e2)
    }
    if k == "array" {
        let mut reachable = true
        let mut types = []
        for el in x.list {
            let (t, e2, r2) = check_evaluated_expr(e, el, nil, reachable)
            e = e2
            reachable = r2
            types = std::array::push(types, resolve_alias(e, t))
        }
        if !reachable {
            return (mkt("Never"), e)
        }
        let mut inner = mkt("Unknown")
        if len(types) > 0 {
            inner = types[0]
            let mut i = 1
            while i < len(types) {
                if !compatible(types[0], types[i]) {
                    inner = tnamed(mixed_name())
                    break
                }
                i += 1
            }
        }
        return (tarr(inner), e)
    }
    if k == "tuple" {
        let mut reachable = true
        let mut types = []
        for el in x.list {
            let (t, e2, r2) = check_evaluated_expr(e, el, nil, reachable)
            e = e2
            reachable = r2
            types = std::array::push(types, t)
        }
        return (never_or(reachable, ttup(types)), e)
    }
    if k == "structlit" {
        return check_struct_literal(e, x)
    }
    if k == "binary" {
        return check_binary_expr(e, x)
    }
    if k == "range" {
        let mut reachable = true
        let (a, e2, r2) = check_evaluated_expr(e, x.a, nil, reachable)
        let (b, e3, r3) = check_evaluated_expr(e2, x.b, nil, r2)
        e = require_compatible(e3, mkt("Int"), a)
        e = require_compatible(e, mkt("Int"), b)
        if resolve_alias(e, a).k == "Never" || resolve_alias(e, b).k == "Never" {
            return (mkt("Never"), e)
        }
        return (tarr(mkt("Int")), e)
    }
    if k == "unary" {
        return check_unary(e, x)
    }
    if k == "call" {
        let (result, e2) = check_call(e, x.a, x.list)
        if resolve_alias(e2, result).k == "Never" || expr_definitely_returns(x.a) || any_definitely_returns(x.list) {
            return (mkt("Never"), e2)
        }
        return (result, e2)
    }
    if k == "methodcall" {
        let (result, e2) = check_method_call(e, x.a, x.text, x.list)
        if resolve_alias(e2, result).k == "Never" || expr_definitely_returns(x.a) || any_definitely_returns(x.list) {
            return (mkt("Never"), e2)
        }
        return (result, e2)
    }
    if k == "index" {
        return check_index(e, x)
    }
    if k == "field" {
        let (raw, e2) = check_expr(e, x.a)
        e = e2
        let t = resolve_alias(e, raw)
        if t.k == "Never" {
            return (mkt("Never"), e)
        }
        if is_named(t, "map") {
            return (mkt("Unknown"), e)
        }
        if t.k == "Named" {
            if std::map::contains(e.structs, t.name) {
                let fields = std::map::get(e.structs, t.name)
                if std::map::contains(fields, x.text) {
                    return (std::map::get(fields, x.text), e)
                }
            }
            return (mkt("Unknown"), err(e, m_unknown_field(t.name, x.text)))
        }
        if t.k == "Unknown" {
            return (mkt("Unknown"), e)
        }
        return (mkt("Unknown"), err(e, m_no_fields(t)))
    }
    if k == "if" {
        return check_if_expr(e, x.a, x.b, x.c, nil)
    }
    if k == "match" {
        return check_match_expr(e, x.a, x.list, nil)
    }
    if k == "for" {
        return check_for(e, x)
    }
    if k == "while" {
        let (c, e2) = check_expr(e, x.a)
        e = require_compatible(e2, mkt("Bool"), c)
        e = set_loop_depth(e, e.loop_depth + 1)
        e = set_breaks(e, std::array::push(e.breaks, false))
        let count = cand_count(e)
        // El valor del cuerpo se descarta: se tipa en posición de sentencia.
        let (bt, e3) = check_block_expected(e, x.b, mkt("Unknown"))
        let (may_break, e4) = pop_break(e3)
        e = set_loop_depth(e4, e4.loop_depth - 1)
        let mut literal: any = nil
        if x.a.kind == "bool" {
            literal = x.a.flag
        }
        if c.k == "Never" || literal == false {
            e = restore_control_flow(e, count, nil)
        }
        if c.k == "Never" {
            return (mkt("Never"), e)
        }
        if literal == true && !may_break {
            return (mkt("Never"), e)
        }
        return (mkt("Unit"), e)
    }
    if k == "loop" {
        e = set_loop_depth(e, e.loop_depth + 1)
        e = set_breaks(e, std::array::push(e.breaks, false))
        // El valor del cuerpo se descarta: se tipa en posición de sentencia.
        let (bt, e2) = check_block_expected(e, x.a, mkt("Unknown"))
        let (may_break, e3) = pop_break(e2)
        e = set_loop_depth(e3, e3.loop_depth - 1)
        if may_break {
            return (mkt("Unit"), e)
        }
        return (mkt("Never"), e)
    }
    if k == "break" {
        let mut reaches = true
        if x.a != nil {
            let (found, e2) = check_expr(e, x.a)
            e = err(e2, m_unsupported("values carried by break"))
            reaches = resolve_alias(e, found).k != "Never"
        }
        if e.loop_depth == 0 {
            e = err(e, m_outside_loop())
        } else if reaches {
            e = set_last_break(e, true)
        }
        return (mkt("Never"), e)
    }
    if k == "continue" {
        if e.loop_depth == 0 {
            e = err(e, m_outside_loop())
        }
        return (mkt("Never"), e)
    }
    if k == "return" {
        let mut found = mkt("Unit")
        if x.a != nil {
            if e.fdepth == 0 {
                let (t, e2) = check_expr(e, x.a)
                e = e2
                found = t
            } else {
                let (t, e2) = check_expr_expected(e, x.a, e.ret)
                e = e2
                found = t
            }
        }
        if e.fdepth == 0 {
            e = err(e, m_outside_function())
        } else {
            if x.a == nil {
                e = require_compatible(e, e.ret, found)
            }
            if found.k != "Never" {
                e = push_candidate(e, found)
            }
        }
        return (mkt("Never"), e)
    }
    if k == "assign" {
        return check_assignment(e, x.a, x.text, x.b)
    }
    if k == "block" {
        return check_block(e, x)
    }
    if k == "spawn" {
        let (raw, e2) = check_expr(e, x.a)
        e = e2
        let t = resolve_alias(e, raw)
        if t.k == "Never" {
            return (mkt("Never"), e)
        }
        if t.k == "Function" {
            if len(t.items) > 0 {
                e = err(e, m_arity(0, len(t.items)))
            }
        } else {
            e = err(e, m_not_callable("spawn expression"))
        }
        return (tnamed("Task"), e)
    }
    if k == "try" {
        let (raw, e2) = check_expr(e, x.a)
        e = e2
        let t = resolve_alias(e, raw)
        if t.k == "Never" {
            return (mkt("Never"), e)
        }
        if is_named(t, "Option") || is_named(t, "Result") {
            let wrapped = tnamed(t.name)
            if e.fdepth == 0 {
                e = err(e, m_outside_function())
            } else {
                e = require_compatible(e, e.ret, wrapped)
                e = push_candidate(e, wrapped)
            }
            return (mkt("Unknown"), e)
        }
        return (mkt("Unknown"), err(e, m_invalid_try()))
    }
    if k == "closure" {
        return check_closure(e, x.list, x.a, x.b, nil, nil)
    }
    return (mkt("Unknown"), e)
}

fn any_definitely_returns(list: array) -> bool {
    for x in list {
        if expr_definitely_returns(x) {
            return true
        }
    }
    false
}

fn check_struct_literal(e0: Env, x) -> (Ty, Env) {
    let mut e = e0
    let name = x.text
    let mut reachable = true
    if std::map::contains(e.structs, name) {
        let expected_fields = std::map::get(e.structs, name)
        let mut supplied = std::map::new()
        let mut i = 0
        while i < len(x.list) {
            let field = x.list[i]
            let value = x.list2[i]
            if std::map::contains(supplied, field) {
                e = err(e, m_duplicate_field(name, field))
            } else {
                supplied = std::map::insert(supplied, field, true)
            }
            if std::map::contains(expected_fields, field) {
                let (t, e2, r2) = check_evaluated_expr(e, value, std::map::get(expected_fields, field), reachable)
                e = e2
                reachable = r2
            } else {
                let (t, e2, r2) = check_evaluated_expr(e, value, nil, reachable)
                e = err(e2, m_unknown_field(name, field))
                reachable = r2
            }
            i += 1
        }
        // Orden alfabético (las claves de los mapas de Titan salen ordenadas),
        // igual que el Rust corregido.
        for field in std::map::keys(expected_fields) {
            if !std::map::contains(supplied, field) {
                e = err(e, m_missing_field(name, field))
            }
        }
    } else {
        e = err(e, m_unknown_type(name))
        for value in x.list2 {
            let (t, e2, r2) = check_evaluated_expr(e, value, nil, reachable)
            e = e2
            reachable = r2
        }
    }
    if !reachable {
        return (mkt("Never"), e)
    }
    return (tnamed(name), e)
}

fn check_binary_expr(e0: Env, x) -> (Ty, Env) {
    let op = x.text
    let (lt0, e1, r1) = check_evaluated_expr(e0, x.a, nil, true)
    let mut e = e1
    let mut reachable = r1
    // lazy_right: nil = None, true/false = Some.
    let mut lazy_right: any = nil
    if lazy_rhs_is_skipped(op, x.a) {
        lazy_right = false
    } else if lazy_rhs_is_guaranteed(op, x.a) {
        lazy_right = true
    }
    let mut rt0 = mkt("Unknown")
    if lazy_right == false {
        let (t, e2, r2) = check_evaluated_expr(e, x.b, nil, false)
        e = e2
        rt0 = t
    } else {
        let (t, e2, r2) = check_evaluated_expr(e, x.b, nil, reachable)
        e = e2
        reachable = r2
        rt0 = t
    }
    let lt = resolve_alias(e, lt0)
    let rt = resolve_alias(e, rt0)
    let lazy = op == "LazyAnd" || op == "LazyOr"
    if lt.k == "Never" || (rt.k == "Never" && (!lazy || lazy_right == true)) {
        return (mkt("Never"), e)
    }
    check_binary(e, op, lt, rt)
}

fn check_unary(e0: Env, x) -> (Ty, Env) {
    let (raw, e1) = check_expr(e0, x.a)
    let mut e = e1
    let t = resolve_alias(e, raw)
    if t.k == "Never" {
        return (mkt("Never"), e)
    }
    let op = x.text
    if op == "Not" {
        return (mkt("Bool"), require_compatible(e, mkt("Bool"), t))
    }
    if op == "Neg" {
        if !is_numeric(t) {
            return (mkt("Unknown"), err(e, m_invalid_unary("Neg", t)))
        }
        return (t, e)
    }
    if op == "BitNot" {
        if !compatible(mkt("Int"), t) {
            return (mkt("Unknown"), err(e, m_invalid_unary("BitNot", t)))
        }
        return (mkt("Int"), e)
    }
    return (mkt("Unknown"), err(e, m_unsupported("references and dereferencing")))
}

fn check_index(e0: Env, x) -> (Ty, Env) {
    let (traw, e1, r1) = check_evaluated_expr(e0, x.a, nil, true)
    let tt = resolve_alias(e1, traw)
    let (it, e2, r2) = check_evaluated_expr(e1, x.b, nil, r1)
    let mut e = e2
    if tt.k == "Never" || it.k == "Never" {
        return (mkt("Never"), e)
    }
    if tt.k == "Array" {
        return (tt.items[0], require_compatible(e, mkt("Int"), it))
    }
    if tt.k == "Tuple" {
        e = require_compatible(e, mkt("Int"), it)
        if x.b.kind == "int" {
            let value = x.b.a
            if value >= 0 && value < len(tt.items) {
                return (tt.items[value], e)
            }
            return (mkt("Unknown"), err(e, m_index_oob(value, len(tt.items))))
        }
        return (common_or_unknown(tt.items), e)
    }
    if tt.k == "String" {
        return (mkt("Char"), require_compatible(e, mkt("Int"), it))
    }
    if is_named(tt, "bytes") {
        return (mkt("Int"), require_compatible(e, mkt("Int"), it))
    }
    if is_named(tt, "map") {
        return (mkt("Unknown"), require_compatible(e, mkt("String"), it))
    }
    if tt.k == "Unknown" {
        return (mkt("Unknown"), e)
    }
    return (mkt("Unknown"), err(e, m_not_indexable(tt)))
}

fn check_for(e0: Env, x) -> (Ty, Env) {
    let mut e = e0
    let pattern = x.a
    if pattern.kind != "p_ident" && pattern.kind != "p_wild" {
        e = err(e, m_unsupported("destructuring patterns in for loops"))
    }
    let (raw, e2) = check_expr(e, x.b)
    e = e2
    let it = resolve_alias(e, raw)
    let mut item = mkt("Unknown")
    if it.k == "Never" {
        item = mkt("Never")
    } else if it.k == "Array" {
        item = it.items[0]
    } else if it.k == "Tuple" {
        item = common_or_unknown(it.items)
    } else if it.k == "String" {
        item = mkt("Char")
    } else if is_named(it, "bytes") {
        item = mkt("Int")
    } else if it.k != "Unknown" {
        e = err(e, m_not_iterable(it))
    }
    e = push_scope(e)
    e = bind_pattern(e, pattern, item)
    e = set_loop_depth(e, e.loop_depth + 1)
    e = set_breaks(e, std::array::push(e.breaks, false))
    let count = cand_count(e)
    // El valor del cuerpo se descarta: se tipa en posición de sentencia
    // (un `if` con ramas de tipos distintos al final del cuerpo es legal,
    // igual que como sentencia suelta).
    let (bt, e3) = check_block_expected(e, x.c, mkt("Unknown"))
    let (b, e4) = pop_break(e3)
    e = set_loop_depth(e4, e4.loop_depth - 1)
    e = pop_scope(e)
    if it.k == "Never" {
        return (mkt("Never"), restore_control_flow(e, count, nil))
    }
    return (mkt("Unit"), e)
}

// ------------------------------------------------------------------- if

fn check_if_expr(e0: Env, condition, then_branch, else_branch, expected) -> (Ty, Env) {
    let (ct, e1) = check_expr(e0, condition)
    let mut e = require_compatible(e1, mkt("Bool"), ct)
    let condition_never = resolve_alias(e, ct).k == "Never"
    let mut literal: any = nil
    if condition.kind == "bool" {
        literal = condition.flag
    }
    let count = cand_count(e)
    let broke = loop_broke(e)
    let mut then_expected: any = nil
    if expected != nil && else_branch != nil && !condition_never && literal != false {
        then_expected = expected
    }
    let (then_type, e2) = check_block_expected(e, then_branch, then_expected)
    e = e2
    let then_count = cand_count(e)
    let then_broke = loop_broke(e)
    if condition_never || literal == false {
        e = restore_control_flow(e, count, broke)
    }
    if else_branch != nil {
        let mut else_expected: any = nil
        if expected != nil && !condition_never && literal != true {
            else_expected = expected
        }
        let (else_type, e3) = check_block_expected(e, else_branch, else_expected)
        e = e3
        if condition_never {
            return (mkt("Never"), restore_control_flow(e, count, broke))
        }
        if literal == true {
            return (then_type, restore_control_flow(e, then_count, then_broke))
        }
        if literal == false {
            return (else_type, e)
        }
        if then_type.k == "Never" {
            return (else_type, e)
        }
        if else_type.k == "Never" {
            return (then_type, e)
        }
        if compatible(resolve_alias(e, then_type), resolve_alias(e, else_type)) {
            return (then_type, e)
        }
        if branch_types_may_differ(e, then_type, else_type, expected) {
            return (join_branch_types(e, then_type, else_type), e)
        }
        return (mkt("Unknown"), err(e, m_mismatch(then_type, else_type)))
    }
    if condition_never {
        return (mkt("Never"), e)
    }
    if literal == true && then_type.k == "Never" {
        return (mkt("Never"), e)
    }
    return (mkt("Unit"), e)
}

// ---------------------------------------------------------------- match

// Dominio: kind "Empty" | "Bool" | "Enum" (name, variants: conjunto) | "Open".
struct Domain {
    kind: string,
    name: string,
    variants: map,
}

// Cobertura de un patrón o de un match: all + conjunto de átomos. Átomos:
// "b:true", "e:<variante>", "i:<n>", "s:<texto>", "c:<char>", "nil".
struct Cov {
    all: bool,
    atoms: map,
}

fn enum_variant_names(e: Env, enumeration: string) -> map {
    let prefix = enumeration + "::"
    let n = len(prefix)
    let mut out = std::map::new()
    for qualified in std::map::keys(e.variants) {
        if std::text::starts_with(qualified, prefix) {
            out = std::map::insert(out, std::text::substring(qualified, n, len(qualified)), true)
        }
    }
    out
}

fn match_domain(e: Env, subject: Ty) -> Domain {
    let t = resolve_alias(e, subject)
    if t.k == "Never" {
        return Domain { kind: "Empty", name: "", variants: std::map::new() }
    }
    if t.k == "Bool" {
        return Domain { kind: "Bool", name: "", variants: std::map::new() }
    }
    if t.k == "Named" {
        let variants = enum_variant_names(e, t.name)
        if std::map::length(variants) > 0 {
            return Domain { kind: "Enum", name: t.name, variants: variants }
        }
    }
    Domain { kind: "Open", name: "", variants: std::map::new() }
}

// Átomo de un literal según el dominio, o "" si no aplica.
fn literal_atom(d: Domain, v) -> string {
    if d.kind == "Bool" && v.kind == "bool" {
        if v.flag {
            return "b:true"
        }
        return "b:false"
    }
    if d.kind == "Open" {
        if v.kind == "int" {
            let n = v.a
            return "i:{n}"
        }
        if v.kind == "string" {
            return "s:" + v.text
        }
        if v.kind == "char" {
            return "c:" + v.text
        }
        if v.kind == "nil" {
            return "nil"
        }
    }
    ""
}

// Option<MatchAtom>: "" = None.
fn known_match_atom(e: Env, x, d: Domain) -> string {
    if d.kind == "Bool" || d.kind == "Open" {
        return literal_atom(d, x)
    }
    if d.kind != "Enum" {
        return ""
    }
    if x.kind == "ident" {
        let sep = find_sub(x.text, "::")
        if sep < 0 {
            return ""
        }
        let found_enum = std::text::substring(x.text, 0, sep)
        let variant = std::text::substring(x.text, sep + 2, len(x.text))
        if found_enum == d.name && std::map::contains(d.variants, variant) && std::map::contains(e.variants, x.text) && len(std::map::get(e.variants, x.text)) == 0 {
            return "e:" + variant
        }
        return ""
    }
    if x.kind == "call" {
        if x.a.kind != "ident" {
            return ""
        }
        let name = x.a.text
        let sep = find_sub(name, "::")
        if sep < 0 || !std::map::contains(e.variants, name) {
            return ""
        }
        let found_enum = std::text::substring(name, 0, sep)
        let variant = std::text::substring(name, sep + 2, len(name))
        let payload = std::map::get(e.variants, name)
        if found_enum == d.name && std::map::contains(d.variants, variant) && len(x.list) == len(payload) {
            return "e:" + variant
        }
    }
    ""
}

fn pattern_is_catchall(p) -> bool {
    if p.kind == "p_wild" || p.kind == "p_ident" {
        return true
    }
    if p.kind == "p_or" {
        return pattern_is_catchall(p.a) || pattern_is_catchall(p.b)
    }
    false
}

fn match_pattern_is_lowerable(p) -> bool {
    let k = p.kind
    if k == "p_wild" || k == "p_ident" || k == "p_lit" {
        return true
    }
    if k == "p_enum" {
        if p.a == nil {
            return true
        }
        return p.a.kind == "p_wild" || p.a.kind == "p_ident"
    }
    false
}

// Option<PatternCoverage>: nil = None.
fn pattern_coverage(e: Env, p, d: Domain) -> any {
    let k = p.kind
    if k == "p_wild" || k == "p_ident" {
        return Cov { all: true, atoms: std::map::new() }
    }
    if k == "p_lit" {
        let atom = literal_atom(d, p.a)
        if atom == "" {
            return nil
        }
        return Cov { all: false, atoms: std::map::insert(std::map::new(), atom, true) }
    }
    if k == "p_enum" {
        if d.kind != "Enum" || p.text != d.name || !std::map::contains(d.variants, p.text2) {
            return nil
        }
        let qualified = p.text + "::" + p.text2
        let mut covers = false
        if std::map::contains(e.variants, qualified) {
            let payload = std::map::get(e.variants, qualified)
            if len(payload) == 0 && p.a == nil {
                covers = true
            } else if len(payload) > 0 && p.a != nil {
                covers = pattern_is_catchall(p.a)
            }
        }
        if !covers {
            return nil
        }
        return Cov { all: false, atoms: std::map::insert(std::map::new(), "e:" + p.text2, true) }
    }
    if k == "p_or" {
        let left = pattern_coverage(e, p.a, d)
        if left == nil {
            return nil
        }
        let right = pattern_coverage(e, p.b, d)
        if right == nil {
            return nil
        }
        return Cov { all: left.all || right.all, atoms: map_union(left.atoms, right.atoms) }
    }
    nil
}

fn map_union(a: map, b: map) -> map {
    let mut out = a
    for key in std::map::keys(b) {
        out = std::map::insert(out, key, true)
    }
    out
}

fn cov_is_complete(c: Cov, d: Domain) -> bool {
    if c.all {
        return true
    }
    if d.kind == "Empty" {
        return true
    }
    if d.kind == "Bool" {
        return std::map::contains(c.atoms, "b:false") && std::map::contains(c.atoms, "b:true")
    }
    if d.kind == "Enum" {
        for v in std::map::keys(d.variants) {
            if !std::map::contains(c.atoms, "e:" + v) {
                return false
            }
        }
        return true
    }
    false
}

fn cov_covers(c: Cov, p: Cov, d: Domain) -> bool {
    if c.all {
        return true
    }
    if p.all {
        return cov_is_complete(c, d)
    }
    if std::map::length(p.atoms) == 0 {
        return false
    }
    for atom in std::map::keys(p.atoms) {
        if !std::map::contains(c.atoms, atom) {
            return false
        }
    }
    true
}

fn check_match_coverage(e0: Env, subject: Ty, arms: array) -> Env {
    let mut e = e0
    let d = match_domain(e, subject)
    let mut cov = Cov { all: false, atoms: std::map::new() }
    let mut index = 0
    while index < len(arms) {
        let arm = arms[index]
        let p = pattern_coverage(e, arm.a, d)
        let unreachable = d.kind == "Empty" || cov.all || (p != nil && cov_covers(cov, p, d))
        if unreachable {
            e = err(e, m_unreachable_pattern(index + 1))
        }
        if arm.b == nil && p != nil {
            cov = Cov { all: cov.all || p.all, atoms: map_union(cov.atoms, p.atoms) }
        }
        index += 1
    }
    if d.kind == "Bool" {
        if !cov_is_complete(cov, d) {
            e = err(e, m_non_exhaustive())
        }
    } else if d.kind == "Enum" {
        if !cov.all {
            let mut missing = []
            for v in std::map::keys(d.variants) {
                if !std::map::contains(cov.atoms, "e:" + v) {
                    missing = std::array::push(missing, v)
                }
            }
            if len(missing) > 0 {
                e = err(e, m_non_exhaustive_enum(d.name, missing))
            }
        }
    } else if d.kind == "Open" {
        if !cov.all {
            e = err(e, m_non_exhaustive())
        }
    }
    e
}

fn check_match_expr(e0: Env, scrutinee, arms: array, expected) -> (Ty, Env) {
    let (subject, e1) = check_expr(e0, scrutinee)
    let mut e = check_match_coverage(e1, subject, arms)
    let subject_never = resolve_alias(e, subject).k == "Never"
    let d = match_domain(e, subject)
    let known = known_match_atom(e, scrutinee, d)
    let count = cand_count(e)
    let broke = loop_broke(e)
    let mut known_open = known != ""
    // result: Option<Type> (nil = None).
    let mut result: any = nil
    for arm in arms {
        if !match_pattern_is_lowerable(arm.a) {
            e = err(e, m_unsupported("or-patterns and nested destructuring in match"))
        }
        let arm_count = cand_count(e)
        let arm_broke = loop_broke(e)
        let mut arm_reachable = !subject_never
        if arm_reachable && known != "" {
            if !known_open {
                arm_reachable = false
            } else {
                let p = pattern_coverage(e, arm.a, d)
                arm_reachable = p != nil && (p.all || std::map::contains(p.atoms, known))
            }
        }
        e = push_scope(e)
        e = bind_pattern(e, arm.a, subject)
        let mut guard_never = false
        let mut guard_literal: any = nil
        if arm.b != nil {
            let (gt, e2) = check_expr(e, arm.b)
            e = require_compatible(e2, mkt("Bool"), gt)
            if arm.b.kind == "bool" {
                guard_literal = arm.b.flag
            }
            guard_never = resolve_alias(e, gt).k == "Never"
        }
        let body_reachable = arm_reachable && !guard_never && guard_literal != false
        let body_count = cand_count(e)
        let body_broke = loop_broke(e)
        let mut body_expected: any = nil
        if body_reachable {
            body_expected = expected
        }
        let (body_type, e3) = check_block_expected(e, arm.c, body_expected)
        e = e3
        if !arm_reachable {
            e = restore_control_flow(e, arm_count, arm_broke)
        } else if !body_reachable {
            e = restore_control_flow(e, body_count, body_broke)
        }
        let mut found: any = nil
        if !arm_reachable || guard_literal == false {
            found = nil
        } else if guard_never {
            found = mkt("Never")
        } else {
            found = body_type
        }
        if found != nil {
            if result == nil {
                result = found
            } else if result.k == "Never" {
                result = found
            } else if found.k == "Never" {
                result = result
            } else if compatible(resolve_alias(e, result), resolve_alias(e, found)) {
                result = result
            } else if branch_types_may_differ(e, result, found, expected) {
                result = join_branch_types(e, result, found)
            } else {
                e = err(e, m_mismatch(result, found))
                result = mkt("Unknown")
            }
        }
        if known != "" && arm_reachable {
            if guard_never || arm.b == nil || guard_literal == true {
                known_open = false
            }
        }
        e = pop_scope(e)
    }
    if subject_never {
        return (mkt("Never"), restore_control_flow(e, count, broke))
    }
    if result == nil {
        return (mkt("Unknown"), e)
    }
    return (result, e)
}

fn pattern_binding_names(p) -> map {
    let k = p.kind
    if k == "p_ident" {
        return std::map::insert(std::map::new(), p.text, true)
    }
    if k == "p_enum" && p.a != nil {
        return pattern_binding_names(p.a)
    }
    if k == "p_or" {
        return map_union(pattern_binding_names(p.a), pattern_binding_names(p.b))
    }
    std::map::new()
}

fn last_scope(e: Env) -> map {
    if len(e.scopes) == 0 {
        return std::map::new()
    }
    e.scopes[len(e.scopes) - 1]
}

fn last_bindings(e: Env) -> map {
    if len(e.bindings) == 0 {
        return std::map::new()
    }
    e.bindings[len(e.bindings) - 1]
}

fn replace_last_scope(e: Env, scope: map, bindings: map) -> Env {
    let mut r = e
    if len(r.scopes) > 0 {
        r = set_scopes(r, std::array::set(r.scopes, len(r.scopes) - 1, scope))
    }
    if len(r.bindings) > 0 {
        r = set_bindings(r, std::array::set(r.bindings, len(r.bindings) - 1, bindings))
    }
    r
}

fn bind_pattern(e0: Env, p, subject: Ty) -> Env {
    let mut e = e0
    let k = p.kind
    if k == "p_wild" {
        return e
    }
    if k == "p_ident" {
        return define(e, p.text, subject)
    }
    if k == "p_lit" {
        let (found, e2) = check_expr(e, p.a)
        return require_compatible(e2, subject, found)
    }
    if k == "p_or" {
        let original = last_scope(e)
        let original_bindings = last_bindings(e)
        e = bind_pattern(e, p.a, subject)
        let left_scope = last_scope(e)
        let left_names = pattern_binding_names(p.a)
        e = replace_last_scope(e, original, original_bindings)
        e = bind_pattern(e, p.b, subject)
        let right_scope = last_scope(e)
        let right_names = pattern_binding_names(p.b)
        e = replace_last_scope(e, original, original_bindings)
        if left_names != right_names {
            e = err(e, m_invalid_pattern("both sides of an or-pattern must bind the same names"))
        }
        for name in std::map::keys(left_names) {
            if !std::map::contains(right_names, name) {
                continue
            }
            let mut lt = mkt("Unknown")
            if std::map::contains(left_scope, name) {
                lt = std::map::get(left_scope, name)
            }
            let mut rt = mkt("Unknown")
            if std::map::contains(right_scope, name) {
                rt = std::map::get(right_scope, name)
            }
            e = require_compatible(e, lt, rt)
            e = define(e, name, lt)
        }
        return e
    }
    // p_enum
    let name = p.text
    let variant = p.text2
    e = require_compatible(e, tnamed(name), subject)
    let qualified = name + "::" + variant
    if std::map::contains(e.variants, qualified) {
        let payload = std::map::get(e.variants, qualified)
        if len(payload) > 0 && p.a != nil {
            return bind_pattern(e, p.a, payload[0])
        }
        if len(payload) == 0 && p.a != nil {
            e = err(e, m_invalid_pattern("variant '" + name + "::" + variant + "' has no payload"))
            return bind_pattern(e, p.a, mkt("Unknown"))
        }
        if len(payload) > 0 && p.a == nil {
            return err(e, m_invalid_pattern("variant '" + name + "::" + variant + "' requires a payload pattern"))
        }
        return e
    }
    e = err(e, m_unknown_variant(name, variant))
    if p.a != nil {
        e = bind_pattern(e, p.a, mkt("Unknown"))
    }
    e
}

// -------------------------------------------------------------- closures

// declared_return: nodo de tipo o nil; contextual_params: array o nil;
// contextual_result: Ty o nil.
fn check_closure(e0: Env, params: array, declared_return, body, contextual_params, contextual_result) -> (Ty, Env) {
    let mut e = e0
    if contextual_params != nil && len(params) != len(contextual_params) {
        e = err(e, m_arity(len(contextual_params), len(params)))
    }
    let mut names = std::map::new()
    for p in params {
        if std::map::contains(names, p.text) {
            e = err(e, m_duplicate("closure parameter", p.text))
            continue
        }
        names = std::map::insert(names, p.text, true)
    }
    e = push_scope(e)
    let mut parameter_types = []
    let mut i = 0
    while i < len(params) {
        let p = params[i]
        if p.a != nil {
            parameter_types = std::array::push(parameter_types, type_from_ast(p.a))
        } else if contextual_params != nil && i < len(contextual_params) {
            parameter_types = std::array::push(parameter_types, contextual_params[i])
        } else {
            parameter_types = std::array::push(parameter_types, mkt("Unknown"))
        }
        i += 1
    }
    i = 0
    while i < len(params) {
        e = define_at_depth(e, params[i].text, parameter_types[i], params[i].flag, e.fdepth + 1)
        i += 1
    }
    // declared_result: Option<Type>.
    let mut declared_result: any = nil
    if declared_return != nil {
        declared_result = type_from_ast(declared_return)
    }
    let mut expected_result = mkt("Unknown")
    if declared_result != nil {
        expected_result = declared_result
    } else if contextual_result != nil {
        expected_result = contextual_result
    }
    let old_return = e.ret
    let old_loop_depth = e.loop_depth
    let old_breaks = e.breaks
    e = set_ret(e, expected_result)
    e = set_loop_depth(e, 0)
    e = set_breaks(e, [])
    e = set_fdepth(e, e.fdepth + 1)
    e = set_cands(e, std::array::push(e.cands, []))
    let (actual, e2) = check_expr(e, body)
    e = e2
    if actual.k != "Never" {
        e = push_candidate(e, actual)
    }
    let mut candidates = []
    if len(e.cands) > 0 {
        candidates = e.cands[len(e.cands) - 1]
        e = set_cands(e, std::array::slice(e.cands, 0, len(e.cands) - 1))
    }
    e = set_fdepth(e, e.fdepth - 1)
    e = set_loop_depth(e, old_loop_depth)
    e = set_breaks(e, old_breaks)
    e = set_ret(e, old_return)
    let mut result = mkt("Unknown")
    if declared_result != nil {
        result = declared_result
    } else if contextual_result != nil {
        result = contextual_result
    } else if actual.k == "Never" && len(candidates) == 0 {
        result = mkt("Never")
    } else {
        let (t, e3) = infer_return_type(e, "closure", candidates)
        e = e3
        result = t
    }
    e = require_compatible(e, result, actual)
    e = pop_scope(e)
    return (tfn(parameter_types, result), e)
}

// ------------------------------------------------------ plantillas "{x}"

fn is_template_path(value: string) -> bool {
    if value == "" {
        return false
    }
    // `::` se trata como `.`; cada segmento: (_|letra)(_|alfanumérico)*.
    let mut segment = ""
    let mut segments = []
    let chars = std::text::chars(value)
    let mut i = 0
    while i < len(chars) {
        let c = chars[i]
        if c == ':' && i + 1 < len(chars) && chars[i + 1] == ':' {
            segments = std::array::push(segments, segment)
            segment = ""
            i += 2
            continue
        }
        if c == '.' {
            segments = std::array::push(segments, segment)
            segment = ""
            i += 1
            continue
        }
        segment += c
        i += 1
    }
    segments = std::array::push(segments, segment)
    for s in segments {
        if s == "" {
            return false
        }
        let mut first = true
        for c in s {
            if first {
                if c != '_' && !std::text::is_alphabetic(c) {
                    return false
                }
                first = false
            } else if c != '_' && !std::text::is_alphanumeric(c) {
                return false
            }
        }
    }
    true
}

// `str::parse::<i64>()`: signo opcional y dígitos ASCII, sin desbordar.
// Devuelve (ok, valor).
fn parse_i64_strict(s: string) -> (bool, int) {
    let chars = std::text::chars(s)
    if len(chars) == 0 {
        return (false, 0)
    }
    let mut i = 0
    let mut negative = false
    if chars[0] == '+' || chars[0] == '-' {
        negative = chars[0] == '-'
        i = 1
    }
    if i >= len(chars) {
        return (false, 0)
    }
    let mut digits = ""
    while i < len(chars) {
        let c = chars[i]
        if c < '0' || c > '9' {
            return (false, 0)
        }
        digits += c
        i += 1
    }
    // Quitar ceros a la izquierda para comparar longitudes.
    let mut start = 0
    while start < len(digits) - 1 && std::text::substring(digits, start, start + 1) == "0" {
        start += 1
    }
    let d = std::text::substring(digits, start, len(digits))
    let mut limit = "9223372036854775807"
    if negative {
        limit = "9223372036854775808"
    }
    if len(d) > len(limit) || (len(d) == len(limit) && d > limit) {
        return (false, 0)
    }
    if negative && d == "9223372036854775808" {
        return (true, -9223372036854775807 - 1)
    }
    let mut v = 0
    for c in d {
        v = v * 10 + (std::text::char_code(c) - 48)
    }
    if negative {
        return (true, -v)
    }
    return (true, v)
}

fn synth_node(kind: string, text: string, value) -> Node {
    Node { kind: kind, text: text, text2: "", flag: false, a: value, b: nil, c: nil, list: [], list2: [], span: zero_span() }
}

fn is_local_binding(e: Env, name: string) -> bool {
    let mut i = len(e.scopes) - 1
    while i >= 1 {
        if std::map::contains(e.scopes[i], name) {
            return true
        }
        i -= 1
    }
    false
}

fn is_global_constant_binding(e: Env, name: string) -> bool {
    let mut i = len(e.scopes) - 1
    while i >= 0 {
        if std::map::contains(e.scopes[i], name) {
            return i == 0 && std::map::contains(e.constants, name)
        }
        i -= 1
    }
    false
}

// Un grupo `{...}` de la gramática antigua: un local, una constante o una llamada `f(a, 1)`.
// Devuelve (entorno, ¿diverge?).
fn check_old_group(e0: Env, source: string) -> (Env, bool) {
    let mut e = e0
    let mut diverges = false
    let open_call = find_sub(source, "(")
    if open_call >= 0 {
        if !std::text::ends_with(source, ")") {
            e = err(e, m_invalid_interpolation(source))
        } else {
            let name = std::text::trim(std::text::substring(source, 0, open_call))
            let arguments = std::text::substring(source, open_call + 1, len(source) - 1)
            if !is_template_path(name) {
                e = err(e, m_invalid_interpolation(source))
            } else {
                let mut args = []
                let mut valid = true
                for raw in split_on(arguments, ',') {
                    let argument = std::text::trim(raw)
                    if argument == "" {
                        continue
                    }
                    let (ok, value) = parse_i64_strict(argument)
                    if ok {
                        args = std::array::push(args, synth_node("int", "", value))
                        continue
                    }
                    if is_template_path(argument) && is_local_binding(e, argument) {
                        args = std::array::push(args, synth_node("ident", argument, nil))
                        continue
                    }
                    valid = false
                    e = err(e, m_invalid_interpolation(argument))
                }
                if valid {
                    let exists = is_local_binding(e, name) || std::map::contains(e.cdecls, name) || std::map::contains(e.functions, name) || std::map::contains(e.variants, name) || std::map::contains(e.natives, name)
                    if exists {
                        let (result, e2) = check_call(e, synth_node("ident", name, nil), args)
                        e = e2
                        if resolve_alias(e, result).k == "Never" {
                            diverges = true
                        }
                    } else {
                        e = err(e, m_invalid_interpolation(source))
                    }
                }
            }
        }
    } else if is_template_path(source) {
        if is_local_binding(e, source) || std::map::contains(e.cdecls, source) {
            let (result, e2) = check_expr(e, synth_node("ident", source, nil))
            e = e2
            if resolve_alias(e, result).k == "Never" {
                diverges = true
            }
        } else {
            e = err(e, m_invalid_interpolation(source))
        }
    } else {
        e = err(e, m_invalid_interpolation(source))
    }
    return (e, diverges)
}

// Texto con `{...}`: los segmentos los dejó listos el parser (ver template_segments en parser.titan).
fn check_string_template(e0: Env, node) -> (Ty, Env) {
    let mut e = e0
    let mut diverges = false
    for seg in node.list {
        let k = seg.kind
        if k == "told" {
            let (e2, d) = check_old_group(e, seg.text)
            e = e2
            if d {
                diverges = true
            }
        } else if k == "tnew" {
            let (result, e2) = check_expr(e, seg.a)
            e = e2
            if resolve_alias(e, result).k == "Never" {
                diverges = true
            }
        } else if k == "tbad" {
            e = err(e, m_invalid_interpolation(seg.text))
        } else if k == "topen" {
            e = err(e, m_invalid_interpolation(node.text))
        }
    }
    if diverges {
        return (mkt("Never"), e)
    }
    return (mkt("String"), e)
}

// ---------------------------------------------------------- métodos

fn unknown_method_result(e: Env, receiver: Ty, method: string, reachable: bool) -> (Ty, Env) {
    return (never_or(reachable, mkt("Unknown")), err(e, m_unknown_method(receiver, method)))
}

fn check_method_call(e0: Env, receiver, method: string, args: array) -> (Ty, Env) {
    let (rraw, e1, r1) = check_evaluated_expr(e0, receiver, nil, true)
    let mut e = e1
    let mut reachable = r1
    let rt = resolve_alias(e, rraw)
    if rt.k == "Never" {
        for a in args {
            let (t, e2, r2) = check_evaluated_expr(e, a, nil, reachable)
            e = e2
            reachable = r2
        }
        return (mkt("Never"), e)
    }
    let (handled, ut, e2, r2) = check_user_method_call(e, rt, method, args, reachable)
    if handled {
        return (ut, e2)
    }
    let na = len(args)
    if method == "len" && na == 0 {
        if is_length_supported(rt) {
            return (mkt("Int"), e)
        }
        return (mkt("Unknown"), err(e, m_unknown_method(rt, method)))
    }
    if (method == "map" || method == "filter" || method == "sort_by" || method == "find" || method == "any" || method == "all") && na == 1 {
        let item = sequence_item_type(rt)
        if item == nil {
            let (t, e3, r3) = check_evaluated_expr(e, args[0], nil, reachable)
            return unknown_method_result(e3, rt, method, r3)
        }
        if method == "map" {
            let (result, e3, r3) = check_evaluated_callback(e, "map callback", args[0], [item], nil, reachable)
            return (never_or(r3, tarr(result)), e3)
        }
        if method == "filter" {
            let (result, e3, r3) = check_evaluated_callback(e, "filter predicate", args[0], [item], mkt("Bool"), reachable)
            return (never_or(r3, tarr(item)), e3)
        }
        if method == "sort_by" {
            let (result, e3, r3) = check_evaluated_callback(e, "sort_by comparator", args[0], [item, item], nil, reachable)
            e = e3
            if r3 && result.k != "Never" && !is_numeric(resolve_alias(e, result)) {
                e = err(e, m_mismatch(mkt("Int"), result))
            }
            return (never_or(r3, tarr(item)), e)
        }
        let (result, e3, r3) = check_evaluated_callback(e, method + " predicate", args[0], [item], mkt("Bool"), reachable)
        if !r3 {
            return (mkt("Never"), e3)
        }
        if method == "find" {
            return (mkt("Unknown"), e3)
        }
        return (mkt("Bool"), e3)
    }
    if method == "fold" && na == 2 {
        let (initial, e3, r3) = check_evaluated_expr(e, args[0], nil, reachable)
        let item = sequence_item_type(rt)
        if item != nil {
            let (result, e4, r4) = check_evaluated_callback(e3, "fold callback", args[1], [initial, item], initial, r3)
            return (never_or(r4, initial), e4)
        }
        let (t, e4, r4) = check_evaluated_expr(e3, args[1], nil, r3)
        return unknown_method_result(e4, rt, method, r4)
    }
    for a in args {
        let (t, e3, r3) = check_evaluated_expr(e, a, nil, reachable)
        e = e3
        reachable = r3
    }
    if rt.k != "Unknown" {
        let expected = builtin_method_arity(rt, method)
        if expected >= 0 {
            e = err(e, m_arity(expected, na))
        } else {
            e = err(e, m_unknown_method(rt, method))
        }
    }
    return (never_or(reachable, mkt("Unknown")), e)
}

// -> (manejado, tipo, env, reachable)
fn check_user_method_call(e0: Env, rt: Ty, method: string, args: array, reachable0: bool) -> (bool, Ty, Env, bool) {
    let mut e = e0
    let mut reachable = reachable0
    if rt.k != "Named" {
        return (false, mkt("Unknown"), e, reachable)
    }
    let qualified = rt.name + "::" + method
    if !std::map::contains(e.functions, qualified) {
        return (false, mkt("Unknown"), e, reachable)
    }
    let sig = std::map::get(e.functions, qualified)
    if len(sig.params) == 0 {
        for a in args {
            let (t, e2, r2) = check_evaluated_expr(e, a, nil, reachable)
            e = e2
            reachable = r2
        }
        e = err(e, m_arity(0, len(args) + 1))
        return (true, never_or(reachable, sig.result), e, reachable)
    }
    e = require_compatible(e, sig.params[0], rt)
    let params = std::array::slice(sig.params, 1, len(sig.params))
    if len(params) != len(args) {
        e = err(e, m_arity(len(params), len(args)))
    }
    let mut i = 0
    while i < len(args) {
        let mut expected: any = nil
        if i < len(params) {
            expected = params[i]
        }
        let (t, e2, r2) = check_evaluated_expr(e, args[i], expected, reachable)
        e = e2
        reachable = r2
        i += 1
    }
    return (true, never_or(reachable, sig.result), e, reachable)
}

// result: Option<Type>.
fn check_evaluated_callback(e0: Env, name: string, x, arguments: array, result, reachable: bool) -> (Ty, Env, bool) {
    let count = cand_count(e0)
    let broke = loop_broke(e0)
    let mut e = e0
    let mut callable = mkt("Unknown")
    if x.kind == "closure" {
        let (t, e2) = check_closure(e, x.list, x.a, x.b, arguments, result)
        e = e2
        callable = t
    } else {
        let (t, e2) = check_expr(e, x)
        e = e2
        callable = t
    }
    let diverges = resolve_alias(e, callable).k == "Never"
    let (found, e3) = check_callback(e, name, callable, arguments, result)
    e = e3
    let mut r = reachable
    if !reachable {
        e = restore_control_flow(e, count, broke)
    } else if diverges {
        r = false
    }
    return (found, e, r)
}

fn check_callback(e0: Env, name: string, callable: Ty, arguments: array, result) -> (Ty, Env) {
    let mut e = e0
    let c = resolve_alias(e, callable)
    if c.k == "Function" {
        let params = c.items
        if len(params) != len(arguments) {
            e = err(e, m_arity(len(arguments), len(params)))
        }
        let mut i = 0
        while i < len(params) && i < len(arguments) {
            if !function_parameter_accepts(resolve_alias(e, params[i]), resolve_alias(e, arguments[i])) {
                e = err(e, m_mismatch(arguments[i], params[i]))
            }
            i += 1
        }
        if result != nil {
            if !function_result_compatible(resolve_alias(e, result), c.ret) {
                e = err(e, m_mismatch(result, c.ret))
            }
        }
        return (c.ret, e)
    }
    if c.k == "Never" {
        return (mkt("Never"), e)
    }
    if c.k == "Unknown" {
        return (mkt("Unknown"), e)
    }
    return (mkt("Unknown"), err(e, m_not_callable(name)))
}

// ------------------------------------------------------------ asignación

fn check_assignment(e0: Env, target, op: string, value) -> (Ty, Env) {
    let mut e = e0
    if target.kind != "ident" {
        let (tt, e2) = check_expr(e, target)
        let (vt, e3) = check_expr(e2, value)
        e = err(e3, m_invalid_assign_target())
        if tt.k == "Never" || vt.k == "Never" {
            return (mkt("Never"), e)
        }
        return (mkt("Unknown"), e)
    }
    let name = target.text
    let target_type = lookup(e, name)
    if target_type == nil {
        e = err(e, m_unknown_var(name))
        let (vt, e2) = check_expr(e, value)
        e = err(e2, m_invalid_assign_target())
        return (never_or(vt.k != "Never", mkt("Unknown")), e)
    }
    if is_global_constant_binding(e, name) {
        let (vt, e2) = check_expr(e, value)
        e = err(e2, m_invalid_assign_target())
        return (never_or(vt.k != "Never", target_type), e)
    }
    let b = binding(e, name)
    let mutable_here = b != nil && b.0 && b.1 == e.fdepth
    if !mutable_here {
        let (vt, e2) = check_expr(e, value)
        e = err(e2, m_invalid_assign_target())
        return (never_or(vt.k != "Never", target_type), e)
    }
    let mut value_type = mkt("Unknown")
    if op != "" {
        let (vt, e2) = check_expr(e, value)
        e = e2
        value_type = vt
        let mut result = mkt("Never")
        if resolve_alias(e, vt).k != "Never" {
            let (r, e3) = check_binary(e, op, resolve_alias(e, target_type), resolve_alias(e, vt))
            e = e3
            result = r
        }
        e = require_compatible(e, target_type, result)
    } else {
        let (vt, e2) = check_expr_expected(e, value, target_type)
        e = e2
        value_type = vt
    }
    return (never_or(value_type.k != "Never", target_type), e)
}

// ----------------------------------------------------------- llamadas

// Option<Type>: nil = no es una llamada intrínseca de colección.
fn check_collection_call(e0: Env, name: string, args: array) -> (any, Env) {
    let mut e = e0
    let mut arity = -1
    if name == "len" {
        arity = 1
    } else if name == "map" || name == "filter" || name == "sort_by" || name == "find" || name == "any" || name == "all" {
        arity = 2
    } else if name == "fold" {
        arity = 3
    }
    if arity < 0 || len(args) != arity {
        return (nil, e)
    }
    if name == "len" {
        let (raw, e2) = check_expr(e, args[0])
        e = e2
        let found = resolve_alias(e, raw)
        if found.k == "Never" {
            return (mkt("Never"), e)
        }
        if !is_length_supported(found) {
            e = err(e, m_invalid_argument(name, "array, tuple, string, bytes, or map", found))
        }
        return (mkt("Int"), e)
    }
    let (raw, e2, r2) = check_evaluated_expr(e, args[0], nil, true)
    e = e2
    let mut reachable = r2
    let sequence = resolve_alias(e, raw)
    if sequence.k == "Never" {
        let mut i = 1
        while i < len(args) {
            let (t, e3, r3) = check_evaluated_expr(e, args[i], nil, reachable)
            e = e3
            reachable = r3
            i += 1
        }
        return (mkt("Never"), e)
    }
    let mut item = sequence_item_type(sequence)
    if item == nil {
        e = err(e, m_invalid_argument(name, "array or tuple", sequence))
        item = mkt("Unknown")
    }
    let mut result = mkt("Unknown")
    if name == "map" {
        let (out, e3, r3) = check_evaluated_callback(e, "map callback", args[1], [item], nil, reachable)
        e = e3
        reachable = r3
        result = tarr(out)
    } else if name == "filter" {
        let (out, e3, r3) = check_evaluated_callback(e, "filter predicate", args[1], [item], mkt("Bool"), reachable)
        e = e3
        reachable = r3
        result = tarr(item)
    } else if name == "fold" {
        let (initial, e3, r3) = check_evaluated_expr(e, args[1], nil, reachable)
        let (out, e4, r4) = check_evaluated_callback(e3, "fold callback", args[2], [initial, item], initial, r3)
        e = e4
        reachable = r4
        result = initial
    } else if name == "sort_by" {
        let (out, e3, r3) = check_evaluated_callback(e, "sort_by comparator", args[1], [item, item], nil, reachable)
        e = e3
        reachable = r3
        if reachable && out.k != "Never" && !is_numeric(resolve_alias(e, out)) {
            e = err(e, m_mismatch(mkt("Int"), out))
        }
        result = tarr(item)
    } else if name == "find" {
        let (out, e3, r3) = check_evaluated_callback(e, "find predicate", args[1], [item], mkt("Bool"), reachable)
        e = e3
        reachable = r3
        result = mkt("Unknown")
    } else {
        let (out, e3, r3) = check_evaluated_callback(e, name + " predicate", args[1], [item], mkt("Bool"), reachable)
        e = e3
        reachable = r3
        result = mkt("Bool")
    }
    return (never_or(reachable, result), e)
}

fn check_try_catch_call(e0: Env, args: array) -> (Ty, Env) {
    let mut e = e0
    let result_type = tnamed("Result")
    if len(args) == 0 {
        return (result_type, err(e, m_arity(1, 0)))
    }
    let callable_expression = args[0]
    let call_args = std::array::slice(args, 1, len(args))
    let mut reachable = true
    let inline_closure = callable_expression.kind == "closure"
    let pre_scopes = e.scopes
    let pre_bindings = e.bindings
    let mut callable = mkt("Unknown")
    if !inline_closure {
        let (t, e2, r2) = check_evaluated_expr(e, callable_expression, nil, reachable)
        e = e2
        reachable = r2
        callable = t
    }
    let mut argument_types = []
    for a in call_args {
        let (t, e2, r2) = check_evaluated_expr(e, a, nil, reachable)
        e = e2
        reachable = r2
        argument_types = std::array::push(argument_types, t)
    }
    if inline_closure {
        let post_scopes = e.scopes
        let post_bindings = e.bindings
        e = set_bindings(set_scopes(e, pre_scopes), pre_bindings)
        let (t, e2) = check_closure(e, callable_expression.list, callable_expression.a, callable_expression.b, argument_types, nil)
        e = set_bindings(set_scopes(e2, post_scopes), post_bindings)
        callable = t
    }
    let c = resolve_alias(e, callable)
    if c.k == "Never" {
        return (mkt("Never"), e)
    }
    if c.k == "Function" {
        if len(c.items) != len(argument_types) {
            e = err(e, m_arity(len(c.items), len(argument_types)))
        }
        let mut i = 0
        while i < len(c.items) && i < len(argument_types) {
            e = require_compatible(e, c.items[i], argument_types[i])
            i += 1
        }
    } else {
        e = err(e, m_not_callable("first argument to std::try::catch"))
    }
    return (never_or(reachable, result_type), e)
}

fn is_one_of(s: string, options: array) -> bool {
    for o in options {
        if s == o {
            return true
        }
    }
    false
}

// -> (manejado, env, reachable)
fn check_dedicated_call_argument(e0: Env, function: string, index: int, x, expected: Ty, reachable: bool) -> (bool, Env, bool) {
    let mut e = e0
    let accepts_utf8 = index == 1 && (function == "std::net::tcp_write" || function == "std::tls::write")
    let mut sequence_item: any = nil
    if function == "select" && index == 0 {
        sequence_item = tnamed("Receiver")
    } else if index == 2 && is_one_of(function, ["std::sqlite::execute", "std::sqlite::query", "std::postgres::execute", "std::postgres::query", "std::mysql::execute", "std::mysql::query", "std::db::execute", "std::db::query"]) {
        sequence_item = mkt("Unknown")
    } else if index == 1 && is_one_of(function, ["std::sqlite::migrate", "std::postgres::migrate", "std::mysql::migrate", "std::db::migrate"]) {
        sequence_item = tnamed("map")
    }
    let tcp_handle = function == "std::net::tcp_close" && index == 0
    let database_handle = index == 0 && is_one_of(function, ["std::db::execute", "std::db::query", "std::db::begin", "std::db::commit", "std::db::rollback", "std::db::migrate", "std::db::close", "std::db::ping"])
    if !accepts_utf8 && sequence_item == nil && !tcp_handle && !database_handle {
        return (false, e, reachable)
    }
    let (found, e2, r2) = check_evaluated_expr(e, x, nil, reachable)
    e = e2
    let fr = resolve_alias(e, found)
    if accepts_utf8 {
        let er = resolve_alias(e, expected)
        if !compatible(er, fr) && !(is_named(er, "bytes") && fr.k == "String") {
            e = err(e, m_mismatch(expected, found))
        }
    } else if sequence_item != nil {
        if !sequence_matches(sequence_item, fr) {
            e = err(e, m_mismatch(tarr(sequence_item), found))
        }
    } else {
        let valid = fr.k == "Unknown" || fr.k == "Never" || (fr.k == "Named" && tcp_handle && !database_handle && (fr.name == "TcpStream" || fr.name == "TcpListener")) || (fr.k == "Named" && !tcp_handle && database_handle && (fr.name == "Sqlite" || fr.name == "Postgres" || fr.name == "Mysql"))
        if !valid {
            let mut what = "SQLite, PostgreSQL, or MySQL connection"
            if tcp_handle {
                what = "TCP stream or listener"
            }
            e = err(e, m_invalid_argument(function, what, found))
        }
    }
    return (true, e, r2)
}

fn check_args_plain(e0: Env, args: array, from: int, reachable0: bool) -> (Env, bool) {
    let mut e = e0
    let mut reachable = reachable0
    let mut i = from
    while i < len(args) {
        let (t, e2, r2) = check_evaluated_expr(e, args[i], nil, reachable)
        e = e2
        reachable = r2
        i += 1
    }
    return (e, reachable)
}

fn check_call(e0: Env, callee, args: array) -> (Ty, Env) {
    let mut e = e0
    // name: Option<String> ("" = None; un identificador nunca es vacío).
    let mut name = ""
    if callee.kind == "ident" {
        name = callee.text
    }
    let mut static_name = ""
    if name != "" && !is_local_binding(e, name) {
        static_name = name
    }
    let variadic_print = static_name == "print" || static_name == "println"
    if static_name != "" {
        let (collection, e2) = check_collection_call(e, static_name, args)
        e = e2
        if collection != nil {
            return (collection, e)
        }
        if static_name == "std::try::catch" {
            return check_try_catch_call(e, args)
        }
        if std::map::contains(e.natives, static_name) {
            let sig = std::map::get(e.natives, static_name)
            if len(args) != len(sig.params) {
                e = err(e, m_arity(len(sig.params), len(args)))
            }
            let mut reachable = true
            let mut i = 0
            while i < len(args) && i < len(sig.params) {
                let (t, e3, r3) = check_evaluated_expr(e, args[i], nil, reachable)
                e = e3
                reachable = r3
                let found = resolve_alias(e, t)
                let expected = sig.params[i]
                if !native_compatible(expected, found) {
                    e = err(e, m_mismatch(expected, found))
                }
                i += 1
            }
            let (e4, r4) = check_args_plain(e, args, len(sig.params), reachable)
            return (never_or(r4, sig.result), e4)
        }
        if std::map::contains(e.variants, static_name) {
            let payload = std::map::get(e.variants, static_name)
            let expected = len(payload)
            if len(args) != expected {
                e = err(e, m_arity(expected, len(args)))
            }
            let mut reachable = true
            let mut checked = 0
            if expected == 1 && len(args) > 0 {
                let (t, e3, r3) = check_evaluated_expr(e, args[0], payload[0], reachable)
                e = e3
                reachable = r3
                checked = 1
            }
            let (e4, r4) = check_args_plain(e, args, checked, reachable)
            let sep = find_sub(static_name, "::")
            let mut enum_name = static_name
            if sep >= 0 {
                enum_name = std::text::substring(static_name, 0, sep)
            }
            return (never_or(r4, tnamed(enum_name)), e4)
        }
    }
    let mut reachable = true
    let mut t = mkt("Unknown")
    if static_name != "" && std::map::contains(e.base, static_name) {
        let sig = std::map::get(e.base, static_name)
        t = tfn(sig.params, sig.result)
    } else {
        let (ct, e2, r2) = check_evaluated_expr(e, callee, nil, reachable)
        e = e2
        reachable = r2
        t = ct
    }
    t = resolve_alias(e, t)
    if t.k == "Never" {
        let (e3, r3) = check_args_plain(e, args, 0, reachable)
        return (mkt("Never"), e3)
    }
    if t.k == "Function" {
        let params = t.items
        if len(params) != len(args) && !variadic_print {
            e = err(e, m_arity(len(params), len(args)))
        }
        let mut i = 0
        while i < len(args) && i < len(params) {
            let mut dedicated = false
            if static_name != "" {
                let (d, e3, r3) = check_dedicated_call_argument(e, static_name, i, args[i], params[i], reachable)
                e = e3
                reachable = r3
                dedicated = d
            }
            if !dedicated {
                let (at, e3, r3) = check_evaluated_expr(e, args[i], params[i], reachable)
                e = e3
                reachable = r3
            }
            i += 1
        }
        let (e4, r4) = check_args_plain(e, args, len(params), reachable)
        return (never_or(r4, t.ret), e4)
    }
    if t.k == "Unknown" {
        let (e3, r3) = check_args_plain(e, args, 0, reachable)
        return (never_or(r3, mkt("Unknown")), e3)
    }
    let (e3, r3) = check_args_plain(e, args, 0, reachable)
    let mut shown = name
    if shown == "" {
        shown = "expression"
    }
    return (never_or(r3, mkt("Unknown")), err(e3, m_not_callable(shown)))
}

// ------------------------------------------------------------ operadores

fn invalid_operands(e: Env, op: string, left: Ty, right: Ty) -> Env {
    err(e, m_invalid_operands(op, left, right))
}

fn check_binary(e0: Env, op: string, left: Ty, right: Ty) -> (Ty, Env) {
    let mut e = e0
    if op == "Eq" || op == "Neq" {
        if resolve_alias(e, left).k != "Nil" && resolve_alias(e, right).k != "Nil" {
            e = require_compatible(e, left, right)
        }
        return (mkt("Bool"), e)
    }
    if op == "Lt" || op == "Gt" || op == "Lte" || op == "Gte" {
        let lr = resolve_alias(e, left)
        let orderable = is_numeric(left) || lr.k == "Char" || lr.k == "String"
        if !orderable || !compatible(left, right) {
            e = invalid_operands(e, op, left, right)
        }
        return (mkt("Bool"), e)
    }
    if op == "LazyAnd" || op == "LazyOr" {
        e = require_compatible(e, mkt("Bool"), left)
        e = require_compatible(e, mkt("Bool"), right)
        return (mkt("Bool"), e)
    }
    if op == "Add" && left.k == "String" {
        return (mkt("String"), e)
    }
    if op == "Add" && right.k == "String" {
        return (mkt("String"), e)
    }
    if (op == "Add" || op == "Sub" || op == "Mul" || op == "Div") && is_numeric(left) && compatible(left, right) {
        return (left, e)
    }
    if op == "Mod" && compatible(mkt("Int"), left) && compatible(mkt("Int"), right) {
        return (mkt("Int"), e)
    }
    if (op == "And" || op == "Or" || op == "Xor") && compatible(mkt("Int"), left) && compatible(mkt("Int"), right) {
        return (mkt("Int"), e)
    }
    return (mkt("Unknown"), invalid_operands(e, op, left, right))
}

// ----------------------------------------------- análisis de flujo (puros)

fn is_bool_lit(x, v: bool) -> bool {
    x.kind == "bool" && x.flag == v
}

fn lazy_rhs_is_skipped(op: string, left) -> bool {
    return (op == "LazyAnd" && is_bool_lit(left, false)) || (op == "LazyOr" && is_bool_lit(left, true))
}

fn lazy_rhs_is_guaranteed(op: string, left) -> bool {
    return (op == "LazyAnd" && is_bool_lit(left, true)) || (op == "LazyOr" && is_bool_lit(left, false))
}

fn stmt_value_exprs(s) -> array {
    if s.kind == "sexpr" {
        return [s.a]
    }
    if s.kind == "slet" {
        return [s.b]
    }
    return []
}

fn block_may_break_current_loop(b) -> bool {
    for s in b.list {
        for x in stmt_value_exprs(s) {
            if expr_may_break_current_loop(x) {
                return true
            }
        }
    }
    b.a != nil && expr_may_break_current_loop(b.a)
}

fn any_may_break(list: array) -> bool {
    for x in list {
        if expr_may_break_current_loop(x) {
            return true
        }
    }
    false
}

fn expr_may_break_current_loop(x) -> bool {
    let k = x.kind
    if k == "break" {
        return true
    }
    if k == "array" || k == "tuple" {
        return any_may_break(x.list)
    }
    if k == "structlit" {
        return any_may_break(x.list2)
    }
    if k == "binary" {
        return expr_may_break_current_loop(x.a) || (!lazy_rhs_is_skipped(x.text, x.a) && expr_may_break_current_loop(x.b))
    }
    if k == "range" || k == "index" || k == "assign" {
        return expr_may_break_current_loop(x.a) || expr_may_break_current_loop(x.b)
    }
    if k == "unary" || k == "field" || k == "spawn" || k == "try" {
        return expr_may_break_current_loop(x.a)
    }
    if k == "call" || k == "methodcall" {
        return expr_may_break_current_loop(x.a) || any_may_break(x.list)
    }
    if k == "if" {
        if expr_may_break_current_loop(x.a) {
            return true
        }
        if is_bool_lit(x.a, true) {
            return block_may_break_current_loop(x.b)
        }
        if is_bool_lit(x.a, false) {
            return x.c != nil && block_may_break_current_loop(x.c)
        }
        return block_may_break_current_loop(x.b) || (x.c != nil && block_may_break_current_loop(x.c))
    }
    if k == "match" {
        if expr_may_break_current_loop(x.a) {
            return true
        }
        for arm in x.list {
            if (arm.b != nil && expr_may_break_current_loop(arm.b)) || block_may_break_current_loop(arm.c) {
                return true
            }
        }
        return false
    }
    if k == "for" {
        return expr_may_break_current_loop(x.b)
    }
    if k == "while" {
        return expr_may_break_current_loop(x.a)
    }
    if k == "return" {
        return x.a != nil && expr_may_break_current_loop(x.a)
    }
    if k == "block" {
        return block_may_break_current_loop(x)
    }
    false
}

fn block_definitely_returns(b) -> bool {
    for s in b.list {
        for x in stmt_value_exprs(s) {
            if expr_definitely_returns(x) {
                return true
            }
        }
    }
    b.a != nil && expr_definitely_returns(b.a)
}

fn expr_definitely_returns(x) -> bool {
    let k = x.kind
    if k == "return" {
        return true
    }
    if k == "array" || k == "tuple" {
        return any_definitely_returns(x.list)
    }
    if k == "structlit" {
        return any_definitely_returns(x.list2)
    }
    if k == "binary" {
        let lazy = x.text == "LazyAnd" || x.text == "LazyOr"
        return expr_definitely_returns(x.a) || ((!lazy || lazy_rhs_is_guaranteed(x.text, x.a)) && expr_definitely_returns(x.b))
    }
    if k == "range" || k == "index" || k == "assign" {
        return expr_definitely_returns(x.a) || expr_definitely_returns(x.b)
    }
    if k == "unary" || k == "field" || k == "spawn" || k == "try" {
        return expr_definitely_returns(x.a)
    }
    if k == "call" || k == "methodcall" {
        return expr_definitely_returns(x.a) || any_definitely_returns(x.list)
    }
    if k == "block" {
        return block_definitely_returns(x)
    }
    if k == "if" {
        if expr_definitely_returns(x.a) {
            return true
        }
        if x.c != nil {
            if is_bool_lit(x.a, true) {
                return block_definitely_returns(x.b)
            }
            if is_bool_lit(x.a, false) {
                return block_definitely_returns(x.c)
            }
            return block_definitely_returns(x.b) && block_definitely_returns(x.c)
        }
        return is_bool_lit(x.a, true) && block_definitely_returns(x.b)
    }
    if k == "match" {
        if expr_definitely_returns(x.a) {
            return true
        }
        if len(x.list) == 0 {
            return false
        }
        for arm in x.list {
            if !block_definitely_returns(arm.c) {
                return false
            }
        }
        return true
    }
    if k == "loop" {
        return !block_may_break_current_loop(x.a)
    }
    if k == "for" {
        return expr_definitely_returns(x.b)
    }
    if k == "while" {
        return expr_definitely_returns(x.a) || (is_bool_lit(x.a, true) && !block_may_break_current_loop(x.b))
    }
    false
}

// ------------------------------------------------------------ salida

// Mismo texto que `titan typecheck <archivo>`.
fn typecheck_dump(text: string) -> string {
    let (tokens, lex_errors) = tokenize(text)
    if len(lex_errors) > 0 {
        return dump_ast(text)
    }
    let (items, parse_errors) = parse_program(tokens)
    if len(parse_errors) > 0 {
        return dump_ast(text)
    }
    let diags = check_program(items)
    if len(diags) == 0 {
        return "ok\n"
    }
    let mut out = ""
    for d in diags {
        let sp = d.span
        if sp != nil && sp.line > 0 && sp.col > 0 {
            let l = sp.line
            let c = sp.col
            out += "diag: " + esc("{l}:{c}: " + d.msg) + "\n"
        } else {
            out += "diag: " + esc(d.msg) + "\n"
        }
    }
    out
}

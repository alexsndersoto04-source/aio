// Compilador de PRUEBAS: igual que build.titan, pero enlaza el runtime de
// prueba selfhost/native/prueba_runtime.titan (el runtime real + funciones
// std::prueba::* que exponen funciones internas) para poder comprobarlas desde
// un programa de prueba. No se usa para compilar programas normales.
// Uso: titan compile selfhost/prueba_interna.titan -o X  (o `titan run`), y
// después X PRUEBA.titan SALIDA, con selfhost/native/ junto a X.
//
// El front-end (raw_signatures, diag_line, front) es el mismo que el del
// compilador de verdad: `frontend.titan`. Antes había aquí copias viejas que
// se quedaron sin el optimizador y sin las operaciones `std::raw::` añadidas
// después (sysreg, fiber_switch, mmio_*, hvc, bare), así que este compilador
// de pruebas ya no podía compilar nada que cargara `native/sys_bare.titan`.
// No se usa para compilar programas normales.

import args
import loader
import codegen
import frontend
import native::backend

// Funciones internas expuestas (implementadas en native/prueba_runtime.titan).
fn prueba_signatures() -> array {
    return [
        "std::prueba::uw_str_width String -> Int",
        "std::prueba::uw_char_width Int -> Int",
        "std::prueba::uw_cps_width Array -> Int",
        "std::prueba::rx_check String -> String",
        "std::prueba::rx_check_hir String -> String",
    ]
}

// Firmas de las operaciones de bajo nivel, solo para el runtime.
fn build(program: string, runtime: string) -> Result {
    let gu = front(program, std::array::concat(native_table(), prueba_signatures()))?
    let rt_natives = std::array::concat(std::array::concat(native_table(), prueba_signatures()), raw_signatures())
    let gr = match front(runtime, rt_natives) {
        Result::Ok(g) => g,
        Result::Err(message) => {
            return Result::Err("native runtime: " + message)
        },
    }
    bk_build(gu, gr)
}

fn main() {
    let args = ar_user_args()
    if len(args) < 2 {
        print("uso: titan run selfhost/prueba_interna.titan PRUEBA.titan SALIDA")
        return
    }
    let here = std::path::parent(std::path::canonical(ar_program()))
    let runtime = std::path::join(std::path::join(here, "native"), "prueba_runtime.titan")
    match build(args[0], runtime) {
        Result::Ok(built) => {
            let (bytes, symbols) = built
            el_write_executable(args[1], bytes)
        },
        Result::Err(message) => {
            print("error: " + message)
        },
    }
}

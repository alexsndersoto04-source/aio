// ============================================================================
// Parser de Titan escrito en Titan (self-hosting, fase 2).
//
// Traducción fiel de crates/titan_parser/src/lib.rs: mismo árbol (AST), mismos
// spans, mismas "desazucaraciones" (destructuring, `|>`, `<=>`, spread, mapas
// literales), mismos mensajes de error y la misma recuperación tras un error.
// Verificación diferencial: `dump_ast` produce el mismo texto que
// `titan ast <archivo>` (parser de Rust) byte por byte.
//
// Representación del AST: un único struct `Node` (unión etiquetada). `kind`
// dice qué es y cada tipo usa los campos que necesita (ver tabla abajo). Un
// hijo ausente (Option::None en Rust) es `nil`.
//
// Estado del parser: la posición en los tokens y el contador de temporales
// sintéticos (`__destrN`) viajan juntos en `St`. Cada función recibe el estado
// y devuelve Result::Ok((valor, estado)) o Result::Err((mensaje, estado)); el
// estado del error es el del punto exacto del fallo (el parser de Rust se
// resincroniza desde ahí y conserva el contador).
//
// Tabla de nodos (campos no mencionados: vacíos):
//   ítems:   fn(text=nombre flag=extern a=abi|nil b=ret|nil c=body|nil list=params)
//            param(text flag=mut a=tipo|nil b=default|nil)
//            struct(text list=sfield(text a=tipo))
//            enum(text list=variant(text a=payload|nil))
//            trait(text list=method(text list=params b=ret c=body))
//            impl(a=trait|nil b=tipo list=fns)   module(text list=ítems)
//            import(text="a::b")   const(text a=tipo|nil b=valor)
//            typealias(text a=tipo)
//   tipos:   t_named(text list=genéricos) t_ref(flag=mut a) t_slice(a)
//            t_array(a b=tamaño) t_tuple(list) t_fn(list a=ret) t_unit t_never
//   bloque:  block(list=sentencias a=final|nil)
//   sent.:   sexpr(a) slet(text flag=mut a=tipo|nil b=valor) sitem(a)
//   expr.:   int(a) float(a) string(text) template(text) char(text) bool(flag)
//            nil ident(text) array(list) tuple(list)
//            structlit(text list=nombres list2=valores)
//            binary(text=op a b) range(flag=inclusive a b) unary(text=op a)
//            call(a=callee list=args) methodcall(text a=receptor list=args)
//            index(a b) field(text a) if(a=cond b=then c=else|nil)
//            match(a list=arm(a=patrón b=guarda|nil c=cuerpo))
//            for(a=patrón b=iter c=cuerpo) while(a b) loop(a)
//            break(a|nil) continue return(a|nil) assign(text=op|"" a b)
//            spawn(a) try(a) closure(list=params a=ret|nil b=cuerpo)
//   patrón:  p_wild p_ident(text) p_lit(a) p_enum(text text2 a|nil)
//            p_or(a b)
// ============================================================================

import lexer

struct Span {
    line: int,
    col: int,
    start: int,
    end: int,
}

struct Node {
    kind: string,
    text: string,
    text2: string,
    flag: bool,
    a: any,
    b: any,
    c: any,
    list: array,
    list2: array,
    span: Span,
}

struct St {
    pos: int,
    ctr: int,
}

// ------------------------------------------------------------- constructores

fn zero_span() -> Span {
    Span { line: 0, col: 0, start: 0, end: 0 }
}

fn mk(kind: string, text: string, flag: bool, a, b, c, list: array, span: Span) -> Node {
    Node { kind: kind, text: text, text2: "", flag: flag, a: a, b: b, c: c, list: list, list2: [], span: span }
}

fn leaf(kind: string, text: string, span: Span) -> Node {
    mk(kind, text, false, nil, nil, nil, [], span)
}

fn node1(kind: string, text: string, a, span: Span) -> Node {
    mk(kind, text, false, a, nil, nil, [], span)
}

fn node2(kind: string, text: string, a, b, span: Span) -> Node {
    mk(kind, text, false, a, b, nil, [], span)
}

fn block_node(stmts: array, final_expr, span: Span) -> Node {
    mk("block", "", false, final_expr, nil, nil, stmts, span)
}

fn int_node(value: int, span: Span) -> Node {
    mk("int", "", false, value, nil, nil, [], span)
}

fn ident_node(name: string, span: Span) -> Node {
    leaf("ident", name, span)
}

fn call_node(callee, args: array, span: Span) -> Node {
    mk("call", "", false, callee, nil, nil, args, span)
}

fn let_stmt(name: string, mutable: bool, type_ann, value, span: Span) -> Node {
    mk("slet", name, mutable, type_ann, value, nil, [], span)
}

fn ty(kind: string, text: string, flag: bool, a, b, list: array) -> Node {
    mk(kind, text, flag, a, b, nil, list, zero_span())
}

// ---------------------------------------------------------- acceso a tokens

fn kind_at(tk: array, i: int) -> string {
    if i < len(tk) {
        return tk[i].kind
    }
    ""
}

fn at_k(tk: array, st: St, kind: string) -> bool {
    kind_at(tk, st.pos) == kind
}

fn adv(tk: array, st: St) -> St {
    if st.pos < len(tk) {
        return St { pos: st.pos + 1, ctr: st.ctr }
    }
    st
}

// eat -> (bool, St)
fn eat(tk: array, st: St, kind: string) -> any {
    if at_k(tk, st, kind) {
        return (true, adv(tk, st))
    }
    return (false, st)
}

fn tok_span(t: Token) -> Span {
    Span { line: t.line, col: t.col, start: t.start, end: t.end }
}

fn span_at(tk: array, i: int) -> Span {
    if i < len(tk) {
        return tok_span(tk[i])
    }
    zero_span()
}

fn cur_span(tk: array, st: St) -> Span {
    span_at(tk, st.pos)
}

fn prev_span(tk: array, st: St) -> Span {
    if st.pos == 0 {
        return span_at(tk, 0)
    }
    span_at(tk, st.pos - 1)
}

fn fresh(st: St) -> any {
    let n = st.ctr
    return ("__destr{n}", St { pos: st.pos, ctr: st.ctr + 1 })
}

// --------------------------------------------------------------- errores

// Escape de `{:?}` de Rust para str/char (ver ESTADO.md: la tabla Unicode de
// "imprimible" de Rust se aproxima con los rangos más comunes).
fn debug_needs_unicode_escape(code: int) -> bool {
    if code < 32 || (code >= 127 && code <= 159) {
        return true
    }
    if code == 173 || (code >= 768 && code <= 879) {
        return true
    }
    if (code >= 8203 && code <= 8207) || (code >= 8232 && code <= 8238) {
        return true
    }
    if (code >= 8288 && code <= 8292) || code == 65279 || (code >= 65024 && code <= 65039) {
        return true
    }
    if (code >= 57344 && code <= 63743) || (code >= 65529 && code <= 65531) {
        return true
    }
    false
}

fn hex(n: int) -> string {
    let digits = "0123456789abcdef"
    if n == 0 {
        return "0"
    }
    let mut out = ""
    let mut v = n
    while v > 0 {
        out = std::text::substring(digits, v % 16, v % 16 + 1) + out
        v = v / 16
    }
    out
}

fn debug_escape(text: string, quote) -> string {
    let mut out = ""
    for c in std::text::chars(text) {
        let code = std::text::char_code(c)
        if c == '\0' {
            out += "\\0"
        } else if c == '\t' {
            out += "\\t"
        } else if c == '\r' {
            out += "\\r"
        } else if c == '\n' {
            out += "\\n"
        } else if c == '\\' {
            out += "\\\\"
        } else if c == quote {
            out += "\\" + c
        } else if debug_needs_unicode_escape(code) {
            out += "\\u{" + hex(code) + "}"
        } else {
            out += c
        }
    }
    out
}

// `format!("{:?}", token.kind)` de Rust.
fn token_debug(t: Token) -> string {
    let k = t.kind
    if k == "Ident" || k == "IntLit" || k == "FloatLit" || k == "StringLit" || k == "Error" {
        return k + "(\"" + debug_escape(t.text, '"') + "\")"
    }
    if k == "CharLit" {
        return "CharLit('" + debug_escape(t.text, '\'') + "')"
    }
    k
}

fn expected(tk: array, st: St, what: string) -> Result {
    if st.pos < len(tk) {
        let t = tk[st.pos]
        let l = t.line
        let c = t.col
        return Result::Err(("expected " + what + ", found " + token_debug(t) + " at {l}:{c}", st))
    }
    Result::Err(("expected " + what + ", found end of input at 0:0", st))
}

fn message_at(msg: string, span: Span, st: St) -> Result {
    let l = span.line
    let c = span.col
    Result::Err((msg + " at {l}:{c}", st))
}

fn expect(tk: array, st: St, kind: string) -> Result {
    if at_k(tk, st, kind) {
        return Result::Ok((cur_span(tk, st), adv(tk, st)))
    }
    expected(tk, st, kind)
}

fn expect_ident(tk: array, st: St) -> Result {
    if at_k(tk, st, "Ident") {
        return Result::Ok((tk[st.pos].text, adv(tk, st)))
    }
    expected(tk, st, "an identifier")
}

fn is_item_start(k: string) -> bool {
    k == "Fn" || k == "Extern" || k == "Struct" || k == "Enum" || k == "Trait" || k == "Impl" || k == "Module" || k == "Import" || k == "Const" || k == "Type"
}

fn synchronize_item(tk: array, st: St) -> St {
    let mut s = st
    while !at_k(tk, s, "Eof") {
        if is_item_start(kind_at(tk, s.pos)) {
            return s
        }
        s = adv(tk, s)
    }
    s
}

// ------------------------------------------------------------ programa/ítems

// -> (items, errors)
fn parse_program(tk: array) -> any {
    let mut items = []
    let mut errors = []
    let mut st = St { pos: 0, ctr: 0 }
    while !at_k(tk, st, "Eof") {
        match parse_item(tk, st) {
            Result::Ok(r) => {
                let (item, s2) = r
                items = std::array::push(items, item)
                st = s2
            },
            Result::Err(e) => {
                let (msg, s2) = e
                errors = std::array::push(errors, msg)
                st = synchronize_item(tk, s2)
            },
        }
    }
    return (items, errors)
}

fn parse_item(tk: array, st0: St) -> Result {
    let (_, st) = eat(tk, st0, "Pub")
    let k = kind_at(tk, st.pos)
    if k == "Fn" || k == "Extern" {
        return parse_function(tk, st)
    }
    if k == "Struct" {
        return parse_struct(tk, st)
    }
    if k == "Enum" {
        return parse_enum(tk, st)
    }
    if k == "Trait" {
        return parse_trait(tk, st)
    }
    if k == "Impl" {
        return parse_impl(tk, st)
    }
    if k == "Module" {
        return parse_module(tk, st)
    }
    if k == "Import" {
        return parse_import(tk, st)
    }
    if k == "Const" {
        return parse_const(tk, st)
    }
    if k == "Type" {
        return parse_type_alias(tk, st)
    }
    expected(tk, st, "a declaration (fn, struct, enum, trait, impl, mod, import, const or type)")
}

fn parse_type_alias(tk: array, st0: St) -> Result {
    let (span, st) = expect(tk, st0, "Type")?
    let (name, st) = expect_ident(tk, st)?
    let (_, st) = expect(tk, st, "Eq")?
    let (target, st) = parse_type(tk, st)?
    let (_, st) = eat(tk, st, "Semicolon")
    Result::Ok((node1("typealias", name, target, span), st))
}

// Parámetros de una función: `(a: int, mut b = 1, self)`; el `(` ya se
// consumió. Devuelve la lista y el estado tras el `)`.
fn parse_fn_params(tk: array, st0: St) -> Result {
    let mut params = []
    let mut st = st0
    while !at_k(tk, st, "RParen") {
        let pspan = cur_span(tk, st)
        let (mutable, s1) = eat(tk, st, "Mut")
        let (is_self, s2) = eat(tk, s1, "Self_")
        let mut pname = "self"
        let mut s3 = s2
        if !is_self {
            let (n, s) = expect_ident(tk, s2)?
            pname = n
            s3 = s
        }
        let (has_type, s4) = eat(tk, s3, "Colon")
        let mut type_ann: any = nil
        let mut s5 = s4
        if has_type {
            let (t, s) = parse_type(tk, s4)?
            type_ann = t
            s5 = s
        }
        let (has_default, s6) = eat(tk, s5, "Eq")
        let mut default: any = nil
        let mut s7 = s6
        if has_default {
            let (e, s) = parse_expr(tk, s6)?
            default = e
            s7 = s
        }
        params = std::array::push(params, mk("param", pname, mutable, type_ann, default, nil, [], pspan))
        let (comma, s8) = eat(tk, s7, "Comma")
        st = s8
        if !comma {
            break
        }
    }
    let (_, st) = expect(tk, st, "RParen")?
    Result::Ok((params, st))
}

fn parse_function(tk: array, st0: St) -> Result {
    let (is_extern, st) = eat(tk, st0, "Extern")
    let mut abi: any = nil
    let mut s1 = st
    if is_extern {
        if at_k(tk, st, "StringLit") {
            abi = tk[st.pos].text
            s1 = adv(tk, st)
        } else {
            abi = "C"
        }
    }
    let (start, st) = expect(tk, s1, "Fn")?
    let (name, st) = expect_ident(tk, st)?
    let (_, st) = expect(tk, st, "LParen")?
    let (params, st) = parse_fn_params(tk, st)?
    let (has_ret, st) = eat(tk, st, "ThinArrow")
    let mut ret: any = nil
    let mut s2 = st
    if has_ret {
        let (t, s) = parse_type(tk, st)?
        ret = t
        s2 = s
    }
    let (no_body, st) = eat(tk, s2, "Semicolon")
    let mut body: any = nil
    let mut s3 = st
    if !no_body {
        let (_, s) = expect(tk, st, "LBrace")?
        let (b, s) = parse_block_after_open(tk, s, start)?
        body = b
        s3 = s
    }
    Result::Ok((mk("fn", name, is_extern, abi, ret, body, params, start), s3))
}

fn parse_struct(tk: array, st0: St) -> Result {
    let (span, st) = expect(tk, st0, "Struct")?
    let (name, st) = expect_ident(tk, st)?
    let (_, st) = expect(tk, st, "LBrace")?
    let mut fields = []
    let mut s = st
    while !at_k(tk, s, "RBrace") {
        let (_, s1) = eat(tk, s, "Pub")
        let fspan = cur_span(tk, s1)
        let (fname, s2) = expect_ident(tk, s1)?
        let (_, s3) = expect(tk, s2, "Colon")?
        let (t, s4) = parse_type(tk, s3)?
        fields = std::array::push(fields, node1("sfield", fname, t, fspan))
        let (comma, s5) = eat(tk, s4, "Comma")
        s = s5
        if !comma {
            let (_, s6) = eat(tk, s5, "Semicolon")
            s = s6
        }
    }
    let (_, st) = expect(tk, s, "RBrace")?
    Result::Ok((mk("struct", name, false, nil, nil, nil, fields, span), st))
}

fn parse_enum(tk: array, st0: St) -> Result {
    let (span, st) = expect(tk, st0, "Enum")?
    let (name, st) = expect_ident(tk, st)?
    let (_, st) = expect(tk, st, "LBrace")?
    let mut variants = []
    let mut s = st
    while !at_k(tk, s, "RBrace") {
        let vspan = cur_span(tk, s)
        let (vname, s1) = expect_ident(tk, s)?
        let (has_payload, s2) = eat(tk, s1, "LParen")
        let mut payload: any = nil
        let mut s3 = s2
        if has_payload {
            let (t, sa) = parse_type(tk, s2)?
            let (_, sb) = expect(tk, sa, "RParen")?
            payload = t
            s3 = sb
        }
        variants = std::array::push(variants, node1("variant", vname, payload, vspan))
        let (comma, s4) = eat(tk, s3, "Comma")
        s = s4
        if !comma {
            let (_, s5) = eat(tk, s4, "Semicolon")
            s = s5
        }
    }
    let (_, st) = expect(tk, s, "RBrace")?
    Result::Ok((mk("enum", name, false, nil, nil, nil, variants, span), st))
}

fn parse_trait(tk: array, st0: St) -> Result {
    let (span, st) = expect(tk, st0, "Trait")?
    let (name, st) = expect_ident(tk, st)?
    let (_, st) = expect(tk, st, "LBrace")?
    let mut methods = []
    let mut s = st
    while !at_k(tk, s, "RBrace") {
        let (f, s1) = parse_function(tk, s)?
        methods = std::array::push(methods, mk("method", f.text, false, nil, f.b, f.c, f.list, f.span))
        s = s1
    }
    let (_, st) = expect(tk, s, "RBrace")?
    Result::Ok((mk("trait", name, false, nil, nil, nil, methods, span), st))
}

fn parse_impl(tk: array, st0: St) -> Result {
    let (span, st) = expect(tk, st0, "Impl")?
    let (first, st) = parse_type(tk, st)?
    let (has_for, st) = eat(tk, st, "For")
    let mut trait_name: any = nil
    let mut target = first
    let mut s = st
    if has_for {
        if first.kind != "t_named" {
            return message_at("trait name must be a named type", cur_span(tk, st), st)
        }
        trait_name = first.text
        let (t, s1) = parse_type(tk, st)?
        target = t
        s = s1
    }
    let (_, s2) = expect(tk, s, "LBrace")?
    let mut methods = []
    let mut s3 = s2
    while !at_k(tk, s3, "RBrace") {
        let (f, s4) = parse_function(tk, s3)?
        methods = std::array::push(methods, f)
        s3 = s4
    }
    let (_, st) = expect(tk, s3, "RBrace")?
    Result::Ok((mk("impl", "", false, trait_name, target, nil, methods, span), st))
}

fn parse_module(tk: array, st0: St) -> Result {
    let (span, st) = expect(tk, st0, "Module")?
    let (name, st) = expect_ident(tk, st)?
    let (_, st) = expect(tk, st, "LBrace")?
    let mut items = []
    let mut s = st
    while !at_k(tk, s, "RBrace") {
        let (item, s1) = parse_item(tk, s)?
        items = std::array::push(items, item)
        s = s1
    }
    let (_, st) = expect(tk, s, "RBrace")?
    Result::Ok((mk("module", name, false, nil, nil, nil, items, span), st))
}

fn parse_import(tk: array, st0: St) -> Result {
    let (span, st) = expect(tk, st0, "Import")?
    let (first, st) = expect_ident(tk, st)?
    let mut path = first
    let mut s = st
    loop {
        let (more, s1) = eat(tk, s, "ColonColon")
        if !more {
            break
        }
        let (seg, s2) = expect_ident(tk, s1)?
        path = path + "::" + seg
        s = s2
    }
    let (_, st) = eat(tk, s, "Semicolon")
    Result::Ok((leaf("import", path, span), st))
}

fn parse_const(tk: array, st0: St) -> Result {
    let (span, st) = expect(tk, st0, "Const")?
    let (name, st) = expect_ident(tk, st)?
    let (has_type, st) = eat(tk, st, "Colon")
    let mut type_ann: any = nil
    let mut s = st
    if has_type {
        let (t, s1) = parse_type(tk, st)?
        type_ann = t
        s = s1
    }
    let (_, st) = expect(tk, s, "Eq")?
    let (value, st) = parse_expr(tk, st)?
    let (_, st) = eat(tk, st, "Semicolon")
    Result::Ok((node2("const", name, type_ann, value, span), st))
}

// -------------------------------------------------------------------- tipos

// Lista de tipos separados por comas hasta `)` (sin consumirlo).
fn parse_type_list_paren(tk: array, st0: St) -> Result {
    let mut out = []
    let mut s = st0
    while !at_k(tk, s, "RParen") {
        let (t, s1) = parse_type(tk, s)?
        out = std::array::push(out, t)
        let (comma, s2) = eat(tk, s1, "Comma")
        s = s2
        if !comma {
            break
        }
    }
    Result::Ok((out, s))
}

fn parse_type(tk: array, st0: St) -> Result {
    let (bang, st) = eat(tk, st0, "Bang")
    if bang {
        return Result::Ok((ty("t_never", "", false, nil, nil, []), st))
    }
    let (amp, st) = eat(tk, st, "Ampersand")
    if amp {
        let (is_mut, s1) = eat(tk, st, "Mut")
        let (inner, s2) = parse_type(tk, s1)?
        return Result::Ok((ty("t_ref", "", is_mut, inner, nil, []), s2))
    }
    let (is_fn, st) = eat(tk, st, "Fn")
    if is_fn {
        let (_, s1) = expect(tk, st, "LParen")?
        let (params, s2) = parse_type_list_paren(tk, s1)?
        let (_, s3) = expect(tk, s2, "RParen")?
        let (has_ret, s4) = eat(tk, s3, "ThinArrow")
        if has_ret {
            let (r, s5) = parse_type(tk, s4)?
            return Result::Ok((ty("t_fn", "", false, r, nil, params), s5))
        }
        return Result::Ok((ty("t_fn", "", false, ty("t_unit", "", false, nil, nil, []), nil, params), s4))
    }
    let (bracket, st) = eat(tk, st, "LBracket")
    if bracket {
        let (inner, s1) = parse_type(tk, st)?
        let (semi, s2) = eat(tk, s1, "Semicolon")
        if semi {
            let (size, s3) = parse_expr(tk, s2)?
            let (_, s4) = expect(tk, s3, "RBracket")?
            return Result::Ok((ty("t_array", "", false, inner, size, []), s4))
        }
        let (_, s3) = expect(tk, s2, "RBracket")?
        return Result::Ok((ty("t_slice", "", false, inner, nil, []), s3))
    }
    let (paren, st) = eat(tk, st, "LParen")
    if paren {
        let (empty, s1) = eat(tk, st, "RParen")
        if empty {
            return Result::Ok((ty("t_unit", "", false, nil, nil, []), s1))
        }
        let (first, s2) = parse_type(tk, st)?
        let mut elements = [first]
        let mut s = s2
        loop {
            let (comma, s3) = eat(tk, s, "Comma")
            if !comma {
                break
            }
            s = s3
            if at_k(tk, s, "RParen") {
                break
            }
            let (t, s4) = parse_type(tk, s)?
            elements = std::array::push(elements, t)
            s = s4
        }
        let (_, s5) = expect(tk, s, "RParen")?
        return Result::Ok((ty("t_tuple", "", false, nil, nil, elements), s5))
    }
    let (name, st) = expect_ident(tk, st)?
    let mut generics = []
    let (lt, s1) = eat(tk, st, "Lt")
    let mut s = s1
    if lt {
        loop {
            let (g, s2) = parse_type(tk, s)?
            generics = std::array::push(generics, g)
            let (comma, s3) = eat(tk, s2, "Comma")
            s = s3
            if !comma {
                break
            }
        }
        let (_, s4) = expect(tk, s, "Gt")?
        s = s4
    }
    Result::Ok((ty("t_named", name, false, nil, nil, generics), s))
}

// ---------------------------------------------------------- destructuring

// Partes de un patrón de destructuring (TuplePart en Rust):
//   tp_wild, tp_ident(text flag=mut), tp_tuple(list), tp_struct(list=nombres list2=partes)
fn parse_destructure_part(tk: array, st0: St) -> Result {
    let (wild, st) = eat(tk, st0, "Underscore")
    if wild {
        return Result::Ok((leaf("tp_wild", "", zero_span()), st))
    }
    if at_k(tk, st, "LParen") {
        let (_, s1) = expect(tk, st, "LParen")?
        let mut inner = []
        let mut s = s1
        while !at_k(tk, s, "RParen") {
            let (p, s2) = parse_destructure_part(tk, s)?
            inner = std::array::push(inner, p)
            let (comma, s3) = eat(tk, s2, "Comma")
            s = s3
            if !comma {
                break
            }
        }
        let (_, s4) = expect(tk, s, "RParen")?
        return Result::Ok((mk("tp_tuple", "", false, nil, nil, nil, inner, zero_span()), s4))
    }
    if at_k(tk, st, "Ident") && kind_at(tk, st.pos + 1) == "LBrace" {
        let (_, s1) = expect_ident(tk, st)?
        let (_, s2) = expect(tk, s1, "LBrace")?
        let (names, parts, s3) = parse_struct_parts(tk, s2)?
        let (_, s4) = expect(tk, s3, "RBrace")?
        return Result::Ok((struct_part(names, parts), s4))
    }
    let (mutable, s1) = eat(tk, st, "Mut")
    let (name, s2) = expect_ident(tk, s1)?
    Result::Ok((mk("tp_ident", name, mutable, nil, nil, nil, [], zero_span()), s2))
}

fn struct_part(names: array, parts: array) -> Node {
    Node { kind: "tp_struct", text: "", text2: "", flag: false, a: nil, b: nil, c: nil, list: names, list2: parts, span: zero_span() }
}

// Campos `x, y: (a, b), z: w` hasta `}` (sin consumirlo).
// -> Ok((names, parts, st))
fn parse_struct_parts(tk: array, st0: St) -> Result {
    let mut names = []
    let mut parts = []
    let mut s = st0
    while !at_k(tk, s, "RBrace") {
        let (field, s1) = expect_ident(tk, s)?
        let (colon, s2) = eat(tk, s1, "Colon")
        let mut bound = mk("tp_ident", field, false, nil, nil, nil, [], zero_span())
        let mut s3 = s2
        if colon {
            let (p, s4) = parse_destructure_part(tk, s2)?
            bound = p
            s3 = s4
        }
        names = std::array::push(names, field)
        parts = std::array::push(parts, bound)
        let (comma, s5) = eat(tk, s3, "Comma")
        s = s5
        if !comma {
            break
        }
    }
    Result::Ok((names, parts, s))
}

fn index_access(temp: string, index: int, span: Span) -> Node {
    node2("index", "", ident_node(temp, span), int_node(index, span), span)
}

fn field_access(temp: string, field: string, span: Span) -> Node {
    node1("field", field, ident_node(temp, span), span)
}

// Emite `let <part> = <access>` recursivamente. -> (stmts, st)
fn emit_pattern_binding(stmts: array, part: Node, access: Node, span: Span, default_mutable: bool, st: St) -> any {
    let k = part.kind
    if k == "tp_wild" {
        return (stmts, st)
    }
    if k == "tp_ident" {
        return (std::array::push(stmts, let_stmt(part.text, part.flag || default_mutable, nil, access, span)), st)
    }
    let (temp, s1) = fresh(st)
    let mut out = std::array::push(stmts, let_stmt(temp, false, nil, access, span))
    let mut s = s1
    if k == "tp_tuple" {
        let mut index = 0
        for sub in part.list {
            let (o2, s2) = emit_pattern_binding(out, sub, index_access(temp, index, span), span, default_mutable, s)
            out = o2
            s = s2
            index += 1
        }
        return (out, s)
    }
    let mut i = 0
    while i < len(part.list) {
        let (o2, s2) = emit_pattern_binding(out, part.list2[i], field_access(temp, part.list[i], span), span, default_mutable, s)
        out = o2
        s = s2
        i += 1
    }
    return (out, s)
}

// Partes `(a, b, ...)` hasta `)` (consumido el `(` inicial y el `)` final).
fn parse_tuple_parts(tk: array, st0: St) -> Result {
    let (_, st) = expect(tk, st0, "LParen")?
    let mut parts = []
    let mut s = st
    while !at_k(tk, s, "RParen") {
        let (p, s1) = parse_destructure_part(tk, s)?
        parts = std::array::push(parts, p)
        let (comma, s2) = eat(tk, s1, "Comma")
        s = s2
        if !comma {
            break
        }
    }
    let (_, s3) = expect(tk, s, "RParen")?
    Result::Ok((parts, s3))
}

// `let (a, b) = expr` -> Ok((stmts, st))
fn desugar_tuple_let(tk: array, st0: St, stmts: array, span: Span, mutable: bool) -> Result {
    let (parts, st) = parse_tuple_parts(tk, st0)?
    let (_, st) = expect(tk, st, "Eq")?
    let (value, st) = parse_expr(tk, st)?
    let (_, st) = eat(tk, st, "Semicolon")
    let (temp, st) = fresh(st)
    let mut out = std::array::push(stmts, let_stmt(temp, false, nil, value, span))
    let mut s = st
    let mut index = 0
    for part in parts {
        let (o2, s2) = emit_pattern_binding(out, part, index_access(temp, index, span), span, mutable, s)
        out = o2
        s = s2
        index += 1
    }
    Result::Ok((out, s))
}

// `let Point { x, y } = expr` -> Ok((stmts, st))
fn desugar_struct_let(tk: array, st0: St, stmts: array, span: Span, mutable: bool) -> Result {
    let (_, st) = expect_ident(tk, st0)?
    let (_, st) = expect(tk, st, "LBrace")?
    let (names, parts, st) = parse_struct_parts(tk, st)?
    let (_, st) = expect(tk, st, "RBrace")?
    let (_, st) = expect(tk, st, "Eq")?
    let (value, st) = parse_expr(tk, st)?
    let (_, st) = eat(tk, st, "Semicolon")
    let (temp, st) = fresh(st)
    let mut out = std::array::push(stmts, let_stmt(temp, false, nil, value, span))
    let mut s = st
    let mut i = 0
    while i < len(names) {
        let (o2, s2) = emit_pattern_binding(out, parts[i], field_access(temp, names[i], span), span, mutable, s)
        out = o2
        s = s2
        i += 1
    }
    Result::Ok((out, s))
}

// ¿`Ident { ... }` en la posición actual va seguido (tras la `}` que lo
// cierra) del token `follow`? (`Eq` para let, `In` para for)
fn struct_pattern_followed_by(tk: array, st: St, follow: string) -> bool {
    let mut i = st.pos + 1
    let mut depth = 0
    while i < len(tk) {
        let k = tk[i].kind
        if k == "LBrace" {
            depth += 1
        } else if k == "RBrace" {
            depth -= 1
            if depth == 0 {
                return kind_at(tk, i + 1) == follow
            }
            if depth < 0 {
                return false
            }
        } else if k == "Eof" {
            return false
        }
        i += 1
    }
    false
}

// -------------------------------------------------------------------- bloques

fn parse_block_after_open(tk: array, st0: St, start: Span) -> Result {
    let mut stmts = []
    let mut final_expr: any = nil
    let mut st = st0
    while !at_k(tk, st, "RBrace") {
        if at_k(tk, st, "Eof") {
            return expected(tk, st, "'}'")
        }
        let (is_let, s1) = eat(tk, st, "Let")
        if is_let {
            let span = prev_span(tk, s1)
            let (mutable, s2) = eat(tk, s1, "Mut")
            if at_k(tk, s2, "LParen") {
                let (out, s3) = desugar_tuple_let(tk, s2, stmts, span, mutable)?
                stmts = out
                st = s3
                continue
            }
            if at_k(tk, s2, "Ident") && kind_at(tk, s2.pos + 1) == "LBrace" {
                if struct_pattern_followed_by(tk, s2, "Eq") {
                    let (out, s3) = desugar_struct_let(tk, s2, stmts, span, mutable)?
                    stmts = out
                    st = s3
                    continue
                }
            }
            let (wild, s3) = eat(tk, s2, "Underscore")
            let mut name = ""
            let mut s4 = s3
            if wild {
                let (n, s) = fresh(s3)
                name = n
                s4 = s
            } else {
                let (n, s) = expect_ident(tk, s3)?
                name = n
                s4 = s
            }
            let (has_type, s5) = eat(tk, s4, "Colon")
            let mut type_ann: any = nil
            let mut s6 = s5
            if has_type {
                let (t, s) = parse_type(tk, s5)?
                type_ann = t
                s6 = s
            }
            let (_, s7) = expect(tk, s6, "Eq")?
            let (value, s8) = parse_expr(tk, s7)?
            let (_, s9) = eat(tk, s8, "Semicolon")
            stmts = std::array::push(stmts, let_stmt(name, mutable, type_ann, value, span))
            st = s9
            continue
        }
        let k = kind_at(tk, st.pos)
        if k == "Fn" || k == "Extern" || k == "Struct" || k == "Enum" || k == "Const" {
            let (item, s2) = parse_item(tk, st)?
            stmts = std::array::push(stmts, node1("sitem", "", item, zero_span()))
            st = s2
            continue
        }
        let (expr, s2) = parse_expr(tk, st)?
        let (semi, s3) = eat(tk, s2, "Semicolon")
        st = s3
        if semi {
            stmts = std::array::push(stmts, node1("sexpr", "", expr, zero_span()))
        } else if at_k(tk, s3, "RBrace") {
            final_expr = expr
            break
        } else {
            stmts = std::array::push(stmts, node1("sexpr", "", expr, zero_span()))
        }
    }
    let (_, s_end) = expect(tk, st, "RBrace")?
    Result::Ok((block_node(stmts, final_expr, start), s_end))
}

// ---------------------------------------------------------------- expresiones

fn parse_expr(tk: array, st: St) -> Result {
    parse_assignment(tk, st)
}

fn assign_op(k: string) -> string {
    if k == "Eq" {
        return "="
    }
    if k == "PlusEq" {
        return "Add"
    }
    if k == "MinusEq" {
        return "Sub"
    }
    if k == "StarEq" {
        return "Mul"
    }
    if k == "SlashEq" {
        return "Div"
    }
    if k == "PercentEq" {
        return "Mod"
    }
    ""
}

fn parse_assignment(tk: array, st0: St) -> Result {
    let (left, st) = parse_range(tk, st0)?
    let op = assign_op(kind_at(tk, st.pos))
    if op == "" {
        return Result::Ok((left, st))
    }
    let (value, s2) = parse_assignment(tk, adv(tk, st))?
    let mut text = op
    if op == "=" {
        text = ""
    }
    Result::Ok((node2("assign", text, left, value, left.span), s2))
}

fn parse_range(tk: array, st0: St) -> Result {
    let (left, st) = parse_binary(tk, st0, 0)?
    let (r1, s1) = eat(tk, st, "Range")
    let mut is_range = r1
    let mut s = s1
    if !r1 {
        let (r2, s2) = eat(tk, st, "RangeInclusive")
        is_range = r2
        s = s2
    }
    if !is_range {
        return Result::Ok((left, st))
    }
    let inclusive = kind_at(tk, s.pos - 1) == "RangeInclusive"
    let (end, s3) = parse_binary(tk, s, 0)?
    Result::Ok((mk("range", "", inclusive, left, end, nil, [], left.span), s3))
}

// -> (op, precedencia) ; op "" si el token no es operador binario
fn binary_op(k: string) -> any {
    if k == "LazyOr" { return ("LazyOr", 1) }
    if k == "LazyAnd" { return ("LazyAnd", 2) }
    if k == "Pipe" { return ("Or", 3) }
    if k == "Caret" { return ("Xor", 4) }
    if k == "Ampersand" { return ("And", 5) }
    if k == "EqEq" { return ("Eq", 6) }
    if k == "NotEq" { return ("Neq", 6) }
    if k == "Lt" { return ("Lt", 7) }
    if k == "Gt" { return ("Gt", 7) }
    if k == "LtEq" { return ("Lte", 7) }
    if k == "GtEq" { return ("Gte", 7) }
    if k == "Plus" { return ("Add", 8) }
    if k == "Minus" { return ("Sub", 8) }
    if k == "Star" { return ("Mul", 9) }
    if k == "Slash" { return ("Div", 9) }
    if k == "Percent" { return ("Mod", 9) }
    return ("", 0)
}

// Un `-`, `*` o `&` con espacio (o salto de línea) antes y pegado a lo que
// sigue es un operador prefijo: empieza una expresión nueva.
fn operator_is_prefix_form(tk: array, st: St) -> bool {
    if st.pos >= len(tk) {
        return false
    }
    let op = tk[st.pos]
    let k = op.kind
    if !(k == "Minus" || k == "Star" || k == "Ampersand") {
        return false
    }
    let mut prev_index = st.pos - 1
    if st.pos == 0 {
        prev_index = 0
    }
    let prev = tk[prev_index]
    let spaced_before = prev.end < op.start
    let mut attached_after = false
    if st.pos + 1 < len(tk) {
        attached_after = tk[st.pos + 1].start == op.end
    }
    spaced_before && attached_after
}

fn parse_binary(tk: array, st0: St, min_prec: int) -> Result {
    let (first, st) = parse_unary(tk, st0)?
    let mut left = first
    let mut s = st
    loop {
        let k = kind_at(tk, s.pos)
        if k == "PipeGt" && min_prec == 0 {
            let (callee, s1) = parse_unary(tk, adv(tk, s))?
            s = s1
            let span = left.span
            if callee.kind == "call" {
                left = call_node(callee.a, std::array::concat([left], callee.list), span)
            } else {
                left = call_node(callee, [left], span)
            }
            continue
        }
        if k == "Spaceship" && 7 >= min_prec {
            let (right, s1) = parse_binary(tk, adv(tk, s), 8)?
            let (cmp, s2) = build_spaceship(left, right, left.span, s1)
            left = cmp
            s = s2
            continue
        }
        let (op, prec) = binary_op(k)
        if op == "" {
            break
        }
        if prec < min_prec {
            break
        }
        if operator_is_prefix_form(tk, s) {
            break
        }
        let (right, s1) = parse_binary(tk, adv(tk, s), prec + 1)?
        left = node2("binary", op, left, right, left.span)
        s = s1
    }
    Result::Ok((left, s))
}

// `a <=> b` -> { let t0 = a; let t1 = b; if t0 < t1 { -1 } else { if t0 > t1 { 1 } else { 0 } } }
// -> (expr, st)
fn build_spaceship(left: Node, right: Node, span: Span, st: St) -> any {
    let (ta, s1) = fresh(st)
    let (tb, s2) = fresh(s1)
    let less = node2("binary", "Lt", ident_node(ta, span), ident_node(tb, span), span)
    let greater = node2("binary", "Gt", ident_node(ta, span), ident_node(tb, span), span)
    let minus_one = node1("unary", "Neg", int_node(1, span), span)
    let inner_if = mk("if", "", false, greater, block_node([], int_node(1, span), span), block_node([], int_node(0, span), span), [], span)
    let cmp = mk("if", "", false, less, block_node([], minus_one, span), block_node([], inner_if, span), [], span)
    let stmts = [let_stmt(ta, false, nil, left, span), let_stmt(tb, false, nil, right, span)]
    return (block_node(stmts, cmp, span), s2)
}

fn unary_op(k: string) -> string {
    if k == "Minus" { return "Neg" }
    if k == "Bang" { return "Not" }
    if k == "Tilde" { return "BitNot" }
    if k == "Star" { return "Deref" }
    if k == "Ampersand" { return "Ref" }
    ""
}

fn parse_unary(tk: array, st: St) -> Result {
    let span = cur_span(tk, st)
    let op = unary_op(kind_at(tk, st.pos))
    if op != "" {
        let s1 = adv(tk, st)
        let mut real_op = op
        let mut s2 = s1
        if op == "Ref" {
            let (m, s) = eat(tk, s1, "Mut")
            if m {
                real_op = "RefMut"
                s2 = s
            }
        }
        let (inner, s3) = parse_unary(tk, s2)?
        return Result::Ok((node1("unary", real_op, inner, span), s3))
    }
    let (sp1, s1) = eat(tk, st, "Spawn")
    let mut is_spawn = sp1
    let mut s = s1
    if !sp1 {
        let (sp2, s2) = eat(tk, st, "Go")
        is_spawn = sp2
        s = s2
    }
    if is_spawn {
        let (inner, s3) = parse_unary(tk, s)?
        return Result::Ok((node1("spawn", "", inner, span), s3))
    }
    parse_postfix(tk, st)
}

// Argumentos de llamada hasta `)` (consumido el `(`; consume el `)`).
fn parse_call_args(tk: array, st0: St) -> Result {
    let mut args = []
    let mut s = st0
    while !at_k(tk, s, "RParen") {
        let (e, s1) = parse_expr(tk, s)?
        args = std::array::push(args, e)
        let (comma, s2) = eat(tk, s1, "Comma")
        s = s2
        if !comma {
            break
        }
    }
    let (_, s3) = expect(tk, s, "RParen")?
    Result::Ok((args, s3))
}

fn parse_postfix(tk: array, st0: St) -> Result {
    let (first, st) = parse_primary(tk, st0)?
    let mut expr = first
    let mut s = st
    loop {
        let k = kind_at(tk, s.pos)
        if k == "LParen" {
            let (args, s1) = parse_call_args(tk, adv(tk, s))?
            expr = call_node(expr, args, expr.span)
            s = s1
        } else if k == "LBracket" {
            let (index, s1) = parse_expr(tk, adv(tk, s))?
            let (_, s2) = expect(tk, s1, "RBracket")?
            expr = node2("index", "", expr, index, expr.span)
            s = s2
        } else if k == "Dot" {
            let s1 = adv(tk, s)
            let span = expr.span
            if at_k(tk, s1, "IntLit") {
                let text = tk[s1.pos].text
                let s2 = adv(tk, s1)
                let (value, s3) = parse_int(text, span, s2)?
                expr = node2("index", "", expr, int_node(value, span), span)
                s = s3
                continue
            }
            let (name, s2) = expect_ident(tk, s1)?
            let (call, s3) = eat(tk, s2, "LParen")
            if call {
                let (args, s4) = parse_call_args(tk, s3)?
                expr = mk("methodcall", name, false, expr, nil, nil, args, span)
                s = s4
            } else {
                expr = node1("field", name, expr, span)
                s = s3
            }
        } else if k == "Question" {
            expr = node1("try", "", expr, expr.span)
            s = adv(tk, s)
        } else {
            break
        }
    }
    Result::Ok((expr, s))
}

fn value_after_keyword(tk: array, st: St) -> Result {
    let k = kind_at(tk, st.pos)
    if k == "RBrace" || k == "Semicolon" || k == "Eof" {
        return Result::Ok((nil, st))
    }
    parse_expr(tk, st)
}

fn parse_primary(tk: array, st: St) -> Result {
    let span = cur_span(tk, st)
    let k = kind_at(tk, st.pos)
    if k == "IntLit" {
        let (value, s1) = parse_int(tk[st.pos].text, span, adv(tk, st))?
        return Result::Ok((int_node(value, span), s1))
    }
    if k == "FloatLit" {
        let (value, s1) = parse_float(tk[st.pos].text, span, adv(tk, st))?
        return Result::Ok((mk("float", "", false, value, nil, nil, [], span), s1))
    }
    if k == "StringLit" {
        let value = tk[st.pos].text
        if contains_interpolation(value) {
            return Result::Ok((leaf("template", value, span), adv(tk, st)))
        }
        return Result::Ok((leaf("string", value, span), adv(tk, st)))
    }
    if k == "CharLit" {
        return Result::Ok((leaf("char", tk[st.pos].text, span), adv(tk, st)))
    }
    if k == "True" {
        return Result::Ok((mk("bool", "", true, nil, nil, nil, [], span), adv(tk, st)))
    }
    if k == "False" {
        return Result::Ok((mk("bool", "", false, nil, nil, nil, [], span), adv(tk, st)))
    }
    if k == "Nil" {
        return Result::Ok((leaf("nil", "", span), adv(tk, st)))
    }
    if k == "Self_" {
        return Result::Ok((ident_node("self", span), adv(tk, st)))
    }
    if k == "Ident" {
        return parse_ident_or_struct(tk, st, span)
    }
    if k == "LParen" {
        let s1 = adv(tk, st)
        let (empty, s2) = eat(tk, s1, "RParen")
        if empty {
            return Result::Ok((mk("tuple", "", false, nil, nil, nil, [], span), s2))
        }
        let (first, s3) = parse_expr(tk, s1)?
        let (comma, s4) = eat(tk, s3, "Comma")
        if comma {
            let mut elements = [first]
            let mut s = s4
            while !at_k(tk, s, "RParen") {
                let (e, s5) = parse_expr(tk, s)?
                elements = std::array::push(elements, e)
                let (c2, s6) = eat(tk, s5, "Comma")
                s = s6
                if !c2 {
                    break
                }
            }
            let (_, s7) = expect(tk, s, "RParen")?
            return Result::Ok((mk("tuple", "", false, nil, nil, nil, elements, span), s7))
        }
        let (_, s8) = expect(tk, s3, "RParen")?
        return Result::Ok((first, s8))
    }
    if k == "LBracket" {
        return parse_array_literal(tk, adv(tk, st), span)
    }
    if k == "LBrace" {
        return parse_block_after_open(tk, adv(tk, st), span)
    }
    if k == "HashLBrace" {
        return parse_map_literal(tk, adv(tk, st), span)
    }
    if k == "Pipe" || k == "LazyOr" {
        return parse_closure(tk, st)
    }
    if k == "If" {
        return parse_if(tk, st)
    }
    if k == "While" {
        return parse_while(tk, st)
    }
    if k == "For" {
        return parse_for(tk, st)
    }
    if k == "Loop" {
        return parse_loop(tk, st)
    }
    if k == "Match" {
        return parse_match(tk, st)
    }
    if k == "Return" || k == "Break" {
        let (value, s1) = value_after_keyword(tk, adv(tk, st))?
        let mut kind = "return"
        if k == "Break" {
            kind = "break"
        }
        return Result::Ok((node1(kind, "", value, span), s1))
    }
    if k == "Continue" {
        return Result::Ok((leaf("continue", "", span), adv(tk, st)))
    }
    expected(tk, st, "an expression")
}

// Decide si la `{` actual abre el cuerpo de un literal de struct o un bloque.
fn brace_opens_struct_body(tk: array, st: St) -> bool {
    let k1 = kind_at(tk, st.pos + 1)
    if k1 == "RBrace" {
        return true
    }
    if k1 == "Ident" {
        let k2 = kind_at(tk, st.pos + 2)
        return k2 == "Colon" || k2 == "Comma" || k2 == "RBrace"
    }
    false
}

fn starts_uppercase(name: string) -> bool {
    let cs = std::text::chars(name)
    len(cs) > 0 && std::text::is_uppercase(cs[0])
}

fn parse_ident_or_struct(tk: array, st: St, span: Span) -> Result {
    let mut qualified = tk[st.pos].text
    let mut s = adv(tk, st)
    loop {
        let (more, s1) = eat(tk, s, "ColonColon")
        if !more {
            break
        }
        let (seg, s2) = expect_ident(tk, s1)?
        qualified = qualified + "::" + seg
        s = s2
    }
    if at_k(tk, s, "LBrace") && starts_uppercase(qualified) && brace_opens_struct_body(tk, s) {
        let mut names = []
        let mut values = []
        let mut s3 = adv(tk, s)
        while !at_k(tk, s3, "RBrace") {
            let (field, s4) = expect_ident(tk, s3)?
            let (colon, s5) = eat(tk, s4, "Colon")
            let mut value = ident_node(field, span)
            let mut s6 = s5
            if colon {
                let (v, s7) = parse_expr(tk, s5)?
                value = v
                s6 = s7
            }
            names = std::array::push(names, field)
            values = std::array::push(values, value)
            let (comma, s8) = eat(tk, s6, "Comma")
            s3 = s8
            if !comma {
                break
            }
        }
        let (_, s9) = expect(tk, s3, "RBrace")?
        let lit = Node { kind: "structlit", text: qualified, text2: "", flag: false, a: nil, b: nil, c: nil, list: names, list2: values, span: span }
        return Result::Ok((lit, s9))
    }
    Result::Ok((ident_node(qualified, span), s))
}

// `[a, ..b, c]`: sin spread es un array literal; con spread, una cadena de
// std::array::concat sobre trozos. El `[` ya se consumió.
fn parse_array_literal(tk: array, st0: St, span: Span) -> Result {
    let mut is_spread = []
    let mut values = []
    let mut had_spread = false
    let mut s = st0
    while !at_k(tk, s, "RBracket") {
        let (spread, s1) = eat(tk, s, "Range")
        if spread {
            had_spread = true
        }
        let (value, s2) = parse_expr(tk, s1)?
        is_spread = std::array::push(is_spread, spread)
        values = std::array::push(values, value)
        let (comma, s3) = eat(tk, s2, "Comma")
        s = s3
        if !comma {
            break
        }
    }
    let (_, s4) = expect(tk, s, "RBracket")?
    if !had_spread {
        return Result::Ok((mk("array", "", false, nil, nil, nil, values, span), s4))
    }
    Result::Ok((build_spread_array(is_spread, values, span), s4))
}

fn build_spread_array(is_spread: array, values: array, span: Span) -> Node {
    // Trozos: cada spread es un trozo; los ítems consecutivos se agrupan en
    // un único array literal.
    let mut chunks = []
    let mut items = []
    let mut have_items = false
    let mut i = 0
    while i < len(values) {
        if is_spread[i] {
            if have_items {
                chunks = std::array::push(chunks, mk("array", "", false, nil, nil, nil, items, span))
                items = []
                have_items = false
            }
            chunks = std::array::push(chunks, values[i])
        } else {
            items = std::array::push(items, values[i])
            have_items = true
        }
        i += 1
    }
    if have_items {
        chunks = std::array::push(chunks, mk("array", "", false, nil, nil, nil, items, span))
    }
    let mut acc = chunks[0]
    let mut j = 1
    while j < len(chunks) {
        acc = call_node(ident_node("std::array::concat", span), [acc, chunks[j]], span)
        j += 1
    }
    acc
}

// `#{ "k": v, k2: v2 }` -> std::map::insert(std::map::insert(std::map::new(), "k", v), "k2", v2)
fn parse_map_literal(tk: array, st0: St, span: Span) -> Result {
    let mut acc = call_node(ident_node("std::map::new", span), [], span)
    let mut s = st0
    while !at_k(tk, s, "RBrace") {
        let k = kind_at(tk, s.pos)
        if !(k == "StringLit" || k == "Ident") {
            return expected(tk, s, "a string literal or identifier as map key")
        }
        let key = tk[s.pos].text
        let (_, s1) = expect(tk, adv(tk, s), "Colon")?
        let (value, s2) = parse_expr(tk, s1)?
        acc = call_node(ident_node("std::map::insert", span), [acc, leaf("string", key, span), value], span)
        let (comma, s3) = eat(tk, s2, "Comma")
        s = s3
        if !comma {
            break
        }
    }
    let (_, s4) = expect(tk, s, "RBrace")?
    Result::Ok((acc, s4))
}

fn parse_closure(tk: array, st0: St) -> Result {
    let span = cur_span(tk, st0)
    let (lazy, st) = eat(tk, st0, "LazyOr")
    let mut params = []
    let mut s = st
    if !lazy {
        let (_, s1) = expect(tk, st, "Pipe")?
        s = s1
        while !at_k(tk, s, "Pipe") {
            let param_span = cur_span(tk, s)
            let (mutable, s2) = eat(tk, s, "Mut")
            let (name, s3) = expect_ident(tk, s2)?
            let (colon, s4) = eat(tk, s3, "Colon")
            let mut type_ann: any = nil
            let mut s5 = s4
            if colon {
                let (t, s6) = parse_type(tk, s4)?
                type_ann = t
                s5 = s6
            }
            params = std::array::push(params, mk("param", name, mutable, type_ann, nil, nil, [], param_span))
            let (comma, s7) = eat(tk, s5, "Comma")
            s = s7
            if !comma {
                break
            }
        }
        let (_, s8) = expect(tk, s, "Pipe")?
        s = s8
    }
    let (arrow, s9) = eat(tk, s, "ThinArrow")
    let mut ret: any = nil
    let mut s10 = s9
    if arrow {
        let (t, s11) = parse_type(tk, s9)?
        ret = t
        s10 = s11
    }
    let (body, s12) = parse_expr(tk, s10)?
    Result::Ok((mk("closure", "", false, ret, body, nil, params, span), s12))
}

fn parse_if(tk: array, st0: St) -> Result {
    let (span, st) = expect(tk, st0, "If")?
    let (cond, st) = parse_expr(tk, st)?
    let (_, st) = expect(tk, st, "LBrace")?
    let (then_branch, st) = parse_block_after_open(tk, st, span)?
    let (has_else, st) = eat(tk, st, "Else")
    if !has_else {
        return Result::Ok((mk("if", "", false, cond, then_branch, nil, [], span), st))
    }
    if at_k(tk, st, "If") {
        let (nested, s1) = parse_if(tk, st)?
        return Result::Ok((mk("if", "", false, cond, then_branch, block_node([], nested, span), [], span), s1))
    }
    let (_, s2) = expect(tk, st, "LBrace")?
    let (else_branch, s3) = parse_block_after_open(tk, s2, span)?
    Result::Ok((mk("if", "", false, cond, then_branch, else_branch, [], span), s3))
}

fn parse_while(tk: array, st0: St) -> Result {
    let (span, st) = expect(tk, st0, "While")?
    let (cond, st) = parse_expr(tk, st)?
    let (_, st) = expect(tk, st, "LBrace")?
    let (body, st) = parse_block_after_open(tk, st, span)?
    Result::Ok((node2("while", "", cond, body, span), st))
}

fn parse_loop(tk: array, st0: St) -> Result {
    let (span, st) = expect(tk, st0, "Loop")?
    let (_, st) = expect(tk, st, "LBrace")?
    let (body, st) = parse_block_after_open(tk, st, span)?
    Result::Ok((node1("loop", "", body, span), st))
}

fn parse_for(tk: array, st0: St) -> Result {
    let (span, st) = expect(tk, st0, "For")?
    if at_k(tk, st, "LParen") {
        let (parts, s1) = parse_tuple_parts(tk, st)?
        return finish_for_destructure(tk, s1, span, parts, [], true)
    }
    if at_k(tk, st, "Ident") && kind_at(tk, st.pos + 1) == "LBrace" {
        if struct_pattern_followed_by(tk, st, "In") {
            let (_, s1) = expect_ident(tk, st)?
            let (_, s2) = expect(tk, s1, "LBrace")?
            let (names, parts, s3) = parse_struct_parts(tk, s2)?
            let (_, s4) = expect(tk, s3, "RBrace")?
            return finish_for_destructure(tk, s4, span, parts, names, false)
        }
    }
    let (pattern, st) = parse_pattern(tk, st)?
    let (_, st) = expect(tk, st, "In")?
    let (iter, st) = parse_expr(tk, st)?
    let (_, st) = expect(tk, st, "LBrace")?
    let (body, st) = parse_block_after_open(tk, st, span)?
    Result::Ok((mk("for", "", false, pattern, iter, body, [], span), st))
}

// `for (a, b) in xs { ... }` / `for P { x, y } in xs { ... }`:
//   for __destrN in xs { let a = __destrN[0] ... ; <cuerpo> }
fn finish_for_destructure(tk: array, st0: St, span: Span, parts: array, names: array, is_tuple: bool) -> Result {
    let (_, st) = expect(tk, st0, "In")?
    let (iter, st) = parse_expr(tk, st)?
    let (_, st) = expect(tk, st, "LBrace")?
    let (temp, st) = fresh(st)
    let (body, st) = parse_block_after_open(tk, st, span)?
    let mut extra = []
    let mut s = st
    let mut i = 0
    while i < len(parts) {
        let mut access = index_access(temp, i, span)
        if !is_tuple {
            access = field_access(temp, names[i], span)
        }
        let (e2, s2) = emit_pattern_binding(extra, parts[i], access, span, false, s)
        extra = e2
        s = s2
        i += 1
    }
    let new_body = block_node(std::array::concat(extra, body.list), body.a, body.span)
    Result::Ok((mk("for", "", false, leaf("p_ident", temp, span), iter, new_body, [], span), s))
}

fn parse_match(tk: array, st0: St) -> Result {
    let (span, st) = expect(tk, st0, "Match")?
    let (scrutinee, st) = parse_expr(tk, st)?
    let (_, st) = expect(tk, st, "LBrace")?
    let mut arms = []
    let mut s = st
    while !at_k(tk, s, "RBrace") {
        let arm_span = cur_span(tk, s)
        let (pattern, s1) = parse_pattern(tk, s)?
        let (has_guard, s2) = eat(tk, s1, "If")
        let mut guard: any = nil
        let mut s3 = s2
        if has_guard {
            let (g, s4) = parse_expr(tk, s2)?
            guard = g
            s3 = s4
        }
        let (_, s5) = expect(tk, s3, "FatArrow")?
        let (brace, s6) = eat(tk, s5, "LBrace")
        let mut body = block_node([], nil, arm_span)
        let mut s7 = s6
        if brace {
            let (b, s8) = parse_block_after_open(tk, s6, arm_span)?
            body = b
            s7 = s8
        } else {
            let (e, s8) = parse_expr(tk, s6)?
            body = block_node([], e, arm_span)
            s7 = s8
        }
        arms = std::array::push(arms, mk("arm", "", false, pattern, guard, body, [], arm_span))
        let (_, s9) = eat(tk, s7, "Comma")
        s = s9
    }
    let (_, s10) = expect(tk, s, "RBrace")?
    Result::Ok((mk("match", "", false, scrutinee, nil, nil, arms, span), s10))
}

fn parse_pattern(tk: array, st: St) -> Result {
    let span = cur_span(tk, st)
    let k = kind_at(tk, st.pos)
    let mut pattern = leaf("p_wild", "", span)
    let mut s = adv(tk, st)
    if k == "Underscore" {
        pattern = leaf("p_wild", "", span)
    } else if k == "Ident" {
        let name = tk[st.pos].text
        let (cc, s1) = eat(tk, s, "ColonColon")
        if cc {
            let (variant, s2) = expect_ident(tk, s1)?
            let (paren, s3) = eat(tk, s2, "LParen")
            let mut inner: any = nil
            let mut s4 = s3
            if paren {
                let (p, s5) = parse_pattern(tk, s3)?
                let (_, s6) = expect(tk, s5, "RParen")?
                inner = p
                s4 = s6
            }
            pattern = Node { kind: "p_enum", text: name, text2: variant, flag: false, a: inner, b: nil, c: nil, list: [], list2: [], span: span }
            s = s4
        } else {
            pattern = leaf("p_ident", name, span)
        }
    } else if k == "IntLit" {
        let (value, s1) = parse_int(tk[st.pos].text, span, s)?
        pattern = node1("p_lit", "", int_node(value, span), span)
        s = s1
    } else if k == "StringLit" {
        pattern = node1("p_lit", "", leaf("string", tk[st.pos].text, span), span)
    } else if k == "True" {
        pattern = node1("p_lit", "", mk("bool", "", true, nil, nil, nil, [], span), span)
    } else if k == "False" {
        pattern = node1("p_lit", "", mk("bool", "", false, nil, nil, nil, [], span), span)
    } else {
        return expected(tk, st, "a pattern")
    }
    loop {
        let (pipe, s1) = eat(tk, s, "Pipe")
        if !pipe {
            break
        }
        let (right, s2) = parse_pattern(tk, s1)?
        pattern = node2("p_or", "", pattern, right, span)
        s = s2
    }
    Result::Ok((pattern, s))
}

// ------------------------------------------------- literales numéricos/texto

fn without_underscores(text: string) -> string {
    let mut out = ""
    for c in std::text::chars(text) {
        if c != '_' {
            out += c
        }
    }
    out
}

// `str::parse::<i64>` de Rust: signo opcional y al menos un dígito ASCII,
// dentro de rango. -> (ok, valor)
fn parse_i64(text: string) -> any {
    let cs = std::text::chars(text)
    let n = len(cs)
    let mut i = 0
    let mut negative = false
    if n > 0 && (cs[0] == '+' || cs[0] == '-') {
        negative = cs[0] == '-'
        i = 1
    }
    if i >= n {
        return (false, 0)
    }
    // Se acumula en negativo para cubrir -9223372036854775808.
    let mut value = 0
    let min_div10 = -922337203685477580
    while i < n {
        let code = std::text::char_code(cs[i])
        if code < 48 || code > 57 {
            return (false, 0)
        }
        let d = code - 48
        if value < min_div10 || (value == min_div10 && d > 8) {
            return (false, 0)
        }
        value = value * 10 - d
        i += 1
    }
    if negative {
        return (true, value)
    }
    if value == -9223372036854775807 - 1 {
        return (false, 0)
    }
    return (true, 0 - value)
}

fn parse_int(text: string, span: Span, st: St) -> Result {
    let (ok, value) = parse_i64(without_underscores(text))
    if ok {
        return Result::Ok((value, st))
    }
    message_at("integer literal out of range: " + text, span, st)
}

fn parse_float(text: string, span: Span, st: St) -> Result {
    match std::text::parse_float(without_underscores(text)) {
        Option::Some(v) => Result::Ok((v, st)),
        _ => message_at("invalid float literal: " + text, span, st),
    }
}

fn is_ws(c) -> bool {
    std::text::is_whitespace(c)
}

// `str::trim` sobre un array de chars -> array de chars.
fn trim_chars(cs: array) -> array {
    let mut a = 0
    let mut b = len(cs)
    while a < b && is_ws(cs[a]) {
        a += 1
    }
    while b > a && is_ws(cs[b - 1]) {
        b -= 1
    }
    std::array::slice(cs, a, b)
}

fn join_chars(cs: array) -> string {
    let mut out = ""
    for c in cs {
        out += c
    }
    out
}

fn find_char(cs: array, from: int, target) -> int {
    let mut i = from
    while i < len(cs) {
        if cs[i] == target {
            return i
        }
        i += 1
    }
    -1
}

fn valid_identifier(cs: array) -> bool {
    if len(cs) == 0 {
        return false
    }
    if !(cs[0] == '_' || std::text::is_alphabetic(cs[0])) {
        return false
    }
    let mut i = 1
    while i < len(cs) {
        if !(cs[i] == '_' || std::text::is_alphanumeric(cs[i])) {
            return false
        }
        i += 1
    }
    true
}

// Ruta `a.b`, `a::b` o mezcla; cada segmento es un identificador válido.
fn valid_path(cs: array) -> bool {
    if len(cs) == 0 {
        return false
    }
    // "::" -> "." (de izquierda a derecha, sin solapamiento), luego split('.')
    let mut norm = []
    let mut i = 0
    while i < len(cs) {
        if cs[i] == ':' && i + 1 < len(cs) && cs[i + 1] == ':' {
            norm = std::array::push(norm, '.')
            i += 2
        } else {
            norm = std::array::push(norm, cs[i])
            i += 1
        }
    }
    let mut seg = []
    for c in norm {
        if c == '.' {
            if !valid_identifier(seg) {
                return false
            }
            seg = []
        } else {
            seg = std::array::push(seg, c)
        }
    }
    valid_identifier(seg)
}

fn valid_interpolation(cs: array) -> bool {
    if valid_path(cs) {
        return true
    }
    let open = find_char(cs, 0, '(')
    if open < 0 {
        return false
    }
    let n = len(cs)
    if cs[n - 1] != ')' {
        return false
    }
    if !valid_path(trim_chars(std::array::slice(cs, 0, open))) {
        return false
    }
    let args = std::array::slice(cs, open + 1, n - 1)
    if len(trim_chars(args)) == 0 {
        return true
    }
    // split(',') y cada argumento recortado: no vacío y ruta o entero.
    let mut start = 0
    let mut i = 0
    while i <= len(args) {
        if i == len(args) || args[i] == ',' {
            let arg = trim_chars(std::array::slice(args, start, i))
            if len(arg) == 0 {
                return false
            }
            let (is_int, _) = parse_i64(join_chars(arg))
            if !(valid_path(arg) || is_int) {
                return false
            }
            start = i + 1
        }
        i += 1
    }
    true
}

fn contains_interpolation(value: string) -> bool {
    let cs = std::text::chars(value)
    let mut from = 0
    loop {
        let open = find_char(cs, from, '{')
        if open < 0 {
            return false
        }
        let close = find_char(cs, open + 1, '}')
        if close < 0 {
            return false
        }
        if valid_interpolation(trim_chars(std::array::slice(cs, open + 1, close))) {
            return true
        }
        from = close + 1
    }
    false
}

// ------------------------------------------------------------ volcado canónico
// Mismo formato que titan_parser::dump_ast (Rust).

fn esc(text: string) -> string {
    let mut out = ""
    for c in std::text::chars(text) {
        let code = std::text::char_code(c)
        if c == '\\' {
            out += "\\\\"
        } else if c == '"' {
            out += "\\\""
        } else if c == '\n' {
            out += "\\n"
        } else if c == '\r' {
            out += "\\r"
        } else if c == '\t' {
            out += "\\t"
        } else if c == '\0' {
            out += "\\0"
        } else if code < 32 || code == 127 {
            out += "\\u{" + hex(code) + "}"
        } else {
            out += c
        }
    }
    out
}

fn q(text: string) -> string {
    "\"" + esc(text) + "\""
}

fn sp(s: Span) -> string {
    let l = s.line
    let c = s.col
    let a = s.start
    let b = s.end
    "@{l}:{c}:{a}..{b}"
}

fn indent(d: int) -> string {
    let mut out = ""
    let mut i = 0
    while i < d {
        out += "  "
        i += 1
    }
    out
}

fn line(d: int, text: string) -> string {
    indent(d) + text + "\n"
}

fn bool_text(b: bool) -> string {
    if b {
        return "true"
    }
    "false"
}

fn d_item(d: int, label: string, n: Node) -> string {
    let k = n.kind
    if k == "fn" {
        return d_function(d, label, n)
    }
    if k == "struct" {
        let mut out = line(d, label + "struct " + q(n.text) + " " + sp(n.span))
        for f in n.list {
            out += line(d + 1, "field " + q(f.text) + " " + sp(f.span))
            out += d_ty(d + 2, "type: ", f.a)
        }
        return out
    }
    if k == "enum" {
        let mut out = line(d, label + "enum " + q(n.text) + " " + sp(n.span))
        for v in n.list {
            out += line(d + 1, "variant " + q(v.text) + " " + sp(v.span))
            out += d_opt_ty(d + 2, "payload: ", v.a)
        }
        return out
    }
    if k == "trait" {
        let mut out = line(d, label + "trait " + q(n.text) + " " + sp(n.span))
        for m in n.list {
            out += line(d + 1, "method " + q(m.text) + " " + sp(m.span))
            for p in m.list {
                out += d_param(d + 2, p)
            }
            out += d_opt_ty(d + 2, "ret: ", m.b)
            out += d_opt_block(d + 2, "body: ", m.c)
        }
        return out
    }
    if k == "impl" {
        let mut tr = "-"
        if n.a != nil {
            tr = q(n.a)
        }
        let mut out = line(d, label + "impl trait=" + tr + " " + sp(n.span))
        out += d_ty(d + 1, "target: ", n.b)
        for m in n.list {
            out += d_function(d + 1, "", m)
        }
        return out
    }
    if k == "module" {
        let mut out = line(d, label + "module " + q(n.text) + " " + sp(n.span))
        for it in n.list {
            out += d_item(d + 1, "", it)
        }
        return out
    }
    if k == "import" {
        return line(d, label + "import " + q(n.text) + " " + sp(n.span))
    }
    if k == "const" {
        let mut out = line(d, label + "const " + q(n.text) + " " + sp(n.span))
        out += d_opt_ty(d + 1, "type: ", n.a)
        out += d_expr(d + 1, "value: ", n.b)
        return out
    }
    // typealias
    line(d, label + "type " + q(n.text) + " " + sp(n.span)) + d_ty(d + 1, "target: ", n.a)
}

fn d_function(d: int, label: string, f: Node) -> string {
    let mut abi = "-"
    if f.a != nil {
        abi = q(f.a)
    }
    let mut out = line(d, label + "fn " + q(f.text) + " extern=" + bool_text(f.flag) + " abi=" + abi + " " + sp(f.span))
    for p in f.list {
        out += d_param(d + 1, p)
    }
    out += d_opt_ty(d + 1, "ret: ", f.b)
    out += d_opt_block(d + 1, "body: ", f.c)
    out
}

fn d_param(d: int, p: Node) -> string {
    let mut out = line(d, "param " + q(p.text) + " mut=" + bool_text(p.flag) + " " + sp(p.span))
    out += d_opt_ty(d + 1, "type: ", p.a)
    if p.b != nil {
        out += d_expr(d + 1, "default: ", p.b)
    } else {
        out += line(d + 1, "default: -")
    }
    out
}

fn d_opt_ty(d: int, label: string, t) -> string {
    if t == nil {
        return line(d, label + "-")
    }
    d_ty(d, label, t)
}

fn d_ty(d: int, label: string, t: Node) -> string {
    let k = t.kind
    if k == "t_named" {
        let mut out = line(d, label + "named " + q(t.text))
        for g in t.list {
            out += d_ty(d + 1, "", g)
        }
        return out
    }
    if k == "t_ref" {
        return line(d, label + "ref mut=" + bool_text(t.flag)) + d_ty(d + 1, "", t.a)
    }
    if k == "t_slice" {
        return line(d, label + "slice") + d_ty(d + 1, "", t.a)
    }
    if k == "t_array" {
        return line(d, label + "array-type") + d_ty(d + 1, "inner: ", t.a) + d_expr(d + 1, "size: ", t.b)
    }
    if k == "t_tuple" {
        let mut out = line(d, label + "tuple-type")
        for e in t.list {
            out += d_ty(d + 1, "", e)
        }
        return out
    }
    if k == "t_fn" {
        let mut out = line(d, label + "fn-type")
        for p in t.list {
            out += d_ty(d + 1, "param: ", p)
        }
        return out + d_ty(d + 1, "ret: ", t.a)
    }
    if k == "t_unit" {
        return line(d, label + "unit")
    }
    line(d, label + "never")
}

fn d_opt_block(d: int, label: string, b) -> string {
    if b == nil {
        return line(d, label + "-")
    }
    d_block(d, label, b)
}

fn d_block(d: int, label: string, b: Node) -> string {
    let mut out = line(d, label + "block " + sp(b.span))
    for s in b.list {
        out += d_stmt(d + 1, s)
    }
    out + d_opt_expr(d + 1, "final: ", b.a)
}

fn d_stmt(d: int, s: Node) -> string {
    let k = s.kind
    if k == "sexpr" {
        return d_expr(d, "expr: ", s.a)
    }
    if k == "slet" {
        let mut out = line(d, "let-stmt " + q(s.text) + " mut=" + bool_text(s.flag) + " " + sp(s.span))
        out += d_opt_ty(d + 1, "type: ", s.a)
        return out + d_expr(d + 1, "value: ", s.b)
    }
    d_item(d, "item: ", s.a)
}

fn d_opt_expr(d: int, label: string, e) -> string {
    if e == nil {
        return line(d, label + "-")
    }
    d_expr(d, label, e)
}

fn d_list(d: int, label: string, xs: array) -> string {
    let mut out = ""
    for x in xs {
        out += d_expr(d, label, x)
    }
    out
}

fn d_expr(d: int, label: string, e: Node) -> string {
    let k = e.kind
    let s = sp(e.span)
    if k == "int" || k == "float" {
        let v = e.a
        return line(d, label + k + " {v} " + s)
    }
    if k == "string" || k == "template" || k == "char" || k == "ident" {
        return line(d, label + k + " " + q(e.text) + " " + s)
    }
    if k == "bool" {
        return line(d, label + "bool " + bool_text(e.flag) + " " + s)
    }
    if k == "nil" || k == "continue" {
        return line(d, label + k + " " + s)
    }
    if k == "array" || k == "tuple" {
        return line(d, label + k + " " + s) + d_list(d + 1, "", e.list)
    }
    if k == "structlit" {
        let mut out = line(d, label + "structlit " + q(e.text) + " " + s)
        let mut i = 0
        while i < len(e.list) {
            out += d_expr(d + 1, q(e.list[i]) + " = ", e.list2[i])
            i += 1
        }
        return out
    }
    if k == "binary" || k == "unary" {
        let mut out = line(d, label + k + " " + e.text + " " + s) + d_expr(d + 1, "", e.a)
        if k == "binary" {
            out += d_expr(d + 1, "", e.b)
        }
        return out
    }
    if k == "range" {
        return line(d, label + "range inclusive=" + bool_text(e.flag) + " " + s) + d_expr(d + 1, "", e.a) + d_expr(d + 1, "", e.b)
    }
    if k == "call" {
        return line(d, label + "call " + s) + d_expr(d + 1, "callee: ", e.a) + d_list(d + 1, "arg: ", e.list)
    }
    if k == "methodcall" {
        return line(d, label + "methodcall " + q(e.text) + " " + s) + d_expr(d + 1, "recv: ", e.a) + d_list(d + 1, "arg: ", e.list)
    }
    if k == "index" {
        return line(d, label + "index " + s) + d_expr(d + 1, "", e.a) + d_expr(d + 1, "", e.b)
    }
    if k == "field" {
        return line(d, label + "field " + q(e.text) + " " + s) + d_expr(d + 1, "", e.a)
    }
    if k == "if" {
        return line(d, label + "if " + s) + d_expr(d + 1, "cond: ", e.a) + d_block(d + 1, "then: ", e.b) + d_opt_block(d + 1, "else: ", e.c)
    }
    if k == "match" {
        let mut out = line(d, label + "match " + s) + d_expr(d + 1, "scrutinee: ", e.a)
        for arm in e.list {
            out += line(d + 1, "arm " + sp(arm.span))
            out += d_pattern(d + 2, "pat: ", arm.a)
            out += d_opt_expr(d + 2, "guard: ", arm.b)
            out += d_block(d + 2, "body: ", arm.c)
        }
        return out
    }
    if k == "for" {
        return line(d, label + "for " + s) + d_pattern(d + 1, "pat: ", e.a) + d_expr(d + 1, "iter: ", e.b) + d_block(d + 1, "body: ", e.c)
    }
    if k == "while" {
        return line(d, label + "while " + s) + d_expr(d + 1, "cond: ", e.a) + d_block(d + 1, "body: ", e.b)
    }
    if k == "loop" {
        return line(d, label + "loop " + s) + d_block(d + 1, "body: ", e.a)
    }
    if k == "break" || k == "return" {
        return line(d, label + k + " " + s) + d_opt_expr(d + 1, "value: ", e.a)
    }
    if k == "assign" {
        let mut op = e.text
        if op == "" {
            op = "-"
        }
        return line(d, label + "assign op=" + op + " " + s) + d_expr(d + 1, "target: ", e.a) + d_expr(d + 1, "value: ", e.b)
    }
    if k == "block" {
        return d_block(d, label, e)
    }
    if k == "spawn" || k == "try" {
        return line(d, label + k + " " + s) + d_expr(d + 1, "", e.a)
    }
    // closure
    let mut out = line(d, label + "closure " + s)
    for p in e.list {
        out += d_param(d + 1, p)
    }
    out += d_opt_ty(d + 1, "ret: ", e.a)
    out + d_expr(d + 1, "body: ", e.b)
}

fn d_pattern(d: int, label: string, p: Node) -> string {
    let k = p.kind
    let s = sp(p.span)
    if k == "p_wild" {
        return line(d, label + "pwild " + s)
    }
    if k == "p_ident" {
        return line(d, label + "pident " + q(p.text) + " " + s)
    }
    if k == "p_lit" {
        return line(d, label + "plit " + s) + d_expr(d + 1, "", p.a)
    }
    if k == "p_enum" {
        let mut out = line(d, label + "penum " + q(p.text) + " " + q(p.text2) + " " + s)
        if p.a != nil {
            return out + d_pattern(d + 1, "inner: ", p.a)
        }
        return out + line(d + 1, "inner: -")
    }
    // p_or
    line(d, label + "por " + s) + d_pattern(d + 1, "", p.a) + d_pattern(d + 1, "", p.b)
}

fn dump_ast(text: string) -> string {
    let (tokens, lex_errors) = tokenize(text)
    if len(lex_errors) > 0 {
        let mut out = ""
        for e in lex_errors {
            out += "lex-error: " + esc(e) + "\n"
        }
        return out
    }
    let (items, errors) = parse_program(tokens)
    if len(errors) > 0 {
        let mut out = ""
        for e in errors {
            out += "error: " + esc(e) + "\n"
        }
        return out
    }
    let mut out = "program\n"
    for item in items {
        out += d_item(1, "", item)
    }
    out
}

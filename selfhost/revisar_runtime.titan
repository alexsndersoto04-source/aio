// Revisa de verdad (cargador + typechecker de Titan) selfhost/native/runtime.titan
// con las mismas firmas que usa build.titan, sin generar código máquina.
// Uso: titan run selfhost/revisar_runtime.titan [RUNTIME]
// Imprime `ok` o los diagnósticos reales; con errores sale con código 1 y, si no
// encuentra el runtime, con código 2.
//
// RUNTIME por defecto: `native/runtime.titan` buscado desde la carpeta actual hacia
// arriba (también se acepta `selfhost/native/runtime.titan`). Antes la ruta salía de
// `ar_program()`, que con la VM de Rust era el `.titan` en ejecución; en un ejecutable
// nativo es el binario temporal de `titan run`, así que la búsqueda acababa en
// `/tmp/native/runtime.titan` y la herramienta no servía sin la VM.
import args
import frontend
import native::backend

// Devuelve la ruta del runtime o nil si no se encuentra.
fn rr_buscar(dir: string, sube: int) -> any {
    if sube < 0 {
        return nil
    }
    for base in [std::path::join(dir, "native"), std::path::join(std::path::join(dir, "selfhost"), "native")] {
        let candidato = std::path::join(base, "runtime.titan")
        if std::fs::is_file(candidato) {
            return candidato
        }
    }
    let arriba: any = std::path::parent(dir)
    if arriba == nil {
        return nil
    }
    rr_buscar(arriba, sube - 1)
}

fn rr_runtime(args: array) -> any {
    if len(args) > 0 {
        return args[0]
    }
    rr_buscar(std::env::current_dir(), 8)
}

fn main() {
    let runtime: any = rr_runtime(ar_user_args())
    if runtime == nil {
        println("no se encontró native/runtime.titan desde " + std::env::current_dir() + " (pasa la ruta como argumento)")
        std::process::exit(2)
    }
    let natives = std::array::concat(native_table(), raw_signatures())
    match front(runtime, natives) {
        Result::Ok(g) => {
            println("ok")
        },
        Result::Err(message) => {
            println(message)
            std::process::exit(1)
        },
    }
}

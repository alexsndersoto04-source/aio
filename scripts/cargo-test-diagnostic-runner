#!/usr/bin/env bash
set -uo pipefail

log_file="$(mktemp "${TMPDIR:-/tmp}/titan-test-runner.XXXXXXXX.log")"
trap 'rm -f "$log_file"' EXIT

"$@" 2>&1 | tee "$log_file"
status=${PIPESTATUS[0]}
if (( status != 0 )) && [[ -n "${GITHUB_ACTIONS:-}" ]]; then
    python3 - "$log_file" <<'PY'
import pathlib, sys
text = pathlib.Path(sys.argv[1]).read_text(errors="replace")[-12_000:]
for index in range(0, len(text), 3_800):
    message = text[index:index + 3_800]
    message = message.replace("%", "%25").replace("\r", "%0D").replace("\n", "%0A")
    print(f"::error file=scripts/cargo-test-diagnostic-runner,line=1,title=TEST_FAILURE_{index // 3800:02d}::{message}")
PY
fi
exit "$status"

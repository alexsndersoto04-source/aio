#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 1 ]]; then
    echo "usage: android-ndk-tool <tool> [arguments...]" >&2
    exit 2
fi
tool="$1"
shift

ndk_root="${ANDROID_NDK_ROOT:-${ANDROID_NDK_HOME:-${ANDROID_NDK:-}}}"
android_root="${ANDROID_SDK_ROOT:-${ANDROID_HOME:-}}"
if [[ -z "$ndk_root" && -n "$android_root" && -d "$android_root/ndk" ]]; then
    preferred="$android_root/ndk/27.3.13750724"
    if [[ -d "$preferred" ]]; then
        ndk_root="$preferred"
    else
        ndk_root="$(find "$android_root/ndk" -mindepth 1 -maxdepth 1 -type d -printf '%p\n' | sort -V | tail -n 1)"
    fi
fi
if [[ -z "$ndk_root" || ! -d "$ndk_root" ]]; then
    echo "error: Android NDK not found; set ANDROID_NDK_ROOT or ANDROID_SDK_ROOT" >&2
    exit 2
fi

case "$(uname -s)" in
    Linux) host=linux-x86_64 ;;
    Darwin)
        if [[ "$(uname -m)" == arm64 ]]; then host=darwin-x86_64
        else host=darwin-x86_64
        fi
        ;;
    *) echo "error: unsupported Android NDK host $(uname -s)" >&2; exit 2 ;;
esac

executable="$ndk_root/toolchains/llvm/prebuilt/$host/bin/$tool"
if [[ ! -x "$executable" ]]; then
    echo "error: Android NDK tool is unavailable: $executable" >&2
    exit 2
fi
exec "$executable" "$@"
